[Unit]
Description=PSCI-via-EFI test: restore the stock m1n1 image early in boot
DefaultDependencies=no
RequiresMountsFor=/var/lib/deepidle
After=systemd-udev-trigger.service
ConditionPathExists=/var/lib/deepidle/psci-efi-armed
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/deepidle/psci-efi-early.sh

[Install]
WantedBy=sysinit.target
