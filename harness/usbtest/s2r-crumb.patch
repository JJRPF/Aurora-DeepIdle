index 000000000000..d5e4e82c7278
--- /dev/null
+++ w/drivers/base/power/s2r_crumb.c
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Debug: write the device PM callback in progress to PMU scratch 0x6040 so it survives the reset. */
+#include <linux/device.h>
+#include <linux/pm.h>
+#include <linux/string.h>
+#include <linux/err.h>
+#include <linux/nvmem-consumer.h>
+
+static struct nvmem_device *s2r_crumb_nvmem;
+
+static int s2r_crumb_match(struct device *dev, const void *data)
+{
+	return !strncmp(dev_name(dev), "spmi_nvmem", 10);
+}
+
+void s2r_crumb(struct device *dev, pm_message_t state, const char *info)
+{
+	u8 buf[16] = { };
+	const char *n = dev_name(dev);
+
+	if (!s2r_crumb_nvmem) {
+		s2r_crumb_nvmem = nvmem_device_find(NULL, s2r_crumb_match);
+		if (IS_ERR(s2r_crumb_nvmem))
+			s2r_crumb_nvmem = NULL;
+		if (!s2r_crumb_nvmem)
+			return;
+	}
+	buf[0] = state.event & 0xff;
+	buf[1] = info ? info[0] : '?';
+	if (n)
+		strscpy((char *)&buf[2], n, 14);
+	nvmem_device_write(s2r_crumb_nvmem, 0x6040, sizeof(buf), buf);
+}
