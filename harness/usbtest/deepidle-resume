#!/bin/bash
# GH-5: reopens the Antigravity (agy) session after a test reboot (Omarchy post-boot hook).
# Armed by ~/.local/state/deepidle/resume (holds the worktree path); remove that file to stop it.
STATE=$HOME/.local/state/deepidle
[ -s "$STATE/resume" ] || exit 0
DIR=$(head -1 "$STATE/resume"); [ -d "$DIR" ] || exit 0
echo "$(date '+%F %T') resume launched in $DIR" >> "$STATE/resume.log"
sleep 20
exec xdg-terminal-exec --title="deep-idle (AGY)" --dir="$DIR" -- \
    bash -lc 'CONV=$(head -1 ~/.local/state/deepidle/agy-conversation 2>/dev/null); if [ -n "$CONV" ]; then set -- --conversation "$CONV"; else set -- --continue; fi; agy "$@" --remote-control --dangerously-skip-permissions -i "$(cat ~/.local/state/deepidle/prompt.txt)"; echo "agy exited: $?"; exec bash'
