#!/bin/bash
# GH-5 / Coordination: reopens the S2R agent (Claude Code, resumes the last conversation in the S2R worktree) and the GPU-AGY / Lichen-AGY agents after a reboot
# and instructs each to immediately reconnect to Lichen (Omarchy post-boot hook).
# Armed by ~/.local/state/deepidle/resume (holds the S2R worktree path); remove that file to stop it.
STATE=$HOME/.local/state/deepidle
[ -s "$STATE/resume" ] || exit 0
DIR=$(head -1 "$STATE/resume"); [ -d "$DIR" ] || exit 0
# one launch at a time, and never a second S2R Claude: skip if a claude already runs in the worktree
exec 9>"$STATE/resume.lock"; flock -n 9 || { echo "$(date '+%F %T') resume skipped (another hook run holds the lock)" >> "$STATE/resume.log"; exit 0; }
echo "$(date '+%F %T') resume launched (S2R-Claude, GPU-AGY, Lichen-AGY)" >> "$STATE/resume.log"
sleep 20

launch_agy() {
    local title="$1" dir="$2" conv="$3" prompt_file="$4"
    [ -d "$dir" ] || return 0
    xdg-terminal-exec --title="$title" --dir="$dir" -- \
        bash -lc "agy --conversation '$conv' --remote-control --dangerously-skip-permissions -i \"\$(cat '$prompt_file')\"; echo 'agy exited: \$?'; exec bash" >/dev/null 2>&1 &
}

# S2R agent: Claude Code, resumes the most recent conversation in the worktree, inside herdr
# (a workspace in the default herdr session; no direct terminal fallback).
CLAUDE_CMD="claude --continue --dangerously-skip-permissions \"\$(cat '$STATE/prompt-claude.txt')\"; echo \"claude exited: \$?\"; exec bash"
H="herdr --session default"
launch_in_herdr() {
    command -v herdr >/dev/null || return 1
    if ! $H status server 2>/dev/null | grep -q 'status: running'; then
        nohup herdr --session default server >> "$STATE/herdr-server.log" 2>&1 &
        for _ in $(seq 1 30); do
            $H status server 2>/dev/null | grep -q 'status: running' && break
            sleep 1
        done
    fi
    $H status server 2>/dev/null | grep -q 'status: running' || return 1
    local out pane
    out=$($H workspace create --cwd "$DIR" --label "S2R-Claude" --no-focus 2>>"$STATE/resume.log") || return 1
    pane=$(printf '%s' "$out" | python3 -c 'import sys,json
d=json.load(sys.stdin)
def find(o):
    if isinstance(o,dict):
        for k,v in o.items():
            if k in ("pane_id","root_pane_id") and isinstance(v,str): return v
            r=find(v)
            if r: return r
    elif isinstance(o,list):
        for v in o:
            r=find(v)
            if r: return r
print(find(d) or "")' 2>/dev/null)
    [ -n "$pane" ] || return 1
    WS=${pane%%:*}
    # pane run types the words into the pane's shell, so hand it a script path (no quoting to lose)
    printf '#!/bin/bash\n%s\n' "$CLAUDE_CMD" > "$STATE/claude-launch.sh"
    $H pane run "$pane" bash -l "$STATE/claude-launch.sh" >>"$STATE/resume.log" 2>&1 || { $H workspace close "$WS" >>"$STATE/resume.log" 2>&1; return 1; }
}
# only through the default herdr session (no direct terminal); retry, then log the failure
s2r_running() {
    local p
    for p in $(ps -eo pid=,args= | awk '$2 ~ /claude$/ {print $1}'); do
        [ "$(readlink /proc/$p/cwd 2>/dev/null)" = "$DIR" ] && return 0
    done
    return 1
}
ok=0
if s2r_running; then ok=2; fi
for try in 1 2 3; do
    [ "$ok" = 2 ] && break
    if launch_in_herdr; then ok=1; break; fi
    sleep 10
done
if [ "$ok" = 2 ]; then
    echo "$(date '+%F %T') S2R Claude already running in $DIR; not starting another" >> "$STATE/resume.log"
elif [ "$ok" = 1 ]; then
    echo "$(date '+%F %T') S2R-Claude started in the default herdr session" >> "$STATE/resume.log"
else
    echo "$(date '+%F %T') herdr (default session) launch FAILED after 3 tries; no terminal fallback" >> "$STATE/resume.log"
fi
# make sure the herdr window itself is on screen (the server alone is headless): attach a client to the default session
if ! ps -eo args= | grep -qx 'herdr\( --session default\)\?'; then
    for _ in $(seq 1 30); do pgrep -x Hyprland >/dev/null && break; sleep 2; done
    xdg-terminal-exec --title="herdr" -- herdr --session default >/dev/null 2>&1 &
    echo "$(date '+%F %T') herdr client window opened" >> "$STATE/resume.log"
fi
sleep 2
# paused while S2R is the sole focus: launch_agy "GPU-AGY" "$HOME/dev/Aurora-GPUParity" "6703655e-f34e-4a18-aaa1-8e0fc9935c43" "$STATE/prompt-gpu.txt"
sleep 2
# paused while S2R is the sole focus: launch_agy "Lichen-AGY" "$HOME/dev/Lichen" "75d72571-9cfd-4259-99b6-2e77046a36d8" "$STATE/prompt-lichen.txt"
