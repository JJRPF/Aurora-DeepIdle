#!/bin/bash
# GH-5 / Coordination: reopens the S2R agent (Claude Code, resumes the last conversation in the S2R worktree) and the GPU-AGY / Lichen-AGY agents after a reboot
# and instructs each to immediately reconnect to Lichen (Omarchy post-boot hook).
# Armed by ~/.local/state/deepidle/resume (holds the S2R worktree path); remove that file to stop it.
STATE=$HOME/.local/state/deepidle
[ -s "$STATE/resume" ] || exit 0
DIR=$(head -1 "$STATE/resume"); [ -d "$DIR" ] || exit 0
echo "$(date '+%F %T') resume launched (S2R-Claude, GPU-AGY, Lichen-AGY)" >> "$STATE/resume.log"
sleep 20

launch_agy() {
    local title="$1" dir="$2" conv="$3" prompt_file="$4"
    [ -d "$dir" ] || return 0
    xdg-terminal-exec --title="$title" --dir="$dir" -- \
        bash -lc "agy --conversation '$conv' --remote-control --dangerously-skip-permissions -i \"\$(cat '$prompt_file')\"; echo 'agy exited: \$?'; exec bash" >/dev/null 2>&1 &
}

# S2R agent: Claude Code, resumes the most recent conversation in the worktree, inside herdr
# (a workspace on the persistent herdr server; falls back to a plain terminal if herdr is not usable).
CLAUDE_CMD="claude --continue --dangerously-skip-permissions \"\$(cat '$STATE/prompt-claude.txt')\"; echo \"claude exited: \$?\"; exec bash"
launch_in_herdr() {
    command -v herdr >/dev/null || return 1
    if ! herdr status server 2>/dev/null | grep -q 'status: running'; then
        nohup herdr server >> "$STATE/herdr-server.log" 2>&1 &
        for _ in $(seq 1 20); do
            herdr status server 2>/dev/null | grep -q 'status: running' && break
            sleep 1
        done
    fi
    herdr status server 2>/dev/null | grep -q 'status: running' || return 1
    local out pane
    out=$(herdr workspace create --cwd "$DIR" --label "S2R-Claude" --no-focus 2>>"$STATE/resume.log") || return 1
    pane=$(printf '%s' "$out" | python3 -c 'import sys,json
d=json.load(sys.stdin)
def find(o):
    if isinstance(o,dict):
        for k,v in o.items():
            if k in ("pane_id","root_pane_id") and isinstance(v,str): return v
            r=find(v)
            if r: return r
    elif isinstance(o,list):
        for v in o:
            r=find(v)
            if r: return r
print(find(d) or "")' 2>/dev/null)
    [ -n "$pane" ] || return 1
    herdr pane run "$pane" bash -lc "$CLAUDE_CMD" >>"$STATE/resume.log" 2>&1
}
if launch_in_herdr; then
    echo "$(date '+%F %T') S2R-Claude started in herdr" >> "$STATE/resume.log"
else
    echo "$(date '+%F %T') herdr launch failed, using a plain terminal" >> "$STATE/resume.log"
    xdg-terminal-exec --title="S2R-Claude" --dir="$DIR" -- bash -lc "$CLAUDE_CMD" >/dev/null 2>&1 &
fi
sleep 2
# paused while S2R is the sole focus: launch_agy "GPU-AGY" "$HOME/dev/Aurora-GPUParity" "6703655e-f34e-4a18-aaa1-8e0fc9935c43" "$STATE/prompt-gpu.txt"
sleep 2
# paused while S2R is the sole focus: launch_agy "Lichen-AGY" "$HOME/dev/Lichen" "75d72571-9cfd-4259-99b6-2e77046a36d8" "$STATE/prompt-lichen.txt"
