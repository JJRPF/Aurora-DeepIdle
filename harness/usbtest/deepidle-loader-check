#!/bin/bash
# GH-5: run by the pacman hook 96-deepidle-loader-check.hook after update-m1n1. Detects that the S2R boot image
# (Aura 129, recorded in /var/lib/deepidle/bootbin/boot.sha256) in m1n1/boot.bin was replaced by the stock image,
# and says so. It never writes the boot chain (a wrong boot.bin can leave the Mac unbootable without
# recoveryOS): put the saved image back by hand: sudo install-bootbin-s2r.
S=/var/lib/deepidle/bootbin; E=/boot/efi/m1n1
[ -s $S/boot.sha256 ] || exit 0
if [ "$(sha256sum $E/boot.bin 2>/dev/null | cut -c1-64)" = "$(cat $S/boot.sha256)" ]; then
    rm -f $S/NEEDS_REBUILD; exit 0
fi
{ date '+%F %T'; echo "update-m1n1 replaced the S2R boot.bin with the stock image; the S2R kernel still boots, but deep sleep needs it back: sudo bash harness/usbtest/bootbin.sh persist $S/boot-s2r.bin"; } > $S/NEEDS_REBUILD
echo "deepidle: update-m1n1 replaced the S2R boot.bin (see $S/NEEDS_REBUILD). The Mac boots normally; S2R sleep is off until the saved image ($S/boot-s2r.bin) is put back with bootbin.sh persist."
exit 0
