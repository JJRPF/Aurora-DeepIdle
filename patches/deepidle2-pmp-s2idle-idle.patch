+++ b/drivers/soc/apple/pmp-sleep.c	2026-10-17 10:37:59.897576554 -0400
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Tell the PMP when the system is in s2idle.
+ *
+ * macOS puts the PMP's RTKit into IOP power state IDLE (0x201, state kept)
+ * as a platform sleep action after every device driver has powered down, and
+ * back to INIT (0x220) on wake (ApplePMP, IOPlatformSleepAction 610). Linux's
+ * s2idle never told the PMP anything. This hooks the same point: the s2idle
+ * platform prepare() runs after every device's suspend_late and before the
+ * noirq phase, so the mailbox interrupt still works; restore() runs after
+ * resume_noirq.
+ *
+ * Built in (s2idle_set_ops is not exported) whenever the PMP driver is built.
+ * Disable with apple_pmp_sleep.s2idle_idle=0 on the command line, or at run
+ * time through /sys/module/apple_pmp_sleep/parameters/s2idle_idle.
+ */
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/printk.h>
+#include <linux/soc/apple/pmp-sleep.h>
+#include <linux/suspend.h>
+
+#undef MODULE_PARAM_PREFIX
+#define MODULE_PARAM_PREFIX "apple_pmp_sleep."
+
+static bool s2idle_idle = true;
+module_param(s2idle_idle, bool, 0644);
+MODULE_PARM_DESC(s2idle_idle, "Put the PMP into RTKit IDLE during s2idle");
+
+static DEFINE_MUTEX(pmp_sleep_lock);
+static void *pmp_ctx;
+static int (*pmp_idle)(void *ctx);
+static int (*pmp_wake)(void *ctx);
+static bool pmp_idled;
+
+static int pmp_s2idle_prepare(void)
+{
+	ktime_t t0 = ktime_get();
+	int ret;
+
+	guard(mutex)(&pmp_sleep_lock);
+	if (!s2idle_idle || !pmp_ctx)
+		return 0;
+	ret = pmp_idle(pmp_ctx);
+	if (ret) {
+		/* Never block the suspend over this; the PMP just stays on. */
+		pr_warn("apple-pmp-sleep: idle failed (%d), PMP left running\n", ret);
+		return 0;
+	}
+	pmp_idled = true;
+	pr_info("apple-pmp-sleep: PMP idle in %lld us\n",
+		ktime_us_delta(ktime_get(), t0));
+	return 0;
+}
+
+static void pmp_s2idle_restore(void)
+{
+	ktime_t t0 = ktime_get();
+	int ret;
+
+	guard(mutex)(&pmp_sleep_lock);
+	if (!pmp_idled)
+		return;
+	pmp_idled = false;
+	ret = pmp_wake(pmp_ctx);
+	if (ret)
+		pr_err("apple-pmp-sleep: wake failed (%d)\n", ret);
+	else
+		pr_info("apple-pmp-sleep: PMP awake in %lld us\n",
+			ktime_us_delta(ktime_get(), t0));
+}
+
+static const struct platform_s2idle_ops pmp_s2idle_ops = {
+	.prepare = pmp_s2idle_prepare,
+	.restore = pmp_s2idle_restore,
+};
+
+int apple_pmp_sleep_register(void *ctx, int (*idle)(void *), int (*wake)(void *))
+{
+	guard(mutex)(&pmp_sleep_lock);
+	if (pmp_ctx)
+		return -EBUSY;
+	pmp_ctx = ctx;
+	pmp_idle = idle;
+	pmp_wake = wake;
+	s2idle_set_ops(&pmp_s2idle_ops);
+	pr_info("apple-pmp-sleep: s2idle hook registered (s2idle_idle=%d)\n", s2idle_idle);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(apple_pmp_sleep_register);
+
+void apple_pmp_sleep_unregister(void *ctx)
+{
+	guard(mutex)(&pmp_sleep_lock);
+	if (pmp_ctx != ctx)
+		return;
+	s2idle_set_ops(NULL);
+	pmp_ctx = NULL;
+	pmp_idle = NULL;
+	pmp_wake = NULL;
+	pmp_idled = false;
+}
+EXPORT_SYMBOL_GPL(apple_pmp_sleep_unregister);
+
+MODULE_LICENSE("Dual MIT/GPL");
