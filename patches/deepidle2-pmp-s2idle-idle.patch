+/// s2idle hook (pmp-sleep.c): put the PMP's RTKit into IDLE, as macOS does
+/// while the system sleeps.
+unsafe extern "C" fn pmp_sleep_idle(ctx: *mut core::ffi::c_void) -> core::ffi::c_int {
+    // SAFETY: `ctx` is the `PmpData` registered in probe; PmpDriver unregisters
+    // it before the Arc can drop.
+    let data = unsafe { &*(ctx as *const PmpData) };
+    let mut guard = data.rtkit.lock();
+    match guard.as_mut().as_pin_mut() {
+        Some(rtk) => match rtk.idle() {
+            Ok(()) => 0,
+            Err(e) => e.to_errno(),
+        },
+        None => -(bindings::ENODEV as core::ffi::c_int),
+    }
+}
+
+/// s2idle hook: wake the PMP's RTKit again (IOP INIT, then AP ON).
+unsafe extern "C" fn pmp_sleep_wake(ctx: *mut core::ffi::c_void) -> core::ffi::c_int {
+    // SAFETY: as in `pmp_sleep_idle`.
+    let data = unsafe { &*(ctx as *const PmpData) };
+    let mut guard = data.rtkit.lock();
+    match guard.as_mut().as_pin_mut() {
+        Some(rtk) => match rtk.wake() {
+            Ok(()) => 0,
+            Err(e) => e.to_errno(),
+        },
+        None => -(bindings::ENODEV as core::ffi::c_int),
+    }
+}
