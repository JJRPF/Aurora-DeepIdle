index 34bdee648798..0907a3e525a4 100644
--- i/drivers/phy/apple/atc.c
+++ w/drivers/phy/apple/atc.c
@@ -39,6 +39,7 @@
 #include <linux/reset-controller.h>
 #include <linux/soc/apple/dp-tunnel.h>
 #include <linux/soc/apple/tunable.h>
+#include <linux/suspend.h>
 #include <linux/types.h>
 #include <linux/usb.h>
 #include <linux/usb/hcd.h>
@@ -1195,6 +1196,12 @@ static int atcphy_pipehandler_lock(struct apple_atcphy *atcphy)
 			reg, atcphy->mode, atcphy->pipe_state, atcphy->mode_dirty);
 		clear32(atcphy->regs.pipehandler + PIPEHANDLER_LOCK_REQ, 1);
 		dev_warn(atcphy->dev, "Pipehandler lock not acked.\n");
+		/* GH-5 TEST: the state the S2R job records after the wake */
+		dev_warn(atcphy->dev,
+			 "TEST s2r: lock nak aon=%08x mux=%08x req=%08x ack=%08x mode=%u pipe=%u host=%u\n",
+			 readl(atcphy->regs.pipehandler + PIPEHANDLER_AON_GEN),
+			 readl(atcphy->regs.pipehandler + PIPEHANDLER_MUX_CTRL), requested, reg,
+			 atcphy->mode, atcphy->pipe_state, atcphy->host_active);
 	}
 
 	return ret;
@@ -5441,7 +5448,26 @@ static int atcphy_resume(struct device *dev)
 	return 0;
 }
 
-static DEFINE_SIMPLE_DEV_PM_OPS(atcphy_pm_ops, NULL, atcphy_resume);
+/*
+ * GH-5: a suspend to RAM with a real S2R power cut resets the PHY while genpd still has its domain as on, so the
+ * domain notifier never sees it go off. Assume the cut and let resume run the full restore.
+ */
+static bool s2r_assume_cut = true;
+module_param(s2r_assume_cut, bool, 0644);
+MODULE_PARM_DESC(s2r_assume_cut, "GH-5: treat a suspend to RAM as a power cut and restore the PHY on resume");
+
+static int atcphy_suspend(struct device *dev)
+{
+	struct apple_atcphy *atcphy = dev_get_drvdata(dev);
+
+	if (s2r_assume_cut && pm_suspend_target_state == PM_SUSPEND_MEM) {
+		WRITE_ONCE(atcphy->pd_was_off, true);
+		dev_info(dev, "TEST s2r: PHY marked for a full restore on resume\n");
+	}
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(atcphy_pm_ops, atcphy_suspend, atcphy_resume);
 
