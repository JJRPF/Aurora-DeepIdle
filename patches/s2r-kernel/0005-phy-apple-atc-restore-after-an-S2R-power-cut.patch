+/*
+ * T6020/T6021 (M2 Pro/Max): the T8103 layout, but the PIPE lock is only
+ * acknowledged while the dummy PIPE PHY is enabled, as on T8122. iBoot leaves
+ * the bit set; it resets with the PHY's power domain (a runtime power-down or
+ * a suspend to RAM), after which every USB3 start fails with "Pipehandler lock
+ * not acked". Set it again on every park.
+ */
+static const struct atcphy_hw atcphy_hw_t6020 = {
+	.gen = ATCPHY_GENERATION_T8103,
+	.aciophy_lane_mode = ACIOPHY_LANE_MODE_T8103,
+	.aciophy_crossbar = ACIOPHY_CROSSBAR_T8103,
+	.configure_post_tunable = atcphy_configure_post_tunable_t8103,
+	.pipe_mux_clk = PIPEHANDLER_MUX_CTRL_CLK_T8103,
+	.pipe_mux_data = PIPEHANDLER_MUX_CTRL_DATA_T8103,
+	.has_usb4 = true,
+	.park_dummy_phy = true,
+};
+
 static const struct atcphy_hw atcphy_hw_t8122 = {
 	.gen = ATCPHY_GENERATION_T8122,
 	.aciophy_lane_mode = ACIOPHY_LANE_MODE_T8122,
@@ -5490,6 +5534,7 @@ static const struct atcphy_hw atcphy_hw_t8142 = {
 };
 
