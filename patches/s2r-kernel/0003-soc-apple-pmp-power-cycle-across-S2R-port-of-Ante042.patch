+		dev_info(dev, "sleep: PMP %s: %d\n", pmp_cycle ? "stopped, SRAM saved" : "SetAPPower/SetIOPPower IDLE", ret);
 		/* TEST: macOS's trace step 6, the CPU complexes' requests withdrawn last */
