+/* GH-5 R60D TEST: every readable SMC key with its type and value, for a before/after-sleep comparison */
+static int macsmc_reboot_keys_show(struct seq_file *m, void *unused)
+{
+	struct apple_smc *smc = m->private;
+	u8 buf[32];
+	int i;
+
+	for (i = 0; i < smc->key_count; i++) {
+		struct apple_smc_key_info info;
+		smc_key key;
+		int ret;
+
+		if (apple_smc_get_key_by_index(smc, i, &key) < 0)
+			continue;
+		if (apple_smc_get_key_info(smc, key, &info) < 0) {
+			seq_printf(m, "%p4ch ? info error\n", &key);
+			continue;
+		}
+		if (!(info.flags & 0x80) || info.size == 0 || info.size > sizeof(buf)) {
+			seq_printf(m, "%p4ch %p4ch f%02x s%u -\n", &key, &info.type_code, info.flags, info.size);
+			continue;
+		}
+		ret = apple_smc_read(smc, key, buf, info.size);
+		if (ret < 0)
+			seq_printf(m, "%p4ch %p4ch f%02x s%u err %d\n", &key, &info.type_code, info.flags, info.size, ret);
+		else
+			seq_printf(m, "%p4ch %p4ch f%02x s%u %*phN\n", &key, &info.type_code, info.flags, info.size,
