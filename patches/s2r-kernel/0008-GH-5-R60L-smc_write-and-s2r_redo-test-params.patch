+/*
+ * GH-5: after a real suspend-to-RAM power cut a conventional port comes back with its slot unpowered (the SMC drops
+ * PWREN), its link down and its MSI and RID2SID setup gone; only probe sets those up. Redo that part of probe here,
+ * in the normal resume phase (the SMC, which drives PWREN, needs interrupts), before the endpoints' drivers resume,
+ * then put the config space of the devices below back, since their noirq restore ran against a dead link.
+ * Idea and result on t602x: nekolyanich ("redo probe's whole per-port setup").
+ */
+static unsigned int s2r_pwren_off_ms = 200;
+module_param(s2r_pwren_off_ms, uint, 0644);
+MODULE_PARM_DESC(s2r_pwren_off_ms, "GH-5: ms with PWREN low before the port power-on after an S2R power cut (0 = no cycle)");
+static unsigned int s2r_attempts = 3;
+module_param(s2r_attempts, uint, 0644);
+MODULE_PARM_DESC(s2r_attempts, "GH-5: how many times to redo a lost port's setup after resume, 3 s apart");
+static unsigned int s2r_resume_delay_ms = 1500;
+module_param(s2r_resume_delay_ms, uint, 0644);
+MODULE_PARM_DESC(s2r_resume_delay_ms, "Delay before a lost conventional port is set up again after resume");
+
+static void apple_pcie_s2r_work(struct work_struct *work)
+{
+	bool any_up = false;
+	struct apple_pcie *pcie = container_of(work, struct apple_pcie, s2r_work);
+	struct device *dev = pcie->dev;
+	struct apple_pcie_port *port;
+	struct pci_bus *root = NULL;
+	struct pci_dev *pdev = NULL, *child, *tmp;
+	bool redone = false;
+	unsigned int attempt;
+	int perst_dir = -1;
+	u32 stat;
+	int ret;
+
+	msleep(s2r_resume_delay_ms);
+	for (attempt = 1; attempt <= s2r_attempts; attempt++) {
+	if (attempt > 1) {
+		if (any_up)
+			break;
+		msleep(3000);
+	}
+	list_for_each_entry(port, &pcie->ports, entry) {
+		if (apple_pcie_port_readl(port, PORT_LINKSTS) & PORT_LINKSTS_UP)
+			continue;
+		dev_info(dev, "port %pOF lost its link in suspend (status %#x, link %#x): redoing its setup\n",
+			 port->np, apple_pcie_port_readl(port, PORT_STATUS),
+			 apple_pcie_port_readl(port, PORT_LINKSTS));
+		if (!port->perst)
+			continue;
+		/*
+		 * GH-5 R59W: gpiolib's set_value only flips the data bit. If the power cut put PERST#'s pin back to an
+		 * input (its reset state), it is never driven again. Record what is found and make it an output (asserted).
+		 */
+		perst_dir = gpiod_get_direction(port->perst);
+		gpiod_direction_output(port->perst, 1);
+		/*
+		 * GH-5 R58T: the SMC may have cut the slot's rail in S2R while gpiolib still has PWREN high, and t602x
+		 * has no pwren_off_ms, so power_on would only write 1 again. Hold PERST# and drop PWREN long enough for
+		 * the rail to discharge before power_on brings it back.
+		 */
+		if (port->pwren && s2r_pwren_off_ms) {
+			gpiod_set_value_cansleep(port->perst, 1);
+			gpiod_set_value_cansleep(port->pwren, 0);
+			msleep(s2r_pwren_off_ms);
+		}
+		ret = apple_pcie_port_power_on(pcie, port);
+		if (ret) {
+			dev_err(dev, "port %pOF power-on after resume failed: %d\n", port->np, ret);
+			continue;
+		}
+		if (!pcie->hw->retain_clocks) {
+			if (pcie->hw->port_refclk)
+				rmw_clear(PORT_REFCLK_CGDIS, port->base + pcie->hw->port_refclk);
+			else if (port->phy)
+				rmw_set(PHY_LANE_CFG_REFCLKCGEN, port->phy + PHY_LANE_CFG);
+			rmw_clear(PORT_APPCLK_CGDIS, port->base + PORT_APPCLK);
+		}
+		apple_pcie_port_writel(port, ~0, PORT_INTMSK);
+		apple_pcie_port_writel(port, ~0, PORT_INTSTAT);
+		apple_pcie_port_writel(port, ~0, PORT_LINKCMDSTS);
+		apple_pcie_port_program_msi(port);
+		apple_pcie_port_writel(port, PORT_LTSSMCTL_START, PORT_LTSSMCTL);
+		ret = readl_relaxed_poll_timeout(port->base + PORT_LINKSTS, stat,
+						 stat & PORT_LINKSTS_UP, 1000,
+						 link_up_timeout * 1000);
+		apple_pcie_port_writel(port, port->s2r_intmask, PORT_INTMSK);
+		dev_info(dev, "port %pOF link %s after resume (%#x)\n", port->np,
+			 ret ? "still down" : "up", stat);
+		/* GH-5 R59V: one line per try for the job: attempt, PWREN read back, link status, port status */
+		dev_info(dev, "TEST s2r: port %u try %u pwren %d link %08x status %08x perstdir %d\n", port->idx, attempt,
+			 port->pwren ? gpiod_get_value_cansleep(port->pwren) : -1,
+			 apple_pcie_port_readl(port, PORT_LINKSTS), apple_pcie_port_readl(port, PORT_STATUS), perst_dir);
+		redone = true;
+		if (!ret)
+			any_up = true;
+	}
+	}
+	if (!redone)
+		return;
+	/*
+	 * GH-5 R59M: the R59K rescan aborted reading the Wi-Fi's vendor ID right after its link came up (a config read
+	 * before the device is ready is fatal here). PCIe asks for 100 ms after link up; give it 200 ms, and do not
+	 * rescan at all when no link came back.
+	 */
+	if (!any_up) {
+		dev_info(dev, "no link came back after resume, not rescanning\n");
+		return;
+	}
+	msleep(200);
+	/* The devices below went through resume against a dead link: take them away and enumerate them afresh. */
+	pci_lock_rescan_remove();
+	for_each_pci_dev(pdev) {
+		struct pci_host_bridge *hb = pci_find_host_bridge(pdev->bus);
+
+		if (hb && hb->dev.parent == dev) {
+			root = hb->bus;
+			pci_dev_put(pdev);
+			break;
+		}
+	}
+	if (root) {
+		list_for_each_entry_safe_reverse(child, tmp, &root->devices, bus_list)
+			pci_stop_and_remove_bus_device(child);
+		dev_info(dev, "rescanning after the S2R power cut: %u devices\n", pci_rescan_bus(root));
+	}
+	pci_unlock_rescan_remove();
+}
+
+/*
+ * GH-5: after a real suspend-to-RAM power cut a conventional port comes back with its slot unpowered (the SMC drops
+ * PWREN), its link down and its MSI setup gone; only probe sets those up. Redo that part of probe from a work item
+ * (the SMC, which drives PWREN, may not take commands yet while devices resume), then enumerate the devices below
+ * afresh. Idea and result on t602x: nekolyanich ("redo probe's whole per-port setup").
+ */
+static int apple_pcie_resume(struct device *dev)
+{
+	struct apple_pcie *pcie = apple_pcie_lookup(dev);
+
+	if (pcie->hw->tunneled || !s2r_resume)
+		return 0;
+	queue_work(system_long_wq, &pcie->s2r_work);
+	return 0;
+}
+
 static const struct dev_pm_ops apple_pcie_pm_ops = {
 	.suspend_noirq = apple_pcie_suspend_noirq,
 	.resume_noirq = apple_pcie_resume_noirq,
+	.resume = apple_pcie_resume,
 };
 
