+/*
+ * GH-5 R61M5 TEST: after a post-wake cold restart of the internal DCP the firmware says "Driver didn't load in
+ * iBoot". Do what iBoot (and m1n1) do on the disp0 service first: HPD/modes, SetPower(1), SetMode(first valid).
+ */
+bool ibootep_test_internal;
+
+static int iboot_test_pick(struct iboot_query *query, u32 op, u8 *reply, u8 *out)
+{
+	const u8 *payload, *mode;
+	size_t size;
+	u32 count, i;
+	int ret, best = -1;
+
+	ret = iboot_read_query(query, op, reply, &payload, &size);
+	if (!ret)
+		ret = iboot_parse_modes(payload, size, &count);
+	if (ret)
+		return ret;
+	for (i = 0; i < count; i++) {
+		mode = payload + 4 + i * IBOOT_MODE_SIZE;
+		if (get_unaligned_le32(mode) != 1)
+			continue;
+		if (best < 0)
+			best = i;
+		if (op == IBOOT_GET_COLOR_MODES && get_unaligned_le32(mode + 12) == 1 &&
+		    get_unaligned_le32(mode + 16) == 32) {
+			best = i;
+			break;
+		}
+		if (op == IBOOT_GET_TIMING_MODES)
+			break;
+	}
+	if (best < 0)
+		return -ENODATA;
+	memcpy(out, payload + 4 + best * IBOOT_MODE_SIZE, IBOOT_MODE_SIZE);
+	dev_info(query->service->ep->dcp->dev, "TEST iBoot: op %u picks index %d of %u: %*phN\n",
+		 op, best, count, IBOOT_MODE_SIZE, out);
+	return 0;
+}
+
+int ibootep_test_bringup(struct apple_dcp *dcp)
+{
+	struct iboot_query *query = ERR_PTR(-EAGAIN);
+	u8 modes[2 * IBOOT_MODE_SIZE], power = 1;
+	u8 *reply;
+	int ret, n;
+
+	for (n = 0; n < 60; n++) {
+		query = iboot_find_query(dcp);
+		if (!IS_ERR(query))
+			break;
+		msleep(50);
+	}
+	if (IS_ERR(query)) {
+		dev_info(dcp->dev, "TEST iBoot: no disp0 service: %ld\n", PTR_ERR(query));
+		return PTR_ERR(query);
+	}
+	reply = kzalloc(IBOOT_QUERY_RX_SIZE, GFP_KERNEL);
+	if (!reply)
+		return -ENOMEM;
+	ret = iboot_refresh_modes(query, reply);
+	dev_info(dcp->dev, "TEST iBoot: HPD/mode query %d\n", ret);
+	ret = iboot_test_pick(query, IBOOT_GET_TIMING_MODES, reply, modes);
+	if (!ret)
+		ret = iboot_test_pick(query, IBOOT_GET_COLOR_MODES, reply, modes + IBOOT_MODE_SIZE);
+	if (ret)
+		goto out;
+	ret = iboot_pattern_command(query, 2, &power, sizeof(power), reply);
+	dev_info(dcp->dev, "TEST iBoot: SetPower(1) %d\n", ret);
+	if (ret)
+		goto out;
+	msleep(100);
+	ret = iboot_pattern_command(query, 6, modes, sizeof(modes), reply);
+	dev_info(dcp->dev, "TEST iBoot: SetMode %d\n", ret);
+out:
+	kfree(reply);
+	return ret;
+}
