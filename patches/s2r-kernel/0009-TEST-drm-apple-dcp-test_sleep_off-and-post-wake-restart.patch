 	mutex_unlock(&dcp->hpd_mutex);
 }
 
+/*
+ * TEST: for a deep suspend, stop the coprocessor's firmware instead of keeping
+ * its power domains on through the wake path, so genpd can power them off.
+ * GH-5 R61H: with test_wake_restart, the DCP whose coproc block is at
+ * test_restart_coproc is cold-started again after the wake: its ASC wrapper's
+ * IO RVBAR (test_restart_iorvbar, ADT reg 1) is saved at suspend and written
+ * back if the power cut lost it, CPU_CONTROL RUN, RTKit reinit + boot, then
+ * dcp_start(). Every step is logged; the others stay down until reboot.
+ */
+static bool test_sleep_off;
+module_param(test_sleep_off, bool, 0644);
+MODULE_PARM_DESC(test_sleep_off,
+		 "TEST: shut the DCP firmware down for a deep suspend");
+static bool test_wake_restart;
+module_param(test_wake_restart, bool, 0644);
+MODULE_PARM_DESC(test_wake_restart, "TEST GH-5: cold-start one DCP after the wake");
+static unsigned long test_restart_coproc = 0x389c00000UL;
+module_param(test_restart_coproc, ulong, 0644);
+static unsigned long test_restart_iorvbar = 0x389850000UL;
+module_param(test_restart_iorvbar, ulong, 0644);
+int iomfb_test_restart_iomfb(struct apple_dcp *dcp);
+extern dma_addr_t dcp_test_shmem_iova;
+#define dcp_test_shmem_iova_get() dcp_test_shmem_iova
+static unsigned int test_restart_step;
+static bool test_restart_iboot;
+module_param(test_restart_iboot, bool, 0644);
+module_param(test_restart_step, uint, 0644);
+static bool test_restart_keep;
+module_param(test_restart_keep, bool, 0644);
+static bool test_restart_nostart;
+module_param(test_restart_nostart, bool, 0644);
+static unsigned int test_restart_delay_ms = 2000;
+module_param(test_restart_delay_ms, uint, 0644);
+
+/*
+ * GH-5 R61M: test_restart_fwdata: the firmware's writable __DATA segment is put back
+ * from the firmware Mach-O (request_firmware("apple/dcp-fw.macho"), loaded at suspend)
+ * before RUN, so the restart starts from pristine data. Segment phys addresses are the
+ * live ADT's iop-dcp0-nub segment-ranges (iBoot); __TEXT is compared as a check.
+ */
+static bool test_restart_fwdata;
+static const struct firmware *dcp_test_fw;
+static int dcp_test_fwdata_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_bool(val, kp);
+
+	if (ret || !test_restart_fwdata || dcp_test_fw)
+		return ret;
+	ret = firmware_request_nowarn(&dcp_test_fw, "apple/dcp-fw.macho", NULL);
+	pr_info("appledrm: TEST fwdata: firmware apple/dcp-fw.macho: %d (%zu bytes)\n", ret,
+		ret ? 0 : dcp_test_fw->size);
+	if (ret) {
+		dcp_test_fw = NULL;
+		test_restart_fwdata = false;
+	}
+	return ret;
+}
+static const struct kernel_param_ops dcp_test_fwdata_ops = {
+	.set = dcp_test_fwdata_set,
+	.get = param_get_bool,
+};
+module_param_cb(test_restart_fwdata, &dcp_test_fwdata_ops, &test_restart_fwdata, 0644);
+static unsigned long test_restart_text_phys = 0x10000230000UL;
+module_param(test_restart_text_phys, ulong, 0644);
+static unsigned long test_restart_data_phys = 0x107d2c94000UL;
+module_param(test_restart_data_phys, ulong, 0644);
+/*
+ * R61M4: appledrm.test_restart_snap=1 (kernel command line): the target DCP's __DATA is copied at probe,
+ * before Linux talks to the firmware (the state iBoot hands over), and that copy is what the restart puts back.
+ */
+static bool test_restart_snap;
+module_param(test_restart_snap, bool, 0444);
+static unsigned int test_restart_data_len = 0x300000;
+module_param(test_restart_data_len, uint, 0444);
+static void *dcp_test_snap;
+
+void dcp_test_snapshot(struct platform_device *pdev)
+{
+	struct resource *r = platform_get_resource_byname(pdev, IORESOURCE_MEM, "coproc");
+	void *m;
+
+	if (!test_restart_snap || dcp_test_snap || !r || r->start != test_restart_coproc)
+		return;
+	m = memremap(test_restart_data_phys, test_restart_data_len, MEMREMAP_WC);
+	if (!m) {
+		dev_info(&pdev->dev, "TEST snap: memremap %#lx failed\n", test_restart_data_phys);
+		return;
+	}
+	dcp_test_snap = vmalloc(test_restart_data_len);
+	if (dcp_test_snap)
+		memcpy(dcp_test_snap, m, test_restart_data_len);
+	memunmap(m);
+	dev_info(&pdev->dev, "TEST snap: __DATA %#lx+%#x %s at probe\n", test_restart_data_phys,
+		 test_restart_data_len, dcp_test_snap ? "copied" : "not copied (no memory)");
+}
+
+/* R61M3: the RTKit header at __TEXT+0x1228 points into __DATA (va, len): iBoot's block, kept live */
+static unsigned int test_restart_keep_va = 0x7410c8;
+module_param(test_restart_keep_va, uint, 0644);
+static unsigned int test_restart_keep_len = 0x51c;
+module_param(test_restart_keep_len, uint, 0644);
+
+/* Mach-O LC_SEGMENT_64 lookup: file offset and size of a named segment. */
+static int dcp_test_macho_seg(const u8 *b, size_t len, const char *name, u64 *vmaddr, u64 *fo, u64 *fs)
+{
+	u32 ncmds, i, off = 32;
+
+	if (len < 32 || get_unaligned_le32(b) != 0xfeedfacf)
+		return -EINVAL;
+	ncmds = get_unaligned_le32(b + 16);
+	for (i = 0; i < ncmds && off + 72 <= len; i++) {
+		u32 cmd = get_unaligned_le32(b + off), sz = get_unaligned_le32(b + off + 4);
+
+		if (cmd == 0x19 && !strncmp((const char *)b + off + 8, name, 16)) {
+			*vmaddr = get_unaligned_le64(b + off + 24);
+			*fo = get_unaligned_le64(b + off + 40);
+			*fs = get_unaligned_le64(b + off + 48);
+			return (*fo + *fs <= len) ? 0 : -EINVAL;
+		}
+		if (!sz)
+			break;
+		off += sz;
+	}
+	return -ENOENT;
+}
+
+static void dcp_test_restore_fwdata(struct apple_dcp *dcp)
+{
+	u64 va, fo, fs, tva, tfo, tfs;
+	size_t i, ndiff = 0, tdiff = 0;
+	void *m;
+
+	if (!dcp_test_fw) {
+		dev_info(dcp->dev, "TEST restart: fwdata: no firmware loaded\n");
+		return;
+	}
+	if (dcp_test_macho_seg(dcp_test_fw->data, dcp_test_fw->size, "__TEXT", &tva, &tfo, &tfs) ||
+	    dcp_test_macho_seg(dcp_test_fw->data, dcp_test_fw->size, "__DATA", &va, &fo, &fs)) {
+		dev_info(dcp->dev, "TEST restart: fwdata: Mach-O segments not found\n");
+		return;
+	}
+	m = memremap(test_restart_text_phys, tfs, MEMREMAP_WC);
+	if (m) {
+		for (i = 0; i < tfs; i += 4) {
+			u32 l = *(u32 *)(m + i), f = get_unaligned_le32(dcp_test_fw->data + tfo + i);
+
+			if (l != f && tdiff++ < 8)
+				dev_info(dcp->dev, "TEST restart: fwdata: __TEXT +%#zx live %#x file %#x\n", i, l, f);
+		}
+		memunmap(m);
+	}
+	dev_info(dcp->dev, "TEST restart: fwdata: __TEXT %#llx+%#llx at %#lx: %zu words differ%s\n",
+		 tva, tfs, test_restart_text_phys, tdiff, m ? "" : " (memremap failed)");
+	if (!m || tdiff > 16) {
+		dev_info(dcp->dev, "TEST restart: fwdata: __TEXT mismatch, __DATA not touched\n");
+		return;
+	}
+	m = memremap(test_restart_data_phys, fs, MEMREMAP_WC);
+	if (!m) {
+		dev_info(dcp->dev, "TEST restart: fwdata: __DATA memremap failed\n");
+		return;
+	}
+	if (dcp_test_snap && fs == test_restart_data_len) {
+		size_t fdiff = 0;
+
+		for (i = 0; i < fs; i += 4) {
+			u32 l = *(u32 *)(m + i), sn = *(u32 *)(dcp_test_snap + i);
+
+			if (l != sn)
+				ndiff++;
+			if (sn != get_unaligned_le32(dcp_test_fw->data + fo + i))
+				fdiff++;
+		}
+		memcpy(m, dcp_test_snap, fs);
+		wmb();
+		for (i = 0, tdiff = 0; i < fs; i += 4)
+			if (*(u32 *)(m + i) != *(u32 *)(dcp_test_snap + i))
+				tdiff++;
+		memunmap(m);
+		dev_info(dcp->dev, "TEST restart: snap: __DATA: %zu words differed from the probe-time copy, restored (%zu still differ); the copy differs from the file in %zu words\n",
+			 ndiff, tdiff, fdiff);
+		return;
+	}
+	{
+		u64 ks = test_restart_keep_va >= va ? test_restart_keep_va - va : fs, ke = ks + test_restart_keep_len;
+		size_t kdiff = 0;
+
+		if (ke > fs)
+			ks = ke = fs;
+		for (i = 0; i < fs; i += 4) {
+			u32 l = *(u32 *)(m + i), f = get_unaligned_le32(dcp_test_fw->data + fo + i);
+
+			if (l == f)
+				continue;
+			if (i >= ks && i < ke) {
+				if (kdiff++ < 16)
+					dev_info(dcp->dev, "TEST restart: fwdata: kept block +%#llx live %#x file %#x\n",
+						 i - ks, l, f);
+			} else {
+				ndiff++;
+			}
+		}
+		memcpy(m, dcp_test_fw->data + fo, ks);
+		memcpy(m + ke, dcp_test_fw->data + fo + ke, fs - ke);
+		wmb();
+		for (i = 0, tdiff = 0; i < fs; i += 4)
+			if ((i < ks || i >= ke) && *(u32 *)(m + i) != get_unaligned_le32(dcp_test_fw->data + fo + i))
+				tdiff++;
+		memunmap(m);
+		dev_info(dcp->dev, "TEST restart: fwdata: __DATA %#llx+%#llx at %#lx: %zu words differed, restored (%zu still differ); block va %#x+%#x kept (%zu words differ from the file)\n",
+			 va, fs, test_restart_data_phys, ndiff, tdiff, test_restart_keep_va, test_restart_keep_len, kdiff);
+	}
+}
+
+static struct apple_dcp *dcp_test_restart_dcp;
+static u64 dcp_test_iorvbar_saved;
+static void dcp_test_restart_fn(struct work_struct *w);
+static DECLARE_DELAYED_WORK(dcp_test_restart_work, dcp_test_restart_fn);
+
+static bool dcp_test_is_restart_target(struct apple_dcp *dcp)
+{
+	struct resource *r = platform_get_resource_byname(to_platform_device(dcp->dev),
+							  IORESOURCE_MEM, "coproc");
+
+	return test_wake_restart && r && r->start == test_restart_coproc;
+}
+
+static void dcp_test_restart_fn(struct work_struct *w)
+{
+	struct apple_dcp *dcp = dcp_test_restart_dcp;
+	void __iomem *rv;
+	u64 now = 0;
+	u32 ctl;
+	int ret, n;
+
+	if (!dcp)
+		return;
+	rv = ioremap(test_restart_iorvbar, 8);
+	if (rv) {
+		now = readq(rv);
+		if (now != dcp_test_iorvbar_saved && dcp_test_iorvbar_saved) {
+			writeq(dcp_test_iorvbar_saved, rv);
+			dev_info(dcp->dev, "TEST restart: iorvbar was %#llx, restored %#llx (reads %#llx)\n",
+				 now, dcp_test_iorvbar_saved, readq(rv));
+		} else {
+			dev_info(dcp->dev, "TEST restart: iorvbar kept %#llx\n", now);
+		}
+		iounmap(rv);
+	}
+	if (test_restart_fwdata)
+		dcp_test_restore_fwdata(dcp);
+	ctl = readl(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL);
+	writel(ctl | APPLE_DCP_COPROC_CPU_CONTROL_RUN, dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL);
+	dev_info(dcp->dev, "TEST restart: CPU_CONTROL %#x -> RUN\n", ctl);
+	ret = test_restart_keep ? apple_rtkit_reinit_keep(dcp->rtk) : apple_rtkit_reinit(dcp->rtk);
+	dev_info(dcp->dev, "TEST restart: rtkit reinit%s %d\n", test_restart_keep ? "_keep" : "", ret);
+	if (ret)
+		return;
+	ret = apple_rtkit_wake(dcp->rtk);
+	for (n = 0; ret == -ETIME && n < 3; n++)
+		ret = apple_rtkit_boot(dcp->rtk);
+	dev_info(dcp->dev, "TEST restart: rtkit wake %d (boot retries %d)\n", ret, n);
+	if (ret)
+		return;
+	if (test_restart_step & 1) {
+		ret = iomfb_test_restart_iomfb(dcp);
+		dev_info(dcp->dev, "TEST restart: IOMFB endpoint restarted with the old shmem %#llx: %d\n",
+			 (u64)dcp_test_shmem_iova_get(), ret);
+		return;
+	}
+	if (test_restart_nostart) {
+		dev_info(dcp->dev, "TEST restart: dcp_start skipped\n");
+		return;
+	}
+	WRITE_ONCE(dcp->crashed, false);
+	WRITE_ONCE(dcp->ext_dead, false);
+	if (test_restart_iboot) {
+		ibootep_test_internal = true;
+		ret = dcp->ibootep ? 0 : ibootep_init(dcp);
+		dev_info(dcp->dev, "TEST restart: iBoot endpoint start %d\n", ret);
+		if (!ret)
+			ret = ibootep_test_bringup(dcp);
+		dev_info(dcp->dev, "TEST restart: iBoot bring-up %d\n", ret);
+	}
+	ret = dcp_start(to_platform_device(dcp->dev));
+	dev_info(dcp->dev, "TEST restart: dcp_start %d\n", ret);
+}
+
+static bool dcp_test_sleep_off(struct apple_dcp *dcp)
+{
+	bool target;
+	int ret;
+
+	if (!READ_ONCE(test_sleep_off) || pm_suspend_target_state != PM_SUSPEND_MEM ||
+	    IS_ERR_OR_NULL(dcp->rtk) || READ_ONCE(dcp->crashed))
+		return false;
+	target = dcp_test_is_restart_target(dcp);
+	if (target) {
+		void __iomem *rv = ioremap(test_restart_iorvbar, 8);
+
+		if (rv) {
+			dcp_test_iorvbar_saved = readq(rv);
+			iounmap(rv);
+		}
+	}
+	ret = apple_rtkit_shutdown(dcp->rtk);
+	if (ret) {
+		dev_warn(dcp->dev, "TEST: firmware shutdown for deep suspend failed: %d\n", ret);
+		return false;
+	}
+	if (!IS_ERR_OR_NULL(dcp->coproc_reg))
+		writel(0, dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL);
+	WRITE_ONCE(dcp->crashed, true);
+	WRITE_ONCE(dcp->ext_dead, true);
+	if (target) {
+		dcp_test_restart_dcp = dcp;
+		dev_info(dcp->dev, "TEST: firmware shut down for deep suspend, restart after the wake (iorvbar %#llx)\n",
+			 dcp_test_iorvbar_saved);
+	} else {
+		dev_info(dcp->dev, "TEST: firmware shut down for deep suspend, down until reboot\n");
+	}
+	return true;
+}
+
 static int dcp_platform_suspend(struct device *dev)
 {
 	struct apple_dcp *dcp = dev_get_drvdata(dev);
@@ -5051,6 +5384,8 @@ static int dcp_platform_suspend(struct device *dev)
 	 * domains to stay on. We need this as we do not support full
 	 * shutdown properly yet.
 	 */
+	if (dcp_test_sleep_off(dcp))
+		return 0;
 	device_set_wakeup_path(dev);
 	/* Last: the steps above still talk to the coprocessor. */
 	dcp_hold_for_sleep(dcp);
@@ -5062,6 +5397,11 @@ static int dcp_platform_resume(struct device *dev)
 {
 	struct apple_dcp *dcp = dev_get_drvdata(dev);
 
+	if (dcp == dcp_test_restart_dcp && READ_ONCE(dcp->ext_dead)) {
+		dev_info(dev, "TEST restart: queued in %u ms\n", test_restart_delay_ms);
+		schedule_delayed_work(&dcp_test_restart_work, msecs_to_jiffies(test_restart_delay_ms));
+		return 0;
+	}
 	if (READ_ONCE(dcp->ext_dead))
 		return 0;
 
diff --git i/drivers/gpu/drm/apple/ibootep.c w/drivers/gpu/drm/apple/ibootep.c
