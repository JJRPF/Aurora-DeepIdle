diff --git i/drivers/nvme/host/apple.c w/drivers/nvme/host/apple.c
index 6d342ee36a9f..3c21d8462059 100644
--- i/drivers/nvme/host/apple.c
+++ w/drivers/nvme/host/apple.c
@@ -37,6 +37,7 @@
 #include <linux/pm_domain.h>
 #include <linux/soc/apple/rtkit.h>
 #include <linux/soc/apple/sart.h>
+#include <linux/suspend.h>
 #include <linux/reset.h>
 #include <linux/time64.h>
 
@@ -202,11 +203,21 @@ struct apple_nvme_hw {
 	unsigned long quirks;
 };
 
+static bool s2r_ans_idle = true; /* GH-5: S2R suspend idles the ANS instead of shutting it down */
+
 struct apple_nvme {
 	struct device *dev;
 	/* TEST (GH-8): the ANS wrapper's IO RVBAR, saved at suspend, restored before RUN if it changed */
 	void __iomem *iorvbar;
 	u64 iorvbar_saved;
+	bool s2r_force_cold; /* GH-5: next reset after a system resume starts the ANS cold */
+	bool s2r_cold; /* GH-5: this reset is that cold start */
+	bool s2r_idle_kept; /* GH-5: idled (0x201) for S2R with its RTKit buffers kept, as Andreas Fernandez does */
+	u32 sart_power_boot; /* GH-5: ANS +0x13e8 after the first good boot (Andreas Fernandez's t6000 ANS restore) */
+	/* GH-5: the ADT ANS AXI2AF / storage-lane tunables Aura publishes in /chosen/aurora,ans-tunables */
+	int s2r_tun_n;
+	void __iomem *s2r_tun_reg[64];
+	u32 s2r_tun_mask[64], s2r_tun_val[64];
 	struct kref ref;
 	/* Serializes the post-M4 controller disable with reset and teardown. */
 	struct mutex disable_lock;
@@ -1563,6 +1574,57 @@ static void apple_nvme_wait_freeze(struct apple_nvme *anv)
 	}
 }
 
+#define APPLE_ANS_SART_POWER	0x13e8
+
+/* GH-5: map the tunables Aura took from the ADT (Andreas Fernandez applies the t6000 ones after an S2R cut) */
+static void apple_nvme_s2r_tunables_init(struct apple_nvme *anv)
+{
+	struct device_node *ch = of_find_node_by_path("/chosen");
+	const __be32 *p;
+	int len, i;
+
+	p = ch ? of_get_property(ch, "aurora,ans-tunables", &len) : NULL;
+	of_node_put(ch);
+	if (!p)
+		return;
+	for (i = 0; i < len / 16 && anv->s2r_tun_n < ARRAY_SIZE(anv->s2r_tun_reg); i++, p += 4) {
+		u64 a = ((u64)be32_to_cpu(p[0]) << 32) | be32_to_cpu(p[1]);
+		void __iomem *r = ioremap_np(a, 4); /* Apple device registers need nGnRnE; not unmapped (test) */
+
+		if (!r)
+			continue;
+		anv->s2r_tun_reg[anv->s2r_tun_n] = r;
+		anv->s2r_tun_mask[anv->s2r_tun_n] = be32_to_cpu(p[2]);
+		anv->s2r_tun_val[anv->s2r_tun_n] = be32_to_cpu(p[3]);
+		anv->s2r_tun_n++;
+	}
+	dev_info(anv->dev, "TEST s2r: %d ANS tunable writes from the ADT\n", anv->s2r_tun_n);
+}
+
+static bool s2r_ans_tunables = true;
+module_param_named(s2r_ans_idle, s2r_ans_idle, bool, 0644);
+module_param(s2r_ans_tunables, bool, 0644);
+
+static void apple_nvme_s2r_tunables(struct apple_nvme *anv)
+{
+	int i, changed = 0;
+
+	if (!s2r_ans_tunables)
+		return;
+
+	for (i = 0; i < anv->s2r_tun_n; i++) {
+		u32 v = readl(anv->s2r_tun_reg[i]);
+		u32 w = (v & ~anv->s2r_tun_mask[i]) | (anv->s2r_tun_val[i] & anv->s2r_tun_mask[i]);
+
+		if (w != v) {
+			writel(w, anv->s2r_tun_reg[i]);
+			changed++;
+		}
+	}
+	dev_info(anv->dev, "TEST s2r: ANS tunables %d of %d rewritten\n", changed, anv->s2r_tun_n);
+}
+
+
 static void apple_nvme_reset_work(struct work_struct *work)
 {
 	unsigned int nr_io_queues = 1;
@@ -1655,6 +1717,18 @@ static void apple_nvme_reset_work(struct work_struct *work)
 		writel(0, anv->mmio_coproc + APPLE_ANS_COPROC_CPU_CONTROL);
 	}
 
+	/*
+	 * GH-5: after S2R the SoC lost power, so whatever CPU_CONTROL reads now, the ANS is not running the
+	 * session we shut down in suspend. Start it cold: reset, RTKit reinit, IORVBAR restore, RUN, boot.
+	 */
+	if (anv->s2r_force_cold && !anv->hw->needs_ioq_registers) {
+		dev_info(anv->dev, "TEST s2r: cpu_control %#x at resume, forcing a cold start\n",
+			 readl(anv->mmio_coproc + APPLE_ANS_COPROC_CPU_CONTROL));
+		writel(0, anv->mmio_coproc + APPLE_ANS_COPROC_CPU_CONTROL);
+		anv->s2r_force_cold = false;
+		anv->s2r_cold = true;
+	}
+
 	/*
 	 * Only do the soft-reset if the CPU is not running, which means either we
 	 * or the previous stage shut it down cleanly.
@@ -1683,7 +1757,13 @@ static void apple_nvme_reset_work(struct work_struct *work)
 		if (ret)
 			goto out;
 
-		ret = apple_rtkit_reinit(anv->rtk);
+		if (anv->s2r_idle_kept) {
+			anv->s2r_idle_kept = false;
+			ret = apple_rtkit_reinit_keep(anv->rtk);
+			dev_info(anv->dev, "TEST s2r: RTKit reinit with buffers kept: %d\n", ret);
+		} else {
+			ret = apple_rtkit_reinit(anv->rtk);
+		}
 		if (ret)
 			goto out;
 
@@ -1692,10 +1772,22 @@ static void apple_nvme_reset_work(struct work_struct *work)
 			goto out;
 
 		apple_nvme_iorvbar_restore(anv);
+		if (anv->s2r_cold) {
+			/* GH-5: the power cut reset what the first good boot had (Andreas Fernandez's t6000 restore) */
+			u32 sp = readl(anv->mmio_nvme + APPLE_ANS_SART_POWER);
+
+			if (anv->sart_power_boot && sp != anv->sart_power_boot)
+				writel(anv->sart_power_boot, anv->mmio_nvme + APPLE_ANS_SART_POWER);
+			dev_info(anv->dev, "TEST s2r: sart power %#x, boot value %#x\n", sp, anv->sart_power_boot);
+			apple_rtkit_set_iop_ack_wait(anv->rtk, 25);
+			apple_nvme_s2r_tunables(anv);
+		}
 		writel(APPLE_ANS_COPROC_CPU_CONTROL_RUN,
 		       anv->mmio_coproc + APPLE_ANS_COPROC_CPU_CONTROL);
 
 		ret = apple_rtkit_boot(anv->rtk);
+		apple_rtkit_set_iop_ack_wait(anv->rtk, 0);
+		anv->s2r_cold = false;
 	} else {
 		ret = apple_rtkit_wake(anv->rtk);
 	}
@@ -1915,6 +2007,10 @@ static void apple_nvme_reset_work(struct work_struct *work)
 	nvme_start_ctrl(&anv->ctrl);
 
 	dev_dbg(anv->dev, "ANS boot and NVMe init completed.");
+	if (!anv->sart_power_boot && !anv->hw->needs_ioq_registers) {
+		anv->sart_power_boot = readl(anv->mmio_nvme + APPLE_ANS_SART_POWER);
+		dev_info(anv->dev, "TEST s2r: saved sart power %#x\n", anv->sart_power_boot);
+	}
 	return;
 
 out_remove_sq:
@@ -2347,6 +2443,7 @@ static struct apple_nvme *apple_nvme_alloc(struct platform_device *pdev)
 	}
 
 	INIT_WORK(&anv->ctrl.reset_work, apple_nvme_reset_work);
+	apple_nvme_s2r_tunables_init(anv);
 	if (iorvbar_phys) {
 		anv->iorvbar = devm_ioremap(dev, iorvbar_phys, 8);
 		if (anv->iorvbar)
@@ -2581,6 +2678,7 @@ static int apple_nvme_resume(struct device *dev)
 		WRITE_ONCE(anv->suspended, false);
 		return nvme_try_sched_reset(&anv->ctrl);
 	}
+	anv->s2r_force_cold = true;
 	return nvme_reset_ctrl(&anv->ctrl);
 }
 
@@ -2632,7 +2730,17 @@ static int apple_nvme_suspend(struct device *dev)
 	}
 
 	if (apple_rtkit_is_running(anv->rtk)) {
-		ret = apple_rtkit_shutdown(anv->rtk);
+		if (s2r_ans_idle && pm_suspend_target_state == PM_SUSPEND_MEM) {
+			/* GH-5: idle, state and buffers kept, so the ANS resumes from its saved context after the cut */
+			ret = apple_rtkit_idle(anv->rtk);
+			if (!ret) {
+				apple_rtkit_detach_keep(anv->rtk);
+				anv->s2r_idle_kept = true;
+			}
+			dev_info(anv->dev, "TEST s2r: ANS idled for S2R: %d\n", ret);
+		} else {
+			ret = apple_rtkit_shutdown(anv->rtk);
+		}
 
 		writel(0, anv->mmio_coproc + APPLE_ANS_COPROC_CPU_CONTROL);
 	}
