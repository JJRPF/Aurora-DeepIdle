@@ -35,6 +35,8 @@ struct apple_rtkit_crashlog_header {
 static_assert(sizeof(struct apple_rtkit_crashlog_header) == 0x20);
 
 struct apple_rtkit {
+	/* GH-5: extra seconds to wait for the IOP power ack (a coprocessor booting after an S2R power cut) */
+	unsigned int iop_ack_extra_s;
 	void *cookie;
 	const struct apple_rtkit_ops *ops;
