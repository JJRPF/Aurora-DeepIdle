diff --git i/drivers/power/reset/macsmc-reboot.c w/drivers/power/reset/macsmc-reboot.c
index fe9eac92b17b..8cae25a0b734 100644
--- i/drivers/power/reset/macsmc-reboot.c
+++ w/drivers/power/reset/macsmc-reboot.c
@@ -467,6 +467,15 @@ static void macsmc_reboot_ps_dump(struct device *dev, const char *when)
 	kfree(buf);
 }
 
+/* GH-5 R59X: the Wi-Fi REG_ON/PWREN line (SMC gpio 13, key gP0d) as the SMC reports it; -1 on error */
+static int macsmc_reboot_wlan_reg_on(struct macsmc_reboot *reboot)
+{
+	u32 val = 0;
+	int ret = apple_smc_rw_u32(reboot->smc, SMC_KEY(gP0d), 1 << 24, &val);
+
+	return ret < 0 ? -1 : !!val;
+}
+
 static int macsmc_reboot_pm_prepare(struct device *dev)
 {
 	struct macsmc_reboot *reboot = dev_get_drvdata(dev);
@@ -520,9 +529,14 @@ static int macsmc_reboot_pm_suspend_late(struct device *dev)
 		dev_info(dev, "sleep: PMP requests released before slpa (%d)\n", ret);
 	}
 	if (reboot->sleep_steps & MACSMC_SLEEP_SLPA) {
+		int reg_on_before = macsmc_reboot_wlan_reg_on(reboot);
+
 		ret = apple_smc_write_u32(reboot->smc, SMC_KEY(MBSE), SMC_KEY(slpa));
 		reboot->slpa_sent = ret >= 0;
 		dev_info(dev, "sleep: MBSE = slpa (%d)\n", ret);
+		dev_info(dev, "TEST s2r: gP0d before %d, after slpa %d\n", reg_on_before, macsmc_reboot_wlan_reg_on(reboot));
+		msleep(100);
+		dev_info(dev, "TEST s2r: gP0d 100ms after slpa %d\n", macsmc_reboot_wlan_reg_on(reboot));
 	}
 	return 0;
 }
@@ -549,11 +563,13 @@ static int macsmc_reboot_pm_resume_early(struct device *dev)
 	if (!reboot->slpa_sent)
 		return 0;
 	reboot->slpa_sent = false;
+	dev_info(dev, "TEST s2r: gP0d at the wake before waka %d\n", macsmc_reboot_wlan_reg_on(reboot));
 	r1 = apple_smc_read_u32(reboot->smc, SMC_KEY(MBSE), &mbse);
 	r2 = apple_smc_read(reboot->smc, SMC_KEY(MBSW), mbsw, sizeof(mbsw));
 	ret = apple_smc_write_u32(reboot->smc, SMC_KEY(MBSE), SMC_KEY(waka));
 	dev_info(dev, "sleep: wake MBSE %08x (%d), MBSW %8phN (%d); MBSE = waka (%d)\n",
 		 mbse, r1, mbsw, r2, ret);
+	dev_info(dev, "TEST s2r: gP0d after waka %d\n", macsmc_reboot_wlan_reg_on(reboot));
 	return 0;
 }
 
