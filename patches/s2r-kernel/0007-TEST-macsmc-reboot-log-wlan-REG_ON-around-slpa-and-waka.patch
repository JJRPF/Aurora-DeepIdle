+/* GH-5 R60D TEST: every readable SMC key with its type and value, for a before/after-sleep comparison */
+static int macsmc_reboot_keys_show(struct seq_file *m, void *unused)
+{
+	struct apple_smc *smc = m->private;
+	u8 buf[32];
+	int i;
+
+	for (i = 0; i < smc->key_count; i++) {
+		struct apple_smc_key_info info;
+		smc_key key;
+		int ret;
+
+		if (apple_smc_get_key_by_index(smc, i, &key) < 0)
+			continue;
+		if (apple_smc_get_key_info(smc, key, &info) < 0) {
+			seq_printf(m, "%p4ch ? info error\n", &key);
+			continue;
+		}
+		if (!(info.flags & 0x80) || info.size == 0 || info.size > sizeof(buf)) {
+			seq_printf(m, "%p4ch %p4ch f%02x s%u -\n", &key, &info.type_code, info.flags, info.size);
+			continue;
+		}
+		ret = apple_smc_read(smc, key, buf, info.size);
+		if (ret < 0)
+			seq_printf(m, "%p4ch %p4ch f%02x s%u err %d\n", &key, &info.type_code, info.flags, info.size, ret);
+		else
+			seq_printf(m, "%p4ch %p4ch f%02x s%u %*phN\n", &key, &info.type_code, info.flags, info.size,
+				   info.size, buf);
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(macsmc_reboot_keys);
+
 static int macsmc_reboot_probe(struct platform_device *pdev)
 {
 	struct apple_smc *smc = dev_get_drvdata(pdev->dev.parent);
@@ -405,6 +441,7 @@ static int macsmc_reboot_probe(struct platform_device *pdev)
 	ret = register_pm_notifier(&reboot->pm_notify);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "Failed to register PM notifier\n");
+	debugfs_create_file("macsmc_keys", 0400, NULL, smc, &macsmc_reboot_keys_fops);	/* GH-5 TEST */
 	ret = devm_add_action_or_reset(&pdev->dev, macsmc_reboot_pm_unregister, reboot);
 	if (ret)
 		return ret;
@@ -467,6 +504,76 @@ static void macsmc_reboot_ps_dump(struct device *dev, const char *when)
 	kfree(buf);
 }
 
+static bool s2r_wake_bnap;
+module_param(s2r_wake_bnap, bool, 0644);
+MODULE_PARM_DESC(s2r_wake_bnap, "GH-5 TEST: send MBSE = bnap after waka");
+
+/*
+ * GH-5 R60G: macOS's PMGR writes pmVC (function-toggle_vdd_cio: 0x100, or 0x300 on T6022, | a mask of
+ * CIO requesters) and Aurora's T6050 sleep, from a trace of macOS, sends it 35 ms before slpa and 58 ms
+ * after waka. We never wrote it: on the J414s it reads 0 and MEPS stays in its sleep state after waka.
+ * 0 = off; otherwise the value written at both points.
+ */
+static unsigned int s2r_pmvc;
+module_param(s2r_pmvc, uint, 0644);
+MODULE_PARM_DESC(s2r_pmvc, "GH-5 TEST: pmVC value sent 35 ms before slpa and 58 ms after waka (0 = off)");
+
+static void macsmc_reboot_log_pmvc(struct device *dev, struct macsmc_reboot *reboot, const char *when)
+{
+	u8 meps[6] = {};
+	u32 pmvc = 0, mbse = 0;
+	int r1 = apple_smc_read_u32(reboot->smc, SMC_KEY(pmVC), &pmvc);
+	int r2 = apple_smc_read(reboot->smc, SMC_KEY(MEPS), meps, sizeof(meps));
+
+	apple_smc_read_u32(reboot->smc, SMC_KEY(MBSE), &mbse);
+	dev_info(dev, "TEST s2r: %s: pmVC %08x (%d) MEPS %6phN (%d) MBSE %08x\n", when, pmvc, r1, meps, r2, mbse);
+}
+
+/*
+ * GH-5 R60H: Andreas Fernandez's t600x S2R (Wi-Fi returns there) drives the SMC GPIO of the SD reader's power
+ * (gP1a on J314s) to 0, macOS's off command, just before slpa, and back on (CMD_OUTPUT | 1) right after the AP is
+ * powered at the wake, before MBSE/MBSW and waka. On the J414s the ADT pcie-sdreader function-sd_pwr_en is gP16.
+ * Bit mask of SMC GPIO numbers (bit 0x16 = gP16); 0 = off.
+ */
+static unsigned long s2r_gpio_off;
+module_param(s2r_gpio_off, ulong, 0644);
+MODULE_PARM_DESC(s2r_gpio_off, "GH-5 TEST: SMC GPIO pins (bit n = gPnn) written 0 before slpa and on again at the wake");
+static unsigned long s2r_gpio_lowered;
+
+static void macsmc_reboot_s2r_gpio(struct device *dev, struct macsmc_reboot *reboot, bool off)
+{
+	unsigned long pins = off ? READ_ONCE(s2r_gpio_off) : s2r_gpio_lowered;
+	unsigned int i;
+
+	for_each_set_bit(i, &pins, 32) {
+		smc_key key = __SMC_KEY('g', 'P', hex_asc_hi(i), hex_asc_lo(i));
+		u32 before = 0, after = 0;
+		int r0 = apple_smc_rw_u32(reboot->smc, key, 1 << 24, &before);
+		int ret = apple_smc_write_u32(reboot->smc, key, off ? 0 : (1 << 24) | 1);
+		int r1 = apple_smc_rw_u32(reboot->smc, key, 1 << 24, &after);
+
+		if (off && ret >= 0)
+			__set_bit(i, &s2r_gpio_lowered);
+		dev_info(dev, "TEST s2r: SMC gP%02x %s (%d): read %#x (%d) -> %#x (%d)\n", i, off ? "= 0 before slpa" :
+			 "on again at the wake", ret, before, r0, after, r1);
+	}
+	if (!off)
+		s2r_gpio_lowered = 0;
+}
+
+static bool s2r_regon_cycle;
+module_param(s2r_regon_cycle, bool, 0644);
+MODULE_PARM_DESC(s2r_regon_cycle, "GH-5 TEST: cycle the radio REG_ON with macOS's gP0d command after the wake");
+
+/* GH-5 R59X: the Wi-Fi REG_ON/PWREN line (SMC gpio 13, key gP0d) as the SMC reports it; -1 on error */
+static int macsmc_reboot_wlan_reg_on(struct macsmc_reboot *reboot)
+{
+	u32 val = 0;
+	int ret = apple_smc_rw_u32(reboot->smc, SMC_KEY(gP0d), 1 << 24, &val);
+
+	return ret < 0 ? -1 : !!val;
+}
+
 static int macsmc_reboot_pm_prepare(struct device *dev)
 {
 	struct macsmc_reboot *reboot = dev_get_drvdata(dev);
@@ -520,9 +627,23 @@ static int macsmc_reboot_pm_suspend_late(struct device *dev)
 		dev_info(dev, "sleep: PMP requests released before slpa (%d)\n", ret);
 	}
 	if (reboot->sleep_steps & MACSMC_SLEEP_SLPA) {
+		int reg_on_before = macsmc_reboot_wlan_reg_on(reboot);
+		unsigned int pmvc = READ_ONCE(s2r_pmvc);
+
+		if (pmvc) {
+			macsmc_reboot_log_pmvc(dev, reboot, "before pmVC");
+			ret = apple_smc_write_u32(reboot->smc, SMC_KEY(pmVC), pmvc);
+			dev_info(dev, "TEST s2r: pmVC = %#x before slpa (%d)\n", pmvc, ret);
+			msleep(35);
+			macsmc_reboot_log_pmvc(dev, reboot, "35 ms after pmVC");
+		}
+		macsmc_reboot_s2r_gpio(dev, reboot, true);
 		ret = apple_smc_write_u32(reboot->smc, SMC_KEY(MBSE), SMC_KEY(slpa));
 		reboot->slpa_sent = ret >= 0;
 		dev_info(dev, "sleep: MBSE = slpa (%d)\n", ret);
+		dev_info(dev, "TEST s2r: gP0d before %d, after slpa %d\n", reg_on_before, macsmc_reboot_wlan_reg_on(reboot));
+		msleep(100);
+		dev_info(dev, "TEST s2r: gP0d 100ms after slpa %d\n", macsmc_reboot_wlan_reg_on(reboot));
 	}
 	return 0;
 }
@@ -549,11 +670,53 @@ static int macsmc_reboot_pm_resume_early(struct device *dev)
 	if (!reboot->slpa_sent)
 		return 0;
 	reboot->slpa_sent = false;
+	macsmc_reboot_s2r_gpio(dev, reboot, false);
+	dev_info(dev, "TEST s2r: gP0d at the wake before waka %d\n", macsmc_reboot_wlan_reg_on(reboot));
 	r1 = apple_smc_read_u32(reboot->smc, SMC_KEY(MBSE), &mbse);
 	r2 = apple_smc_read(reboot->smc, SMC_KEY(MBSW), mbsw, sizeof(mbsw));
 	ret = apple_smc_write_u32(reboot->smc, SMC_KEY(MBSE), SMC_KEY(waka));
 	dev_info(dev, "sleep: wake MBSE %08x (%d), MBSW %8phN (%d); MBSE = waka (%d)\n",
 		 mbse, r1, mbsw, r2, ret);
+	dev_info(dev, "TEST s2r: gP0d after waka %d\n", macsmc_reboot_wlan_reg_on(reboot));
+	if (READ_ONCE(s2r_pmvc)) {
+		unsigned int pmvc = READ_ONCE(s2r_pmvc);
+
+		macsmc_reboot_log_pmvc(dev, reboot, "at waka");
+		msleep(58);
+		ret = apple_smc_write_u32(reboot->smc, SMC_KEY(pmVC), pmvc);
+		dev_info(dev, "TEST s2r: pmVC = %#x 58 ms after waka (%d)\n", pmvc, ret);
+		macsmc_reboot_log_pmvc(dev, reboot, "right after pmVC");
+		msleep(500);
+		macsmc_reboot_log_pmvc(dev, reboot, "500 ms after pmVC");
+	}
+	if (READ_ONCE(s2r_wake_bnap)) {
+		/*
+		 * GH-5 R60F: the SMC stays in a sleep power state after waka (MEPS 04 -> 01). macOS sends
+		 * MBSE = 'bnap' from userspace during boot (hypervisor trace 2026-11-13); try it after waka.
+		 */
+		u8 meps[6] = {};
+		u32 m2 = 0;
+		int r3 = apple_smc_write_u32(reboot->smc, SMC_KEY(MBSE), SMC_KEY(bnap));
+
+		msleep(500);
+		apple_smc_read_u32(reboot->smc, SMC_KEY(MBSE), &m2);
+		apple_smc_read(reboot->smc, SMC_KEY(MEPS), meps, sizeof(meps));
+		dev_info(dev, "TEST s2r: MBSE = bnap (%d); 500 ms later MBSE %08x MEPS %6phN\n", r3, m2, meps);
+	}
+	if (READ_ONCE(s2r_regon_cycle)) {
+		/*
+		 * GH-5 R60C: macOS drives the radio's REG_ON with the ADT function-reg_on, pKW4 gP0d 0x00800000,
+		 * whose handler puts the on/off value in the low 16 bits: gP0d = 0x00800000 | v. Linux's gpio
+		 * driver writes CMD_OUTPUT | v (0x01000000 | v) instead. Cycle it the macOS way after the wake.
+		 */
+		int r0 = apple_smc_write_u32(reboot->smc, SMC_KEY(gP0d), 0x00800000);
+
+		msleep(100);
+		ret = apple_smc_write_u32(reboot->smc, SMC_KEY(gP0d), 0x00800001);
+		msleep(200);
+		dev_info(dev, "TEST s2r: REG_ON cycled the macOS way (%d, %d), gP0d now %d\n", r0, ret,
+			 macsmc_reboot_wlan_reg_on(reboot));
+	}
 	return 0;
 }
 
