diff --git a/drivers/mfd/macsmc.c b/drivers/mfd/macsmc.c
index 687788e3309c..b5ecfb7164e3 100644
--- a/drivers/mfd/macsmc.c
+++ b/drivers/mfd/macsmc.c
@@ -554,6 +554,10 @@ static bool pmp_sleep;
 module_param(pmp_sleep, bool, 0644);
 MODULE_PARM_DESC(pmp_sleep, "PMP SetAPPower/SetIOPPower IDLE after the SMC's SetAPPower IDLE in system suspend");
 static bool pmp_slept;
+/* GH-5: with pmp_sleep, stop the PMP and save its SRAM for a sleep with a power cut, and restart it on wake */
+static bool pmp_cycle;
+module_param(pmp_cycle, bool, 0644);
+MODULE_PARM_DESC(pmp_cycle, "With pmp_sleep: power-cycle the PMP (SRAM saved and restored) around a suspend to RAM with a power cut");
 int apple_pmp_report_test_pcpm_release(void);
 
 static int apple_smc_suspend_late(struct device *dev)
@@ -566,9 +570,9 @@ static int apple_smc_suspend_late(struct device *dev)
 	ret = apple_rtkit_set_ap_power(smc->rtk, 0x201);
 	dev_info(dev, "SetAPPower IDLE: %d\n", ret);
 	if (pmp_sleep && pm_suspend_target_state == PM_SUSPEND_MEM) {
-		ret = apple_pmp_sleep(true);
+		ret = pmp_cycle ? apple_pmp_power_cycle(true) : apple_pmp_sleep(true);
 		pmp_slept = !ret;
-		dev_info(dev, "sleep: PMP SetAPPower/SetIOPPower IDLE: %d\n", ret);
+		dev_info(dev, "sleep: PMP %s: %d\n", pmp_cycle ? "stopped, SRAM saved" : "SetAPPower/SetIOPPower IDLE", ret);
 		/* TEST: macOS's trace step 6, the CPU complexes' requests withdrawn last */
 		ret = apple_pmp_report_test_pcpm_release();
 		if (ret)
@@ -588,8 +592,8 @@ static int apple_smc_resume_early(struct device *dev)
 	dev_info(dev, "SetAPPower ON: %d\n", ret);
 	if (pmp_slept) {
 		pmp_slept = false;
-		ret = apple_pmp_sleep(false);
-		dev_info(dev, "sleep: PMP wake: %d\n", ret);
+		ret = pmp_cycle ? apple_pmp_power_cycle(false) : apple_pmp_sleep(false);
+		dev_info(dev, "sleep: PMP %s: %d\n", pmp_cycle ? "restarted" : "wake", ret);
 	}
 	return 0;
 }
diff --git a/drivers/nvme/host/apple.c b/drivers/nvme/host/apple.c
index 6d342ee36a9f..3c21d8462059 100644
--- a/drivers/nvme/host/apple.c
+++ b/drivers/nvme/host/apple.c
@@ -37,6 +37,7 @@
 #include <linux/pm_domain.h>
