+++ b/drivers/i2c/busses/i2c-pasemi-core.c
@@ -450,6 +450,17 @@ int pasemi_i2c_common_probe(struct pasemi_smbus *smbus)
 }
 EXPORT_SYMBOL_GPL(pasemi_i2c_common_probe);
 
+/*
+ * Set the controller up again after its registers were lost, e.g. after an
+ * S2R power cut on Apple SoCs (the PM core keeps the power domain "on", but
+ * the hardware was off and REG_CTL is back at its reset value).
+ */
+void pasemi_i2c_reinit(struct pasemi_smbus *smbus)
+{
+	pasemi_reset(smbus);
+}
+EXPORT_SYMBOL_GPL(pasemi_i2c_reinit);
+
 irqreturn_t pasemi_irq_handler(int irq, void *dev_id)
 {
 	struct pasemi_smbus *smbus = dev_id;
