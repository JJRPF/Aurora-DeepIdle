+/*
+ * SYSTEM_SUSPEND with the SoC kept on (S2R plan, Phase 2): the kernel has quiesced everything and masked
+ * interrupts. The boot CPU powers down in WFI without state retention (CYC_OVRD WFI_MODE 3 + DISABLE_WFI_RET,
+ * as a parked secondary does) and the AIC wakes it on a wake line; it then comes back through its RVBAR into
+ * _cpu_reset_c(), which calls psci_suspend_rvbar() below instead of m1n1_main(), and that resumes the kernel at
+ * its entry point, MMU and caches off, as a PSCI resume. If the core keeps its state after all, the WFI just
+ * returns and the same wake handling runs here.
+ */
+#define SUSPEND_MIN_MS 500 /* ignore wake lines for this long after entry */
+#define SUSPEND_WDT_S  115 /* image 43: 115, apart from the kernel apple_wdt 120 */ 
+#define SUSPEND_WDT_S_OLD 120 /* hardware reset if no wake line ever brings the CPU back */
+#define RESUME_MAGIC   0x5253554d45ULL /* "RSUME" */
+
+/* Debug words Linux reads back (found by scan-magic): see run.sh for the layout */
+volatile u64 psci_dbg[24] __attribute__((used));
+
+/* Wake lines (AIC2 event numbers): 724 nub-spmi0 (PMU alarm), 865 smc mailbox recv-not-empty (key/lid events) */
+static const unsigned wake_irq[2] = {724, 865};
+
+/*
+ * Set on the kernel's first PSCI call: from then on Linux owns the hardware, so CPU resets through RVBAR
+ * (CPU_ON restarts, the boot CPU's SYSTEM_SUSPEND wake) must not print: the UART may be powered down, and its
+ * TX-empty wait would then spin forever.
+ */
+/* a cache line of its own: psci_runtime_quiet() invalidates it */
+volatile struct {
+    bool on;
+    u8 pad[63];
+} psci_runtime_line __attribute__((aligned(64)));
+#define psci_runtime (psci_runtime_line.on)
+
+/* What the RVBAR re-entry needs, cleaned to the PoC: it runs with the MMU and caches off */
+volatile struct {
+    u64 magic, entry, context, start, frq;
+    u32 basew[2];
+} psci_resume __attribute__((aligned(64), used));
+
+static u64 wake_hw_word(unsigned i)
+{
+    return aic->base + aic->regs.mask_clr + 4 * (aic->max_irq >> 5) + 4 * (wake_irq[i] >> 5);
+}
+
+/* The wake line that newly asserted since entry, or -1 */
+static int psci_wake_line(void)
+{
+    for (unsigned i = 0; i < 2; i++) {
+        u32 w = read32(wake_hw_word(i)) & BIT(wake_irq[i] & 31);
+        if (w & ~psci_resume.basew[i])
+            return wake_irq[i];
+    }
+    return -1;
+}
+
+static void psci_sleep_core(void)
+{
+    /*
+     * Deep WFI with state retention (WFI_MODE 3, retention left on). Images 32 to 36 also set DISABLE_WFI_RET:
+     * the core then never came back (not even to the first instruction at RVBAR), so the AIC wake does not
+     * restart a core powered down without retention. The RVBAR resume path stays as a backstop.
+     */
+    /* image 42: deep_wfi() with the CYC_OVRD write synchronized (isb) before the WFI */
+    u64 cyc_ovrd = mrs(SYS_IMP_APL_CYC_OVRD);
+
+    msr(SYS_IMP_APL_CYC_OVRD, cyc_ovrd | CYC_OVRD_WFI_MODE(3));
+    sysop("isb");
+    extern void _deep_wfi_helper(void);
+    _deep_wfi_helper();
+    msr(SYS_IMP_APL_CYC_OVRD, cyc_ovrd);
+}
+
+static void __attribute__((noreturn)) psci_resume_kernel(int line, int via_rvbar)
+{
+    u64 now;
+
+    for (unsigned i = 0; i < 2; i++)
+        write32(aic->base + aic->regs.mask_set + 4 * (wake_irq[i] >> 5), BIT(wake_irq[i] & 31));
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(now));
+    if (!via_rvbar)
+        wdt_psci_arm(65); /* image 40 stage E: 65 s; the kernel's apple_wdt resume takes the watchdog back */
+    psci_resume.magic = 0;
+    if (via_rvbar)
+        wdt_psci_arm(75); /* stage 2: reset 45 s from here unless the kernel's resume takes over its watchdog */
+    psci_dbg[3] = 1;
+    psci_dbg[4] = line;
+    psci_dbg[5] = now - psci_resume.start;
+    psci_dbg[13] = via_rvbar ? 2 : 1; /* 2: the core lost its state and came back through RVBAR */
+    psci_dbg[15] = mrs(SYS_IMP_APL_CYC_OVRD);
+    psci_dbg[0] = 0xA0AA0001;
+    dc_civac_range((void *)&psci_resume, sizeof(psci_resume));
+    dc_civac_range((void *)psci_dbg, sizeof(psci_dbg));
+    psci_enter(psci_resume.entry, psci_resume.context);
+}
+
+bool psci_runtime_quiet(void)
+{
+    dc_ivac_range((void *)&psci_runtime, sizeof(psci_runtime));
+    return psci_runtime;
+}
+
+bool psci_suspend_resuming(void)
+{
+    dc_ivac_range((void *)&psci_resume, sizeof(psci_resume));
+    return psci_resume.magic == RESUME_MAGIC;
+}
+
+/* RVBAR re-entry of the boot CPU from psci_system_suspend(), after init_cpu() and exception_initialize() */
+void __attribute__((noreturn)) psci_suspend_rvbar(void)
+{
+    int line;
+
+    asm volatile("msr daifset, #0xf\n isb" ::: "memory");
+    /* stage 1: reset 30 s from here, so the time to the reset tells how far the RVBAR path got */
+    wdt_psci_arm(50);
+    dc_ivac_range((void *)psci_dbg, sizeof(psci_dbg));
+    psci_dbg[12]++;
+    while ((line = psci_wake_line()) < 0) {
+        /* not a wake line (a stray event): sleep again */
+        psci_sleep_core();
+        psci_dbg[12]++;
+    }
+    psci_resume_kernel(line, 1);
+}
+
+static unsigned long psci_system_suspend(unsigned long entry, unsigned long context)
+{
+    u64 now, hcr, daif;
+    int line;
+
+    wdt_psci_arm(SUSPEND_WDT_S);
+    asm volatile("mrs %0, hcr_el2" : "=r"(hcr));
+    asm volatile("mrs %0, daif" : "=r"(daif));
+    for (unsigned i = 0; i < 24; i++)
+        psci_dbg[i] = 0;
+    psci_dbg[1] = hcr;
+    psci_dbg[2] = daif;
+    psci_dbg[14] = mrs(SYS_IMP_APL_CYC_OVRD);
+
+    if (!aic || aic->version != 2) {
+        psci_dbg[3] = 2;
+        wdt_psci_disarm();
+        psci_dbg[0] = 0xA0AA0001;
+        dc_civac_range((void *)psci_dbg, sizeof(psci_dbg));
+        psci_enter(entry, context);
+    }
+
+    psci_resume.entry = entry;
+    psci_resume.context = context;
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(psci_resume.frq));
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(psci_resume.start));
+    /* Ignore wake sources for the first SUSPEND_MIN_MS (Linux is still finishing its own suspend work) */
+    do {
+        asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(now));
+    } while (now - psci_resume.start < psci_resume.frq / 1000 * SUSPEND_MIN_MS);
+
+    wdt_psci_arm(105); /* image 40 stage B: after the SUSPEND_MIN_MS wait */
+    for (unsigned i = 0; i < 2; i++)
+        psci_resume.basew[i] = read32(wake_hw_word(i)) & BIT(wake_irq[i] & 31);
+    psci_dbg[11] = 0x100000000UL | psci_resume.basew[0] | ((u64)psci_resume.basew[1] << 16);
+    psci_resume.magic = RESUME_MAGIC;
+
+    /*
+     * All of DAIF masked (WFI still wakes on a pending interrupt, and Linux's vectors never run); the wake lines
+     * unmasked at the AIC for the wait and masked again afterwards as Linux's syscore suspend left them. A line
+     * already asserted would end every WFI at once, so it stays masked.
+     */
+    asm volatile("msr daifset, #0xf\n isb" ::: "memory");
+    for (unsigned i = 0; i < 2; i++)
+        if (!psci_resume.basew[i])
+            write32(aic->base + aic->regs.mask_clr + 4 * (wake_irq[i] >> 5), BIT(wake_irq[i] & 31));
+    /*
+     * The RVBAR path runs with the MMU and caches off and so reads DRAM directly: every global it touches
+     * (boot_cpu_mpidr for is_boot_cpu(), the watchdog and AIC bases, cpu_features, the reset stacks, this
+     * state) must be in memory, and nothing of the image may stay cached to shadow what it writes there.
+     * Clean and invalidate the whole resident image, code to end of BSS.
+     */
+    /* image 39: the whole-image clean (images 35 to 38) is left out: 37 and 38 hung with it, 31 passed without */
+    dc_civac_range((void *)&psci_resume, sizeof(psci_resume));
+
+    wdt_psci_arm(95); /* image 40 stage C: entering the WFI loop */
+    for (;;) {
+        psci_sleep_core();
+        psci_dbg[12]++;
+        if ((line = psci_wake_line()) >= 0)
+            break;
+    }
+    wdt_psci_arm(80); /* image 40 stage D: woken on a wake line */
+    psci_resume_kernel(line, 0);
+}
