diff --git i/src/aic.c w/src/aic.c
index e7f02d49..83706465 100644
--- i/src/aic.c
+++ w/src/aic.c
@@ -210,3 +210,22 @@ uint32_t aic_ack(void)
 {
     return read32(aic->base + aic->regs.event);
 }
+
+/* Unmask the interrupt an event word (as read by aic_ack) names, so a still-asserted line is delivered again */
+void aic_unmask_event(uint32_t ev)
+{
+    u32 die = (ev >> 24) & 0xff;
+    u32 irq = ev & 0xffff;
+    write32(aic->base + aic->regs.mask_clr + die * aic->intmaskclear_stride + MASK_REG(irq), MASK_BIT(irq));
+}
+
+/*
+ * Read (and so acknowledge) the AP event register. AIC2 keeps it in its own 16K page after the 0xc000 bytes of
+ * core registers (the DT's second "event" reg), not at AIC_EVENT as on AIC1. Not for AIC3, which returns 0.
+ */
+uint32_t aic_poll_event(void)
+{
+    if (!aic || aic->version != 2)
+        return 0;
+    return read32(aic->base + 0xc000);
+}
