diff --git i/src/psci.c w/src/psci.c
index dfcdf45a..dc1927bb 100644
--- i/src/psci.c
+++ w/src/psci.c
@@ -1943,6 +1943,44 @@ static unsigned long psci_system_suspend(unsigned long entry, unsigned long cont
     psci_resume_kernel(line, 0);
 }
 
+/*
+ * Image 106: the kernel's SYSTEM_RESET after an RVBAR wake. R57W showed the woken kernel panics within about a
+ * second (reset stamp = alarm + kernel.panic), and DRAM does not survive the reset. The restart runs this handler on
+ * the panicking CPU's kernel stack with the kernel's TTBR1 live, so walk its frame records (FRAME_POINTER=y, no
+ * KASLR) and leave the return addresses in PMU scratch, which survives: 0x6040 'P', frames, MPIDR aff0|aff1<<4,
+ * RVBAR entries; 0x6044.. low 32 bits of each kernel return address (PAC bits stripped), 31 max (to 0x60bf).
+ * Only after an RVBAR wake in this suspend (psci_dbg[12]); returns NOT_SUPPORTED so the kernel's next restart
+ * handler (the watchdog) still resets. Frames that are not kernel addresses (Aura's own) are skipped.
+ */
+static void __attribute__((noinline)) psci_reset_trace(void)
+{
+    u64 rv = psci_dbg[12];
+
+    if (!rv || !qs_crumbs.base)
+        return;
+    qs_crumbs.on = 1;
+    u64 mp = mrs(MPIDR_EL1);
+    u8 hdr[4] = {0x50, 0, (u8)((mp & 0xf) | ((mp >> 4) & 0xf0)), rv > 255 ? 255 : (u8)rv};
+    qs_crumb_write(0x6040, hdr, 4);
+    u64 fp = (u64)__builtin_frame_address(0);
+    u8 n = 0;
+    for (int i = 0; i < 48 && n < 31; i++) {
+        if (!fp || (fp & 7) || (fp >> 48) != 0xffff)
+            break;
+        u64 next = ((volatile u64 *)fp)[0];
+        u64 lr = ((volatile u64 *)fp)[1];
+        if (lr & BIT(55)) {
+            u32 lo = (u32)lr;
+            qs_crumb_write(0x6044 + 4 * n, (u8 *)&lo, 4);
+            n++;
+            qs_crumb_write(0x6041, &n, 1);
+        }
+        if (next == fp)
+            break;
+        fp = next;
+    }
+}
+
 unsigned long psci_efi_handler(unsigned long fid, unsigned long arg0, unsigned long arg1,
                                unsigned long arg2)
 {
@@ -1965,6 +2003,9 @@ unsigned long psci_efi_handler(unsigned long fid, unsigned long arg0, unsigned l
             return psci_system_suspend(arg0, arg1);
         case PSCI_0_2_FN64_AFFINITY_INFO:
             return psci_affinity_info(arg0, arg1);
+        case PSCI_0_2_FN_SYSTEM_RESET:
+            psci_reset_trace();
+            return PSCI_RET_NOT_SUPPORTED;
         default:
             return PSCI_RET_NOT_SUPPORTED;
     }
