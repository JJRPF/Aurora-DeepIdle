From a1215d2f00b90fe451adf9bdf3bdfd763455296a Mon Sep 17 00:00:00 2001
From: Justin Pfister <git@jjrpf.com>
Date: Tue, 10 Nov 2026 15:50:05 -0500
Subject: [PATCH] psci: PSCI_S2R_ATC (bit 19): atcN_pcie and atcN_common to
 target 0 before the commit

macOS has them off at sleep entry; the DT keeps them always-on. On T6040 the
same domains left on made the S2R timer reset the SoC (aurora-silicon/linux
PR 1477). Restored on any resume. PMU scratch 0x600e = which are still on.

Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>
---
 src/psci.c | 50 +++++++++++++++++++++++++++++++++++++++++++++++++-
 src/psci.h |  2 ++
 2 files changed, 51 insertions(+), 1 deletion(-)

diff --git a/src/psci.c b/src/psci.c
index 6b401ea6..b30356c3 100644
--- a/src/psci.c
+++ b/src/psci.c
@@ -131,6 +131,7 @@ static volatile struct {
     u32 aic_words;
     u64 dvfs[3];           /* image 61: bit 7, PSCI_S2R_DVFS: each cluster's CLUSTER_PSTATE before APSC_DIS */
     u32 fabric[3];         /* image 62: bit 8, PSCI_S2R_FABRIC: the three fabric PS words before macOS's value */
+    u32 atc[8];            /* image 63: bit 9, PSCI_S2R_ATC: atcN_pcie and atcN_common before their target went to 0 */
 } qs_save __attribute__((aligned(64)));
 
 /*
@@ -354,6 +355,44 @@ static u8 qs_fabric_state(void)
     return b;
 }
 
+/*
+ * Image 63 (GH-5 worklog 2026-11-10 'aurora-silicon'): macOS has ATCn_PCIE and ATCn_COMMON at target 0 at sleep
+ * entry (data/psmap.txt); Linux's DT marks them always-on, so they are on at every commit (run S8's genpd dump).
+ * On T6040 the same "axi2af" domains left on made the S2R timer reset the SoC (aurora-silicon/linux PR 1477,
+ * t6040_sleep_lower_atc). Children first: the four pcie words, then the four common words (pmgr 0x28e080000).
+ * psci_dbg[23] bits 44-51 = poll timeouts. Written back on any resume, parents first.
+ */
+static const u64 qs_atc[8] = {
+    0x28e080278ULL, 0x28e080288ULL, 0x28e080298ULL, 0x28e0802a8ULL, /* atc0..3_pcie */
+    0x28e080228ULL, 0x28e080230ULL, 0x28e080238ULL, 0x28e080240ULL, /* atc0..3_common */
+};
+
+static void psci_quiesce_atc(void)
+{
+    u64 fail = 0;
+
+    for (unsigned i = 0; i < 8; i++)
+        qs_save.atc[i] = read32(qs_atc[i]);
+    qs_save.saved |= 512;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+    for (unsigned i = 0; i < 8; i++) {
+        write32(qs_atc[i], qs_save.atc[i] & ~QS_PS_CLEAR);
+        fail |= (u64)qs_poll(qs_atc[i], 0xf0, 0, 10000) << (44 + i);
+    }
+    psci_dbg[23] |= fail;
+}
+
+/* image 63: bit i = qs_atc[i]'s actual state is not 0 (still on); for the crumb snapshot */
+static u8 qs_atc_state(void)
+{
+    u8 b = 0;
+
+    for (unsigned i = 0; i < 8; i++)
+        if (read32(qs_atc[i]) & 0xf0)
+            b |= BIT(i);
+    return b;
+}
+
 static void psci_quiesce_dvfs(void)
 {
     u32 fail = 0;
@@ -380,6 +419,10 @@ static void psci_quiesce_undo(void)
         for (unsigned i = 0; i < 3; i++)
             write32(qs_fabric[i], qs_save.fabric[i] & ~0x300);
     }
+    if (qs_save.saved & 512) {
+        for (int i = 7; i >= 0; i--)
+            write32(qs_atc[i], qs_save.atc[i] & ~(BIT(11) | BIT(9) | BIT(8)));
+    }
     if (qs_save.saved & 128) {
         for (unsigned i = 0; i < 3; i++) {
             u64 a = qs_dvfs_base[i] + QS_DVFS_PSTATE;
@@ -661,6 +704,9 @@ static void qs_crumb_snapshot(void)
     /* image 62: with no never-slept core, 0x600d = qs_fabric_state() at the snapshot (only when bit 18 ran) */
     if (fi <= 0 && (qs_save.saved & 256))
         q[1] = qs_fabric_state();
+    /* image 63: likewise 0x600e = qs_atc_state() (only when bit 19 ran) */
+    if (fi <= 0 && (qs_save.saved & 512))
+        q[2] = qs_atc_state();
     if (fi > 0) {
         u64 mp = smp_psci_ipi_mpidr(fi);
         u32 pe = smp_psci_s2r_word(fi, 1), wr = smp_psci_s2r_word(fi, 2);
@@ -754,7 +800,7 @@ static unsigned long psci_system_suspend(unsigned long entry, unsigned long cont
     psci_dbg[2] = daif;
     psci_dbg[14] = mrs(SYS_IMP_APL_CYC_OVRD);
     dc_ivac_range((void *)psci_ctl, sizeof(psci_ctl));
-    u64 steps = psci_ctl[1] & (PSCI_S2R_TIMER | PSCI_S2R_CORESOFF | PSCI_S2R_DOMAINS | PSCI_S2R_CLOCKS | PSCI_S2R_CLUSTERS | PSCI_S2R_STOPREQ | PSCI_S2R_HELD | PSCI_S2R_REC | PSCI_S2R_AMCC | PSCI_S2R_STOPWD2 | PSCI_S2R_AICMASK | PSCI_S2R_WD1OFF | PSCI_S2R_RESUMENOW | PSCI_S2R_CRUMB | PSCI_S2R_QUIET | PSCI_S2R_EACC | PSCI_S2R_DVFS | PSCI_S2R_FABRIC);
+    u64 steps = psci_ctl[1] & (PSCI_S2R_TIMER | PSCI_S2R_CORESOFF | PSCI_S2R_DOMAINS | PSCI_S2R_CLOCKS | PSCI_S2R_CLUSTERS | PSCI_S2R_STOPREQ | PSCI_S2R_HELD | PSCI_S2R_REC | PSCI_S2R_AMCC | PSCI_S2R_STOPWD2 | PSCI_S2R_AICMASK | PSCI_S2R_WD1OFF | PSCI_S2R_RESUMENOW | PSCI_S2R_CRUMB | PSCI_S2R_QUIET | PSCI_S2R_EACC | PSCI_S2R_DVFS | PSCI_S2R_FABRIC | PSCI_S2R_ATC);
     for (unsigned i = 0; i < 48; i++)
         psci_dbg2[i] = 0;
     psci_dbg2[1] = steps | ((u64)qs_amcc_n << 32) | ((u64)qs_amcc_planes << 40);
@@ -815,6 +861,8 @@ static unsigned long psci_system_suspend(unsigned long entry, unsigned long cont
         psci_quiesce_held();
     if (steps & PSCI_S2R_DOMAINS)
         psci_quiesce_domains();
+    if (steps & PSCI_S2R_ATC)
+        psci_quiesce_atc();
     if (steps & PSCI_S2R_FABRIC)
         psci_quiesce_fabric();
     if (steps & PSCI_S2R_CLUSTERS)
diff --git a/src/psci.h b/src/psci.h
index 36d6c669..eac2289a 100644
--- a/src/psci.h
+++ b/src/psci.h
@@ -100,6 +100,8 @@ u64 psci_crumb_base(void);
  * (Linux's pmgr-pwrstate never writes PS_AUTO). After the domains step, write macOS's 0x1000030f (AUTO_ENABLE, PS_AUTO 0,
  * target f): the PMGR may gate each lane while it is idle and wakes it on access. Restored on any resume */
 #define PSCI_S2R_FABRIC   BIT(18)
+/* image 63: the USB-C complexes macOS has off at sleep entry and the DT keeps always-on: atcN_pcie, atcN_common */
+#define PSCI_S2R_ATC      BIT(19)
 void psci_ctl_init(void);
 
 bool psci_suspend_resuming(void);
-- 
2.56.0

