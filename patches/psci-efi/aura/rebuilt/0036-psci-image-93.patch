From: Justin Pfister <git@jjrpf.com>
Date: Thu, 12 Nov 2026 22:52:43 -0500
Subject: [PATCH] psci: image 93: observer mode bit 61 compares the 374 PMGR
 power words before the commit with macOS's at its timer write

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/psci.c        |  40 +++++
 src/qs_macos_ps.h | 378 ++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 418 insertions(+)
 create mode 100644 src/qs_macos_ps.h

diff --git a/src/psci.c b/src/psci.c
index b4d4b722..8c389b94 100644
--- a/src/psci.c
+++ b/src/psci.c
@@ -840,6 +840,42 @@ static void psci_quiesce_asc(void)
     }
 }
 
+#include "qs_macos_ps.h"
+/*
+ * image 93 (psci_ctl[4] bit 61): the observer compares the 374 PMGR power words, as they stand right before the commit (after
+ * every Aura quiesce step), with macOS's at its own S2R timer write (qs_macos_ps.h, from the hypervisor run). bits 0-9 only.
+ * psci_ctl[4] bits 0-15 = first mismatch index to list. Scratch: 0x6005 number of mismatches (255 max), then the list as
+ * index - start (one byte each, ff = none) at 0x6006..0x600b and 0x6011..0x6016.
+ */
+static void psci_s2r_pscmp(void)
+{
+    u8 e[12], r[1];
+    u32 n = 0, k = 0, start = psci_ctl[4] & 0xffff;
+
+    for (int i = 0; i < 12; i++)
+        e[i] = 0xff;
+    qs_crumb(0xa1);
+    for (u32 i = 0; i < sizeof(qs_macos_ps) / sizeof(qs_macos_ps[0]); i++) {
+        u32 v = read32(qs_macos_ps[i].addr) & 0x3ff;
+        if (v == qs_macos_ps[i].val)
+            continue;
+        n++;
+        if (i >= start && k < 12) {
+            u32 d = i - start;
+            e[k++] = d > 254 ? 254 : d;
+        }
+    }
+    qs_crumb_write(0x6006, e, 4);
+    qs_crumb_write(0x600a, e + 4, 2);
+    qs_crumb_write(0x6011, e + 6, 4);
+    qs_crumb_write(0x6015, e + 10, 2);
+    r[0] = n > 255 ? 255 : n;
+    qs_crumb_write(0x6005, r, 1);
+    qs_crumb(0xa4);
+    psci_s2r_snapdone = 1;
+    dc_civac_range((void *)&psci_s2r_snapdone, sizeof(psci_s2r_snapdone));
+}
+
 /*
  * image 90 (psci_ctl[4] bit 62): which AP wake sources stand at the commit. The five-wake-status words of Naeem Malik's T8103
  * entry latch at the first S2R-timer write; the T6020 block is the PMGR's "AOP global" one (0x404ea8000: mask words +0x0c,
@@ -995,6 +1031,10 @@ void psci_s2r_observe(void)
         psci_s2r_trace();
         return;
     }
+    if (obs & BIT(61)) {
+        psci_s2r_pscmp();
+        return;
+    }
     if (obs & BIT(62)) {
         psci_s2r_wakestat();
         return;
