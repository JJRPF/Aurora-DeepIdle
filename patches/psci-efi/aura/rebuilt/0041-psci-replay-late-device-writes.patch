From ce98322f3a3b17dd22bf545899c67c9dba8c4269 Mon Sep 17 00:00:00 2001
From: Justin Pfister <git@jjrpf.com>
Date: Thu, 12 Nov 2026 23:50:10 -0500
Subject: [PATCH] psci: replay macOS's late-window device writes too
 (ANE/AVE/AOP GPIO/PCIe/PMGR/event-log) with the memory ones; completion
 marker at 0x601e

---
 src/psci.c         |  8 +++--
 src/qs_macos_mem.h | 75 ++++++++++++++++++++++++++++++++++++++++++++--
 src/smp.c          | 20 +++++++++++++
 3 files changed, 98 insertions(+), 5 deletions(-)

diff --git a/src/psci.c b/src/psci.c
index 9b4720e0..a0b0b859 100644
--- a/src/psci.c
+++ b/src/psci.c
@@ -847,6 +847,7 @@ static void psci_quiesce_asc(void)
  * per-plane words it clears or sets (0x158000/0x158800 groups, 0x1c1c00, 0x200584.., the 0x1000-stepped banks) and mcc_0's
  * 0x11000 block, which it clears twice around the PMP's last target write. Applied count into 0x601e.
  */
+static u8 psci_mem_done;
 static void psci_replay_mem(void)
 {
     u8 r[1] = {0};
@@ -860,7 +861,7 @@ static void psci_replay_mem(void)
             r[0]++;
     }
     sysop("dsb sy");
-    qs_crumb_write(0x601e, r, 1);
+    psci_mem_done = 1;
 }
 
 /*
@@ -885,7 +886,10 @@ static void psci_force_ps(void)
             r[0]++;
     }
     sysop("dsb sy");
-    qs_crumb_write(0x601f, r, 1);
+    {
+        u8 rr[2] = {psci_mem_done ? 0x77 : 0x11, r[0]};
+        qs_crumb_write(0x601e, rr, 2); /* image 98: 0x77 = the memory/device replay finished */
+    }
 }
 
 /*
