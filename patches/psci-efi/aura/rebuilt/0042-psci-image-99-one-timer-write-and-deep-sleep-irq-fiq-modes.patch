+volatile bool cpu_sleep_deep_extra;
+
+/* image 99: what Andreas Fernandez's apple_s2r_cpu_sleep does before the final WFI (his s2r-sleep.S): a pending timer,
+ * even a masked one, aborts the power down, and a parked core takes no IRQ/FIQ as a wake source */
+static void cpu_sleep_deep_extra_setup(void)
+{
+    msr(CNTP_CTL_EL0, 0L);
+    msr(CNTV_CTL_EL0, 0L);
+    if (in_el2()) {
+        msr(CNTP_CTL_EL02, 0L);
+        msr(CNTV_CTL_EL02, 0L);
+    }
+    if (cpu_features->apple_sysregs_unlocked)
+        reg_mask(SYS_IMP_APL_CYC_OVRD, CYC_OVRD_FIQ_MODE_MASK | CYC_OVRD_IRQ_MODE_MASK,
+                 CYC_OVRD_FIQ_MODE(2) | CYC_OVRD_IRQ_MODE(2));
+}
+
