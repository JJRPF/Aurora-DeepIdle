From af34dfa1b8ea8f91fea5b363567e34481553b6ff Mon Sep 17 00:00:00 2001
From: Justin Pfister <git@jjrpf.com>
Date: Thu, 12 Nov 2026 23:34:49 -0500
Subject: [PATCH] psci: replay macOS's memory-controller sleep-entry writes
 (PSCI_CTL5 bit 2), runtime-map their pages

---
 src/kboot.c        |   6 +-
 src/psci.c         |  24 +++
 src/qs_macos_mem.h | 421 +++++++++++++++++++++++++++++++++++++++++++++
 src/smp.c          |  88 ++++++++++
 4 files changed, 536 insertions(+), 3 deletions(-)
 create mode 100644 src/qs_macos_mem.h

diff --git a/src/kboot.c b/src/kboot.c
index 07ec3f85..29f139c9 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -745,9 +745,9 @@ static int dt_set_psci(void)
     if (fdt_setprop(dt, node, "aura,psci-runtime-code", code, sizeof(code)))
         bail("FDT: couldn't set aura,psci-runtime-code\n");
 
-    u64 ranges[2 * 96]; /* image 72: 64 could not hold the twelve external debug pages too */
-    int n = smp_psci_mmio_ranges(ranges, 96);
-    fdt64_t mmio[2 * 96];
+    u64 ranges[2 * 256]; /* image 72: 64 could not hold the twelve external debug pages too */
+    int n = smp_psci_mmio_ranges(ranges, 256);
+    fdt64_t mmio[2 * 256];
     for (int i = 0; i < 2 * n; i++)
         mmio[i] = cpu_to_fdt64(ranges[i]);
     if (fdt_setprop(dt, node, "aura,psci-runtime-mmio", mmio, 2 * n * sizeof(fdt64_t)))
diff --git a/src/psci.c b/src/psci.c
index e4dceb65..9b4720e0 100644
--- a/src/psci.c
+++ b/src/psci.c
@@ -841,6 +841,28 @@ static void psci_quiesce_asc(void)
 }
 
 #include "qs_macos_ps.h"
+#include "qs_macos_mem.h"
+/*
+ * image 97 (psci_ctl[5] bit 2): replay macOS's memory-controller writes of its sleep entry (qs_macos_mem.h, in order): the
+ * per-plane words it clears or sets (0x158000/0x158800 groups, 0x1c1c00, 0x200584.., the 0x1000-stepped banks) and mcc_0's
+ * 0x11000 block, which it clears twice around the PMP's last target write. Applied count into 0x601e.
+ */
+static void psci_replay_mem(void)
+{
+    u8 r[1] = {0};
+
+    for (u32 i = 0; i < sizeof(qs_macos_mem) / sizeof(qs_macos_mem[0]); i++) {
+        if (qs_macos_mem[i].size == 8)
+            write64(qs_macos_mem[i].addr, qs_macos_mem[i].val);
+        else
+            write32(qs_macos_mem[i].addr, (u32)qs_macos_mem[i].val);
+        if (r[0] < 255)
+            r[0]++;
+    }
+    sysop("dsb sy");
+    qs_crumb_write(0x601e, r, 1);
+}
+
 /*
  * image 96 (psci_ctl[5] bit 1): force every PMGR power word that differs from macOS's at its S2R timer write (desired/actual,
  * bits 0-7; table of image 93) to macOS's desired state, outside the CPU cores and complexes (indexes 0 to 14), each waited
@@ -1449,6 +1471,8 @@ static unsigned long psci_system_suspend(unsigned long entry, unsigned long cont
      */
     if (psci_ctl[5] & 1)
         psci_quiesce_asc();
+    if (psci_ctl[5] & 4)
+        psci_replay_mem();
     if (psci_ctl[5] & 2)
         psci_force_ps();
     qs_crumb(0x12);
