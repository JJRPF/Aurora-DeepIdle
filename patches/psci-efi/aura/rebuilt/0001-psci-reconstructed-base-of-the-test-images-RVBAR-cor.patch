+/*
+ * Breadcrumbs of the last RVBAR entry (0xa1 asm entry, 0xa2 stack chosen, 0xa3 _cpu_reset_c,
+ * 0xa4 after init_cpu, 0xa5 smp_secondary_entry), readable from the kernel through /dev/mem.
+ */
+volatile u8 reset_dbg[8] __attribute__((aligned(64), section(".data")));
+
 /* Secondary SMP core boot */
 void _cpu_reset_c(void *stack)
 {
+    reset_dbg[2] = 0xa3;
     if (chip_id == T8152 && !is_boot_cpu()) {
         if (smp_secondary_prepare() < 0)
             while (1)
@@ -248,6 +255,7 @@ void _cpu_reset_c(void *stack)
         printf("  MPIDR: 0x%lx\n", mrs(MPIDR_EL1));
     }
     init_cpu();
+    reset_dbg[3] = 0xa4;
     if (!quiet)
         printf("  Running in EL%lu\n\n", mrs(CurrentEL) >> 2);
 
