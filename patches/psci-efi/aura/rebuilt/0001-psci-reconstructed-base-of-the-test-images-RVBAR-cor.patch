+/*
+ * Leave Aura for a kernel entry point (secondary_entry, cpu_resume) as PSCI firmware would: MMU and
+ * caches off at EL2 (the caller runs under a 1:1 map, so the code under
+ * us stays reachable), HCR_EL2 back to its reset value (the kernel ran as a VHE host), then
+ * x0 = context, branch to the entry.
+ */
+void psci_enter(u64 entry, u64 context) __attribute__((noreturn));
+asm(".text\n.globl psci_enter\npsci_enter:\n"
+    "mrs x2, sctlr_el2\n"
+    "bic x2, x2, #(1 << 0)\n"
+    "bic x2, x2, #(1 << 2)\n"
+    "bic x2, x2, #(1 << 12)\n"
+    "msr sctlr_el2, x2\n"
+    "isb\n"
+    "mov x2, #(1 << 31)\n"
+    "orr x2, x2, #(1 << 34)\n"
+    "msr hcr_el2, x2\n"
+    "isb\n"
+    "mov x3, x0\n"
+    "mov x0, x1\n"
+    "br x3\n");
+
+/* The parked state of a CPU_OFF'd core: deep WFI on the Aura stack until it is handed an entry. */
+void psci_park_c(u64 index) __attribute__((noreturn, used));
+void psci_park_c(u64 index)
+{
+    struct spin_table *me = &spin_table[index];
+    u64 target;
+
+    if (cpu_features->apple_sysregs_unlocked)
+        reg_mask(SYS_IMP_APL_CYC_OVRD, CYC_OVRD_WFI_MODE_MASK,
+                 CYC_OVRD_WFI_MODE(3) | CYC_OVRD_DISABLE_WFI_RET);
+    while (1) {
+        /* Plain load: the mapping is inner-shareable write-back, the other CPU's civac-ed store is visible. */
+        if ((target = *(volatile u64 *)&me->target))
+            break;
+        sysop("isb");
+        sysop("wfi");
+    }
+    sysop("dmb sy");
+    me->flag++;
+    sysop("dmb sy");
+    psci_enter(target, me->args[0]);
+}
+
 int smp_psci_cpu_off(void)
 {
     int index = smp_psci_index(mrs(MPIDR_EL1));
@@ -1109,24 +1107,22 @@ int smp_psci_cpu_off(void)
     if (index < 0 || index == boot_cpu_idx)
         return PSCI_RET_DENIED;
 
-    const struct cpu_info *cpu = &cpu_info[index];
-    u64 start_base = cpu_start_base + cpu->die * PMGR_DIE_OFFSET;
-
     /*
-     * As smp_stop_cpu(): request the stop, then power the core down. Not cpu_sleep(true): its
-     * ACC_OVRD writes (PWR_DN_SRM, POWER_DOWN_CPM, DEEP_SLEEP) are per cluster, shared with the
-     * cores that keep running Linux, and meant for the last core of a bootloader handoff. The first
-     * CPU_OFF with it took the whole SoC down (boot test 2026-10-25). cpu_sleep(false) only sets
-     * the per-core CYC_OVRD (deep WFI, no retention), which is what macOS's per-core idle uses.
+     * Not the PMGR stop request: a core stopped that way did not come back from any start
+     * strobe, IPI or timer (images 5 to 10, 2026-10-25), and a deep-WFI core resumes after the
+     * WFI instead of restarting at RVBAR. So the core parks in Aura: clean its L1, move to its
+     * Aura stack, and wait in psci_park_c() for the next CPU_ON.
      */
-    write32(start_base + 0x0, cpu_start_bit(index, cpu));
-
+    /* The entry this core was started with is still in the table (the kernel never returns). */
+    spin_table[index].target = 0;
+    dc_civac_range(&spin_table[index], sizeof(struct spin_table));
     psci_cpu_state[index] = PSCI_CPU_OFF;
     dc_civac_range(&psci_cpu_state[index], 1);
-    /* This core's L1 goes away with its power: write the kernel's dirty lines back. */
     dcsw_op_level1(DCSW_OP_DCCISW);
     sysop("dsb sy");
-    cpu_sleep(false);
+    u64 sp = (u64)secondary_stacks[index] + SECONDARY_STACK_SIZE;
+    asm volatile("mov sp, %0\n mov x0, %1\n b psci_park_c" ::"r"(sp), "r"((u64)index) : "x0");
+    __builtin_unreachable();
 }
 
