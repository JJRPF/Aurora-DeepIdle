From 8f4404def5ad69a69af6cd41ed79cea0f628212f Mon Sep 17 00:00:00 2001
From: Justin Pfister <git@jjrpf.com>
Date: Wed, 11 Nov 2026 08:46:19 -0500
Subject: [PATCH] psci: the observer reports the PMGR power words that change
 in the 3 s after the commit (image 78; replaces the wake probe)

---
 src/pmgr.c | 42 +++++++++++++++++++++++++++++++
 src/pmgr.h |  3 +++
 src/psci.c | 73 ++++++++++++++++++++++--------------------------------
 3 files changed, 74 insertions(+), 44 deletions(-)

diff --git a/src/pmgr.c b/src/pmgr.c
index fd8914a2..ab4e04de 100644
--- a/src/pmgr.c
+++ b/src/pmgr.c
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: MIT AND GPL-2.0-only */
 
 #include "pmgr.h"
+#include "memory.h"
 #include "adt.h"
 #include "string.h"
 #include "types.h"
@@ -739,3 +740,44 @@ int pmgr_set_voltage_ctl(uint32_t offset)
 
     return 0;
 }
+
+/*
+ * image 78: every die-0 device's power word, listed while the ADT is still around (psci_ctl_init), for the S2R
+ * observer's before/after snapshot. key = ps-reg index << 8 | address offset (the word is ps-reg base + offset * 8).
+ */
+#define PMGR_PS_TAB_MAX 512
+static struct {
+    u64 addr;
+    u32 key;
+    u32 pad;
+} pmgr_ps_tab[PMGR_PS_TAB_MAX] __attribute__((aligned(64)));
+static u32 pmgr_ps_tab_n;
+
+void pmgr_ps_tab_build(void)
+{
+    pmgr_ps_tab_n = 0;
+    if (!pmgr_devices || pmgr_use_group_and_offset)
+        return;
+    for (size_t i = 0; i < pmgr_devices_len && pmgr_ps_tab_n < PMGR_PS_TAB_MAX; i++) {
+        const struct pmgr_device *d = &pmgr_devices[i];
+        uintptr_t a = pmgr_device_get_addr(0, d);
+        if (!a)
+            continue;
+        pmgr_ps_tab[pmgr_ps_tab_n].addr = a;
+        pmgr_ps_tab[pmgr_ps_tab_n].key = ((u32)d->psreg_idx << 8) | d->addr_offset;
+        pmgr_ps_tab_n++;
+    }
+    dc_civac_range(pmgr_ps_tab, sizeof(pmgr_ps_tab));
+    dc_civac_range(&pmgr_ps_tab_n, sizeof(pmgr_ps_tab_n));
+}
+
+u32 pmgr_ps_tab_count(void)
+{
+    return pmgr_ps_tab_n;
+}
+
+u64 pmgr_ps_tab_addr(u32 i, u32 *key)
+{
+    *key = pmgr_ps_tab[i].key;
+    return pmgr_ps_tab[i].addr;
+}
diff --git a/src/pmgr.h b/src/pmgr.h
index d258ad66..9fc01feb 100644
--- a/src/pmgr.h
+++ b/src/pmgr.h
@@ -51,5 +51,8 @@ int pmgr_set_mode(uintptr_t addr, u8 target_mode);
 u32 pmgr_get_feature(const char *name);
 
 int pmgr_set_voltage_ctl(uint32_t offset);
+void pmgr_ps_tab_build(void);
+u32 pmgr_ps_tab_count(void);
+u64 pmgr_ps_tab_addr(u32 i, u32 *key);
 
 #endif
diff --git a/src/psci.c b/src/psci.c
index e29efd51..5fae1b34 100644
--- a/src/psci.c
+++ b/src/psci.c
@@ -8,6 +8,7 @@
 #include "smp.h"
 #include "types.h"
 #include "adt.h"
+#include "pmgr.h"
 
 /*
  * CPU_ON, CPU_OFF and AFFINITY_INFO for the secondaries; the CPU work is in
@@ -637,6 +638,7 @@ void psci_ctl_init(void)
         psci_ctl[i] = 0;
     psci_ctl[0] = PSCI_CTL_MAGIC_HI | lo;
     dc_civac_range((void *)psci_ctl, sizeof(psci_ctl));
+    pmgr_ps_tab_build(); /* image 78 */
     /* image 58: the AMCC planes, found now while the ADT is still around */
     qs_amcc_n = mcc_plane_bases(qs_amcc_base, 8, &qs_amcc_stride, &qs_amcc_planes);
     if (qs_amcc_planes > 4)
@@ -810,6 +812,11 @@ void psci_s2r_observe(void)
             qs_crumb(0xaf); /* the boot core never committed */
             return;
         }
+    /* image 78: every PMGR power word as the commit is seen (before the crumb: SPMI takes a while) */
+    static u32 snap[512];
+    u32 nps = pmgr_ps_tab_count(), key;
+    for (u32 i = 0; i < nps; i++)
+        snap[i] = read32(pmgr_ps_tab_addr(i, &key));
     qs_crumb(0xa1);
     t0 = qs_now();
     do {
@@ -855,53 +862,31 @@ void psci_s2r_observe(void)
     qs_crumb(0xa3);
 
     /*
-     * image 76: wake each sleeping core with an IPI and see how it comes back. Returned from its WFI (word 5) = it was
-     * only clock-stopped; through its reset vector (psci_s2r_probe) = it had lost power; neither = it cannot be woken.
-     * Order: the other P complex, this one, the E cores, the boot core last. 0x600b = the index being woken (ff = done),
-     * 0x6005/0x6006 = WFI-returned mask, 0x6008/0x6009 = reset-vector mask (bit 15 = written), 0x6007 = the boot
-     * core's WFI count, 0x600a = reset_dbg[0], stage a4.
+     * image 78 (replaces image 76's wake probe, which the control R26B showed to be blind): the PMGR power words that
+     * differ between the commit and 3 s later, the three CPU complex words left out. 0x6005 = how many differ, 0x6006 =
+     * words in the table / 2, then up to five 3-byte entries at 0x6007, 0x600a, 0x6012, 0x6015, 0x601b:
+     * [offset] [ps-reg index (low 3 bits) | upper bits differ (bit 3) | old actual state << 4] [new target | new actual << 4]
      */
-    extern volatile u8 psci_s2r_probe[64];
-    extern volatile u8 reset_dbg[8];
-    int self = smp_id();
-    for (int i = 0; i < 64; i++)
-        psci_s2r_probe[i] = 0;
-    psci_s2r_probe[0] = 0x5a;
-    dc_civac_range((void *)psci_s2r_probe, 64);
-    reset_dbg[0] = 0;
-    dc_civac_range((void *)reset_dbg, 8);
-    sysop("dsb sy");
-    static const s8 order[] = {8, 9, 10, 4, 5, 6, 1, 2, 3, 0};
-    for (u32 n = 0; n < sizeof(order); n++) {
-        int i = order[n];
-        if (i == self || !smp_psci_cpu_valid(i))
+    static const u16 slot[] = {0x6007, 0x600a, 0x6012, 0x6015, 0x601b};
+    u32 nd = 0;
+    for (u32 i = 0; i < nps; i++) {
+        u64 a = pmgr_ps_tab_addr(i, &key);
+        if (a >= QS_CPM_PS && a <= QS_CPM_PS + 0x10)
             continue;
-        r[0] = i;
-        qs_crumb_write(0x600b, r, 1);
-        smp_send_ipi(i);
-        sysop("isb");
-        mdelay(100);
+        u32 v = read32(a);
+        if (v == snap[i])
+            continue;
+        if (nd < 5) {
+            r[0] = key & 0xff;
+            r[1] = ((key >> 8) & 7) | (((v ^ snap[i]) & ~0xffU) ? 8 : 0) | (snap[i] & 0xf0);
+            r[2] = v & 0xff;
+            qs_crumb_write(slot[nd], r, 3);
+        }
+        nd++;
     }
-    u32 rv = 0;
-    wk = 0;
-    dc_ivac_range((void *)psci_s2r_probe, 64);
-    for (int i = 0; i < 12; i++) {
-        if (psci_s2r_probe[16 + i] == 0xa5)
-            rv |= BIT(i);
-        if (i < MAX_CPUS && smp_psci_cpu_valid(i) && smp_psci_s2r_word(i, 5))
-            wk |= BIT(i);
-    }
-    bc = smp_psci_s2r_word(boot_cpu_idx, 5);
-    r[0] = wk & 0xff;
-    r[1] = (wk >> 8) | 0x80;
-    r[2] = bc > 255 ? 255 : bc;
-    qs_crumb_write(0x6005, r, 3);
-    dc_ivac_range((void *)reset_dbg, 8);
-    r[0] = rv & 0xff;
-    r[1] = (rv >> 8) | 0x80;
-    r[2] = reset_dbg[0];
-    r[3] = 0xff;
-    qs_crumb_write(0x6008, r, 4);
+    r[0] = nd > 255 ? 255 : nd;
+    r[1] = nps >> 1;
+    qs_crumb_write(0x6005, r, 2);
     qs_crumb(0xa4);
 }
 static void qs_crumb_snapshot(void)
-- 
2.56.0

