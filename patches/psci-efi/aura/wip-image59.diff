+/*
+ * SYSTEM_SUSPEND with the SoC kept on (S2R plan, Phase 2): the kernel has quiesced everything and masked
+ * interrupts. The boot CPU powers down in WFI without state retention (CYC_OVRD WFI_MODE 3 + DISABLE_WFI_RET,
+ * as a parked secondary does) and the AIC wakes it on a wake line; it then comes back through its RVBAR into
+ * _cpu_reset_c(), which calls psci_suspend_rvbar() below instead of m1n1_main(), and that resumes the kernel at
+ * its entry point, MMU and caches off, as a PSCI resume. If the core keeps its state after all, the WFI just
+ * returns and the same wake handling runs here.
+ */
+#define SUSPEND_MIN_MS 500 /* ignore wake lines for this long after entry */
+#define SUSPEND_WDT_S  120 /* hardware reset if no wake line ever brings the CPU back */
+#define RESUME_MAGIC   0x5253554d45ULL /* "RSUME" */
+/*
+ * Heartbeat (image 49): the watchdog cannot be armed for more than about 178 s (32-bit count at 24 MHz), so a
+ * longer sleep needs it re-armed. The EL2 physical timer (Linux runs on the EL2 virtual timer) wakes the core
+ * every SUSPEND_HB_S; a wake that is not a wake line re-arms the dog and the timer and sleeps again. If Aura stops
+ * running, nothing re-arms it and the Mac resets as before.
+ */
+#define SUSPEND_HB_S   60
+#define RVBAR_WDT_S    10  /* boot CPU back through RVBAR, until it hands over to the kernel's resume */
+#define RESUME_WDT_S   150 /* resuming the kernel after an RVBAR entry (WD1 tops out near 178 s) */
+#define SYS_CNTHP_CVAL_EL2 sys_reg(3, 4, 14, 2, 2)
+
+/* Debug words Linux reads back (found by scan-magic): see run.sh for the layout */
+volatile u64 psci_dbg[24] __attribute__((used));
+
+/*
+ * S2R steps (image 52, 2026-11-05), set by Linux before a suspend: psci_ctl[0] holds a magic written at boot (built
+ * at run time, so no copy of the image carries it), psci_ctl[1] the steps, written through /dev/mem by
+ * harness/mmio/aura-ctl.c. 0 is image 51's suspend. Read once at SYSTEM_SUSPEND entry.
+ *   PSCI_S2R_TIMER    macOS's last PMGR quiesce step (AppleT6020PMGR::startS2RTimer, 13.5): write 1 to
+ *                     MPMGR_AON + 0x4000, just before the boot core sleeps
+ *   PSCI_S2R_CORESOFF macOS's ml_arm_sleep: release the parked secondaries into the global deep sleep
+ *                     (cpu_sleep(true): ACC_OVRD deep sleep, no WFI retention), then the boot core the same way.
+ *                     A core that sleeps like this comes back only through RVBAR, when the PMGR restarts it.
+ */
+/*
+ * Image 53: the rest of AppleT6020PMGR::quiesceHW (13.5), done before the timer (all die 0; T6020 has one die):
+ *   PSCI_S2R_DOMAINS  ps_afr (pmgr_gfx + 0x100) written 0 (fully off) when MINI 0x4d010 bits 18-19 are not both
+ *                     set, then its actual state polled to 0; ps_sio and ps_sio_cpu (pmgr_east + 0x1c0, + 0x1e0)
+ *                     lose AUTO_ENABLE (bit 28), then actual == target polled
+ *   PSCI_S2R_CLOCKS   ClkGen-SOC 0x38160, 0x38168, 0x38164, 0x38158, 0x3816c: bits 24-27 cleared, bit 31 set, bit
+ *                     30 polled to 0; then setPLLOffMode(0x37, 0, 3) on 0x28e224000: bits 3-5 = mode 3, set bit 1,
+ *                     clear bit 0, bit 31 polled to 0
+ * Each register's old value is kept and written back on any resume (the RVBAR path included).
+ */
+#define QS_MINI_4D010   0x29e2cd010ULL
+#define QS_AFR          0x404e80100ULL
+#define QS_SIO          0x2902801c0ULL
+#define QS_SIO_CPU      0x2902801e0ULL
+#define QS_CLKGEN       0x28e000000ULL
+#define QS_PLLOFF       0x28e224000ULL
+/*
+ * Image 54: quiesceHW step 4, enableCluster(c, false, c > 3, die) for soc-clusters 1..5 (ADT pmgr `soc-clusters`:
+ * EACC, PACC0, PACC1, ANE0, AVEMSR, DISPLAY). Each cluster's word is at pmgr reg 4 (0x28e000000) + the ADT's
+ * `cluster-ctl-offset` (0x88000) + 4 * its id (the entry's first byte); enableCluster writes (v & ~0xf) | 0 and,
+ * for c > 3, waits for bit 4 to clear. Linux reads 0xf for EACC and 0x2f for the other five. Not done: for AVEMSR
+ * macOS also makes one more PMGR call first (vtable +0xa08 with the entry's byte 11, 0x0d).
+ *   PSCI_S2R_CLUSTERS the five clusters' targets to 0, after the domains and before the clocks
+ */
+#define QS_CLUSTER      0x28e088000ULL
+/*
+ * Image 56 (GH-8 worklog 2026-11-06 'run S3'): the PMGR domains Linux's genpd still has on at syscore suspend and
+ * that are not always-on: the three display chains (the DCP driver keeps its device on a wake path, so cpu0, fe and
+ * sys stay up) and the USB-C ports' atcN_usb (dwc3 syscore or wakeup). macOS has its devices off by then.
+ *   PSCI_S2R_HELD     each written with target 0 (AUTO_ENABLE, reset, disable and the flag bits cleared, as
+ *                     Linux's apple_pmgr_ps_set), children first, then its actual state polled to 0; before the
+ *                     quiesceHW domains, since ps_afr is dispext0_sys's parent. psci_dbg[23] bits 32-43 = poll
+ *                     timeouts, one per entry. The old words are written back on any resume, parents first.
+ */
+#define QS_PS_CLEAR     (BIT(31) | BIT(28) | BIT(12) | BIT(11) | BIT(10) | BIT(9) | BIT(8) | 0xf)
+static const u64 qs_held[12] = {
+    0x28e0802d8ULL, 0x28e0802c0ULL, 0x28e080258ULL, /* dispext0_cpu0, _fe, _sys */
+    0x28e0802b8ULL, 0x28e0802b0ULL, 0x28e080248ULL, /* dispext1_cpu0, _fe, _sys */
+    0x2902801d8ULL, 0x2902801d0ULL, 0x2902801b0ULL, /* disp0_cpu0, _fe, _sys */
+    0x29e2800c8ULL, 0x29e2800d0ULL, 0x29e2800d8ULL, /* atc0_usb, atc1_usb, atc2_usb */
+};
+static const u8 qs_cluster_id[5] = {1, 2, 3, 6, 4};
+static const u32 qs_clkgen_off[5] = {0x38160, 0x38168, 0x38164, 0x38158, 0x3816c};
+/* Wake lines (AIC2 event numbers): 724 nub-spmi0 (PMU alarm), 865 smc mailbox recv-not-empty (key/lid events) */
+static const unsigned wake_irq[2] = {724, 865};
+#define MPMGR_AON_S2R_TIMER 0x29e5c4000ULL      /* MPMGR_AON (PMGR reg 38, T6020) + 0x4000 */
+
+static volatile struct {
+    u32 saved; /* bit 0 domains, bit 1 clocks, bit 2 clusters, bit 3 held */
+    u32 afr, sio, sio_cpu, pll;
+    u32 clk[5];
+    u32 cluster[5];
+    u32 held[12];
+    u32 held_mask;
+    u32 amcc_en[8][4][2]; /* image 58: bit 4, PSCI_S2R_AMCC: each plane's error enable words 0 and 1 */
+    u32 amcc_n, amcc_planes;
+    u32 aic_mask[128];     /* image 58: bit 5, PSCI_S2R_AICMASK: the AIC mask words before the mask-all */
+    u32 aic_words;
+} qs_save __attribute__((aligned(64)));
+
+/*
+ * Image 58 (GH-8 worklog 2026-11-06 'image 58'): leads from DJ's T8140 (aurora-silicon/aura feat/sptm-hv,
+ * docs/sptm-nv2-virt.md) and Naeem Malik's t8103 (malik-na/m1-power-lab, docs/evidence/2026-11-06-mac27-hv) S2R.
+ *   PSCI_S2R_REC      psci_dbg2: the AON watchdogs WD0..2 (count, alarm, ctl) and the S2R timer word at entry, just
+ *                     before the timer, right after it and 100 ms later; each AMCC instance's error status (OR of its
+ *                     planes) at entry and just before the timer, and its plane 0 enables at entry
+ *   PSCI_S2R_AMCC     before the timer, clear DSID_AGE_OUT (word 0 bit 26) and UNEXP_RT_HIT_DIR (word 1 bit 8) in
+ *                     every plane's error enables (T6020, 13.5 AppleT6020PlatformErrorHandler::_amccEnableErrors:
+ *                     enable word i at plane + 0x21000 + 8 * i, status at + 4; T8140 has them at 0x25000, bit 25).
+ *                     DJ: with no platform error handler, a pending enabled AMCC error wakes the SoC within 20 ms of
+ *                     the commit, and a display power-off raises DSID_AGE_OUT
+ *   PSCI_S2R_STOPWD2  100 ms after the timer, WD2 ctl = 0. On t8103 and T8140 the commit loads WD2 (macOS: 5 s, reset
+ *                     enabled) and only a completed entry stops it; our timer resets the SoC about 60 s after it
+ *   PSCI_S2R_AICMASK  after the timer, every AIC line masked, as macOS's AIC quiesce right after its S2R timer; only
+ *                     with PSCI_S2R_CORESOFF (Aura's own wait needs its two wake lines)
+ */
+#define WDT_N            3
+#define AMCC_EN(b, p, w)  ((b) + (p) * qs_amcc_stride + 0x21000 + 8 * (w))
+#define AMCC_STS(b, p, w) (AMCC_EN(b, p, w) + 4)
+#define AMCC_DSID_AGE_OUT     BIT(26)
+#define AMCC_UNEXP_RT_HIT_DIR BIT(8)
+volatile u64 psci_dbg2[48] __attribute__((used));
+static u64 qs_amcc_base[8], qs_amcc_stride;
+static int qs_amcc_n, qs_amcc_planes;
+
+/* psci_dbg2[at..at+5]: per watchdog (alarm << 32 | count), (timer word << 32 | ctl); the timer word only with WD0 */
+static void qs_rec_wdt(unsigned at)
+{
+    u64 wdt = wdt_psci_base();
+
+    if (!wdt)
+        return;
+    for (unsigned i = 0; i < WDT_N; i++) {
+        u64 b = wdt + 0x10 * i;
+        psci_dbg2[at + 2 * i] = ((u64)read32(b + 4) << 32) | read32(b);
+        psci_dbg2[at + 2 * i + 1] = read32(b + 0xc) | (i ? 0 : (u64)read32(MPMGR_AON_S2R_TIMER) << 32);
+    }
+}
+
+/* psci_dbg2[at + i]: instance i's error status, OR over its planes, word 0 low and word 1 high */
+static void qs_rec_amcc(unsigned at)
+{
+    for (int i = 0; i < qs_amcc_n && i < 4; i++) {
+        u32 s0 = 0, s1 = 0;
+        for (int p = 0; p < qs_amcc_planes; p++) {
+            s0 |= read32(AMCC_STS(qs_amcc_base[i], p, 0));
+            s1 |= read32(AMCC_STS(qs_amcc_base[i], p, 1));
+        }
+        psci_dbg2[at + i] = ((u64)s1 << 32) | s0;
+    }
+}
+
+static void psci_quiesce_amcc(void)
+{
+    qs_save.amcc_n = qs_amcc_n;
+    qs_save.amcc_planes = qs_amcc_planes;
+    for (int i = 0; i < qs_amcc_n; i++)
+        for (int p = 0; p < qs_amcc_planes; p++)
+            for (int w = 0; w < 2; w++)
+                qs_save.amcc_en[i][p][w] = read32(AMCC_EN(qs_amcc_base[i], p, w));
+    qs_save.saved |= 16;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+    for (int i = 0; i < qs_amcc_n; i++)
+        for (int p = 0; p < qs_amcc_planes; p++) {
+            write32(AMCC_EN(qs_amcc_base[i], p, 0), qs_save.amcc_en[i][p][0] & ~AMCC_DSID_AGE_OUT);
+            write32(AMCC_EN(qs_amcc_base[i], p, 1), qs_save.amcc_en[i][p][1] & ~AMCC_UNEXP_RT_HIT_DIR);
+        }
+    psci_dbg2[42] = ((u64)read32(AMCC_EN(qs_amcc_base[0], 0, 1)) << 32) | read32(AMCC_EN(qs_amcc_base[0], 0, 0));
+}
+
+static void psci_quiesce_aic(void)
+{
+    u32 words = (aic->nr_irq + 31) / 32;
+
+    if (words > 128)
+        words = 128;
+    qs_save.aic_words = words;
+    for (u32 w = 0; w < words; w++)
+        qs_save.aic_mask[w] = read32(aic->base + aic->regs.mask_set + 4 * w);
+    qs_save.saved |= 32;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+    for (u32 w = 0; w < words; w++)
+        write32(aic->base + aic->regs.mask_set + 4 * w, 0xffffffff);
+    sysop("dsb sy");
+}
+
+/* poll (read32(a) & mask) == val for up to us microseconds; 0 when it matched */
+static int qs_poll(u64 a, u32 mask, u32 val, u32 us)
+{
+    for (u32 i = 0; i < us; i++) {
+        if ((read32(a) & mask) == val)
+            return 0;
+        udelay(1);
+    }
+    return 1;
+}
+
+/* image 57: psci_ctl[2] bits 0-11 pick which qs_held entries bit 6 turns off (0 = all), to find one that hangs */
+static u32 qs_held_mask;
+
+static void psci_quiesce_held(void)
+{
+    u64 fail = 0;
+
+    for (unsigned i = 0; i < 12; i++)
+        qs_save.held[i] = read32(qs_held[i]);
+    qs_save.held_mask = qs_held_mask;
+    qs_save.saved |= 8;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+    for (unsigned i = 0; i < 12; i++) {
+        if (!(qs_held_mask & BIT(i)))
+            continue;
+        write32(qs_held[i], qs_save.held[i] & ~QS_PS_CLEAR);
+        fail |= (u64)qs_poll(qs_held[i], 0xf0, 0, 10000) << (32 + i);
+    }
+    psci_dbg[23] |= fail;
+}
+
+static void psci_quiesce_domains(void)
+{
+    u32 fail = 0;
+
+    qs_save.afr = read32(QS_AFR);
+    qs_save.sio = read32(QS_SIO);
+    qs_save.sio_cpu = read32(QS_SIO_CPU);
+    qs_save.saved |= 1;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+    if ((~read32(QS_MINI_4D010) & 0xc0000) != 0) {
+        write32(QS_AFR, 0);
+        fail |= qs_poll(QS_AFR, 0xf0, 0, 10000);
+    }
+    write32(QS_SIO, qs_save.sio & ~BIT(28));
+    fail |= qs_poll(QS_SIO, 0xf0, (qs_save.sio & 0xf) << 4, 10000) << 1;
+    write32(QS_SIO_CPU, qs_save.sio_cpu & ~BIT(28));
+    fail |= qs_poll(QS_SIO_CPU, 0xf0, (qs_save.sio_cpu & 0xf) << 4, 10000) << 2;
+    psci_dbg[19] = ((u64)qs_save.afr << 32) | read32(QS_AFR);
+    psci_dbg[20] = ((u64)qs_save.sio << 32) | read32(QS_SIO);
+    psci_dbg[21] = ((u64)qs_save.sio_cpu << 32) | read32(QS_SIO_CPU);
+    psci_dbg[23] |= fail;
+}
+
+static void psci_quiesce_clocks(void)
+{
+    u32 fail = 0, v;
+
+    for (unsigned i = 0; i < 5; i++)
+        qs_save.clk[i] = read32(QS_CLKGEN + qs_clkgen_off[i]);
+    qs_save.pll = read32(QS_PLLOFF);
+    qs_save.saved |= 2;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+    for (unsigned i = 0; i < 5; i++) {
+        write32(QS_CLKGEN + qs_clkgen_off[i], (qs_save.clk[i] & 0x70ffffff) | 0x80000000);
+        fail |= qs_poll(QS_CLKGEN + qs_clkgen_off[i], BIT(30), 0, 10000) << (8 + i);
+    }
+    v = read32(QS_PLLOFF);
+    write32(QS_PLLOFF, (v & ~0x38) | (3 << 3));
+    write32(QS_PLLOFF, read32(QS_PLLOFF) | 2);
+    write32(QS_PLLOFF, read32(QS_PLLOFF) & ~1);
+    fail |= qs_poll(QS_PLLOFF, BIT(31), 0, 10000) << 16;
+    psci_dbg[22] = ((u64)qs_save.pll << 32) | read32(QS_PLLOFF);
+    psci_dbg[23] |= fail;
+}
+
+/* undo both, in reverse, on the way back to the kernel */
+static void psci_quiesce_clusters(void)
+{
+    u32 fail = 0;
+
+    for (unsigned i = 0; i < 5; i++)
+        qs_save.cluster[i] = read32(QS_CLUSTER + 4 * qs_cluster_id[i]);
+    qs_save.saved |= 4;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+    for (unsigned i = 0; i < 5; i++) {
+        u64 a = QS_CLUSTER + 4 * qs_cluster_id[i];
+        write32(a, qs_save.cluster[i] & ~0xf);
+        if (i + 1 > 3)
+            fail |= qs_poll(a, BIT(4), 0, 10000) << (24 + i);
+    }
+    for (unsigned i = 0; i < 5; i++)
+        psci_dbg[6 + i] = ((u64)qs_save.cluster[i] << 32) | read32(QS_CLUSTER + 4 * qs_cluster_id[i]);
+    psci_dbg[23] |= fail;
+}
+
+static void psci_quiesce_undo(void)
+{
+    dc_ivac_range((void *)&qs_save, sizeof(qs_save));
+    if (qs_save.saved & 2) {
+        write32(QS_PLLOFF, qs_save.pll);
+        for (int i = 4; i >= 0; i--)
+            write32(QS_CLKGEN + qs_clkgen_off[i], qs_save.clk[i]);
+    }
+    if (qs_save.saved & 4) {
+        for (unsigned i = 0; i < 5; i++)
+            write32(QS_CLUSTER + 4 * qs_cluster_id[i], qs_save.cluster[i]);
+    }
+    if (qs_save.saved & 1) {
+        write32(QS_SIO_CPU, qs_save.sio_cpu);
+        write32(QS_SIO, qs_save.sio);
+        write32(QS_AFR, qs_save.afr);
+    }
+    if (qs_save.saved & 32) {
+        /* unmask what was unmasked, except Aura's two wake lines, which Linux keeps masked */
+        for (u32 w = 0; w < qs_save.aic_words; w++) {
+            u32 keep = 0;
+            for (unsigned i = 0; i < 2; i++)
+                if ((wake_irq[i] >> 5) == w)
+                    keep |= BIT(wake_irq[i] & 31);
+            write32(aic->base + aic->regs.mask_clr + 4 * w, ~qs_save.aic_mask[w] & ~keep);
+        }
+    }
+    if (qs_save.saved & 16) {
+        for (u32 i = 0; i < qs_save.amcc_n; i++)
+            for (u32 p = 0; p < qs_save.amcc_planes; p++)
+                for (u32 w = 0; w < 2; w++)
+                    write32(AMCC_EN(qs_amcc_base[i], p, w), qs_save.amcc_en[i][p][w]);
+    }
+    if (qs_save.saved & 8) {
+        for (int i = 11; i >= 0; i--)
+            if (qs_save.held_mask & BIT(i))
+                write32(qs_held[i], qs_save.held[i] & ~(BIT(11) | BIT(9) | BIT(8)));
+    }
+    qs_save.saved = 0;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+}
+
+volatile u64 psci_ctl[8] __attribute__((aligned(64), used));
+#define PSCI_CTL_MAGIC_HI 0x5332524354524c00ULL /* "S2RCTRL", low byte added at run time */
+
+void psci_ctl_init(void)
+{
+    volatile u64 lo = 0x21;
+
+    for (unsigned i = 0; i < 8; i++)
+        psci_ctl[i] = 0;
+    psci_ctl[0] = PSCI_CTL_MAGIC_HI | lo;
+    dc_civac_range((void *)psci_ctl, sizeof(psci_ctl));
+    /* image 58: the AMCC planes, found now while the ADT is still around */
+    qs_amcc_n = mcc_plane_bases(qs_amcc_base, 8, &qs_amcc_stride, &qs_amcc_planes);
+    if (qs_amcc_planes > 4)
+        qs_amcc_planes = 4;
+}
+
+
+/*
+ * Set on the kernel's first PSCI call: from then on Linux owns the hardware, so CPU resets through RVBAR
+ * (CPU_ON restarts, the boot CPU's SYSTEM_SUSPEND wake) must not print: the UART may be powered down, and its
+ * TX-empty wait would then spin forever.
+ */
+/* a cache line of its own: psci_runtime_quiet() invalidates it */
+volatile struct {
+    bool on;
+    u8 pad[63];
+} psci_runtime_line __attribute__((aligned(64)));
+#define psci_runtime (psci_runtime_line.on)
+
+/* What the RVBAR re-entry needs, cleaned to the PoC: it runs with the MMU and caches off */
+volatile struct {
+    u64 magic, entry, context, start, frq;
+    u32 basew[2];
+} psci_resume __attribute__((aligned(64), used));
+
+static u64 wake_hw_word(unsigned i)
+{
+    return aic->base + aic->regs.mask_clr + 4 * (aic->max_irq >> 5) + 4 * (wake_irq[i] >> 5);
+}
+
+/* The wake line that newly asserted since entry, or -1 */
+static int psci_wake_line(void)
+{
+    for (unsigned i = 0; i < 2; i++) {
+        u32 w = read32(wake_hw_word(i)) & BIT(wake_irq[i] & 31);
+        if (w & ~psci_resume.basew[i])
+            return wake_irq[i];
+    }
+    return -1;
+}
+
+static void psci_sleep_core(void)
+{
+    /*
+     * Deep WFI with state retention (WFI_MODE 3, retention left on). Images 32 to 36 also set DISABLE_WFI_RET:
+     * the core then never came back (not even to the first instruction at RVBAR), so the AIC wake does not
+     * restart a core powered down without retention. The RVBAR resume path stays as a backstop.
+     */
+    /* image 42: deep_wfi() with the CYC_OVRD write synchronized (isb) before the WFI */
+    u64 cyc_ovrd = mrs(SYS_IMP_APL_CYC_OVRD);
+
+    msr(SYS_IMP_APL_CYC_OVRD, cyc_ovrd | CYC_OVRD_WFI_MODE(3));
+    sysop("isb");
+    extern void _deep_wfi_helper(void);
+    _deep_wfi_helper();
+    msr(SYS_IMP_APL_CYC_OVRD, cyc_ovrd);
+}
+
+static void __attribute__((noreturn)) psci_resume_kernel(int line, int via_rvbar)
+{
+    u64 now;
+
+    for (unsigned i = 0; i < 2; i++)
+        write32(aic->base + aic->regs.mask_set + 4 * (wake_irq[i] >> 5), BIT(wake_irq[i] & 31));
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(now));
+    if (!via_rvbar)
+        wdt_psci_disarm();
+    psci_resume.magic = 0;
+    smp_psci_s2r_clear();
+    psci_quiesce_undo();
+    if (via_rvbar)
+        wdt_psci_arm(RESUME_WDT_S); /* stage 2: reset unless the kernel's resume takes over its watchdog */
+    psci_dbg[3] = 1;
+    psci_dbg[4] = line;
+    psci_dbg[5] = now - psci_resume.start;
+    /* 2: the core lost its state and came back through RVBAR; 3: the same with no wake line (S2R) */
+    psci_dbg[13] = via_rvbar ? (line < 0 ? 3 : 2) : 1;
+    psci_dbg[15] = mrs(SYS_IMP_APL_CYC_OVRD);
+    psci_dbg[0] = 0xA0AA0001;
+    dc_civac_range((void *)&psci_resume, sizeof(psci_resume));
+    dc_civac_range((void *)psci_dbg, sizeof(psci_dbg));
+    psci_enter(psci_resume.entry, psci_resume.context);
+}
+
+bool psci_runtime_quiet(void)
+{
+    dc_ivac_range((void *)&psci_runtime, sizeof(psci_runtime));
+    return psci_runtime;
+}
+
+bool psci_suspend_resuming(void)
+{
+    dc_ivac_range((void *)&psci_resume, sizeof(psci_resume));
+    return psci_resume.magic == RESUME_MAGIC;
+}
+
+/* RVBAR re-entry of the boot CPU from psci_system_suspend(), after init_cpu() and exception_initialize() */
+void __attribute__((noreturn)) psci_suspend_rvbar(void)
+{
+    int line;
+
+    asm volatile("msr daifset, #0xf\n isb" ::: "memory");
+    /*
+     * stage 1: reset 10 s from here. The time to the reset tells how far the RVBAR path got: 10 s and 150 s
+     * (stage 2) are unlike every other dog (120 s) and the SMC's own reset, so a reset time names its stage.
+     */
+    wdt_psci_arm(RVBAR_WDT_S);
+    dc_ivac_range((void *)psci_dbg, sizeof(psci_dbg));
+    psci_dbg[12]++;
+    /*
+     * A boot CPU back through RVBAR with the resume magic set had its power cut: by the SoC's S2R (the
+     * reconfig engine restarts it on a wake source) or a core power-down. After S2R the AIC has lost its
+     * state, so no wake line shows; resume the kernel anyway (line -1, psci_dbg[13] 3) and let its AIC
+     * restore and drivers take over. Stage 2 (RESUME_WDT_S) resets the Mac if the kernel's resume hangs.
+     */
+    line = psci_wake_line();
+    psci_resume_kernel(line, 1);
+}
+
+static unsigned long psci_system_suspend(unsigned long entry, unsigned long context)
+{
+    u64 now, hcr, daif;
+    int line;
+
+    wdt_psci_arm(SUSPEND_WDT_S);
+    asm volatile("mrs %0, hcr_el2" : "=r"(hcr));
+    asm volatile("mrs %0, daif" : "=r"(daif));
+    for (unsigned i = 0; i < 24; i++)
+        psci_dbg[i] = 0;
+    psci_dbg[1] = hcr;
+    psci_dbg[2] = daif;
+    psci_dbg[14] = mrs(SYS_IMP_APL_CYC_OVRD);
+    dc_ivac_range((void *)psci_ctl, sizeof(psci_ctl));
+    u64 steps = psci_ctl[1] & (PSCI_S2R_TIMER | PSCI_S2R_CORESOFF | PSCI_S2R_DOMAINS | PSCI_S2R_CLOCKS | PSCI_S2R_CLUSTERS | PSCI_S2R_STOPREQ | PSCI_S2R_HELD | PSCI_S2R_REC | PSCI_S2R_AMCC | PSCI_S2R_STOPWD2 | PSCI_S2R_AICMASK | PSCI_S2R_WD1OFF | PSCI_S2R_RESUMENOW);
+    for (unsigned i = 0; i < 48; i++)
+        psci_dbg2[i] = 0;
+    psci_dbg2[1] = steps | ((u64)qs_amcc_n << 32) | ((u64)qs_amcc_planes << 40);
+    if (steps & PSCI_S2R_REC) {
+        qs_rec_wdt(2);
+        qs_rec_amcc(26);
+        for (int i = 0; i < qs_amcc_n && i < 4; i++)
+            psci_dbg2[34 + i] = ((u64)read32(AMCC_EN(qs_amcc_base[i], 0, 1)) << 32) | read32(AMCC_EN(qs_amcc_base[i], 0, 0));
+    }
+    qs_held_mask = (psci_ctl[2] & 0xfff) ? (psci_ctl[2] & 0xfff) : 0xfff;
+    psci_dbg[17] = 0x5300000000ULL | (psci_ctl[1] & 0xffffffff); /* the control word this suspend read */
+
+    if (!aic || aic->version != 2) {
+        psci_dbg[3] = 2;
+        wdt_psci_disarm();
+        psci_dbg[0] = 0xA0AA0001;
+        dc_civac_range((void *)psci_dbg, sizeof(psci_dbg));
+        psci_enter(entry, context);
+    }
+
+    psci_resume.entry = entry;
+    psci_resume.context = context;
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(psci_resume.frq));
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(psci_resume.start));
+    /* Ignore wake sources for the first SUSPEND_MIN_MS (Linux is still finishing its own suspend work) */
+    do {
+        asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(now));
+    } while (now - psci_resume.start < psci_resume.frq / 1000 * SUSPEND_MIN_MS);
+
+    for (unsigned i = 0; i < 2; i++)
+        psci_resume.basew[i] = read32(wake_hw_word(i)) & BIT(wake_irq[i] & 31);
+    psci_dbg[11] = 0x100000000UL | psci_resume.basew[0] | ((u64)psci_resume.basew[1] << 16);
+    psci_resume.magic = RESUME_MAGIC;
+
+    /*
+     * All of DAIF masked (WFI still wakes on a pending interrupt, and Linux's vectors never run); the wake lines
+     * unmasked at the AIC for the wait and masked again afterwards as Linux's syscore suspend left them. A line
+     * already asserted would end every WFI at once, so it stays masked.
+     */
+    asm volatile("msr daifset, #0xf\n isb" ::: "memory");
+    for (unsigned i = 0; i < 2; i++)
+        if (!psci_resume.basew[i])
+            write32(aic->base + aic->regs.mask_clr + 4 * (wake_irq[i] >> 5), BIT(wake_irq[i] & 31));
+    /*
+     * The RVBAR path runs with the MMU and caches off and so reads DRAM directly: every global it touches
+     * (boot_cpu_mpidr for is_boot_cpu(), the watchdog and AIC bases, cpu_features, the reset stacks, this
+     * state) must be in memory, and nothing of the image may stay cached to shadow what it writes there.
+     * Clean and invalidate the whole resident image, code to end of BSS.
+     */
+    /* image 39: the whole-image clean (images 35 to 38) is left out: 37 and 38 hung with it, 31 passed without */
+    dc_civac_range((void *)&psci_resume, sizeof(psci_resume));
+
+    /* the S2R steps, in macOS's order: quiesceHW's domains and clocks, its S2R timer last, then every core */
+    if (steps & PSCI_S2R_HELD)
+        psci_quiesce_held();
+    if (steps & PSCI_S2R_DOMAINS)
+        psci_quiesce_domains();
+    if (steps & PSCI_S2R_CLUSTERS)
+        psci_quiesce_clusters();
+    if (steps & PSCI_S2R_CLOCKS)
+        psci_quiesce_clocks();
+    if (steps & PSCI_S2R_AMCC)
+        psci_quiesce_amcc();
+    if (steps & PSCI_S2R_REC) {
+        qs_rec_wdt(8);
+        qs_rec_amcc(30);
+    }
+    /*
+     * Image 59: macOS enters with every AON watchdog's ctl at 0 (t8103 and T8140 traces; 13.5's AppleARMWatchdogTimer
+     * sleep action leaves WD1 alone and clears WD0 and reg 3's low byte, both already 0 here). Aura's WD1 has been armed
+     * (120 s) through every entry so far. The timer's own reset stays as the safety net.
+     */
+    if ((steps & PSCI_S2R_WD1OFF) && (steps & PSCI_S2R_TIMER)) {
+        wdt_psci_disarm();
+        psci_dbg2[45] = 0x5100000000ULL | 1;
+    }
+    if (steps & PSCI_S2R_TIMER) {
+        write32(MPMGR_AON_S2R_TIMER, 1);
+        sysop("dsb sy");
+        psci_dbg[18] = 1;
+        if (steps & PSCI_S2R_REC)
+            qs_rec_wdt(14);
+        if (steps & PSCI_S2R_REC || steps & PSCI_S2R_STOPWD2) {
+            udelay(100000);
+            qs_rec_wdt(20);
+        }
+        if (steps & PSCI_S2R_STOPWD2) {
+            u64 wdt = wdt_psci_base();
+            if (wdt) {
+                write32(wdt + 0x2c, 0);
+                sysop("dsb sy");
+                psci_dbg2[44] = 0x5700000000ULL | read32(wdt + 0x2c);
+            }
+        }
+        if ((steps & PSCI_S2R_AICMASK) && (steps & PSCI_S2R_CORESOFF))
+            psci_quiesce_aic();
+    }
+    psci_dbg2[0] = 0xA0AA0002;
+    dc_civac_range((void *)psci_dbg2, sizeof(psci_dbg2));
+    /* image 59: straight back to the kernel after the timer (no cores off): Linux logs the watchdogs until the reset */
+    if ((steps & PSCI_S2R_RESUMENOW) && (steps & PSCI_S2R_TIMER) && !(steps & PSCI_S2R_CORESOFF)) {
+        asm volatile("msr daifset, #0xf\n isb" ::: "memory");
+        psci_resume_kernel(-1, 0);
+    }
+    if (steps & PSCI_S2R_CORESOFF) {
+        psci_dbg[0] = 0xA0AA0001;
+        dc_civac_range((void *)psci_dbg, sizeof(psci_dbg));
+        smp_psci_release_parked(steps & PSCI_S2R_STOPREQ); /* the secondaries go first, as macOS's stall release */
+        udelay(2000);
+        dcsw_op_all(DCSW_OP_DCCISW);
+        sysop("dsb sy");
+        cpu_sleep(true); /* back only through RVBAR: psci_suspend_rvbar() */
+    }
+
+    u64 hb_ctl = mrs(SYS_CNTHP_CTL_EL2), hb_cval = mrs(SYS_CNTHP_CVAL_EL2), hb_next;
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(now));
+    hb_next = now + psci_resume.frq * SUSPEND_HB_S;
+    msr(SYS_CNTHP_CVAL_EL2, hb_next);
+    msr(SYS_CNTHP_CTL_EL2, CNTx_CTL_ENABLE);
+    sysop("isb");
+    for (;;) {
+        psci_sleep_core();
+        psci_dbg[12]++;
+        if ((line = psci_wake_line()) >= 0)
+            break;
+        asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(now));
+        if (now >= hb_next) {
+            wdt_psci_arm(SUSPEND_WDT_S);
+            psci_dbg[16]++;
+            hb_next = now + psci_resume.frq * SUSPEND_HB_S;
+            msr(SYS_CNTHP_CVAL_EL2, hb_next);
+            sysop("isb");
+        }
+    }
+    msr(SYS_CNTHP_CTL_EL2, hb_ctl);
+    msr(SYS_CNTHP_CVAL_EL2, hb_cval);
+    sysop("isb");
+    psci_resume_kernel(line, 0);
+}
