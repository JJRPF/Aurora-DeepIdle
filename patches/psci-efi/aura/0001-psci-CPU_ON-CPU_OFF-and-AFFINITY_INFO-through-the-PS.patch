diff --git a/src/kboot.c b/src/kboot.c
index 070d90e6..ec854c3d 100644
--- a/src/kboot.c
+++ b/src/kboot.c
@@ -23,6 +23,7 @@
 #include "memory.h"
 #include "pcie.h"
 #include "pmgr.h"
+#include "psci.h"
 #include "sep.h"
 #include "sio.h"
 #include "smp.h"
@@ -707,6 +708,54 @@ static int dt_set_smbios(void)
     return 0;
 }
 
+/*
+ * PSCI-via-EFI (psci.c): only when the payload's DT asks for it with
+ * psci { method = "efi"; }, tell the EFI provider (U-Boot) what to publish:
+ *   aura,psci-table         physical address of struct psci_efi_table, for the
+ *                           LINUX_EFI_ARM_PSCI_HANDLER_TABLE configuration table
+ *   aura,psci-runtime-code  <base size> of this image (handler, data, stacks),
+ *                           to map as EFI runtime services code
+ *   aura,psci-runtime-mmio  <base size>... the MMIO the handler touches, to map
+ *                           as EFI runtime MMIO (Device-nGnRnE)
+ * The kernel must boot with efi=novamap: the handler pointer and everything it
+ * uses are physical addresses, so the runtime map has to be 1:1.
+ */
+static int dt_set_psci(void)
+{
+    int psci = fdt_path_offset(dt, "/psci");
+    if (psci < 0)
+        return 0;
+
+    const char *method = fdt_getprop(dt, psci, "method", NULL);
+    if (!method || strcmp(method, "efi"))
+        return 0;
+
+    int node = fdt_path_offset(dt, "/chosen");
+    if (node < 0)
+        bail("FDT: /chosen node not found in devtree\n");
+
+    if (fdt_setprop_u64(dt, node, "aura,psci-table", (u64)&psci_efi_table))
+        bail("FDT: couldn't set aura,psci-table\n");
+
+    u64 base = ALIGN_DOWN((u64)_base, SZ_16K);
+    u64 end = ALIGN_UP((u64)_end, SZ_16K);
+    fdt64_t code[2] = {cpu_to_fdt64(base), cpu_to_fdt64(end - base)};
+    if (fdt_setprop(dt, node, "aura,psci-runtime-code", code, sizeof(code)))
+        bail("FDT: couldn't set aura,psci-runtime-code\n");
+
+    u64 ranges[2 * 16];
+    int n = smp_psci_mmio_ranges(ranges, 16);
+    fdt64_t mmio[2 * 16];
+    for (int i = 0; i < 2 * n; i++)
+        mmio[i] = cpu_to_fdt64(ranges[i]);
+    if (fdt_setprop(dt, node, "aura,psci-runtime-mmio", mmio, 2 * n * sizeof(fdt64_t)))
+        bail("FDT: couldn't set aura,psci-runtime-mmio\n");
+
+    printf("FDT: PSCI-via-EFI table at %p, image 0x%lx..0x%lx, %d MMIO ranges\n",
+           &psci_efi_table, base, end, n);
+    return 0;
+}
+
 static int dt_set_cpus(void)
 {
     int ret = 0;
@@ -4732,6 +4781,8 @@ int kboot_prepare_dt(void *fdt)
         return -1;
     if (dt_set_cpus())
         return -1;
+    if (dt_set_psci())
+        return -1;
     if (dt_set_mac_addresses())
         return -1;
     if (dt_set_wifi())
