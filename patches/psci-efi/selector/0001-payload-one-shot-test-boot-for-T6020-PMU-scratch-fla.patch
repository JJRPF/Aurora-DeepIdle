From 22cbe6fe0be89ad6bdd8c5d7c22821c2c6763508 Mon Sep 17 00:00:00 2001
From: Justin Pfister <git@jjrpf.com>
Date: Tue, 10 Nov 2026 06:45:10 -0500
Subject: [PATCH] payload: one-shot test boot for T6020 (PMU scratch flag,
 watchdog, chainload m1n1/boot-test.bin)

---
 src/payload.c | 74 +++++++++++++++++++++++++++++++++++++++++++++++++++
 src/wdt.c     | 17 ++++++++++++
 src/wdt.h     |  2 ++
 3 files changed, 93 insertions(+)

diff --git a/src/payload.c b/src/payload.c
index 035968ba..0553bfdc 100644
--- a/src/payload.c
+++ b/src/payload.c
@@ -17,6 +17,9 @@
 #include "mitigations.h"
 #include "nvme.h"
 #include "smp.h"
+#include "soc.h"
+#include "spmi.h"
+#include "wdt.h"
 #include "stage1_config.h"
 #include "utils.h"
 
@@ -376,6 +379,72 @@ bool payload_logo(void **custom_128, void **custom_256)
     return false;
 }
 
+#ifdef ESP_STAGE2
+/*
+ * DeepIdle one-shot test boot (Aurora-DeepIdle GH-5), T6020 only.
+ *
+ * Linux sets PMU legacy scratch key 0x10 (register 0x6010 of the PMU at SPMI address 0xb, a free key that a
+ * SoC reset does not touch) to 0xa5. This stage 2 then clears the byte, starts the watchdog and chainloads
+ * m1n1/boot-test.bin from the ESP instead of booting its own payloads. The flag is cleared before the test
+ * image is read, so whatever the test image does, the next boot is the normal one, and a test chain that
+ * hangs anywhere is reset by the watchdog. Without the flag the only difference from the stock image is one
+ * SPMI read with bounded waits.
+ */
+#define ONESHOT_PMU_ADDR 0xb
+#define ONESHOT_REG      0x6010
+#define ONESHOT_MAGIC    0xa5
+#define ONESHOT_WDT_S    120
+#define ONESHOT_ESP_VAR  "chosen.asahi,efi-system-partition="
+
+static int oneshot_test_boot(void)
+{
+    static bool tried;
+    static char spec[160];
+    const char *esp = NULL;
+    u8 v = 0, zero = 0;
+
+    if (tried || chip_id != T6020)
+        return -1;
+    tried = true;
+
+    spmi_dev_t *spmi = spmi_init("/arm-io/nub-spmi0");
+    if (!spmi)
+        return -1;
+    if (spmi_ext_read_long(spmi, ONESHOT_PMU_ADDR, ONESHOT_REG, &v, 1) < 0 || v != ONESHOT_MAGIC) {
+        spmi_shutdown(spmi);
+        return -1;
+    }
+    /* One shot: no test boot unless the flag is seen to be gone. */
+    v = 0xff;
+    if (spmi_ext_write_long(spmi, ONESHOT_PMU_ADDR, ONESHOT_REG, &zero, 1) < 0 ||
+        spmi_ext_read_long(spmi, ONESHOT_PMU_ADDR, ONESHOT_REG, &v, 1) < 0 || v != 0) {
+        printf("oneshot: could not clear the flag, normal boot\n");
+        spmi_shutdown(spmi);
+        return -1;
+    }
+    spmi_shutdown(spmi);
+
+    for (size_t i = 0; i < chosen_cnt; i++)
+        if (!strncmp(chosen[i], ONESHOT_ESP_VAR, sizeof(ONESHOT_ESP_VAR) - 1))
+            esp = chosen[i] + sizeof(ONESHOT_ESP_VAR) - 1;
+    if (!esp || strlen(esp) > 64) {
+        printf("oneshot: no ESP from stage 1, normal boot\n");
+        return -1;
+    }
+    snprintf(spec, sizeof(spec), "%s;m1n1/boot-test.bin", esp);
+    printf("oneshot: flag was set, watchdog %d s, chainloading %s\n", ONESHOT_WDT_S, spec);
+    wdt_arm_raw(ONESHOT_WDT_S);
+    next_stage.entry = NULL;
+    if (chainload_load(spec, chosen, &chosen_cnt, ARRAY_SIZE(chosen)) || !next_stage.entry) {
+        printf("oneshot: chainload failed, normal boot\n");
+        next_stage.entry = NULL;
+        wdt_stop_raw();
+        return -1;
+    }
+    return 0;
+}
+#endif
+
 int payload_run(void)
 {
     const char *target = adt_getprop(adt, 0, "target-type", NULL);
@@ -420,6 +489,11 @@ int payload_run(void)
     }
 #endif
 
+#ifdef ESP_STAGE2
+    if (!oneshot_test_boot())
+        return 0;
+#endif
+
     if (chainload_spec && boot_spec) {
         printf("Payload: cannot combine boot= and chainload=\n");
         next_stage.entry = NULL;
diff --git a/src/wdt.c b/src/wdt.c
index 333c0d4c..3c5e3979 100644
--- a/src/wdt.c
+++ b/src/wdt.c
@@ -48,6 +48,23 @@ void wdt_disable(void)
     }
 }
 
+/* DeepIdle one-shot test boot: (re)start the primary watchdog; wdt_disable() has found the base. */
+void wdt_arm_raw(unsigned seconds)
+{
+    if (!wdt_base)
+        return;
+    write32(wdt_base + WDT_CTL, 0);
+    write32(wdt_base + WDT_COUNT, 0);
+    write32(wdt_base + WDT_ALARM, seconds * 24000000u);
+    write32(wdt_base + WDT_CTL, 4);
+}
+
+void wdt_stop_raw(void)
+{
+    if (wdt_base)
+        write32(wdt_base + WDT_CTL, 0);
+}
+
 void wdt_reboot(void)
 {
     if (!wdt_base)
diff --git a/src/wdt.h b/src/wdt.h
index 855f9bb3..8ef5d0be 100644
--- a/src/wdt.h
+++ b/src/wdt.h
@@ -5,6 +5,8 @@
 
 void wdt_disable(void);
 void wdt_reboot(void);
+void wdt_arm_raw(unsigned seconds);
+void wdt_stop_raw(void);
 int wdt_arm_seconds(unsigned seconds);
 
 #endif
-- 
2.56.0

