diff --git i/drivers/soc/apple/pm_shim.c w/drivers/soc/apple/pm_shim.c
index 884ecbb354a0..1a37575c13a8 100644
--- i/drivers/soc/apple/pm_shim.c
+++ w/drivers/soc/apple/pm_shim.c
@@ -6,16 +6,74 @@
  * across sleep.
  */
 #include <linux/compiler.h>
+#include <linux/delay.h>
+#include <linux/io.h>
 #include <linux/device.h>
 #include <linux/notifier.h>
 #include <linux/of.h>
 #include <linux/pm_domain.h>
+#include <linux/moduleparam.h>
 #include <linux/suspend.h>
 
 #include "shim.h"
 
 static void (*sep_pm_event)(bool entering);
 
+/*
+ * TEST (GH-8): when nonzero, the enclave is sent macOS's SLEEP control message
+ * (type 0x0c, this value as the sleep type) once the system is about to
+ * suspend. Writable at run time; for runs that end in a reset only.
+ */
+static int test_sleep_msg;
+module_param(test_sleep_msg, int, 0644);
+MODULE_PARM_DESC(test_sleep_msg, "TEST: send the enclave SLEEP with this type before a suspend (0 = off)");
+
+int sep_pm_test_sleep_msg(void)
+{
+	return READ_ONCE(test_sleep_msg);
+}
+
+/*
+ * TEST (GH-8): with test_sleep_msg also set, after the SLEEP do what macOS 15.6.1
+ * does next (maralcbr's J314s trace): clear the mailbox OUTBOX_CTRL enable bit and
+ * hand ps_sep to the PMGR with PS_AUTO 0 (0x1000030f), so it can gate the enclave.
+ * J414s (T6020) addresses only; nothing turns it back on, so reset-ending runs only.
+ */
+static bool test_sleep_psoff;
+module_param(test_sleep_psoff, bool, 0644);
+MODULE_PARM_DESC(test_sleep_psoff, "TEST: after the SLEEP, clear OUTBOX_CTRL enable and set ps_sep to 0x1000030f (J414s)");
+
+#define TEST_SEP_MBOX	0x396408000ULL
+#define TEST_PS_SEP	0x290280c00ULL
+
+static void sep_pm_test_psoff(void)
+{
+	void __iomem *mb = ioremap_np(TEST_SEP_MBOX, 0x1000);
+	void __iomem *ps = ioremap_np(TEST_PS_SEP & PAGE_MASK, PAGE_SIZE);
+	void __iomem *r;
+	u32 ctl, before;
+	int t;
+
+	if (!mb || !ps)
+		goto out;
+	r = ps + (TEST_PS_SEP & ~PAGE_MASK);
+	ctl = readl(mb + 0x114);
+	writel(ctl & ~BIT(0), mb + 0x114);
+	before = readl(r);
+	writel(0x1000030f, r);
+	pr_info("apple_sep: TEST PSOFF: outbox ctrl %08x -> %08x, ps_sep %08x -> %08x\n",
+		ctl, readl(mb + 0x114), before, readl(r));
+	for (t = 10; t <= 100; t += 10) {
+		mdelay(10);
+		pr_info("apple_sep: TEST PSOFF: +%d ms ps_sep %08x\n", t, readl(r));
+	}
+out:
+	if (mb)
+		iounmap(mb);
+	if (ps)
+		iounmap(ps);
+}
+
