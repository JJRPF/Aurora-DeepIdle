+/// TEST (GH-8): macOS 13.5's `AppleSEPControl::cmsgSLEEP` as `AppleSEPManager::_sleepSEPAsync`
+/// sends it before system sleep: type 0x0c, param = the sleep type (2; 3 in one platform mode),
+/// data 0. The 15000 ms there is the reply timeout (times a multiplier of 1 outside simulators).
+pub(crate) fn op_sleep(sleep_type: u8) -> ControlOp {
+    ControlOp {
+        ty: 0x0c,
+        param: sleep_type,
+        data: 0,
+        expect_reply: true,
+        timeout_ms: 15000,
+        reserved_tag: false,
+        name: c"SLEEP",
+    }
+}
