From 611d83b1c1fccb2543b6167d8729a17f6eb58c2b Mon Sep 17 00:00:00 2001
From: Justin Pfister <119864532+JJRPF@users.noreply.github.com>
Date: Mon, 19 Oct 2026 18:40:23 -0400
Subject: [PATCH 2/2] rtc: macsmc: clear the PMU's alarm-fired bit when arming

When the alarm goes off the PMU clears the enable bit (0x1401 bit 6) and
sets bit 1 of the same byte. While bit 1 stays set, the next alarm still
clears the enable bit at its second but sets no event and raises no
interrupt. The first version wrote bit 6 alone, through a one-bit NVMEM
cell, so only the first alarm after boot worked: in the smoke test the
awake alarm fired and the three rtcwake s2idle cycles after it slept
until the owner touched the machine (10.1 h, 39 min, 16 min).

Checked on the J414s with the handler unbound: with bit 1 set, the alarm
second clears 0x40 and nothing else happens; after writing 0x01 to the
byte, the same alarm sets the event bit and SPMI interrupt 2 again. With
bit 1 clear, an rtcwake-style s2idle woke on the alarm after 30.1 s
(pm_wakeup_irq = the RTC's interrupt) ahead of a 90 s backup timer.

The cell becomes the whole control byte; arming and disarming clear
bits 6 and 1 and leave the rest (bit 0 reads 1, meaning unknown) as
found.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AuzUDcEeRJQ6RCdWW2XWLb
---
 .../bindings/rtc/apple,smc-rtc.yaml           |  6 ++--
 arch/arm64/boot/dts/apple/t602x-die0.dtsi     |  7 ++--
 drivers/rtc/rtc-macsmc.c                      | 32 ++++++++++++++-----
 3 files changed, 31 insertions(+), 14 deletions(-)

diff --git a/Documentation/devicetree/bindings/rtc/apple,smc-rtc.yaml b/Documentation/devicetree/bindings/rtc/apple,smc-rtc.yaml
index 233912de2342..c00ece36e76d 100644
--- a/Documentation/devicetree/bindings/rtc/apple,smc-rtc.yaml
+++ b/Documentation/devicetree/bindings/rtc/apple,smc-rtc.yaml
@@ -29,7 +29,9 @@ properties:
       - description:
           PMU alarm time, a 32bit little-endian count of the RTC counter's
           whole seconds.
-      - description: PMU alarm enable bit.
+      - description:
+          PMU alarm control byte, with the alarm enable bit (bit 6) and the
+          bit the PMU sets when the alarm fires (bit 1).
       - description: PMU alarm event byte, bit 0 set when the alarm fired,
           cleared by writing 1.
       - description: PMU alarm interrupt mask bit, 1 masks the interrupt.
@@ -39,7 +41,7 @@ properties:
     items:
       - const: rtc_offset
       - const: rtc_alarm
-      - const: rtc_alarm_en
+      - const: rtc_alarm_ctrl
       - const: rtc_alarm_event
       - const: rtc_alarm_irq_mask
 
diff --git a/arch/arm64/boot/dts/apple/t602x-die0.dtsi b/arch/arm64/boot/dts/apple/t602x-die0.dtsi
index 98fdcea85d09..29b694304956 100644
--- a/arch/arm64/boot/dts/apple/t602x-die0.dtsi
+++ b/arch/arm64/boot/dts/apple/t602x-die0.dtsi
@@ -325,9 +325,8 @@ nvmem-layout {
 				#address-cells = <1>;
 				#size-cells = <1>;
 
-				rtc_alarm_en: rtc-alarm-en@1401,6 {
+				rtc_alarm_ctrl: rtc-alarm-ctrl@1401 {
 					reg = <0x1401 0x1>;
-					bits = <6 1>;
 				};
 
 				pm_setting: pm-setting@1405 {
@@ -433,9 +432,9 @@ smc_hwmon: hwmon {
 
 		rtc {
 			compatible = "apple,smc-rtc";
-			nvmem-cells = <&rtc_offset>, <&rtc_alarm>, <&rtc_alarm_en>,
+			nvmem-cells = <&rtc_offset>, <&rtc_alarm>, <&rtc_alarm_ctrl>,
 				<&rtc_alarm_event>, <&rtc_alarm_irq_mask>;
-			nvmem-cell-names = "rtc_offset", "rtc_alarm", "rtc_alarm_en",
+			nvmem-cell-names = "rtc_offset", "rtc_alarm", "rtc_alarm_ctrl",
 				"rtc_alarm_event", "rtc_alarm_irq_mask";
 			/* The PMU alarm, SPMI peripheral interrupt 2 */
 			interrupts-extended = <&nub_spmi0 2 IRQ_TYPE_EDGE_RISING>;
diff --git a/drivers/rtc/rtc-macsmc.c b/drivers/rtc/rtc-macsmc.c
index 1af95c8f5cc7..d3425dd72488 100644
--- a/drivers/rtc/rtc-macsmc.c
+++ b/drivers/rtc/rtc-macsmc.c
@@ -26,6 +26,15 @@
 /* Offset kept as a 64-bit little-endian count of whole seconds */
 #define RTC_OFFSET_SECS_BYTES 8
 
+/*
+ * PMU alarm control byte. The PMU clears ALARM_EN and sets ALARM_FIRED when
+ * the alarm goes off; until ALARM_FIRED is cleared again, a later alarm
+ * still clears ALARM_EN at its second but raises no event and no interrupt.
+ * Bit 0 is left as found.
+ */
+#define RTC_ALARM_FIRED BIT(1)
+#define RTC_ALARM_EN BIT(6)
+
 struct macsmc_rtc {
 	struct device *dev;
 	struct apple_smc *smc;
@@ -37,7 +46,7 @@ struct macsmc_rtc {
 	 * whole seconds (CLKM >> 15) at which to fire, 32 bits wide.
 	 */
 	struct nvmem_cell *alarm;		/* u32 LE, counter seconds */
-	struct nvmem_cell *alarm_en;		/* one bit: alarm enabled */
+	struct nvmem_cell *alarm_ctrl;		/* u8, RTC_ALARM_* */
 	struct nvmem_cell *alarm_event;		/* bit 0: fired, write 1 to clear */
 	struct nvmem_cell *alarm_irq_mask;	/* one bit: 1 = masked */
 };
@@ -193,13 +202,20 @@ static int macsmc_rtc_alarm_irq_enable(struct device *dev, unsigned int enabled)
 	struct macsmc_rtc *rtc = dev_get_drvdata(dev);
 	int ret;
 
+	u8 ctrl;
+
+	ret = macsmc_rtc_read_u8(rtc->alarm_ctrl, &ctrl);
+	if (ret)
+		return ret;
+	ctrl &= ~(RTC_ALARM_EN | RTC_ALARM_FIRED);
+
 	/* The order AppleDialogSPMIPMURTC uses: unmask, then enable */
 	if (enabled) {
 		ret = macsmc_rtc_write_u8(rtc->alarm_irq_mask, 0);
 		if (!ret)
-			ret = macsmc_rtc_write_u8(rtc->alarm_en, 1);
+			ret = macsmc_rtc_write_u8(rtc->alarm_ctrl, ctrl | RTC_ALARM_EN);
 	} else {
-		ret = macsmc_rtc_write_u8(rtc->alarm_en, 0);
+		ret = macsmc_rtc_write_u8(rtc->alarm_ctrl, ctrl);
 		if (!ret)
 			ret = macsmc_rtc_write_u8(rtc->alarm_irq_mask, 1);
 	}
@@ -211,7 +227,7 @@ static int macsmc_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *wkalrm)
 	struct macsmc_rtc *rtc = dev_get_drvdata(dev);
 	u32 ctr_secs, alarm;
 	time64_t now;
-	u8 en, ev;
+	u8 ctrl, ev;
 	size_t len;
 	void *p;
 	int ret;
@@ -230,14 +246,14 @@ static int macsmc_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *wkalrm)
 	alarm = get_unaligned_le32(p);
 	kfree(p);
 
-	ret = macsmc_rtc_read_u8(rtc->alarm_en, &en);
+	ret = macsmc_rtc_read_u8(rtc->alarm_ctrl, &ctrl);
 	if (!ret)
 		ret = macsmc_rtc_read_u8(rtc->alarm_event, &ev);
 	if (ret)
 		return ret;
 
 	rtc_time64_to_tm(now + (s32)(alarm - ctr_secs), &wkalrm->time);
-	wkalrm->enabled = en & 1;
+	wkalrm->enabled = !!(ctrl & RTC_ALARM_EN);
 	wkalrm->pending = ev & 1;
 	return 0;
 }
@@ -316,10 +332,10 @@ static int macsmc_rtc_init_alarm(struct platform_device *pdev,
 		return 0;
 
 	rtc->alarm = devm_nvmem_cell_get(dev, "rtc_alarm");
-	rtc->alarm_en = devm_nvmem_cell_get(dev, "rtc_alarm_en");
+	rtc->alarm_ctrl = devm_nvmem_cell_get(dev, "rtc_alarm_ctrl");
 	rtc->alarm_event = devm_nvmem_cell_get(dev, "rtc_alarm_event");
 	rtc->alarm_irq_mask = devm_nvmem_cell_get(dev, "rtc_alarm_irq_mask");
-	if (IS_ERR(rtc->alarm) || IS_ERR(rtc->alarm_en) ||
+	if (IS_ERR(rtc->alarm) || IS_ERR(rtc->alarm_ctrl) ||
 	    IS_ERR(rtc->alarm_event) || IS_ERR(rtc->alarm_irq_mask)) {
 		dev_warn(dev, "alarm interrupt without its NVMEM cells, no alarm\n");
 		return 0;
-- 
