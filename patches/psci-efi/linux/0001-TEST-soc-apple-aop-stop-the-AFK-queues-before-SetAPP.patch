From 17be3e270921baacb0502b520535eae1292ca24e Mon Sep 17 00:00:00 2001
From: Justin Pfister <119864532+JJRPF@users.noreply.github.com>
Date: Thu, 5 Nov 2026 22:24:54 -0500
Subject: [PATCH] TEST: soc: apple: aop: stop the AFK queues before SetAPPower
 0x201, start them after 0x20, as macOS's AppleSPU

AppleSPU::_stopQueue sends 0xa4 to each endpoint and waits for 0x87
(_queueStopped) before RTBuddy signals the AP state; _startQueue sends
0xa3 and waits for 0x86. Without it the AOP crashed in its ring writer
right after acking 0x201, and CPUs 1-9 then failed to come online. The
0x201 is skipped if any endpoint does not acknowledge the stop.
---
 drivers/soc/apple/aop.rs | 89 ++++++++++++++++++++++++++++++++++++++--
 1 file changed, 86 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/apple/aop.rs b/drivers/soc/apple/aop.rs
index 10274b52e80b..1fe96faee211 100644
--- a/drivers/soc/apple/aop.rs
+++ b/drivers/soc/apple/aop.rs
@@ -102,6 +102,8 @@
 const AFK_OPC_INIT_UNK: u64 = 0x8c;
 const AFK_OPC_SEND: u64 = 0xa2;
 const AFK_OPC_START_ACK: u64 = 0x86;
+/// The AOP's answer to `AFK_MSG_STOP_QUEUE` (macOS 13.5 `AppleSPU::_asyncMessage` sets `_queueStopped` on it).
+const AFK_OPC_STOP_ACK: u64 = 0x87;
 const AFK_OPC_SHUTDOWN_ACK: u64 = 0xc1;
 const AFK_OPC_RECV: u64 = 0x85;
 const AFK_MSG_GET_BUF_ACK: u64 = 0xa1 << 48;
@@ -109,6 +111,10 @@
 const AFK_MSG_INIT_ACK: u64 = 0xa0 << 48;
 const AFK_MSG_START: u64 = 0xa3 << 48;
 const AFK_MSG_SHUTDOWN: u64 = 0xc0 << 48;
+/// System sleep: stop the endpoint's queue, its buffers kept (macOS 13.5 `AppleSPU::_stopQueue`; 0xc2 for
+/// hibernation). `AFK_MSG_START` starts it again (`AppleSPU::_startQueue`).
+const AFK_MSG_STOP_QUEUE: u64 = 0xa4 << 48;
+const AFK_QUEUE_TIMEOUT_MS: u32 = 1000;
 const AFK_RB_BLOCK_STEP: usize = 0x40;
 const EPIC_TYPE_NOTIFY: u32 = 0;
 const EPIC_CATEGORY_REPORT: u8 = 0x00;
@@ -446,7 +452,9 @@ fn recv_message(
                 self.recv_get_buf(client.dev.clone(), rtkit, msg)?;
             }
             AFK_OPC_INIT_UNK => {} // no-op
-            AFK_OPC_START_ACK => {}
+            AFK_OPC_START_ACK | AFK_OPC_STOP_ACK => {
+                client.queue_ack(self.index, opc);
+            }
             AFK_OPC_INIT_RX => {
                 if self.rxbuf.is_some() {
                     dev_err!(
@@ -1162,6 +1170,8 @@ unsafe impl Send for ChildDevice {}
 /// Set when the AOP acknowledged 0x201, so that 0x20 is sent only then (an RTKit firmware may panic when asked for
 /// the AP state it already has, as the PMP's does).
 static SLEEP_AP_IDLE: Atomic<bool> = Atomic::new(false);
+/// Set when the queues were stopped for sleep, so that they are started again after it.
+static SLEEP_QUEUES: Atomic<bool> = Atomic::new(false);
 // SAFETY (all uses): only the PM notifier chain touches the block, under its own lock.
 static mut SLEEP_NB: bindings::notifier_block = bindings::notifier_block {
     notifier_call: Some(aop_pm_notify),
@@ -1184,11 +1194,34 @@ unsafe impl Send for ChildDevice {}
         _ => return 0,
     };
     let data = SLEEP_AOP.load(CoreOrdering::Acquire);
-    if data.is_null() || (!entering && !SLEEP_AP_IDLE.xchg(false, Acquire)) {
+    if data.is_null() || (!entering && !SLEEP_QUEUES.xchg(false, Acquire)) {
         return 0;
     }
     // SAFETY: `remove` unregisters the notifier, which waits for a call in progress, before it drops the reference.
     let data = unsafe { &*data };
+    if entering {
+        // The AOP stops using the AP's buffers once told the AP is asleep: in the 2026-11-05 regressions it
+        // crashed in its ring writer 140 ms after the ack (a store through a bad pointer) while the queues ran.
+        let (total, acked) = data.set_queues(true);
+        SLEEP_QUEUES.store(true, Release);
+        dev_info!(data.dev, "TEST queues stopped for system sleep: {} of {}\n", acked, total);
+        if acked != total {
+            return 0;
+        }
+    }
+    aop_set_ap_power(data, entering);
+    if !entering {
+        let (total, acked) = data.set_queues(false);
+        dev_info!(data.dev, "TEST queues started after system sleep: {} of {}\n", acked, total);
+    }
+    0
+}
+
+/// `SetAPPower` 0x201 (`entering`) or 0x20 for system sleep; 0x20 only after an acknowledged 0x201.
+fn aop_set_ap_power(data: &AopData, entering: bool) -> c_int {
+    if !entering && !SLEEP_AP_IDLE.xchg(false, Acquire) {
+        return 0;
+    }
     let raw = match &*data.rtkit.lock() {
         Some(rtk) => rtk.as_raw(),
         None => return 0,
@@ -1201,7 +1234,7 @@ unsafe impl Send for ChildDevice {}
         SLEEP_AP_IDLE.store(true, Release);
     }
     dev_info!(data.dev, "TEST SetAPPower {:#x} for system sleep: {}\n", state, ret);
-    0
+    ret
 }
 
 impl ChildDevice {
@@ -1280,6 +1313,9 @@ struct AopData {
     call_turn: [Mutex<()>; AFK_ENDPOINT_COUNT as usize],
     #[pin]
     ep_shutdown: [FutureValue<()>; AFK_ENDPOINT_COUNT as usize],
+    /// The opcode of an endpoint's last start or stop acknowledgment, for system sleep.
+    #[pin]
+    ep_queue: [FutureValue<u64>; AFK_ENDPOINT_COUNT as usize],
     #[pin]
     hid_listeners: Mutex<KVec<ListenerEntry>>,
     #[pin]
@@ -1414,6 +1450,7 @@ fn new(dev: &platform::Device<Core<'_>>, cfg: &AopHwConfig) -> Result<Arc<AopDat
                     }),
                     call_turn <- pin_init::pin_init_array_from_fn(|_| new_mutex!(())),
                     ep_shutdown <- pin_init::pin_init_array_from_fn(|_| FutureValue::pin_init()),
+                    ep_queue <- pin_init::pin_init_array_from_fn(|_| FutureValue::pin_init()),
                     hid_listeners <- new_mutex!(KVec::new()),
                     report_listeners <- new_mutex!(KVec::new()),
                     source_ring <- new_mutex!(None),
@@ -1555,6 +1592,52 @@ fn shutdown_complete(&self, endpoint: u8) {
         }
     }
 
+    fn queue_ack(&self, endpoint: u8, opc: u64) {
+        if let Some(index) = afk_endpoint_index(endpoint) {
+            self.ep_queue[index].complete(opc);
+        }
+    }
+
+    /// TEST (S2R): stops (`stop`) or starts again every started endpoint's queue around system sleep, as macOS's
+    /// `AppleSPU` does before RTBuddy tells the AOP the AP is asleep. Waits for each acknowledgment outside the
+    /// `rtkit` lock, as `stop` does. Returns how many endpoints were handled and how many acknowledged.
+    fn set_queues(&self, stop: bool) -> (u32, u32) {
+        let (msg, ack) = if stop {
+            (AFK_MSG_STOP_QUEUE, AFK_OPC_STOP_ACK)
+        } else {
+            (AFK_MSG_START, AFK_OPC_START_ACK)
+        };
+        let (mut total, mut acked) = (0, 0);
+        for ep in 0..AFK_ENDPOINT_COUNT as usize {
+            let index = AFK_ENDPOINT_START + ep as u8;
+            {
+                let mut guard = self.rtkit.lock();
+                let Some(mut rtk) = guard.as_mut().as_pin_mut() else {
+                    return (total, acked);
+                };
+                if !self.endpoints[ep].lock().started {
+                    continue;
+                }
+                total += 1;
+                self.ep_queue[ep].reset();
+                if rtk.as_mut().send_message(index, msg).is_err() {
+                    continue;
+                }
+            }
+            match self.ep_queue[ep].wait_timeout(AFK_QUEUE_TIMEOUT_MS) {
+                Some(opc) if opc == ack => acked += 1,
+                got => dev_warn!(
+                    self.dev,
+                    "TEST endpoint {:#04x}: queue {} not acknowledged ({:?})\n",
+                    index,
+                    if stop { "stop" } else { "start" },
+                    got
+                ),
+            }
+        }
+        (total, acked)
+    }
+
     /// Shuts down every started endpoint, waiting a bounded time for each
     /// acknowledgment. Returns the first error but still tries the rest.
     fn stop(&self) -> Result<()> {
-- 
2.55.0

