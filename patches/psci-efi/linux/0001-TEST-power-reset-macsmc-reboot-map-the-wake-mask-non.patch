From bcc910953661a9b04cf58ef4dfad0091cb0e9abc Mon Sep 17 00:00:00 2001
From: Justin Pfister <119864532+JJRPF@users.noreply.github.com>
Date: Fri, 6 Nov 2026 16:01:54 -0500
Subject: [PATCH] TEST: power: reset: macsmc-reboot: map the wake mask
 non-posted (ioremap_np)

---
 drivers/power/reset/macsmc-reboot.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/power/reset/macsmc-reboot.c b/drivers/power/reset/macsmc-reboot.c
index b5f0c6d09391..cfd1ba98ee80 100644
--- a/drivers/power/reset/macsmc-reboot.c
+++ b/drivers/power/reset/macsmc-reboot.c
@@ -274,7 +274,7 @@ static int macsmc_reboot_pm_notify(struct notifier_block *nb, unsigned long acti
 
 	if (action == PM_SUSPEND_PREPARE && (READ_ONCE(deep_steps) & MACSMC_SLEEP_WAKEMASK)) {
 		dev_info(reboot->dev, "sleep: wake mask: reading\n");
-		m = ioremap(WAKEMASK_PHYS, 0x40);
+		m = ioremap_np(WAKEMASK_PHYS, 0x40);
 		if (!m)
 			return NOTIFY_DONE;
 		for (int i = 0; i < WAKEMASK_WORDS; i++)
@@ -292,7 +292,7 @@ static int macsmc_reboot_pm_notify(struct notifier_block *nb, unsigned long acti
 		iounmap(m);
 	} else if (action == PM_POST_SUSPEND && reboot->mask_set) {
 		reboot->mask_set = false;
-		m = ioremap(WAKEMASK_PHYS, 0x40);
+		m = ioremap_np(WAKEMASK_PHYS, 0x40);
 		if (!m)
 			return NOTIFY_DONE;
 		for (int i = 0; i < WAKEMASK_WORDS; i++)
-- 
2.55.0

