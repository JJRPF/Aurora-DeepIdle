From 68d4098cae44d0004430ad58a193a702192d849f Mon Sep 17 00:00:00 2001
From: Justin Pfister <119864532+JJRPF@users.noreply.github.com>
Date: Sat, 24 Oct 2026 08:21:44 -0400
Subject: [PATCH] arm64: dts: apple: t6020-j414s-psci: opt-in PSCI-via-EFI CPU
 bring-up

Test variant of t6020-j414s.dts: a psci node with method "efi" and
enable-method "psci" on every CPU, for the resident bootloader's
CPU_ON/CPU_OFF. CPU idle stays with the Apple cpuidle driver. Left out
of the Makefile: only the boot CPU comes up without the EFI table.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AuzUDcEeRJQ6RCdWW2XWLb
---
 .../arm64/boot/dts/apple/t6020-j414s-psci.dts | 39 +++++++++++++++++++
 1 file changed, 39 insertions(+)
 create mode 100644 arch/arm64/boot/dts/apple/t6020-j414s-psci.dts

diff --git a/arch/arm64/boot/dts/apple/t6020-j414s-psci.dts b/arch/arm64/boot/dts/apple/t6020-j414s-psci.dts
new file mode 100644
index 000000000000..661e550b26fa
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6020-j414s-psci.dts
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * MacBook Pro (14-inch, M2 Pro, 2023), CPUs brought up through PSCI
+ *
+ * target-type: J414s
+ *
+ * Opt-in test variant of t6020-j414s.dts for the PSCI-via-EFI conduit: the
+ * secondaries are started and stopped with PSCI CPU_ON/CPU_OFF, served by the
+ * resident bootloader through the LINUX_EFI_ARM_PSCI_HANDLER_TABLE config
+ * table, instead of the spin-table. CPU idle stays with the Apple cpuidle
+ * driver for now, so no idle-states are added.
+ *
+ * Without that config table only the boot CPU comes up, so this must only
+ * be booted with a bootloader that provides it. It is left out of the
+ * Makefile on purpose (same compatible as t6020-j414s.dtb; m1n1 boots the
+ * last DTB that matches). Build it by name.
+ */
+
+#include "t6020-j414s.dts"
+
+/ {
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "efi";
+	};
+};
+
+&cpu_e00 { enable-method = "psci"; };
+&cpu_e01 { enable-method = "psci"; };
+&cpu_e02 { enable-method = "psci"; };
+&cpu_e03 { enable-method = "psci"; };
+&cpu_p00 { enable-method = "psci"; };
+&cpu_p01 { enable-method = "psci"; };
+&cpu_p02 { enable-method = "psci"; };
+&cpu_p03 { enable-method = "psci"; };
+&cpu_p10 { enable-method = "psci"; };
+&cpu_p11 { enable-method = "psci"; };
+&cpu_p12 { enable-method = "psci"; };
+&cpu_p13 { enable-method = "psci"; };
-- 
