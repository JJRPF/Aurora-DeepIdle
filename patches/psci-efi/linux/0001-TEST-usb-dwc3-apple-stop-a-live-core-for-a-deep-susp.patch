From f60139c75aa55a67e1d98bc9d79ce3709486ff38 Mon Sep 17 00:00:00 2001
From: Justin Pfister <119864532+JJRPF@users.noreply.github.com>
Date: Fri, 6 Nov 2026 18:14:28 -0500
Subject: [PATCH] TEST: usb: dwc3: apple: stop a live core for a deep suspend;
 phy: apple: atc: restore after PD off on T8103

dwc3-apple keeps a live core as a syscore device, which holds its power
domain (shared with the ATC PHY) on through system sleep. With
dwc3_apple.test_deep_teardown=1, a PM notifier stops the core at
PM_SUSPEND_PREPARE for a deep (mem) suspend, as a cable removal would,
records role switches while it is down, and restarts it in that role at
PM_POST_SUSPEND.

phy-apple-atc.test_restore_pd_off (default on) follows the power domain on
the T8103 generation too (T6020 binds that compatible), so the PHY is
brought back to its tracked mode after the domain was off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/phy/apple/atc.c       | 19 +++++++-
 drivers/usb/dwc3/dwc3-apple.c | 86 +++++++++++++++++++++++++++++++++++
 2 files changed, 103 insertions(+), 2 deletions(-)

diff --git a/drivers/phy/apple/atc.c b/drivers/phy/apple/atc.c
index 4ce4ad506250..34bdee648798 100644
--- a/drivers/phy/apple/atc.c
+++ b/drivers/phy/apple/atc.c
@@ -3619,6 +3619,21 @@ static void _atcphy_dwc3_reset_assert(struct apple_atcphy *atcphy);
  * controller, the USB controller and the display controller resume does not
  * matter.
  */
+/*
+ * TEST: also follow the power domain on the T8103 generation (T6020 binds the
+ * T8103 compatible), where a stopped USB controller now lets it go off in a
+ * deep suspend. Read at probe.
+ */
+static bool test_restore_pd_off = true;
+module_param(test_restore_pd_off, bool, 0444);
+MODULE_PARM_DESC(test_restore_pd_off,
+		 "TEST: restore the PHY after its power domain was off on every generation");
+
+static bool atcphy_restores_after_pd_off(struct apple_atcphy *atcphy)
+{
+	return atcphy->hw->restore_after_pd_off || test_restore_pd_off;
+}
+
 static void atcphy_restore_after_pd_off(struct apple_atcphy *atcphy)
 {
 	enum atcphy_mode mode = atcphy->mode;
@@ -3626,7 +3641,7 @@ static void atcphy_restore_after_pd_off(struct apple_atcphy *atcphy)
 
 	lockdep_assert_held(&atcphy->lock);
 
-	if (!atcphy->hw->restore_after_pd_off || !READ_ONCE(atcphy->pd_was_off))
+	if (!atcphy_restores_after_pd_off(atcphy) || !READ_ONCE(atcphy->pd_was_off))
 		return;
 	WRITE_ONCE(atcphy->pd_was_off, false);
 
@@ -5346,7 +5361,7 @@ static void atcphy_probe_pd_notifier(struct apple_atcphy *atcphy)
 {
 	int ret;
 
-	if (!atcphy->hw->restore_after_pd_off)
+	if (!atcphy_restores_after_pd_off(atcphy))
 		return;
 
 	atcphy->pd_nb.notifier_call = atcphy_pd_notify;
diff --git a/drivers/usb/dwc3/dwc3-apple.c b/drivers/usb/dwc3/dwc3-apple.c
index 464e5d9e691f..6186d3473bc0 100644
--- a/drivers/usb/dwc3/dwc3-apple.c
+++ b/drivers/usb/dwc3/dwc3-apple.c
@@ -14,6 +14,7 @@
 #include <linux/phy/phy.h>
 #include <linux/platform_device.h>
 #include <linux/pm_wakeup.h>
+#include <linux/suspend.h>
 #include <linux/reset.h>
 #include <linux/usb/phy.h>
 
@@ -108,6 +109,9 @@
  * @reset_pending: Controller reset must complete before another start
  * @usb2_power_off_pending: Core-owned USB2 references still to release
  * @usb3_power_off_pending: Core-owned USB3 references still to release
+ * @pm_nb: PM notifier, TEST: stops a live core for a deep suspend
+ * @sleep_teardown: TEST: the core was stopped for a deep suspend; role switches only record
+ * @sleep_role: TEST: the role to bring back after the deep suspend
  */
 struct dwc3_apple {
 	struct dwc3 dwc;
@@ -130,8 +134,24 @@ struct dwc3_apple {
 	bool reset_pending;
 	unsigned long usb2_power_off_pending;
 	unsigned long usb3_power_off_pending;
+
+	struct notifier_block pm_nb;
+	bool sleep_teardown;
+	enum usb_role sleep_role;
 };
 
+/*
+ * TEST: a live core is a syscore device and keeps its power domain (and the
+ * PHY's, which shares it) on through system sleep. For a deep suspend, where
+ * the SoC powers the domain off anyway, stop the core before the suspend as a
+ * cable removal would, and start it again in the same role afterwards. USB
+ * devices are re-enumerated. Suspend-to-idle keeps the core running.
+ */
+static bool test_deep_teardown;
+module_param(test_deep_teardown, bool, 0644);
+MODULE_PARM_DESC(test_deep_teardown,
+		 "TEST: stop a live core before a deep (mem) suspend and restart it after");
+
 #define to_dwc3_apple(d) container_of((d), struct dwc3_apple, dwc)
 
 /*
@@ -505,6 +525,12 @@ static int dwc3_usb_role_switch_set(struct usb_role_switch *sw, enum usb_role ro
 	if (appledwc->fixed_hub)
 		return 0;
 
+	/* TEST: the core stays down until the deep suspend is over */
+	if (appledwc->sleep_teardown) {
+		appledwc->sleep_role = role;
+		return 0;
+	}
+
 	/*
 	 * Skip role switches if appledwc is already in the desired state. The
 	 * USB-C port controller on M2 and M1/M2 Pro/Max/Ultra devices issues
@@ -550,6 +576,9 @@ static enum usb_role dwc3_usb_role_switch_get(struct usb_role_switch *sw)
 
 	guard(mutex)(&appledwc->lock);
 
+	if (appledwc->sleep_teardown)
+		return appledwc->sleep_role;
+
 	switch (appledwc->state) {
 	case DWC3_APPLE_HOST:
 		return USB_ROLE_HOST;
@@ -565,6 +594,57 @@ static enum usb_role dwc3_usb_role_switch_get(struct usb_role_switch *sw)
 	}
 }
 
+static int dwc3_apple_pm_notify(struct notifier_block *nb, unsigned long action, void *data)
+{
+	struct dwc3_apple *appledwc = container_of(nb, struct dwc3_apple, pm_nb);
+	int ret = 0;
+
+	guard(mutex)(&appledwc->lock);
+
+	switch (action) {
+	case PM_SUSPEND_PREPARE:
+		if (!READ_ONCE(test_deep_teardown) || pm_suspend_default_s2idle())
+			break;
+		switch (appledwc->state) {
+		case DWC3_APPLE_HOST:
+			appledwc->sleep_role = USB_ROLE_HOST;
+			break;
+		case DWC3_APPLE_DEVICE:
+			appledwc->sleep_role = USB_ROLE_DEVICE;
+			break;
+		default:
+			appledwc->sleep_role = USB_ROLE_NONE;
+			break;
+		}
+		appledwc->sleep_teardown = true;
+		if (appledwc->sleep_role == USB_ROLE_NONE)
+			break;
+		ret = dwc3_apple_exit(appledwc);
+		dev_info(appledwc->dev, "TEST: core stopped for deep suspend (role %d): %d\n",
+			 appledwc->sleep_role, ret);
+		break;
+	case PM_POST_SUSPEND:
+		if (!appledwc->sleep_teardown)
+			break;
+		appledwc->sleep_teardown = false;
+		switch (appledwc->sleep_role) {
+		case USB_ROLE_HOST:
+			ret = dwc3_apple_init(appledwc, DWC3_APPLE_HOST);
+			break;
+		case USB_ROLE_DEVICE:
+			ret = dwc3_apple_init(appledwc, DWC3_APPLE_DEVICE);
+			break;
+		default:
+			return NOTIFY_DONE;
+		}
+		dev_info(appledwc->dev, "TEST: core restarted after deep suspend (role %d): %d\n",
+			 appledwc->sleep_role, ret);
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
 static int dwc3_apple_setup_role_switch(struct dwc3_apple *appledwc)
 {
 	struct usb_role_switch_desc dwc3_role_switch = { NULL };
@@ -654,6 +734,9 @@ static int dwc3_apple_probe(struct platform_device *pdev)
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "Failed to setup role switch\n");
 
+	appledwc->pm_nb.notifier_call = dwc3_apple_pm_notify;
+	register_pm_notifier(&appledwc->pm_nb);
+
 	if (!appledwc->fixed_hub)
 		return 0;
 
@@ -670,6 +753,7 @@ static int dwc3_apple_probe(struct platform_device *pdev)
 			dev_err(dev, "Host startup left pending PHY/reset cleanup\n");
 		if (appledwc->state != DWC3_APPLE_PROBE_PENDING)
 			dwc3_core_remove_no_shutdown(&appledwc->dwc);
+		unregister_pm_notifier(&appledwc->pm_nb);
 		usb_role_switch_unregister(appledwc->role_sw);
 		return dev_err_probe(dev, ret, "Failed to start host mode\n");
 	}
@@ -682,6 +766,8 @@ static void dwc3_apple_remove(struct platform_device *pdev)
 	struct dwc3 *dwc = platform_get_drvdata(pdev);
 	struct dwc3_apple *appledwc = to_dwc3_apple(dwc);
 
+	unregister_pm_notifier(&appledwc->pm_nb);
+
 	guard(mutex)(&appledwc->lock);
 
 	usb_role_switch_unregister(appledwc->role_sw);
-- 
2.55.0

