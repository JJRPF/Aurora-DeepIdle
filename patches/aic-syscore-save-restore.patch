+
+/*
+ * System sleep with the SoC powered down (S2R): macOS's AIC quiesce action saves and masks every
+ * bank, and restores them on wake. Do the same from syscore ops: they run on the last CPU with
+ * interrupts off, after every device. s2idle never calls them (the AIC stays powered there), so
+ * this only runs for a sleep state that does, such as PSCI SYSTEM_SUSPEND once firmware offers
+ * it, and around a hibernation snapshot, where the round trip changes nothing.
+ *
+ * Saved: AIC2_CONFIG and each IRQ's IRQ_CFG (v2/v3) or TARGET_CPU (v1). The masks are rebuilt
+ * from the IRQ core's own mask state rather than read back. Not covered: per-CPU sources (timer,
+ * fast IPI, PMC FIQs), whose IMP-DEF registers a CPU coming back through firmware has reset; the
+ * secondaries redo them in aic_init_cpu(), the boot CPU's need handling once S2R exists.
+ */
+static u32 *aic_saved_cfg;
+static u32 aic_saved_config;
+
+static u32 aic_cfg_reg(struct aic_irq_chip *ic)
+{
+	return ic->info.version == 1 ? ic->info.target_cpu : ic->info.irq_cfg;
+}
+
+static void aic_mask_all(struct aic_irq_chip *ic)
+{
+	u32 off = 0;
+	int die, i;
+
+	for (die = 0; die < ic->nr_die; die++) {
+		for (i = 0; i < BITS_TO_U32(ic->nr_irq); i++)
+			aic_ic_write(ic, ic->info.mask_set + off + i * 4, U32_MAX);
+		off += ic->info.die_stride;
+	}
+}
+
+static int aic_syscore_suspend(void *data)
+{
+	struct aic_irq_chip *ic = aic_irqc;
+	u32 off = 0;
+	int die, i;
+
+	if (!aic_saved_cfg)
+		return 0;
+	for (die = 0; die < ic->nr_die; die++) {
+		for (i = 0; i < ic->nr_irq; i++)
+			aic_saved_cfg[die * ic->nr_irq + i] =
+				aic_ic_read(ic, aic_cfg_reg(ic) + off + i * 4);
+		off += ic->info.die_stride;
+	}
+	if (ic->info.version == 2 || ic->info.version == 3)
+		aic_saved_config = aic_ic_read(ic, AIC2_CONFIG);
+	aic_mask_all(ic);
+	return 0;
+}
+
+static void aic_syscore_resume(void *data)
+{
+	struct aic_irq_chip *ic = aic_irqc;
+	u32 off = 0;
+	int die, i;
+
+	if (!aic_saved_cfg)
+		return;
+	aic_mask_all(ic);
+	for (die = 0; die < ic->nr_die; die++) {
+		for (i = 0; i < ic->nr_irq; i++)
+			aic_ic_write(ic, aic_cfg_reg(ic) + off + i * 4,
+				     aic_saved_cfg[die * ic->nr_irq + i]);
+		off += ic->info.die_stride;
+	}
+	if (ic->info.version == 2 || ic->info.version == 3)
+		aic_ic_write(ic, AIC2_CONFIG, aic_saved_config);
+
+	/* Unmask what the IRQ core has unmasked; pending wake IRQs then fire as usual */
+	for (die = 0; die < ic->nr_die; die++) {
+		for (i = 0; i < ic->nr_irq; i++) {
+			unsigned int virq = irq_find_mapping(ic->hw_domain, AIC_IRQ_HWIRQ(die, i));
+			struct irq_data *d = virq ? irq_get_irq_data(virq) : NULL;
+
+			if (d && !irqd_irq_masked(d))
+				aic_ic_write(ic, ic->info.mask_clr + die * ic->info.die_stride +
+					     MASK_REG(i), MASK_BIT(i));
+		}
+	}
+}
+
+static const struct syscore_ops aic_syscore_ops = {
+	.suspend = aic_syscore_suspend,
+	.resume = aic_syscore_resume,
+};
+
+static struct syscore aic_syscore = {
+	.ops = &aic_syscore_ops,
+};
+
+static void aic_init_syscore(struct aic_irq_chip *ic)
+{
+	aic_saved_cfg = kcalloc(ic->nr_die * ic->nr_irq, sizeof(u32), GFP_KERNEL);
+	if (!aic_saved_cfg) {
+		pr_warn("No memory to save AIC state across system sleep");
+		return;
+	}
+	register_syscore(&aic_syscore);
+}
+
 static int __init aic_of_ic_init(struct device_node *node, struct device_node *parent)
 {
