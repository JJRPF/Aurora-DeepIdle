From c979968983ffa59d23e8423c88659c1876c6c476 Mon Sep 17 00:00:00 2001
From: Justin Pfister <119864532+JJRPF@users.noreply.github.com>
Date: Sun, 25 Oct 2026 11:39:04 -0400
Subject: [PATCH] hv trace_smc: log an unparsed ASC message instead of entering
 the debug shell

---
 ...ck-carries-the-core-index-in-bits-44.patch | 29 +++++++++++++++++++
 proxyclient/hv/trace_smc.py                   |  7 ++++-
 2 files changed, 35 insertions(+), 1 deletion(-)
 create mode 100644 patches/hvsleep-trace/0099-smp-RVBAR-readback-carries-the-core-index-in-bits-44.patch

diff --git a/patches/hvsleep-trace/0099-smp-RVBAR-readback-carries-the-core-index-in-bits-44.patch b/patches/hvsleep-trace/0099-smp-RVBAR-readback-carries-the-core-index-in-bits-44.patch
new file mode 100644
index 00000000..642949ca
--- /dev/null
+++ b/patches/hvsleep-trace/0099-smp-RVBAR-readback-carries-the-core-index-in-bits-44.patch
@@ -0,0 +1,29 @@
+From 90b2155e11658b37c2ff6ab9ce210ad7f57f027f Mon Sep 17 00:00:00 2001
+From: Justin Pfister <119864532+JJRPF@users.noreply.github.com>
+Date: Sun, 25 Oct 2026 11:20:00 -0400
+Subject: [PATCH] smp: RVBAR readback carries the core index in bits 44-45 on
+ T6020; compare bits 43:12 only
+
+Without this a resident (stage 2) image refuses to start every core but core 0 of each cluster.
+
+Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
+---
+ src/smp.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/src/smp.c b/src/smp.c
+index a563d33d..73469c0d 100644
+--- a/src/smp.c
++++ b/src/smp.c
+@@ -27,7 +27,7 @@
+ #define SMP_SHARED __attribute__((section(".data.smp_shared")))
+ 
+ #define RVBAR_LOCK BIT(0)
+-#define RVBAR_ADDR GENMASK(47, 12)
++#define RVBAR_ADDR GENMASK(43, 12) /* bits 44-45 read back as the core index on T6020 */
+ 
+ struct spin_table {
+     u64 mpidr;
+-- 
+2.55.0
+
diff --git a/proxyclient/hv/trace_smc.py b/proxyclient/hv/trace_smc.py
index 2a1efa68..2d23e32f 100644
--- a/proxyclient/hv/trace_smc.py
+++ b/proxyclient/hv/trace_smc.py
@@ -102,7 +102,12 @@ class SMCTracer(ASCTracer):
     }
 
     def handle_msg(self, direction, r0, r1):
-        super().handle_msg(direction, r0, r1)
+        # A message the base ASC decoder does not parse (an assert in the field validator) must not
+        # drop the run into the interactive debug shell: log it raw and let the guest go on.
+        try:
+            super().handle_msg(direction, r0, r1)
+        except AssertionError:
+            self.log(f"[smc] unparsed msg dir={direction} r0={int(r0.value):#x} r1={int(r1.value):#x}")
 
 smc_tracer = SMCTracer(hv, "/arm-io/smc", verbose=1)
 smc_tracer.start()
-- 
2.55.0

