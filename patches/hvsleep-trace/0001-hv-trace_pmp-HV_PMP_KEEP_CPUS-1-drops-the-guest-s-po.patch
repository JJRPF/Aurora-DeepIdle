From 0ee308a8a70e45c6c2a3dbec7a863bb4c3e1ca35 Mon Sep 17 00:00:00 2001
From: Justin Pfister <jpfister@gmail.com>
Date: Sun, 25 Oct 2026 19:13:15 -0400
Subject: [PATCH] hv/trace_pmp: HV_PMP_KEEP_CPUS=1 drops the guest's power-off
 of the CPU domains (emulated PMP registers)

---
 proxyclient/hv/trace_pmp.py | 45 ++++++++++++++++++++++++++++++-------
 1 file changed, 37 insertions(+), 8 deletions(-)

diff --git a/proxyclient/hv/trace_pmp.py b/proxyclient/hv/trace_pmp.py
index 048a25b8..df93d62a 100644
--- a/proxyclient/hv/trace_pmp.py
+++ b/proxyclient/hv/trace_pmp.py
@@ -5,6 +5,7 @@ from m1n1.utils import *
 from m1n1.constructutils import *
 from m1n1.proxyutils import RegMonitor
 
+import os
 import sys
 import struct
 
@@ -179,20 +180,48 @@ else:
     exit(1)
 
 
+class _Flags:
+    def __init__(self, write, width):
+        self.WRITE = write
+        self.MULTI = False
+        self.WIDTH = width
+
+class _Evt:
+    def __init__(self, addr, data, write, width):
+        self.addr = addr
+        self.data = data
+        self.flags = _Flags(write, width)
+
+# HV_PMP_KEEP_CPUS=1: the guest's sleep path powers the CPU complexes off through DEV_STATUS_TGT_WR
+# (PCPM0/PCPM1/ECPM); the HV cannot survive that (its own cores go with them, run 9: rendezvous
+# panic). Emulate the PMP registers in the HV and drop the clear of a CPU-complex bit that is
+# currently set; every access is still logged the usual way.
+KEEP_CPUS = os.environ.get("HV_PMP_KEEP_CPUS") == "1"
+CPU_DOMAIN_MASK = sum(1 << pmp_bits[n] for n in ("ECPM", "PCPM0", "PCPM1") if n in pmp_bits)
+
 class PMPRegTracer(Tracer):
 
     def start(self):
-        #self.trace(start, len, TraceMode.HOOK)
-        self.trace_regmap(pmp_base, pmp_len, PMPRegs, name="PMP", regmap_offset=0, mode=TraceMode.ASYNC)
+        mode = TraceMode.HOOK if KEEP_CPUS else TraceMode.ASYNC
+        self.trace_regmap(pmp_base, pmp_len, PMPRegs, name="PMP", regmap_offset=0, mode=mode)
+        if KEEP_CPUS:
+            self.hv.log(f"PMP: keeping CPU domains on (mask {CPU_DOMAIN_MASK:#x})")
+
     def hook_w(self, addr, val, width, **kwargs):
-        self.hv.log(f"PMP: W {addr:#x} <- {val:#x}")
-        super().hook_w(addr, val, width, **kwargs)
+        reg = self.PMP.lookup_addr(addr)[0]
+        if reg == "DEV_STATUS_TGT_WR":
+            cur = self.hv.u.read(self.PMP.addrof("DEV_STATUS_TGT_RD"), 64)
+            keep = val | (cur & CPU_DOMAIN_MASK)
+            if keep != val:
+                self.hv.log(f"PMP: guest wrote TGT {val:#x}, CPU domains kept on -> {keep:#x}")
+                val = keep
+        self.hv.u.write(addr, val, width)
+        self.evt_rw(_Evt(addr, val, True, {8: 0, 16: 1, 32: 2, 64: 3}.get(width, 3)), **kwargs)
+
     def hook_r(self, addr, width, **kwargs):
-        val = super().hook_r(addr, width, **kwargs)
-        self.hv.log(f"PMP: R {addr:#x} = {val:#x}")
+        val = self.hv.u.read(addr, width)
+        self.evt_rw(_Evt(addr, val, False, {8: 0, 16: 1, 32: 2, 64: 3}.get(width, 3)), **kwargs)
         return val
-    def evt_rw(self, *args, **kwargs):
-        super().evt_rw(*args, **kwargs)
 
 
 rt = PMPRegTracer(hv)
-- 
