From 029ff32ed6d443ce777fe30b705bc4f7e03eff90 Mon Sep 17 00:00:00 2001
From: Justin Pfister <jpfister@gmail.com>
Date: Sun, 25 Oct 2026 18:33:32 -0400
Subject: [PATCH] hv: print the exception syndrome at proxy entry, before the
 rendezvous that can panic

---
 src/hv/hv_exc.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/hv/hv_exc.c b/src/hv/hv_exc.c
index 7c4fa64f..417227a5 100644
--- a/src/hv/hv_exc.c
+++ b/src/hv/hv_exc.c
@@ -47,6 +47,10 @@ static void _hv_exc_proxy(struct exc_info *ctx, uartproxy_boot_reason_t reason,
 
     hv_wdt_breadcrumb('P');
 
+    /* Say why we are here before the rendezvous: it can panic if a CPU is already asleep. */
+    printf("HV: proxy entry on CPU %ld: reason %d type %d esr 0x%lx elr 0x%lx afsr1 0x%lx\n",
+           mrs(TPIDR_EL2), reason, type, ctx->esr, ctx->elr, ctx->afsr1);
+
     /*
      * Get all the CPUs into the HV before running the proxy, to make sure they all exit to
      * the guest with a consistent time offset.
-- 
2.55.0

