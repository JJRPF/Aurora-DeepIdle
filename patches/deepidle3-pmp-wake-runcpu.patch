+    /// Reads CPU_STATUS; outside a `Core` context, so through `try_access`.
+    fn cpu_status(&self) -> Result<u32> {
+        self.asc_mmio
+            .try_access_with(|io| io.relaxed().read32(CPU_STATUS))
+            .ok_or(ENXIO)
+    }
+    /// Sets or clears RUN in CPU_CONTROL (macOS `AppleA7IOPV4::_runCPU`).
+    fn run_cpu(&self, run: bool) -> Result<()> {
+        self.asc_mmio
+            .try_access_with(|io| {
+                let io = io.relaxed();
+                let val = io.read32(CPU_CONTROL);
+                io.write32(if run { val | CPU_RUN } else { val & !CPU_RUN }, CPU_CONTROL);
+            })
+            .ok_or(ENXIO)
+    }
+    /// macOS `AppleA7IOP::stopCPU`: poll CPU_STATUS every 1 ms until the CPU is idle, then
+    /// clear RUN. Returns the number of polls it took.
+    fn stop_cpu_when_idle(&self) -> Result<u32> {
+        for polls in 0..CPU_IDLE_POLLS {
+            if self.cpu_status()? & CPU_STATUS_IDLE != 0 {
+                self.run_cpu(false)?;
+                return Ok(polls);
+            }
+            fsleep(Delta::from_millis(1));
+        }
+        Err(ETIMEDOUT)
+    }
