+			nvmem-cells = <&rtc_offset>, <&rtc_alarm>, <&rtc_alarm_en>,
+				<&rtc_alarm_event>, <&rtc_alarm_irq_mask>;
+			nvmem-cell-names = "rtc_offset", "rtc_alarm", "rtc_alarm_en",
+				"rtc_alarm_event", "rtc_alarm_irq_mask";
