+++ b/drivers/spmi/spmi-apple-controller.c
@@ -284,7 +284,12 @@ static struct irq_chip apple_spmi_irq_chip = {
 	.irq_unmask = apple_spmi_irq_unmask,
 	.irq_ack = apple_spmi_irq_ack,
