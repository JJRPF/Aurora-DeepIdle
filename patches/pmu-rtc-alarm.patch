--- a/drivers/rtc/rtc-macsmc.c
+++ b/drivers/rtc/rtc-macsmc.c
@@ -26,6 +26,15 @@
 /* Offset kept as a 64-bit little-endian count of whole seconds */
 #define RTC_OFFSET_SECS_BYTES 8
 
