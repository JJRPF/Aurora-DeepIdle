@@ -20,15 +20,36 @@ properties:
     const: apple,smc-rtc
 
   nvmem-cells:
+    minItems: 1
     items:
       - description:
           RTC offset. By default a 48bit value, specified in 32768 (2^15) Hz
           clock ticks. With apple,rtc-offset-seconds, a 64bit little-endian
           count of whole seconds.
+      - description:
+          PMU alarm time, a 32bit little-endian count of the RTC counter's
