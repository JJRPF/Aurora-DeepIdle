diff --git a/drivers/rtc/rtc-macsmc.c b/drivers/rtc/rtc-macsmc.c
index 25d5af5cfbbc..e64871c70ec2 100644
--- a/drivers/rtc/rtc-macsmc.c
+++ b/drivers/rtc/rtc-macsmc.c
@@ -5,11 +5,13 @@
  */
 
 #include <linux/bitops.h>
+#include <linux/interrupt.h>
 #include <linux/mfd/macsmc.h>
 #include <linux/module.h>
 #include <linux/nvmem-consumer.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
+#include <linux/pm_wakeirq.h>
 #include <linux/rtc.h>
 #include <linux/slab.h>
 #include <linux/unaligned.h>
@@ -30,6 +32,14 @@ struct macsmc_rtc {
 	struct rtc_device *rtc_dev;
 	struct nvmem_cell *rtc_offset;
 	bool offset_in_seconds;
+	/*
+	 * Optional PMU wake alarm. The alarm register holds the PMU counter's
+	 * whole seconds (CLKM >> 15) at which to fire, 32 bits wide.
+	 */
+	struct nvmem_cell *alarm;		/* u32 LE, counter seconds */
+	struct nvmem_cell *alarm_en;		/* one bit: alarm enabled */
+	struct nvmem_cell *alarm_event;		/* bit 0: fired, write 1 to clear */
+	struct nvmem_cell *alarm_irq_mask;	/* one bit: 1 = masked */
 };
 
 static int macsmc_rtc_get_time_secs(struct macsmc_rtc *rtc, u64 ctr,
@@ -62,20 +72,13 @@ static int macsmc_rtc_get_time_secs(struct macsmc_rtc *rtc, u64 ctr,
 	return 0;
 }
 
-static int macsmc_rtc_get_time(struct device *dev, struct rtc_time *tm)
+/* The time at counter value ctr (CLKM) */
+static int macsmc_rtc_time_at(struct macsmc_rtc *rtc, u64 ctr, struct rtc_time *tm)
 {
-	struct macsmc_rtc *rtc = dev_get_drvdata(dev);
-	u64 ctr = 0, off = 0;
+	u64 off = 0;
 	time64_t now;
 	void *p_off;
 	size_t len;
-	int ret;
-
-	ret = apple_smc_read(rtc->smc, SMC_KEY(CLKM), &ctr, RTC_BYTES);
-	if (ret < 0)
-		return ret;
-	if (ret != RTC_BYTES)
-		return -EIO;
 
 	if (rtc->offset_in_seconds)
 		return macsmc_rtc_get_time_secs(rtc, ctr, tm);
@@ -95,7 +98,22 @@ static int macsmc_rtc_get_time(struct device *dev, struct rtc_time *tm)
 	now = sign_extend64(ctr + off, RTC_BITS - 1) >> RTC_SEC_SHIFT;
 	rtc_time64_to_tm(now, tm);
 
-	return ret;
+	return 0;
+}
+
+static int macsmc_rtc_get_time(struct device *dev, struct rtc_time *tm)
+{
+	struct macsmc_rtc *rtc = dev_get_drvdata(dev);
+	u64 ctr = 0;
+	int ret;
+
+	ret = apple_smc_read(rtc->smc, SMC_KEY(CLKM), &ctr, RTC_BYTES);
+	if (ret < 0)
+		return ret;
+	if (ret != RTC_BYTES)
+		return -EIO;
+
+	return macsmc_rtc_time_at(rtc, ctr, tm);
 }
 
 static int macsmc_rtc_set_time(struct device *dev, struct rtc_time *tm)
@@ -124,15 +142,211 @@ static int macsmc_rtc_set_time(struct device *dev, struct rtc_time *tm)
 	return nvmem_cell_write(rtc->rtc_offset, &off, RTC_BYTES);
 }
 
+static int macsmc_rtc_read_u8(struct nvmem_cell *cell, u8 *val)
+{
+	size_t len;
+	u8 *p;
+
+	p = nvmem_cell_read(cell, &len);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+	*val = len ? p[0] : 0;
+	kfree(p);
+	return len ? 0 : -EIO;
+}
+
+static int macsmc_rtc_write_u8(struct nvmem_cell *cell, u8 val)
+{
+	int ret = nvmem_cell_write(cell, &val, 1);
+
+	return ret < 0 ? ret : 0;
+}
+
+/* Counter seconds and wall-clock seconds, from one CLKM read */
+static int macsmc_rtc_now(struct macsmc_rtc *rtc, u32 *ctr_secs, time64_t *now)
+{
+	struct rtc_time tm;
+	u64 ctr = 0;
+	int ret;
+
+	ret = apple_smc_read(rtc->smc, SMC_KEY(CLKM), &ctr, RTC_BYTES);
+	if (ret < 0)
+		return ret;
+	if (ret != RTC_BYTES)
+		return -EIO;
+	*ctr_secs = ctr >> RTC_SEC_SHIFT;
+
+	ret = macsmc_rtc_time_at(rtc, ctr, &tm);
+	if (ret < 0)
+		return ret;
+	*now = rtc_tm_to_time64(&tm);
+	return 0;
+}
+
+static int macsmc_rtc_alarm_irq_enable(struct device *dev, unsigned int enabled)
+{
+	struct macsmc_rtc *rtc = dev_get_drvdata(dev);
+	int ret;
+
+	/* The order AppleDialogSPMIPMURTC uses: unmask, then enable */
+	if (enabled) {
+		ret = macsmc_rtc_write_u8(rtc->alarm_irq_mask, 0);
+		if (!ret)
+			ret = macsmc_rtc_write_u8(rtc->alarm_en, 1);
+	} else {
+		ret = macsmc_rtc_write_u8(rtc->alarm_en, 0);
+		if (!ret)
+			ret = macsmc_rtc_write_u8(rtc->alarm_irq_mask, 1);
+	}
+	return ret;
+}
+
+static int macsmc_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *wkalrm)
+{
+	struct macsmc_rtc *rtc = dev_get_drvdata(dev);
+	u32 ctr_secs, alarm;
+	time64_t now;
+	u8 en, ev;
+	size_t len;
+	void *p;
+	int ret;
+
+	ret = macsmc_rtc_now(rtc, &ctr_secs, &now);
+	if (ret)
+		return ret;
+
+	p = nvmem_cell_read(rtc->alarm, &len);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+	if (len < 4) {
+		kfree(p);
+		return -EIO;
+	}
+	alarm = get_unaligned_le32(p);
+	kfree(p);
+
+	ret = macsmc_rtc_read_u8(rtc->alarm_en, &en);
+	if (!ret)
+		ret = macsmc_rtc_read_u8(rtc->alarm_event, &ev);
+	if (ret)
+		return ret;
+
+	rtc_time64_to_tm(now + (s32)(alarm - ctr_secs), &wkalrm->time);
+	wkalrm->enabled = en & 1;
+	wkalrm->pending = ev & 1;
+	return 0;
+}
+
+static int macsmc_rtc_set_alarm(struct device *dev, struct rtc_wkalrm *wkalrm)
+{
+	struct macsmc_rtc *rtc = dev_get_drvdata(dev);
+	s64 delta;
+	u32 ctr_secs;
+	time64_t now;
+	__le32 alarm;
+	int ret;
+
+	ret = macsmc_rtc_now(rtc, &ctr_secs, &now);
+	if (ret)
+		return ret;
+
+	delta = rtc_tm_to_time64(&wkalrm->time) - now;
+	if (delta > S32_MAX)
+		return -ERANGE;
+
+	ret = macsmc_rtc_alarm_irq_enable(dev, 0);
+	if (ret)
+		return ret;
+	ret = macsmc_rtc_write_u8(rtc->alarm_event, 1);
+	if (ret)
+		return ret;
+
+	alarm = cpu_to_le32(ctr_secs + (s32)delta);
+	ret = nvmem_cell_write(rtc->alarm, &alarm, sizeof(alarm));
+	if (ret < 0)
+		return ret;
+
+	return wkalrm->enabled ? macsmc_rtc_alarm_irq_enable(dev, 1) : 0;
+}
+
+static irqreturn_t macsmc_rtc_alarm_irq(int irq, void *data)
+{
+	struct macsmc_rtc *rtc = data;
+	u8 ev;
+
+	if (macsmc_rtc_read_u8(rtc->alarm_event, &ev) || !(ev & 1))
+		return IRQ_NONE;
+
+	/* One-shot, as macOS uses it: clear the event, disable and mask */
+	macsmc_rtc_write_u8(rtc->alarm_event, 1);
+	macsmc_rtc_alarm_irq_enable(rtc->dev, 0);
+	rtc_update_irq(rtc->rtc_dev, 1, RTC_IRQF | RTC_AF);
+	return IRQ_HANDLED;
+}
+
 static const struct rtc_class_ops macsmc_rtc_ops = {
 	.read_time = macsmc_rtc_get_time,
 	.set_time = macsmc_rtc_set_time,
 };
 
+static const struct rtc_class_ops macsmc_rtc_alarm_ops = {
+	.read_time = macsmc_rtc_get_time,
+	.set_time = macsmc_rtc_set_time,
+	.read_alarm = macsmc_rtc_read_alarm,
+	.set_alarm = macsmc_rtc_set_alarm,
+	.alarm_irq_enable = macsmc_rtc_alarm_irq_enable,
+};
+
+/* The alarm is optional: without all of its cells and an interrupt, none */
+static int macsmc_rtc_init_alarm(struct platform_device *pdev,
+				 struct macsmc_rtc *rtc)
+{
+	struct device *dev = &pdev->dev;
+	int irq, ret;
+
+	irq = platform_get_irq_optional(pdev, 0);
+	if (irq == -EPROBE_DEFER)
+		return irq;
+	if (irq < 0)
+		return 0;
+
+	rtc->alarm = devm_nvmem_cell_get(dev, "rtc_alarm");
+	rtc->alarm_en = devm_nvmem_cell_get(dev, "rtc_alarm_en");
+	rtc->alarm_event = devm_nvmem_cell_get(dev, "rtc_alarm_event");
+	rtc->alarm_irq_mask = devm_nvmem_cell_get(dev, "rtc_alarm_irq_mask");
+	if (IS_ERR(rtc->alarm) || IS_ERR(rtc->alarm_en) ||
+	    IS_ERR(rtc->alarm_event) || IS_ERR(rtc->alarm_irq_mask)) {
+		dev_warn(dev, "alarm interrupt without its NVMEM cells, no alarm\n");
+		return 0;
+	}
+
+	/* Nothing armed before the handler exists */
+	ret = macsmc_rtc_alarm_irq_enable(dev, 0);
+	if (!ret)
+		ret = macsmc_rtc_write_u8(rtc->alarm_event, 1);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to disarm the alarm\n");
+
+	ret = devm_request_threaded_irq(dev, irq, NULL, macsmc_rtc_alarm_irq,
+					IRQF_ONESHOT, dev_name(dev), rtc);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to request the alarm IRQ\n");
+
+	rtc->rtc_dev->ops = &macsmc_rtc_alarm_ops;
+	if (of_property_read_bool(dev->of_node, "wakeup-source")) {
+		device_init_wakeup(dev, true);
+		ret = devm_pm_set_wake_irq(dev, irq);
+		if (ret)
+			dev_warn(dev, "alarm cannot wake the system: %d\n", ret);
+	}
+	return 0;
+}
+
 static int macsmc_rtc_probe(struct platform_device *pdev)
 {
 	struct apple_smc *smc = dev_get_drvdata(pdev->dev.parent);
 	struct macsmc_rtc *rtc;
+	int ret;
 
 	/*
 	 * MFD will probe this device even without a node in the device tree,
@@ -172,6 +386,10 @@ static int macsmc_rtc_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, rtc);
 
+	ret = macsmc_rtc_init_alarm(pdev, rtc);
+	if (ret)
+		return ret;
+
 	return devm_rtc_register_device(rtc->rtc_dev);
 }
 
