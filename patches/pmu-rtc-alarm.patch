+      - description: PMU alarm enable bit.
+      - description: PMU alarm event byte, bit 0 set when the alarm fired,
+          cleared by writing 1.
+      - description: PMU alarm interrupt mask bit, 1 masks the interrupt.
 
   nvmem-cell-names:
+    minItems: 1
     items:
       - const: rtc_offset
+      - const: rtc_alarm
+      - const: rtc_alarm_en
+      - const: rtc_alarm_event
+      - const: rtc_alarm_irq_mask
