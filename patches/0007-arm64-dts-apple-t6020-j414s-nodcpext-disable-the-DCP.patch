From f098b4d2eb9feee01b07ddd12fadb97a819f0ab6 Mon Sep 17 00:00:00 2001
From: Justin Pfister <119864532+JJRPF@users.noreply.github.com>
Date: Wed, 14 Oct 2026 21:34:28 -0400
Subject: [PATCH 07/37] arm64: dts: apple: t6020-j414s-nodcpext: disable the
 DCPs' Type-C routes

The routes inside the external DCPs are the mode-switch providers the
USB-C controllers find through their connector graph. The graph checks
only the far node's own status, so with the DCPs disabled the routes still
looked available, and fwnode_typec_mux_get() would have deferred the
cd321x probe for ever, waiting for a mux nobody registers. Disable the six
routes, and test that no graph link from an enabled node leads to a node
that is disabled only through an ancestor.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AuzUDcEeRJQ6RCdWW2XWLb
---
 .../boot/dts/apple/t6020-j414s-nodcpext.dts   | 30 ++++++++++++-
 docs/deep-idle-research.md                    | 15 +++++--
 tools/aurora-sep/tests/test_t6020_nodcpext.py | 43 ++++++++++++++++++-
 3 files changed, 83 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6020-j414s-nodcpext.dts b/arch/arm64/boot/dts/apple/t6020-j414s-nodcpext.dts
index b5cc900a26bd..d71777234e95 100644
--- a/arch/arm64/boot/dts/apple/t6020-j414s-nodcpext.dts
+++ b/arch/arm64/boot/dts/apple/t6020-j414s-nodcpext.dts
@@ -15,7 +15,11 @@
  * their DARTs and mailboxes disabled, nothing uses the dispext power
  * domains, so they are powered off as unused. The display subsystem keeps
  * only the internal display's DART: an iommus entry for a disabled DART
- * fails the whole IOMMU setup of the node.
+ * fails the whole IOMMU setup of the node. The DCPs' Type-C routes are
+ * disabled too: they are the mode-switch providers the USB-C controllers
+ * look up through the graph, which checks only the route node's own status,
+ * so an enabled route under a disabled DCP would keep the controllers'
+ * probe deferred waiting for a mux nobody registers.
  *
  * It is left out of the Makefile on purpose: it has the same compatible as
  * t6020-j414s.dtb, and m1n1 boots the last DTB that matches. Build it by
@@ -69,3 +73,27 @@ &dcpext1_mbox {
 &dispext1_dart {
 	status = "disabled";
 };
+
+&{/soc/dcp@289c00000/typec-routes/route@0} {
+	status = "disabled";
+};
+
+&{/soc/dcp@289c00000/typec-routes/route@1} {
+	status = "disabled";
+};
+
+&{/soc/dcp@289c00000/typec-routes/route@2} {
+	status = "disabled";
+};
+
+&{/soc/dcp@315c00000/typec-routes/route@0} {
+	status = "disabled";
+};
+
+&{/soc/dcp@315c00000/typec-routes/route@1} {
+	status = "disabled";
+};
+
+&{/soc/dcp@315c00000/typec-routes/route@2} {
+	status = "disabled";
+};
diff --git a/docs/deep-idle-research.md b/docs/deep-idle-research.md
