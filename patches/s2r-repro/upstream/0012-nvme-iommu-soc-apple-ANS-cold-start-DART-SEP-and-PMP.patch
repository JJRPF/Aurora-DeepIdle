From c5bff4f9fe74bc76405dc2d9ed474e8d39369f33 Mon Sep 17 00:00:00 2001
From: Justin Pfister <git@jjrpf.com>
Date: Thu, 26 Nov 2026 10:17:19 -0500
Subject: [PATCH 12/15] nvme, iommu, soc: apple: ANS cold start, DART, SEP and
 PMP state across suspend-to-RAM

Cold-start the ANS after the power cut with its buffers kept and the ADT tunables applied
(mapped with ioremap_np), save and restore the SEP DART, let the SEP SLEEP commit run without
the apple_sleep driver, back up the PMP SRAM, and enable the AIC2 firmware suspend save and
restore.

Signed-off-by: Justin Pfister <git@jjrpf.com>
---
 drivers/iommu/apple-dart.c      | 10 +++-
 drivers/irqchip/irq-apple-aic.c |  1 +
 drivers/nvme/host/apple.c       | 95 ++++++++++++++++++++++++++++++++-
 drivers/soc/apple/pm_shim.c     | 83 ++++++++++++++++++++--------
 drivers/soc/apple/pmp.rs        | 10 ++++
 5 files changed, 174 insertions(+), 25 deletions(-)

diff --git a/drivers/iommu/apple-dart.c b/drivers/iommu/apple-dart.c
index 33a29ce9beb0..fff374af3cd8 100644
--- a/drivers/iommu/apple-dart.c
+++ b/drivers/iommu/apple-dart.c
@@ -6510,8 +6510,16 @@ int apple_dart_sleep_prepare(struct device *dev)
 
 	if (!dart)
 		return -ENODEV;
-	if (!dart->sleep_restore.count)
+	if (!dart->sleep_restore.count) {
+		spin_lock_irqsave(&dart->lock, flags);
+		apple_dart_save_state(dart);
+		for (i = 0; i < BITS_TO_U32(dart->num_streams); i++)
+			dart->sleep_enable[i] =
+				apple_dart_readl(dart, dart->hw->enable_streams + 4 * i);
+		dart->sleep_saved = true;
+		spin_unlock_irqrestore(&dart->lock, flags);
 		return 0;
+	}
 
 	apple_dart_sleep_cfg_read(dart, dart->sleep_cfg);
 	spin_lock_irqsave(&dart->lock, flags);
diff --git a/drivers/irqchip/irq-apple-aic.c b/drivers/irqchip/irq-apple-aic.c
index 52a892164c3a..ee8eb227b21d 100644
--- a/drivers/irqchip/irq-apple-aic.c
+++ b/drivers/irqchip/irq-apple-aic.c
@@ -315,6 +315,7 @@ static const struct aic_info aic2_info __initconst = {
 
 	.fast_ipi	= true,
 	.local_fast_ipi = true,
+	.fw_suspend	= true,
 };
 
 static const struct aic_info aic3_info __initconst = {
diff --git a/drivers/nvme/host/apple.c b/drivers/nvme/host/apple.c
index e4522195f9a2..fefe822b8471 100644
--- a/drivers/nvme/host/apple.c
+++ b/drivers/nvme/host/apple.c
@@ -238,6 +238,13 @@ struct apple_nvme_hw {
 struct apple_nvme {
 	struct device *dev;
 	struct apple_nvme_m5_sleep m5;
+	bool s2r_force_cold;
+	bool s2r_cold;
+	bool s2r_idle_kept;
+	u32 sart_power_boot;
+	int s2r_tun_n;
+	void __iomem *s2r_tun_reg[64];
+	u32 s2r_tun_mask[64], s2r_tun_val[64];
 	struct kref ref;
 	/* Serializes the post-M4 controller disable with reset and teardown. */
 	struct mutex disable_lock;
@@ -1743,6 +1750,48 @@ static void apple_nvme_stop_crashed_session(struct apple_nvme *anv)
 	anv->ctrl.ctrl_config = 0;
 }
 
+#define APPLE_ANS_SART_POWER	0x13e8
+
+static void apple_nvme_s2r_tunables_init(struct apple_nvme *anv)
+{
+	struct device_node *ch = of_find_node_by_path("/chosen");
+	const __be32 *p;
+	int len, i;
+
+	p = ch ? of_get_property(ch, "aurora,ans-tunables", &len) : NULL;
+	of_node_put(ch);
+	if (!p)
+		return;
+	for (i = 0; i < len / 16 && anv->s2r_tun_n < ARRAY_SIZE(anv->s2r_tun_reg); i++, p += 4) {
+		u64 a = ((u64)be32_to_cpu(p[0]) << 32) | be32_to_cpu(p[1]);
+		void __iomem *r = ioremap_np(a, 4);
+
+		if (!r)
+			continue;
+		anv->s2r_tun_reg[anv->s2r_tun_n] = r;
+		anv->s2r_tun_mask[anv->s2r_tun_n] = be32_to_cpu(p[2]);
+		anv->s2r_tun_val[anv->s2r_tun_n] = be32_to_cpu(p[3]);
+		anv->s2r_tun_n++;
+	}
+	dev_dbg(anv->dev, "s2r: %d ANS tunable writes from ADT\n", anv->s2r_tun_n);
+}
+
+static void apple_nvme_s2r_tunables_apply(struct apple_nvme *anv)
+{
+	int i, changed = 0;
+
+	for (i = 0; i < anv->s2r_tun_n; i++) {
+		u32 v = readl(anv->s2r_tun_reg[i]);
+		u32 w = (v & ~anv->s2r_tun_mask[i]) | (anv->s2r_tun_val[i] & anv->s2r_tun_mask[i]);
+
+		if (w != v) {
+			writel(w, anv->s2r_tun_reg[i]);
+			changed++;
+		}
+	}
+	dev_dbg(anv->dev, "s2r: ANS tunables %d of %d rewritten\n", changed, anv->s2r_tun_n);
+}
+
 static bool apple_nvme_sleep_wait_on(struct apple_nvme *anv);
 
 static void apple_nvme_reset_work_impl(struct work_struct *work)
@@ -1872,6 +1921,17 @@ static void apple_nvme_reset_work_impl(struct work_struct *work)
 		writel(0, anv->mmio_coproc + APPLE_ANS_COPROC_CPU_CONTROL);
 	}
 
+	/*
+	 * After a firmware S2R power cut, the ANS lost power even if CPU_CONTROL
+	 * reads non-zero: force a cold start with its saved RTKit buffers kept,
+	 * SART power word and ADT tunables restored.
+	 */
+	if (anv->s2r_force_cold && !anv->hw->needs_ioq_registers) {
+		writel(0, anv->mmio_coproc + APPLE_ANS_COPROC_CPU_CONTROL);
+		anv->s2r_force_cold = false;
+		anv->s2r_cold = true;
+	}
+
 	/*
 	 * Only do the soft-reset if the CPU is not running, which means either we
 	 * or the previous stage shut it down cleanly.
@@ -1899,7 +1959,12 @@ static void apple_nvme_reset_work_impl(struct work_struct *work)
 		if (ret)
 			goto out;
 
-		ret = apple_rtkit_reinit(anv->rtk);
+		if (anv->s2r_idle_kept) {
+			anv->s2r_idle_kept = false;
+			ret = apple_rtkit_reinit_keep(anv->rtk);
+		} else {
+			ret = apple_rtkit_reinit(anv->rtk);
+		}
 		if (ret)
 			goto out;
 
@@ -1907,10 +1972,23 @@ static void apple_nvme_reset_work_impl(struct work_struct *work)
 		if (ret)
 			goto out;
 
+		if (anv->s2r_cold) {
+			u32 sp = readl(anv->mmio_nvme + APPLE_ANS_SART_POWER);
+
+			if (anv->sart_power_boot && sp != anv->sart_power_boot)
+				writel(anv->sart_power_boot, anv->mmio_nvme + APPLE_ANS_SART_POWER);
+			apple_rtkit_set_iop_ack_wait(anv->rtk, 25);
+			apple_nvme_s2r_tunables_apply(anv);
+		}
+
 		writel(APPLE_ANS_COPROC_CPU_CONTROL_RUN,
 		       anv->mmio_coproc + APPLE_ANS_COPROC_CPU_CONTROL);
 
 		ret = apple_rtkit_boot(anv->rtk);
+		if (anv->s2r_cold) {
+			apple_rtkit_set_iop_ack_wait(anv->rtk, 0);
+			anv->s2r_cold = false;
+		}
 	} else {
 		ret = apple_rtkit_wake(anv->rtk);
 	}
@@ -2154,6 +2232,8 @@ static void apple_nvme_reset_work_impl(struct work_struct *work)
 		ret = -ENODEV;
 		goto out_remove_sq;
 	}
+	if (!anv->sart_power_boot && !anv->hw->needs_ioq_registers)
+		anv->sart_power_boot = readl(anv->mmio_nvme + APPLE_ANS_SART_POWER);
 
 	/* M5 remains REBUILDING even if nvme_start_ctrl unquiesces. The
 	 * bounded PM owner, not this worker, releases admission and retention.
@@ -2672,6 +2752,7 @@ static struct apple_nvme *apple_nvme_alloc(struct platform_device *pdev)
 	}
 
 	INIT_WORK(&anv->ctrl.reset_work, apple_nvme_reset_work);
+	apple_nvme_s2r_tunables_init(anv);
 	INIT_WORK(&anv->remove_work, apple_nvme_remove_dead_ctrl_work);
 	INIT_WORK(&anv->recovery_work, apple_nvme_recovery_work);
 	spin_lock_init(&anv->lock);
@@ -3083,6 +3164,8 @@ static int apple_nvme_resume(struct device *dev)
 		WRITE_ONCE(anv->suspended, false);
 		return nvme_try_sched_reset(&anv->ctrl);
 	}
+	if (pm_resume_via_firmware())
+		anv->s2r_force_cold = true;
 	return nvme_reset_ctrl(&anv->ctrl);
 }
 
@@ -3243,7 +3326,15 @@ static int apple_nvme_suspend(struct device *dev)
 	}
 
 	if (apple_rtkit_is_running(anv->rtk)) {
-		ret = apple_rtkit_shutdown(anv->rtk);
+		if (pm_suspend_via_firmware() && pm_suspend_target_state == PM_SUSPEND_MEM) {
+			ret = apple_rtkit_idle(anv->rtk);
+			if (!ret) {
+				apple_rtkit_detach_keep(anv->rtk);
+				anv->s2r_idle_kept = true;
+			}
+		} else {
+			ret = apple_rtkit_shutdown(anv->rtk);
+		}
 
 		writel(0, anv->mmio_coproc + APPLE_ANS_COPROC_CPU_CONTROL);
 	}
diff --git a/drivers/soc/apple/pm_shim.c b/drivers/soc/apple/pm_shim.c
index c1d415c0bd74..39475eb46d99 100644
--- a/drivers/soc/apple/pm_shim.c
+++ b/drivers/soc/apple/pm_shim.c
@@ -182,7 +182,7 @@ static struct sep_pm_commit {
 	u64 reply, reply_mask;
 	void (*rx)(struct apple_mbox *mbox, struct apple_mbox_msg msg, void *cookie);
 	void *cookie;
-	bool registered, sent, answered, gate_valid;
+	bool registered, noirq_direct, sent, answered, gate_valid;
 	u8 reply_result;
 	unsigned int answer_us;
 	int gate_ret;
@@ -249,10 +249,12 @@ static int sep_pm_commit_stop(void *data)
 		}
 		udelay(SEP_PM_POLL_US);
 	}
-	ret = apple_dart_sleep_prepare(c->dart);
-	if (ret)
-		goto out;
-	prepared = true;
+	if (!c->noirq_direct) {
+		ret = apple_dart_sleep_prepare(c->dart);
+		if (ret)
+			goto out;
+		prepared = true;
+	}
 	/* The PM core's earlier check precedes the potentially long preparation. */
 	if (pm_wakeup_pending()) {
 		ret = -EBUSY;
@@ -289,23 +291,44 @@ static int sep_pm_commit_stop(void *data)
 	/* Preserve the failure reason without another hardware query. */
 	if (ret >= 0 && !c->answered)
 		ret = c->state & SEP_PS_DEV_DISABLE ? -EHOSTDOWN : -ETIMEDOUT;
-	if (c->answered && c->reply_result)
+	if (c->answered && c->reply_result && !c->noirq_direct)
 		ret = -EREMOTEIO;
 	/* Native cmsgSLEEP errors/abort/timeout are fatal, never cancellation. */
-	if (ret < 0)
-		panic("SEP SLEEP failed after send: ret %d reply_valid %d result %#x state %#x",
-		      ret, c->answered, c->reply_result, c->state);
+	if (ret < 0) {
+		if (!c->noirq_direct)
+			panic("SEP SLEEP failed after send: ret %d reply_valid %d result %#x state %#x",
+			      ret, c->answered, c->reply_result, c->state);
+		dev_warn(c->dev, "SEP SLEEP noirq failed: ret %d answered %d result %#x state %#x\n",
+			 ret, c->answered, c->reply_result, c->state);
+	}
 	/*
 	 * Native success-only receive close. No mailbox access follows it. The
 	 * held RX IRQ adapts native workloop exclusion; access-until-close is
 	 * the native contract, not proved atomic by the preceding PMGR sample.
+	 * On T6020 (noirq_direct), Aura's PSCI_S2R_SEP clears OUTBOX_CTRL and
+	 * gates ps_sep at the commit; clearing it from Linux causes an SError.
 	 */
-	apple_mbox_set_recv_enabled(c->mbox, false);
-	c->gate_ret = readl_poll_timeout_atomic(c->ps, c->state, c->state & SEP_PS_DEV_DISABLE,
-						SEP_PM_POLL_US, SEP_PM_TIMEOUT_US);
+	if (!c->noirq_direct) {
+		apple_mbox_set_recv_enabled(c->mbox, false);
+		c->gate_ret = readl_poll_timeout_atomic(
+			c->ps, c->state, c->state & SEP_PS_DEV_DISABLE,
+			SEP_PM_POLL_US, SEP_PM_TIMEOUT_US);
+	} else {
+		c->gate_ret = readl_poll_timeout_atomic(
+			c->ps, c->state,
+			(c->state & SEP_PS_DEV_DISABLE) ||
+			((c->state >> 24) == 0x10 && !(c->state & SEP_PS_ACTUAL)),
+			SEP_PM_POLL_US, SEP_PM_TIMEOUT_US);
+	}
 	c->gate_valid = true;
-	if (c->gate_ret)
-		panic("SEP SLEEP did not gate after send: %d state %#x", c->gate_ret, c->state);
+	if (c->gate_ret) {
+		if (!c->noirq_direct)
+			panic("SEP SLEEP did not gate after send: %d state %#x", c->gate_ret, c->state);
+		dev_warn(c->dev, "SEP SLEEP noirq did not gate: %d state %#x\n", c->gate_ret, c->state);
+	} else if (c->noirq_direct) {
+		dev_info(c->dev, "SEP SLEEP noirq ok: answered=%d result=%#x state=%#x\n",
+			 c->answered, c->reply_result, c->state);
+	}
 
 	return 0;
 }
@@ -321,13 +344,15 @@ int sep_pm_commit_prepare(void *ptr, void *mbox, u64 msg0, u32 msg1, u64 reply,
 	struct device *dev = ptr;
 	struct device_node *np;
 	struct resource res;
+	bool use_apple_sleep;
 	u32 offset;
 	int ret;
 
 	/* Check capability before resources that legacy providers need not have. */
-	if (!READ_ONCE(sep_pm_suspending) || !IS_ENABLED(CONFIG_APPLE_SOC_SLEEP) ||
-	    !is_kernel_in_hyp_mode())
+	if (!READ_ONCE(sep_pm_suspending))
 		return -EOPNOTSUPP;
+	use_apple_sleep = IS_ENABLED(CONFIG_APPLE_SOC_SLEEP) && is_kernel_in_hyp_mode() &&
+			  apple_sleep_commit_stops_coprocs();
 	if (c->registered)
 		return -EBUSY;
 	/* Reject ACK/counting/PSD transports before any request or MMIO. */
@@ -350,7 +375,7 @@ int sep_pm_commit_prepare(void *ptr, void *mbox, u64 msg0, u32 msg1, u64 reply,
 		ret = -ENODEV;
 		goto err;
 	}
-	c->ps = ioremap(res.start + offset, 4);
+	c->ps = ioremap_np(res.start + offset, 4);
 	if (!c->ps) {
 		ret = -ENOMEM;
 		goto err;
@@ -369,9 +394,16 @@ int sep_pm_commit_prepare(void *ptr, void *mbox, u64 msg0, u32 msg1, u64 reply,
 	c->gate_ret = -EINVAL;
 	c->gate_valid = false;
 	c->state = 0;
-	ret = apple_sleep_enclave_register(dev, sep_pm_commit_stop, c);
-	if (ret)
-		goto err;
+	c->noirq_direct = !use_apple_sleep;
+	if (use_apple_sleep) {
+		ret = apple_sleep_enclave_register(dev, sep_pm_commit_stop, c);
+		if (ret)
+			goto err;
+	} else {
+		ret = apple_dart_sleep_prepare(c->dart);
+		if (ret)
+			goto err;
+	}
 	c->registered = true;
 
 	return 0;
@@ -395,8 +427,10 @@ int sep_pm_commit_finish(void *ptr)
 		return -ENOENT;
 	if (c->sent && !pm_resume_via_firmware())
 		panic("SEP SLEEP was sent without a physical sleep/wake");
-	apple_sleep_enclave_unregister(c->dev);
+	if (!c->noirq_direct)
+		apple_sleep_enclave_unregister(c->dev);
 	c->registered = false;
+	c->noirq_direct = false;
 	dev_dbg(c->dev,
 		"sleep commit finished: sent=%d reply_valid=%d result=%#x answer_us=%u gate_valid=%d gate_ret=%d state=%#x\n",
 		c->sent, c->answered, c->reply_result, c->answer_us,
@@ -433,10 +467,15 @@ static int __maybe_unused sep_pm_suspend(struct device *dev)
 /* The last step before the platform's own: the domain has to be down by now. */
 static int __maybe_unused sep_pm_suspend_noirq(struct device *dev)
 {
+	struct sep_pm_commit *c = &sep_pm_commit;
 	bool (*told)(void) = READ_ONCE(sep_pm_told);
 	int ret;
 
-	if (!pm_suspend_via_firmware() || !told || !told())
+	if (!pm_suspend_via_firmware())
+		return 0;
+	if (c->registered && c->noirq_direct && c->dev == dev)
+		return sep_pm_commit_stop(c);
+	if (!told || !told())
 		return 0;
 
 	ret = sep_pm_wait_gated(dev, 5000);
diff --git a/drivers/soc/apple/pmp.rs b/drivers/soc/apple/pmp.rs
index afc8a973f771..4f7f8e41cbad 100644
--- a/drivers/soc/apple/pmp.rs
+++ b/drivers/soc/apple/pmp.rs
@@ -863,6 +863,15 @@ enum Ep7 {
     Always,
 }
 
+/// T6020: PMP's 1 MiB SRAM does not survive a power-cutting S2R; save and
+/// restore the full region around the sleep so the firmware restarts warm.
+const HW_CFG_T6020: PmpHwConfig = PmpHwConfig {
+    dma_mask: None,
+    check_bootargs_uuid: false,
+    coreanalytics: Ep7::No,
+    sram_backup: Some((0, 0x100000)),
+};
+
 const HW_CFG_DEFAULT: PmpHwConfig = PmpHwConfig {
     dma_mask: None,
     check_bootargs_uuid: false,
@@ -933,6 +942,7 @@ fn drop(&mut self) {
         (of::DeviceId::new(c"apple,t8142-pmp-v2"), &HW_CFG_T8142),
         (of::DeviceId::new(c"apple,t6041-pmp-v2"), &HW_CFG_T6041),
         (of::DeviceId::new(c"apple,t6050-pmp-v2"), &HW_CFG_T6050),
+        (of::DeviceId::new(c"apple,t6020-pmp-v2"), &HW_CFG_T6020),
         (of::DeviceId::new(c"apple,t6000-pmp-v2"), &HW_CFG_DEFAULT),
     ]
 );
