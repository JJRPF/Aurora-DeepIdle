 /// Trait used to abstract the firmware/GPU-dependent variants of the GpuManager.
@@ -1040,6 +1047,7 @@ fn make_mgr(
                 io_mappings: KVec::new(),
                 next_mmio_iova: IOVA_KERN_MMIO_RANGE.start,
                 rtkit <- new_mutex!(None, "rtkit"),
