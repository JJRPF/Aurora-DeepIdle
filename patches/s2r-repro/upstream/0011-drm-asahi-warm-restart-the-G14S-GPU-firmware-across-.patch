     }
+
+    fn sleep_prepare(&self) -> Result {
+        if self.is_crashed() {
+            dev_warn!(
+                self.dev.as_ref(),
+                "s2r: GPU firmware already crashed before sleep; skipping idle\n"
+            );
+            return Ok(());
+        }
+        let mut guard = self.rtkit.lock();
+        let rtk = guard.as_mut().as_pin_mut().ok_or(ENODEV)?;
+        rtk.idle()?;
+        self.sleep_idled.store(true, Ordering::Release);
+        dev_info!(self.dev.as_ref(), "s2r: GPU firmware idled for sleep\n");
+        Ok(())
+    }
+
+    fn sleep_complete(&self, start_cpu: &dyn Fn()) {
+        if !self.sleep_idled.swap(false, Ordering::AcqRel) {
+            return;
+        }
+        // SAFETY: Reads a global PM flag word.
+        let real = unsafe { kernel::bindings::pm_resume_via_firmware() };
+        let res = {
+            let mut guard = self.rtkit.lock();
+            if guard.is_none() {
+                Err(ENODEV)
+            } else if !real {
+                guard.as_mut().as_pin_mut().unwrap().wake()
+            } else {
+                guard
+                    .as_mut()
+                    .as_pin_mut()
+                    .unwrap()
+                    .warm_restart()
+                    .and_then(|()| {
+                        start_cpu();
+                        guard.as_mut().as_pin_mut().unwrap().boot()
+                    })
+            }
+        };
+        match res {
+            Ok(()) => {
+                let kick = self.kick_firmware();
+                dev_info!(
+                    self.dev.as_ref(),
+                    "s2r: GPU firmware {} (kick {:?})\n",
+                    if real {
+                        "restarted warm"
+                    } else {
+                        "woken after refused sleep"
+                    },
+                    kick
+                );
+            }
+            Err(e) => {
+                self.crashed.store(true, Ordering::Relaxed);
+                dev_err!(
+                    self.dev.as_ref(),
+                    "s2r: GPU firmware {} failed: {:?}\n",
+                    if real { "warm restart" } else { "wake" },
+                    e
+                );
+            }
+        }
+    }
 }
 
