+/// Mapped ASC CPU control register for starting/restarting the legacy GPU coprocessor.
+pub(crate) struct AscControl<'drm> {
+    mmio: IoMem<'drm, ASC_CTL_SIZE>,
+}
+
+impl AscControl<'_> {
+    pub(crate) fn new<'bound>(
+        pdev: &'bound platform::Device<Core<'_>>,
+    ) -> Result<AscControl<'bound>> {
+        let asc_req = pdev.io_request_by_name(c_str!("asc")).ok_or(EINVAL)?;
+        let mmio = asc_req.iomap_sized::<ASC_CTL_SIZE>()?;
+        Ok(AscControl { mmio })
+    }
+
+    pub(crate) fn start_cpu(&self) {
+        self.mmio
+            .as_view()
+            .relaxed()
+            .update(ASC_CPU_CONTROL, |r| r.with_const_cpu_run::<1>());
+    }
+}
+
 /// Device resources for this GPU instance.
 pub(crate) struct Resources<'drm> {
     dev: ARef<platform::Device>,
@@ -356,15 +378,6 @@ pub(crate) fn init_mmio(&self) -> Result {
         Ok(())
     }
 
