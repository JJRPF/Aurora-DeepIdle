+    /// Prepare the GPU firmware for a firmware-driven system sleep (S2R).
+    fn sleep_prepare(&self) -> Result {
+        Err(EBUSY)
+    }
+    /// Restart or wake the GPU firmware after a system sleep.
+    fn sleep_complete(&self, _start_cpu: &dyn Fn()) {}
