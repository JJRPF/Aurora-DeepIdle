 	if (!query)
@@ -717,6 +719,8 @@ static void disp_service_init(struct apple_epic_service *service, const char *na
 		return;
 	}
 	smp_store_release(&service->cookie, query);
+	if (!dcp->external)
+		return;
 	ret = dcpext_scanout_register(dcp);
 	if (ret && ret != -ENODEV)
 		dev_warn(dcp->dev, "external pattern interface unavailable: %d\n", ret);
@@ -741,6 +745,88 @@ static const struct apple_epic_service_ops external_ibootep_ops[] = {
 	{}
 };
 
+static int iboot_s2r_pick(struct iboot_query *query, u32 op, u8 *reply, u8 *out)
+{
+	const u8 *payload, *mode;
+	size_t size;
+	u32 count, i;
+	int ret, best = -1;
+
+	ret = iboot_read_query(query, op, reply, &payload, &size);
+	if (!ret)
+		ret = iboot_parse_modes(payload, size, &count);
+	if (ret)
+		return ret;
+	for (i = 0; i < count; i++) {
+		mode = payload + 4 + i * IBOOT_MODE_SIZE;
+		if (get_unaligned_le32(mode) != 1)
+			continue;
+		if (best < 0)
+			best = i;
+		if (op == IBOOT_GET_COLOR_MODES && get_unaligned_le32(mode + 12) == 1 &&
+		    get_unaligned_le32(mode + 16) == 32) {
+			best = i;
+			break;
+		}
+		if (op == IBOOT_GET_TIMING_MODES)
+			break;
+	}
+	if (best < 0)
+		return -ENODATA;
+	memcpy(out, payload + 4 + best * IBOOT_MODE_SIZE, IBOOT_MODE_SIZE);
+	return 0;
+}
+
+/*
+ * After a post-S2R cold restart of the internal DCP, drive the iBoot disp0
+ * service (SetPower(1), HPD/mode query, SetMode) so IOMFB's start_ios_gated()
+ * finds the panel powered and initialized as iBoot hands it over.
+ */
+int ibootep_s2r_bringup(struct apple_dcp *dcp)
+{
+	struct iboot_query *query = ERR_PTR(-EAGAIN);
+	u8 modes[2 * IBOOT_MODE_SIZE], power = 1;
+	u8 *reply;
+	int ret, n;
+
+	WRITE_ONCE(ibootep_s2r_internal, true);
+	if (!dcp->ibootep) {
+		ret = ibootep_init(dcp);
+		if (ret)
+			return ret;
+	}
+	for (n = 0; n < 60; n++) {
+		query = iboot_find_query(dcp);
+		if (!IS_ERR(query))
+			break;
+		msleep(50);
+	}
+	if (IS_ERR(query))
+		return PTR_ERR(query);
+	reply = kzalloc(IBOOT_QUERY_RX_SIZE, GFP_KERNEL);
+	if (!reply)
+		return -ENOMEM;
+	ret = iboot_pattern_command(query, 2, &power, sizeof(power), reply);
+	if (ret)
+		goto out;
+	msleep(100);
+	for (n = 0; n < 10; n++) {
+		ret = iboot_refresh_modes(query, reply);
+		if (ret != -ENOLINK)
+			break;
+		msleep(100);
+	}
+	ret = iboot_s2r_pick(query, IBOOT_GET_TIMING_MODES, reply, modes);
+	if (!ret)
+		ret = iboot_s2r_pick(query, IBOOT_GET_COLOR_MODES, reply, modes + IBOOT_MODE_SIZE);
+	if (ret)
+		goto out;
+	ret = iboot_pattern_command(query, 6, modes, sizeof(modes), reply);
+out:
+	kfree(reply);
+	return ret;
+}
