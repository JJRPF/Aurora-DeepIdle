From 2b80a72d7ee0daccbb38c03bf4722b9fc8237c8d Mon Sep 17 00:00:00 2001
From: Justin Pfister <git@jjrpf.com>
Date: Thu, 26 Nov 2026 10:17:17 -0500
Subject: [PATCH 07/15] soc: apple: rtkit: keep state across a firmware sleep

Add reinit_keep and detach_keep, an optional IOP acknowledgement wait, and the helpers drivers
need to restart a co-processor firmware that was idled or powered off by a system sleep.

Signed-off-by: Justin Pfister <git@jjrpf.com>
---
 drivers/soc/apple/rtkit-internal.h |  1 +
 drivers/soc/apple/rtkit.c          | 74 ++++++++++++++++++++++++++++++
 include/linux/soc/apple/rtkit.h    |  4 ++
 3 files changed, 79 insertions(+)

diff --git a/drivers/soc/apple/rtkit-internal.h b/drivers/soc/apple/rtkit-internal.h
index d953d8c0d6c4..1f7280cbce9e 100644
--- a/drivers/soc/apple/rtkit-internal.h
+++ b/drivers/soc/apple/rtkit-internal.h
@@ -61,6 +61,7 @@ struct apple_rtkit {
 
 	unsigned int iop_power_state;
 	unsigned int ap_power_state;
+	unsigned int iop_ack_extra_s;
 	bool crashed;
 	bool shutting_down;
 	/*
diff --git a/drivers/soc/apple/rtkit.c b/drivers/soc/apple/rtkit.c
index e529b4d4dd4c..212e954567a5 100644
--- a/drivers/soc/apple/rtkit.c
+++ b/drivers/soc/apple/rtkit.c
@@ -2618,6 +2618,61 @@ int apple_rtkit_reinit(struct apple_rtkit *rtk)
 }
 EXPORT_SYMBOL_GPL(apple_rtkit_reinit);
 
+/*
+ * Like apple_rtkit_reinit(), but for a coprocessor that was put to idle and
+ * resumes from its saved context. It keeps its shared buffers mapped; only the
+ * mailbox and the power handshake restart.
+ */
+int apple_rtkit_reinit_keep(struct apple_rtkit *rtk)
+{
+	unsigned long flags;
+	int ret;
+
+	apple_rtkit_detach_rx(rtk);
+	flush_workqueue(rtk->wq);
+
+	bitmap_zero(rtk->endpoints, APPLE_RTKIT_MAX_ENDPOINTS);
+	set_bit(APPLE_RTKIT_EP_MGMT, rtk->endpoints);
+	bitmap_zero(rtk->started, APPLE_RTKIT_MAX_ENDPOINTS);
+	set_bit(APPLE_RTKIT_EP_MGMT, rtk->started);
+
+	reinit_completion(&rtk->epmap_completion);
+	reinit_completion(&rtk->coreanalytics_completion);
+	reinit_completion(&rtk->iop_pwr_ack_completion);
+	reinit_completion(&rtk->ap_pwr_ack_completion);
+
+	rtk->crashed = false;
+	rtk->iop_power_state = APPLE_RTKIT_PWR_STATE_OFF;
+	rtk->ap_power_state = APPLE_RTKIT_PWR_STATE_OFF;
+	kfifo_reset(&rtk->sync_ack_fifo);
+
+	spin_lock_irqsave(&rtk->mbox->rx_lock, flags);
+	WRITE_ONCE(rtk->shutting_down, false);
+	rtk->mbox->rx = apple_rtkit_rx;
+	spin_unlock_irqrestore(&rtk->mbox->rx_lock, flags);
+
+	ret = apple_mbox_start(rtk->mbox);
+	if (ret) {
+		apple_rtkit_detach_rx(rtk);
+		flush_workqueue(rtk->wq);
+	}
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_reinit_keep);
+
+void apple_rtkit_detach_keep(struct apple_rtkit *rtk)
+{
+	apple_rtkit_detach_rx(rtk);
+	flush_workqueue(rtk->wq);
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_detach_keep);
+
+void apple_rtkit_set_iop_ack_wait(struct apple_rtkit *rtk, unsigned int seconds)
+{
+	rtk->iop_ack_extra_s = seconds;
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_set_iop_ack_wait);
+
 static int apple_rtkit_set_ap_power_state(struct apple_rtkit *rtk,
 					  unsigned int state)
 {
@@ -2705,6 +2760,14 @@ static int apple_rtkit_boot_common(struct apple_rtkit *rtk, bool early_ap_power,
 
 	dev_dbg(rtk->dev, "RTKit: waiting for IOP power state ACK\n");
 	ret = apple_rtkit_wait(rtk, &rtk->iop_pwr_ack_completion);
+	if (ret == -ETIME && rtk->iop_ack_extra_s) {
+		unsigned int i;
+
+		for (i = 0; ret == -ETIME && i < rtk->iop_ack_extra_s && !rtk->crashed; i++)
+			ret = apple_rtkit_wait(rtk, &rtk->iop_pwr_ack_completion);
+		dev_info(rtk->dev, "RTKit: IOP power ack %s after %u s more\n",
+			 ret ? "still missing" : "came", i);
+	}
 	if (ret) {
 		dev_err(rtk->dev, "RTKit: IOP power acknowledgment failed: %d\n", ret);
 		return ret;
@@ -3320,6 +3383,17 @@ int apple_rtkit_power_cycled_return(struct apple_rtkit *rtk, void __iomem *cpu_c
 }
 EXPORT_SYMBOL_GPL(apple_rtkit_power_cycled_return);
 
+int apple_rtkit_restore_mbox(struct apple_rtkit *rtk)
+{
+	int ret;
+
+	ret = apple_mbox_restore(rtk->mbox);
+	if (!ret)
+		apple_mbox_set_recv_enabled(rtk->mbox, true);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_restore_mbox);
+
 void apple_rtkit_set_oslog_echo(struct apple_rtkit *rtk, bool echo)
 {
 	rtk->oslog_echo = echo;
diff --git a/include/linux/soc/apple/rtkit.h b/include/linux/soc/apple/rtkit.h
index 4db916bb89f0..ae27e679a972 100644
--- a/include/linux/soc/apple/rtkit.h
+++ b/include/linux/soc/apple/rtkit.h
@@ -210,6 +210,9 @@ void apple_rtkit_free_retaining_buffers(struct apple_rtkit *rtk);
  * is held in reset.
  */
 int apple_rtkit_reinit(struct apple_rtkit *rtk);
+int apple_rtkit_reinit_keep(struct apple_rtkit *rtk);
+void apple_rtkit_detach_keep(struct apple_rtkit *rtk);
+void apple_rtkit_set_iop_ack_wait(struct apple_rtkit *rtk, unsigned int seconds);
 
 /*
  * Set how long each handshake step (power state and endpoint map replies)
@@ -398,6 +401,7 @@ int apple_rtkit_power_cycled_return(struct apple_rtkit *rtk, void __iomem *cpu_c
  * firmware can be started in between. -EOPNOTSUPP after a sleep that kept the power.
  */
 int apple_rtkit_sleep_return_start(struct apple_rtkit *rtk, void __iomem *cpu_control);
+int apple_rtkit_restore_mbox(struct apple_rtkit *rtk);
 
 /*
  * Echo each OSLOG channel-0 counter the firmware sends, as macOS does. On by default on
-- 
