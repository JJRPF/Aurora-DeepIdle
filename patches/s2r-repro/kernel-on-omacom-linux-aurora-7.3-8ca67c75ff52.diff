+/*
+ * Post-S2R cold restart of the internal DCP on T602x:
+ * At firmware-driven S2R suspend, shut down the DCP firmware so its power
+ * domains can gate. After the wake, restore __DATA from apple/dcp-fw.macho
+ * (keeping iBoot's RTKit tagged parameter block), cold-start RTKit, run the
+ * iBoot disp0 bring-up (SetPower(1), HPD, SetMode), and call dcp_start().
+ */
+static bool s2r_fw_restart = true;
+module_param(s2r_fw_restart, bool, 0644);
+MODULE_PARM_DESC(s2r_fw_restart, "Cold-restart internal DCP after firmware S2R using apple/dcp-fw.macho");
+
+static const struct firmware *dcp_fw_s2r_img;
+static struct apple_dcp *dcp_fw_s2r_target;
+static void dcp_fw_s2r_work_fn(struct work_struct *w);
+static DECLARE_DELAYED_WORK(dcp_fw_s2r_work, dcp_fw_s2r_work_fn);
+
+static int dcp_fw_s2r_macho_seg(const u8 *b, size_t len, const char *name,
+				u64 *vmaddr, u64 *fo, u64 *fs)
+{
+	u32 ncmds, i, off = 32;
+
+	if (len < 32 || get_unaligned_le32(b) != 0xfeedfacf)
+		return -EINVAL;
+	ncmds = get_unaligned_le32(b + 16);
+	for (i = 0; i < ncmds && off + 72 <= len; i++) {
+		u32 cmd = get_unaligned_le32(b + off);
+		u32 sz = get_unaligned_le32(b + off + 4);
+
+		if (cmd == 0x19 && !strncmp((const char *)b + off + 8, name, 16)) {
+			*vmaddr = get_unaligned_le64(b + off + 24);
+			*fo = get_unaligned_le64(b + off + 40);
+			*fs = get_unaligned_le64(b + off + 48);
+			return (*fo + *fs <= len) ? 0 : -EINVAL;
+		}
+		if (!sz)
+			break;
+		off += sz;
+	}
+	return -ENOENT;
+}
+
+/* Read __TEXT and __DATA physical addresses from Aura's /chosen/aurora-adt-dcp0-nub. */
+static int dcp_fw_s2r_adt_segments(u64 *text_phys, u64 *data_phys)
+{
+	struct device_node *np = of_find_node_by_path("/chosen/aurora-adt-dcp0-nub");
+	const char *names, *p;
+	const u8 *ranges;
+	int nlen = 0, rlen = 0, idx = 0;
+	bool got_text = false, got_data = false;
+
+	if (!np)
+		return -ENOENT;
+	names = of_get_property(np, "segment-names", &nlen);
+	ranges = of_get_property(np, "segment-ranges", &rlen);
+	if (!names || !ranges || rlen < 32) {
+		of_node_put(np);
+		return -ENOENT;
+	}
+	for (p = names; p < names + nlen && (idx + 1) * 32 <= rlen; idx++) {
+		const char *sep = memchr(p, ';', (names + nlen) - p);
+		size_t slen = sep ? (size_t)(sep - p) : strnlen(p, (names + nlen) - p);
+		u64 phys = get_unaligned_le64(ranges + idx * 32);
+
+		if (slen == 6 && !memcmp(p, "__TEXT", 6)) {
+			*text_phys = phys;
+			got_text = true;
+		} else if (slen == 6 && !memcmp(p, "__DATA", 6)) {
+			*data_phys = phys;
+			got_data = true;
+		}
+		if (!sep)
+			break;
+		p = sep + 1;
+	}
+	of_node_put(np);
+	return (got_text && got_data) ? 0 : -ENOENT;
+}
+
+static int dcp_fw_s2r_restore_data(struct apple_dcp *dcp)
+{
+	u64 text_phys = 0, data_phys = 0;
+	u64 va, fo, fs, tva, tfo, tfs;
+	u32 keep_va = 0, keep_len = 0;
+	size_t i, tdiff = 0;
+	void *m;
+
+	if (!dcp_fw_s2r_img)
+		return -ENOENT;
+	if (dcp_fw_s2r_adt_segments(&text_phys, &data_phys)) {
+		dev_warn(dcp->dev, "s2r: /chosen/aurora-adt-dcp0-nub segments not found\n");
+		return -ENOENT;
+	}
+	if (dcp_fw_s2r_macho_seg(dcp_fw_s2r_img->data, dcp_fw_s2r_img->size,
+				 "__TEXT", &tva, &tfo, &tfs) ||
+	    dcp_fw_s2r_macho_seg(dcp_fw_s2r_img->data, dcp_fw_s2r_img->size,
+				 "__DATA", &va, &fo, &fs)) {
+		dev_warn(dcp->dev, "s2r: Mach-O __TEXT/__DATA segments not found\n");
+		return -EINVAL;
+	}
+	m = memremap(text_phys, tfs, MEMREMAP_WC);
+	if (!m)
+		return -ENOMEM;
+	for (i = 0; i < tfs; i += 4) {
+		if (*(u32 *)(m + i) != get_unaligned_le32(dcp_fw_s2r_img->data + tfo + i))
+			tdiff++;
+	}
+	if (tfs >= 0x1230) {
+		keep_va = *(u32 *)(m + 0x1228);
+		keep_len = *(u32 *)(m + 0x122c);
+	}
+	memunmap(m);
+	if (tdiff > 16) {
+		dev_warn(dcp->dev, "s2r: __TEXT mismatch (%zu words), skipping __DATA restore\n",
+			 tdiff);
+		return -EINVAL;
+	}
+	m = memremap(data_phys, fs, MEMREMAP_WC);
+	if (!m)
+		return -ENOMEM;
+	{
+		u64 ks = (keep_va >= va && keep_len) ? (keep_va - va) : fs;
+		u64 ke = ks + keep_len;
+
+		if (ke > fs)
+			ks = ke = fs;
+		memcpy(m, dcp_fw_s2r_img->data + fo, ks);
+		memcpy(m + ke, dcp_fw_s2r_img->data + fo + ke, fs - ke);
+		wmb();
+	}
+	memunmap(m);
+	dev_info(dcp->dev, "s2r: restored DCP __DATA (%#llx bytes, kept iBoot block %#x+%#x)\n",
+		 fs, keep_va, keep_len);
+	return 0;
+}
+
+static void dcp_fw_s2r_work_fn(struct work_struct *w)
+{
+	struct apple_dcp *dcp = dcp_fw_s2r_target;
+	u32 ctl;
+	int ret, n;
+
+	if (!dcp)
+		return;
+	ret = dcp_fw_s2r_restore_data(dcp);
+	if (ret) {
+		dev_err(dcp->dev, "s2r: DCP __DATA restore failed: %d\n", ret);
+		return;
+	}
+	ctl = readl(dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL);
+	writel(ctl | APPLE_DCP_COPROC_CPU_CONTROL_RUN,
+	       dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL);
+	ret = apple_rtkit_reinit(dcp->rtk);
+	if (ret) {
+		dev_err(dcp->dev, "s2r: DCP rtkit reinit failed: %d\n", ret);
+		return;
+	}
+	ret = apple_rtkit_wake(dcp->rtk);
+	for (n = 0; ret == -ETIME && n < 3; n++)
+		ret = apple_rtkit_boot(dcp->rtk);
+	if (ret) {
+		dev_err(dcp->dev, "s2r: DCP rtkit wake failed: %d\n", ret);
+		return;
+	}
+	WRITE_ONCE(dcp->crashed, false);
+	WRITE_ONCE(dcp->ext_dead, false);
+	ret = ibootep_s2r_bringup(dcp);
+	if (ret)
+		dev_warn(dcp->dev, "s2r: DCP iBoot disp0 bring-up failed: %d\n", ret);
+	ret = dcp_start(to_platform_device(dcp->dev));
+	dev_info(dcp->dev, "s2r: internal DCP cold restart complete (%d)\n", ret);
+}
+
+static bool dcp_fw_s2r_suspend(struct apple_dcp *dcp)
+{
+	int ret;
+
+	if (!READ_ONCE(s2r_fw_restart) || pm_suspend_target_state != PM_SUSPEND_MEM ||
+	    !pm_suspend_via_firmware() || IS_ERR_OR_NULL(dcp->rtk) ||
+	    READ_ONCE(dcp->crashed))
+		return false;
+	if (!dcp->external && !dcp_fw_s2r_img) {
+		ret = firmware_request_nowarn(&dcp_fw_s2r_img, "apple/dcp-fw.macho", dcp->dev);
+		if (ret) {
+			dcp_fw_s2r_img = NULL;
+			dev_dbg(dcp->dev, "s2r: apple/dcp-fw.macho not available (%d)\n", ret);
+		}
+	}
+	ret = apple_rtkit_shutdown(dcp->rtk);
+	if (ret) {
+		dev_warn(dcp->dev, "s2r: DCP firmware shutdown failed: %d\n", ret);
+		return false;
+	}
+	if (!IS_ERR_OR_NULL(dcp->coproc_reg))
+		writel(0, dcp->coproc_reg + APPLE_DCP_COPROC_CPU_CONTROL);
+	WRITE_ONCE(dcp->crashed, true);
+	WRITE_ONCE(dcp->ext_dead, true);
+	if (!dcp->external && dcp_fw_s2r_img)
+		dcp_fw_s2r_target = dcp;
+	return true;
+}
