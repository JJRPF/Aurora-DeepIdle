+/* J414c retention only. No PMGR sleep commit or legacy T6020 MMIO replay. */
+static unsigned long psci_j414c_retention(unsigned long entry, unsigned long context)
+{
+    if (!entry || !aic || aic->version != 2 || wake_irq[0] >= aic->nr_irq ||
+        !wdt_psci_base())
+        return PSCI_RET_INTERNAL_FAILURE;
+
+    /* The tested J414c has four cores in each of its three clusters. */
+    for (unsigned cluster = 0; cluster < 3; cluster++) {
+        for (unsigned core = 0; core < 4; core++) {
+            u64 mpidr = cluster ? (BIT(16) | (cluster << 8) | core) : core;
+            if (mpidr && smp_psci_affinity_info(mpidr) != PSCI_AFFINITY_INFO_OFF)
+                return PSCI_RET_DENIED;
+        }
+    }
+
+    unsigned irq = wake_irq[0]; /* J414c RTC: nub-spmi0, AIC die 0, IRQ 724. */
+    u32 bit = BIT(irq & 31);
+    u64 raw = wake_hw_word(0);
+    if (read32(raw) & bit)
+        return PSCI_RET_DENIED;
+
+    static bool rtc_poll_passed;
+    u64 saved_daif = mrs(DAIF);
+    /* WFI wakes on a pending interrupt with DAIF masked. Linux handles it after resume. */
+    asm volatile("msr daifset, #0xf\n isb" ::: "memory");
+    wdt_psci_arm(35);
+    write32(aic->base + aic->regs.mask_clr + 4 * (irq >> 5), bit);
+    sysop("dsb sy");
+
+    if (!rtc_poll_passed) {
+        /* Control: prove the PMU line asserts after Linux has suspended devices. */
+        u64 stop = mrs(CNTPCT_EL0) + 24 * mrs(CNTFRQ_EL0);
+        while (!(read32(raw) & bit) && mrs(CNTPCT_EL0) < stop)
+            sysop("yield");
+        rtc_poll_passed = !!(read32(raw) & bit);
+    } else {
+        u64 cyc = mrs(SYS_IMP_APL_CYC_OVRD);
+        msr(SYS_IMP_APL_CYC_OVRD,
+            (cyc & ~(CYC_OVRD_WFI_MODE_MASK | CYC_OVRD_DISABLE_WFI_RET)) | CYC_OVRD_WFI_MODE(3));
+        sysop("isb");
+        extern void _deep_wfi_helper(void);
+        do {
+            _deep_wfi_helper();
+        } while (!(read32(raw) & bit));
+        msr(SYS_IMP_APL_CYC_OVRD, cyc);
+        sysop("isb");
+    }
+
+    write32(aic->base + aic->regs.mask_set + 4 * (irq >> 5), bit);
+    wdt_psci_disarm();
+    if (!rtc_poll_passed) {
+        msr(DAIF, saved_daif);
+        return PSCI_RET_INTERNAL_FAILURE;
+    }
+    psci_enter(entry, context);
+}
