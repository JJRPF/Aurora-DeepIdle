+/// Runs after every device's suspend callback: the legacy GPU's firmware is idled here.
+unsafe extern "C" fn sleep_late(dev: *mut bindings::device) -> core::ffi::c_int {
+    // SAFETY: Reads a global flag word.
+    if !unsafe { bindings::pm_suspend_via_firmware() }
+        || crate::module_parameters::g14_s2r_idle_late.value() == 0
+    {
+        return 0;
+    }
+    // SAFETY: Called by the PM core.
+    let data = unsafe { sleep_data(dev) };
+    match data.legacy.as_ref() {
+        Some(gpu) => kernel::error::from_result(|| gpu.sleep_prepare().map(|_| 0)),
+        None => 0,
+    }
+}
