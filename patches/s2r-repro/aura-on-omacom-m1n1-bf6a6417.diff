+        qs_save.aon[i] = read32(qs_aon[i]);
+    qs_save.saved |= 2048;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+    for (unsigned i = 0; i < 4; i++) {
+        write32(qs_aon[i], qs_save.aon[i] & ~QS_PS_CLEAR);
+        fail |= (u64)qs_poll(qs_aon[i], 0xf0, 0, 10000) << (55 + i);
+    }
+    psci_dbg[23] |= fail;
+}
+
+/* image 65: pmp (0x28e0802c8), then pms_sram (0x28e0802d0); both on image 58's dispext page of the PSCI map.
+ * psci_dbg[23] bits 59-60 = poll timeouts */
+static const u64 qs_pmp[2] = {0x28e0802c8ULL, 0x28e0802d0ULL};
+
+static void psci_quiesce_pmp(void)
+{
+    u64 fail = 0;
+
+    for (unsigned i = 0; i < 2; i++)
+        qs_save.pmp[i] = read32(qs_pmp[i]);
+    qs_save.saved |= 4096;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+    for (unsigned i = 0; i < 2; i++) {
+        write32(qs_pmp[i], qs_save.pmp[i] & ~QS_PS_CLEAR);
+        fail |= (u64)qs_poll(qs_pmp[i], 0xf0, 0, 10000) << (59 + i);
+    }
+    psci_dbg[23] |= fail;
+}
+
+/*
+ * image 67: the secure enclave as macOS has it at sleep entry. Linux has sent the SLEEP control message and got the
+ * ack (apple_sep test_sleep_msg); after it the enclave holds its PS_AUTO floor at f (ps_sep 0x1f0003ff, run R18D)
+ * until the mailbox's OUTBOX_CTRL enable (bit 0) is cleared, then drops it within 200 ms (0x1000070f, R18F), and the
+ * host's write of 0x1000030f then takes. Done from Linux, the system hangs within 10 s (R18F to R18H), so it is
+ * done here, as the first step of the quiesce (image 68). qs_sep_res for the crumb: 0x10 = ran, bit 2 = the outbox enable did not clear, bit 3 = the word
+ * is not 0x10....0f at the end. psci_dbg2[47] = the word (high) and OUTBOX_CTRL (low) read back.
+ */
+#define QS_SEP_OUTBOX_CTRL 0x396408114ULL
+#define QS_PS_SEP          0x290280c00ULL
+static u8 qs_sep_res;
+
+static void psci_quiesce_sep(void)
+{
+    u32 w = 0, ob;
+
+    /*
+     * image 69: OUTBOX_CTRL is read back at once and the mailbox is not touched again. Images 67 and 68 read it
+     * after the word write and hung there (R18I, R18J: crumb 0x18): once the enclave has dropped its floor its
+     * domain is gated and the mailbox, which sits in it, no longer answers. The same access is what hung Linux
+     * (R18F to R18H).
+     */
+    write32(QS_SEP_OUTBOX_CTRL, read32(QS_SEP_OUTBOX_CTRL) & ~1u);
+    ob = read32(QS_SEP_OUTBOX_CTRL);
+    sysop("dsb sy");
+    for (unsigned i = 0; i < 500; i++) {
+        w = read32(QS_PS_SEP);
+        if ((w >> 24) == 0x10)
+            break;
+        udelay(1000);
+    }
+    write32(QS_PS_SEP, 0x1000030f);
+    sysop("dsb sy");
+    udelay(1000);
+    w = read32(QS_PS_SEP);
+    qs_sep_res = 0x10;
+    if (ob & 1)
+        qs_sep_res |= 4;
+    if ((w >> 24) != 0x10 || (w & 0xff) != 0x0f)
+        qs_sep_res |= 8;
+    psci_dbg2[47] = ((u64)w << 32) | ob;
+}
+
+/* for the crumb: 0x40 = the step ran, bit 0 pmp still on, bit 1 pms_sram still on */
+static u8 qs_pmp_state(void)
+{
+    u8 b = 0x40;
+
+    for (unsigned i = 0; i < 2; i++)
+        if (read32(qs_pmp[i]) & 0xf0)
+            b |= BIT(i);
+    return b;
+}
+
+/* image 64: bits 0-2 = qs_pcie[i] still on, bits 3-6 = qs_aon[i] still on (each only if its step ran); for the crumb */
+static u8 qs_pcie_aon_state(void)
+{
+    u8 b = 0;
+
+    if (qs_save.saved & 1024)
+        for (unsigned i = 0; i < 3; i++)
+            if (read32(qs_pcie[i]) & 0xf0)
+                b |= BIT(i);
+    if (qs_save.saved & 2048)
+        for (unsigned i = 0; i < 4; i++)
+            if (read32(qs_aon[i]) & 0xf0)
+                b |= BIT(3 + i);
+    return b;
+}
+
+/* image 71: @mask = the clusters to touch (bit = index); a cluster left out is saved as ~0 and skipped by the undo */
+static void psci_quiesce_dvfs(unsigned mask)
+{
+    u32 fail = 0;
+
+    for (unsigned i = 0; i < 3; i++)
+        qs_save.dvfs[i] = (mask & BIT(i)) ? read64(qs_dvfs_base[i] + QS_DVFS_PSTATE) : ~0ULL;
+    qs_save.saved |= 128;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+    for (unsigned i = 0; i < 3; i++) {
+        u64 a = qs_dvfs_base[i] + QS_DVFS_PSTATE;
+        if (!(mask & BIT(i)))
+            continue;
+        write64(a, read64(a) | QS_DVFS_APSC_DIS);
+        fail |= qs_poll(a, QS_DVFS_APSC_BUSY, 0, 10000) << (28 + i);
+    }
+    /* psci_dbg2 words 48..50: the low half before (high 32 bits) and after (low 32 bits) */
+    for (unsigned i = 0; i < 3; i++)
+        psci_dbg2[48 + i] = (mask & BIT(i)) ? (qs_save.dvfs[i] << 32) | (u32)read64(qs_dvfs_base[i] + QS_DVFS_PSTATE) : ~0ULL;
+    psci_dbg[23] |= fail;
+}
+
+static void psci_quiesce_undo(void)
+{
+    dc_ivac_range((void *)&qs_save, sizeof(qs_save));
+    if (qs_save.saved & 256) {
+        for (unsigned i = 0; i < 3; i++)
+            write32(qs_fabric[i], qs_save.fabric[i] & ~0x300);
+    }
+    if (qs_save.saved & 4096) {
+        for (int i = 1; i >= 0; i--)
+            write32(qs_pmp[i], qs_save.pmp[i] & ~(BIT(11) | BIT(9) | BIT(8)));
+    }
+    if (qs_save.saved & 2048) {
+        for (int i = 3; i >= 0; i--)
+            write32(qs_aon[i], qs_save.aon[i] & ~(BIT(11) | BIT(9) | BIT(8)));
+    }
+    if (qs_save.saved & 1024) {
+        for (int i = 2; i >= 0; i--)
+            write32(qs_pcie[i], qs_save.pcie[i] & ~(BIT(11) | BIT(9) | BIT(8)));
+    }
+    if (qs_save.saved & 512) {
+        for (int i = 7; i >= 0; i--)
+            write32(qs_atc[i], qs_save.atc[i] & ~(BIT(11) | BIT(9) | BIT(8)));
+    }
+    if (qs_save.saved & 128) {
+        for (unsigned i = 0; i < 3; i++) {
+            u64 a = qs_dvfs_base[i] + QS_DVFS_PSTATE;
+            if (qs_save.dvfs[i] == ~0ULL)
+                continue;
+            write64(a, (read64(a) & ~QS_DVFS_APSC_DIS) | (qs_save.dvfs[i] & QS_DVFS_APSC_DIS));
+            qs_poll(a, QS_DVFS_APSC_BUSY, 0, 10000);
+        }
+    }
+    if (qs_save.saved & 2) {
+        write32(QS_PLLOFF, qs_save.pll);
+        for (int i = 4; i >= 0; i--)
+            write32(QS_CLKGEN + qs_clkgen_off[i], qs_save.clk[i]);
+    }
+    if (qs_save.saved & 64)
+        write32(QS_CLUSTER, qs_save.eacc);
+    if (qs_save.saved & 4) {
+        for (unsigned i = 0; i < 5; i++)
+            write32(QS_CLUSTER + 4 * qs_cluster_id[i], qs_save.cluster[i]);
+    }
+    if (qs_save.saved & 1) {
+        write32(QS_SIO_CPU, qs_save.sio_cpu);
+        write32(QS_SIO, qs_save.sio);
+        write32(QS_AFR, qs_save.afr);
+    }
+    dc_ivac_range((void *)&qs_lower_save, sizeof(qs_lower_save));
+    if (qs_lower_save.n && qs_lower_save.n <= 128) {
+        for (int i = (int)qs_lower_save.n - 1; i >= 0; i--) {
+            u64 a = qs_lower_save.ent[i].addr;
+            u32 v = qs_lower_save.ent[i].val & ~(BIT(11) | BIT(9) | BIT(8));
+            write32(a, v);
+            if (v & 0xf)
+                qs_poll(a, 0xf0, (v & 0xf) << 4, 2000);
+        }
+        qs_lower_save.n = 0;
+        dc_civac_range((void *)&qs_lower_save, sizeof(qs_lower_save));
+    }
+    if (qs_save.saved & 32) {
+        /* unmask what was unmasked, except Aura's two wake lines, which Linux keeps masked */
+        for (u32 w = 0; w < qs_save.aic_words; w++) {
+            u32 keep = 0;
+            for (unsigned i = 0; i < 2; i++)
+                if ((wake_irq[i] >> 5) == w)
+                    keep |= BIT(wake_irq[i] & 31);
+            write32(aic->base + aic->regs.mask_clr + 4 * w, ~qs_save.aic_mask[w] & ~keep);
+        }
+    }
+    if (qs_save.saved & 16) {
+        for (u32 i = 0; i < qs_save.amcc_n; i++)
+            for (u32 p = 0; p < qs_save.amcc_planes; p++)
+                for (u32 w = 0; w < 2; w++)
+                    write32(AMCC_EN(qs_amcc_base[i], p, w), qs_save.amcc_en[i][p][w]);
+    }
+    if (qs_save.saved & 8) {
+        for (int i = 11; i >= 0; i--)
+            if (qs_save.held_mask & BIT(i))
+                write32(qs_held[i], qs_save.held[i] & ~(BIT(11) | BIT(9) | BIT(8)));
+    }
+    qs_save.saved = 0;
+    dc_civac_range((void *)&qs_save, sizeof(qs_save));
+}
+
+volatile u64 psci_ctl[8] __attribute__((aligned(64), used));
+#define PSCI_CTL_MAGIC_HI 0x5332524354524c00ULL /* "S2RCTRL", low byte added at run time */
+
+static void qs_crumb_init(void);
+static void qs_gpio_init(void);
+static void qs_apq_init(void);
+
+void psci_ctl_init(void)
+{
+    volatile u64 lo = 0x21;
+
+    for (unsigned i = 0; i < 8; i++)
+        psci_ctl[i] = 0;
+    psci_ctl[0] = PSCI_CTL_MAGIC_HI | lo;
+    dc_civac_range((void *)psci_ctl, sizeof(psci_ctl));
+    pmgr_ps_tab_build(); /* image 78 */
+    /* image 58: the AMCC planes, found now while the ADT is still around */
+    qs_amcc_n = mcc_plane_bases(qs_amcc_base, 8, &qs_amcc_stride, &qs_amcc_planes);
+    if (qs_amcc_planes > 4)
+        qs_amcc_planes = 4;
+    qs_crumb_init();
+    qs_gpio_init(); /* image 120 */
+    qs_apq_init(); /* image 125 */
+}
+
+
+/*
+ * Set on the kernel's first PSCI call: from then on Linux owns the hardware, so CPU resets through RVBAR
+ * (CPU_ON restarts, the boot CPU's SYSTEM_SUSPEND wake) must not print: the UART may be powered down, and its
+ * TX-empty wait would then spin forever.
+ */
+/* a cache line of its own: psci_runtime_quiet() invalidates it */
+volatile struct {
+    bool on;
+    u8 pad[63];
+} psci_runtime_line __attribute__((aligned(64)));
+#define psci_runtime (psci_runtime_line.on)
+
+/* What the RVBAR re-entry needs, cleaned to the PoC: it runs with the MMU and caches off */
+volatile struct {
+    u64 magic, entry, context, start, frq;
+    u32 basew[2];
+} psci_resume __attribute__((aligned(64), used));
+
+static u64 wake_hw_word(unsigned i)
+{
+    return aic->base + aic->regs.mask_clr + 4 * (aic->max_irq >> 5) + 4 * (wake_irq[i] >> 5);
+}
+
+/* The wake line that newly asserted since entry, or -1 */
+static int psci_wake_line(void)
+{
+    for (unsigned i = 0; i < 2; i++) {
+        u32 w = read32(wake_hw_word(i)) & BIT(wake_irq[i] & 31);
+        if (w & ~psci_resume.basew[i])
+            return wake_irq[i];
+    }
+    return -1;
+}
+
+static void psci_sleep_core(void)
+{
+    /*
+     * Deep WFI with state retention (WFI_MODE 3, retention left on). Images 32 to 36 also set DISABLE_WFI_RET:
+     * the core then never came back (not even to the first instruction at RVBAR), so the AIC wake does not
+     * restart a core powered down without retention. The RVBAR resume path stays as a backstop.
+     */
+    /* image 42: deep_wfi() with the CYC_OVRD write synchronized (isb) before the WFI */
+    u64 cyc_ovrd = mrs(SYS_IMP_APL_CYC_OVRD);
+
+    msr(SYS_IMP_APL_CYC_OVRD, cyc_ovrd | CYC_OVRD_WFI_MODE(3));
+    sysop("isb");
+    extern void _deep_wfi_helper(void);
+    _deep_wfi_helper();
+    msr(SYS_IMP_APL_CYC_OVRD, cyc_ovrd);
+}
+
+/*
+ * Image 60: breadcrumbs. The S2R timer's reset loses everything Aura keeps in DRAM, and Linux cannot run after the
+ * timer (run W2), so how far the boot core gets is left in the PMU, which a SoC reset does not touch: legacy scratch
+ * key 4 (0x6004), unused by 13.5's AppleDialogSPMIPMU (keys 0-3, 8-11, 0xf, 0x18-0x1a, 0x1f). One SPMI extended
+ * long write to the PMU (slave 0xb on nub-spmi0), no printing, bounded waits; Linux reads and clears it at boot. The
+ * controller's registers are kept in memory (cleaned) so the RVBAR path, with the MMU and caches off, can write too.
+ */
+#define QS_PMU_SPMI_ADDR 0xb
+#define QS_PMU_CRUMB_REG 0x6004
+static struct {
+    u64 base;
+    u32 st, cmd, rsp, rx_empty, tx_empty;
+    u32 on;
+} qs_crumbs __attribute__((aligned(64)));
+
+static void qs_crumb_init(void)
+{
+    int path[8];
+    u64 base = 0;
+    s32 gen = -1;
+    int off = adt_path_offset_trace(adt, "/arm-io/nub-spmi0", path);
+
+    qs_crumbs.base = 0;
+    if (off >= 0 && adt_get_reg(adt, path, "reg", 0, &base, NULL) >= 0) {
+        if (ADT_GETPROP(adt, off, "gen", &gen) < 0)
+            gen = -1;
+        if (gen >= 4) {
+            qs_crumbs.st = 0x200, qs_crumbs.cmd = 0x210, qs_crumbs.rsp = 0x220;
+            qs_crumbs.rx_empty = BIT(30), qs_crumbs.tx_empty = BIT(14);
+        } else {
+            qs_crumbs.st = 0x00, qs_crumbs.cmd = 0x04, qs_crumbs.rsp = 0x08;
+            qs_crumbs.rx_empty = BIT(24), qs_crumbs.tx_empty = BIT(8);
+        }
+        qs_crumbs.base = base;
+    }
+    qs_crumbs.on = 0;
+    dc_civac_range((void *)&qs_crumbs, sizeof(qs_crumbs));
+}
+
+/* image 60b: the SPMI controller's page must be in Linux's EFI runtime map (smp_psci_mmio_ranges); 60 left it out */
+u64 psci_crumb_base(void)
+{
+    return qs_crumbs.base;
+}
+
+static int qs_crumb_write_st(u16 reg, const u8 *v, int len);
+static void qs_crumb_write(u16 reg, const u8 *v, int len)
+{
+    (void)qs_crumb_write_st(reg, v, len);
+}
+
+/* image 111: 0 sent and answered, 1 off or bad args, 2 TX FIFO never empty, 3 no response */
+static int qs_crumb_write_st(u16 reg, const u8 *v, int len)
+{
+    u64 b = qs_crumbs.base, t0, t;
+    u32 data = 0;
+
+    if (!qs_crumbs.on || !b || len < 1 || len > 4)
+        return 1;
+    /* image 60e: wait up to about 5 ms for the TX FIFO instead of dropping the write (R12 lost its 0x600c write) */
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(t0));
+    while (!(read32(b + qs_crumbs.st) & qs_crumbs.tx_empty)) {
+        asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(t));
+        if (t - t0 >= 120000)
+            return 2;
+    }
+    for (int i = 0; i < 16 && !(read32(b + qs_crumbs.st) & qs_crumbs.rx_empty); i++)
+        read32(b + qs_crumbs.rsp);
+    /* extended register write long (opcode 0x30 | len - 1), the register address in the upper half */
+    write32(b + qs_crumbs.cmd, ((u32)reg << 16) | BIT(15) | (QS_PMU_SPMI_ADDR << 8) | 0x30 | (len - 1));
+    for (int i = 0; i < len; i++)
+        data |= (u32)v[i] << (8 * i);
+    write32(b + qs_crumbs.cmd, data);
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(t0));
+    do {
+        if (!(read32(b + qs_crumbs.st) & qs_crumbs.rx_empty)) {
+            read32(b + qs_crumbs.rsp);
+            if (!qs_crumbs.st) {
+                write32(b + 0x80, 1);
+                (void)read32(b + 0x80);
+            }
+            return 0;
+        }
+        asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(t));
+    } while (t - t0 < 120000); /* about 5 ms at 24 MHz */
+    return 3;
+}
+
+static void qs_crumb(u8 v)
+{
+    qs_crumb_write(QS_PMU_CRUMB_REG, &v, 1);
+}
+
+/*
+ * Image 60c: what the CPU side looks like 2 ms after the secondaries were released, just before the boot core's
+ * flush and deep WFI (code 18). Free scratch keys 0x10-0x13 and 0x1b-0x1e (0x17 is left alone: it reads 1, iBoot's?):
+ *   0x10 PMP request word bits 8-15, 0x11 its ack (macOS ends at 0: PCPM0/1 and the display bits released)
+ *   0x12 0x13 the ECPM and PCPM0 power words bits 4-11 (0x28e080060, 68), 0x1b PCPM1's (0x70)
+ *   0x1c 0x1d 0x1e the EACC, PACC0, PACC1 soc-cluster controls (0x28e088000, 4, 8) bits 0-7
+ */
+#define QS_PMP_REQ 0x28e3c2000ULL
+#define QS_CPM_PS  0x28e080060ULL
+#define QS_STATE_CNT 0x29e2c8100ULL /* image 83: perf block 0, config of counter 0 */
+static volatile u64 psci_s2r_committed __attribute__((aligned(64)));
+
+static inline u64 qs_now(void)
+{
+    u64 t;
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(t));
+    return t;
+}
+
+/*
+ * image 73, run on the observer core (smp.c's park loop) with the boot core in its commit. Nothing else uses SPMI after
+ * the boot core's last crumb, so this core may. 24 MHz counter.
+ */
+/*
+ * image 84: the observer diffs the whole MPMGR_AON block (pmgr reg 38, 0x29e5c0000, 0x14000) across the commit.
+ * The boot core asks for the "before" snapshot (psci_s2r_committed = 2) and waits up to 2 s for psci_s2r_snapdone;
+ * the observer reads the block twice 50 ms apart (words that differ are volatile and left out), then waits for the
+ * commit (psci_s2r_committed = 1), 3 s more, reads again and reports the words that changed.
+ * Scratch: 0x6005 state counters that advanced in the 3 s (bit 0 SLP_DDR, 1 AWAKE, 2 SLP_S2R, 3 DEEP_WAIT, 4 SYS_AWAKE,
+ * 5 SYS_S2R_AOP, 6 SYS_SLP_DDR, 7 = written); 0x6006 changed words at or after the start index (psci_ctl[4] bits
+ * 0-15; ff = 255 or more); 0x600c the 4 KiB page being read | 0x80 (before), | 0x40 (after), ff = done; 0x600d
+ * volatile words / 16; the first two changed words from the start index as 5-byte entries at 0x6007 and 0x6012:
+ * word index low, high, lowest differing byte (low nibble) | differing bytes (high nibble), old byte, new byte;
+ * 0x601b/c the last changed word's index (ffff = none). WD2: 0x600e = ctl low nibble | alarm s / 10 << 4.
+ */
+#define QS_AON_BASE  0x29e5c0000ULL
+#define QS_AON_WORDS 0x5000
+static u32 qs_aon_snap[QS_AON_WORDS];
+static u8 qs_aon_vol[QS_AON_WORDS / 8];
+static volatile u64 psci_s2r_snapdone __attribute__((aligned(64)));
+
+/*
+ * image 92 (psci_ctl[5] bit 0): macOS halts the coprocessors' firmware before the commit (hypervisor run 2026-11-12, "ascw2"):
+ * after the RTKit idle messages (SetAPPower/SetIOPPower 0x201) it writes each wrapper's mailbox control (+0x8114) and
+ * CPU_CONTROL (+0x44) := 0 for GFX, ANS, SIO and the PMP (the DCPs are shut down by Linux's test_sleep_off). Linux leaves these four running.
+ */
+static void psci_quiesce_asc(void)
+{
+    static const struct { u64 base; u32 ctrl; } asc[] = {
+        {0x406400000ULL, 0x21100}, /* gfx-asc */
+        {0x347400000ULL, 0x24400}, /* ans */
+        {0x39bc00000ULL, 0x29900}, /* sio */
+        {0x28ec00000ULL, 0x21100}, /* pmp */
+    };
+    for (unsigned i = 0; i < sizeof(asc) / sizeof(asc[0]); i++) {
+        write32(asc[i].base + 0x8114, asc[i].ctrl);
+        write32(asc[i].base + 0x44, 0);
+        sysop("dsb sy");
+    }
+}
+
+#include "qs_macos_ps.h"
+#include "qs_macos_mem.h"
+/*
+ * image 97 (psci_ctl[5] bit 2): replay macOS's memory-controller writes of its sleep entry (qs_macos_mem.h, in order): the
+ * per-plane words it clears or sets (0x158000/0x158800 groups, 0x1c1c00, 0x200584.., the 0x1000-stepped banks) and mcc_0's
+ * 0x11000 block, which it clears twice around the PMP's last target write. Applied count into 0x601e.
+ */
+static u8 psci_mem_done;
+static void psci_replay_mem(void)
+{
+    u8 r[1] = {0};
+
+    for (u32 i = 0; i < sizeof(qs_macos_mem) / sizeof(qs_macos_mem[0]); i++) {
+        if (qs_macos_mem[i].size == 8)
+            write64(qs_macos_mem[i].addr, qs_macos_mem[i].val);
+        else
+            write32(qs_macos_mem[i].addr, (u32)qs_macos_mem[i].val);
+        if (r[0] < 255)
+            r[0]++;
+    }
+    sysop("dsb sy");
+    psci_mem_done = 1;
+}
+
+/*
+ * image 96 (psci_ctl[5] bit 1): force every PMGR power word that differs from macOS's at its S2R timer write (desired/actual,
+ * bits 0-7; table of image 93) to macOS's desired state, outside the CPU cores and complexes (indexes 0 to 14), each waited
+ * for 1 ms. R44 found 59 such words on the J414s (peripherals, fabric, PCIe, SIO, UARTs...). Counts into 0x6005 (applied).
+ */
+static void psci_force_ps(void)
+{
+    u8 r[1] = {0};
+
+    for (u32 i = 15; i < sizeof(qs_macos_ps) / sizeof(qs_macos_ps[0]); i++) {
+        u64 a = qs_macos_ps[i].addr;
+        u32 want = qs_macos_ps[i].val & 0xff, v = read32(a);
+        if ((v & 0xff) == want)
+            continue;
+        write32(a, (v & ~0xfU) | (want & 0xf));
+        u64 t0 = qs_now();
+        while ((((read32(a) >> 4) & 0xf) != (want >> 4 & 0xf)) && qs_now() - t0 < 24000)
+            ;
+        if (r[0] < 255)
+            r[0]++;
+    }
+    sysop("dsb sy");
+    {
+        u8 rr[2] = {psci_mem_done ? 0x77 : 0x11, r[0]};
+        qs_crumb_write(0x601e, rr, 2); /* image 98: 0x77 = the memory/device replay finished */
+    }
+}
+
+/*
+ * image 102 (psci_ctl[5] bit 7): PCIe root-complex teardown written before psci_quiesce_pcie() powers
+ * the PCIe domains off.
+ */
+static void psci_quiesce_pcie_rc(void)
+{
+    write32(0x59e008000ULL, 0x1f0c383);
+    write32(0x59e008000ULL, 0x1f0c381);
+    write32(0x59e008000ULL, 0x1f0c380);
+    write32(0x59e008000ULL, 0x1f0c080);
+    write32(0x59e008004ULL, 1);
+    write32(0x59e008004ULL, 0);
+    write32(0x59c000400ULL, 0xc0f00010);
+    sysop("dsb sy");
+}
+
+/*
+ * image 125 (psci_ctl[5] bit 8): the apcie handshake macOS's quiesceHW does on t6000 (Andreas Fernandez's
+ * t600x-s2r-reference, s2r.c: 0x58c008014 = 1, then 0x58c0082bc = 1, 2, 4; saved values written back at the wake,
+ * 82bc first). On T6020 assumed at the same offsets in pmgr's apcie block 0x59c000000 (macOS writes its +0x400 too).
+ * Only if the ADT's pmgr reg list covers both words. Crumbs (the free end of the PMU scratch): 0x6025 bit0 range ok,
+ * bit1 done at suspend, bit2 put back at the wake; 0x6026 the saved values, 0x6027 those read at the wake
+ * (8014 in bits 3:0, 82bc in bits 7:4).
+ */
+#define QS_APQ_8014 0x59c008014ULL
+#define QS_APQ_82BC 0x59c0082bcULL
+static bool qs_apq_ok;
+static u32 qs_apq_saved[2];
+static bool qs_apq_done;
+
+static void qs_apq_init(void)
+{
+    int path[8];
+    qs_apq_ok = false;
+    if (adt_path_offset_trace(adt, "/arm-io/pmgr", path) < 0)
+        return;
+    for (int i = 0; i < 128; i++) {
+        u64 a, sz;
+        if (adt_get_reg(adt, path, "reg", i, &a, &sz) < 0)
+            break;
+        if (a <= QS_APQ_8014 && QS_APQ_82BC + 4 <= a + sz) {
+            qs_apq_ok = true;
+            break;
+        }
+    }
+    dc_civac_range((void *)&qs_apq_ok, sizeof(qs_apq_ok));
+}
+
+static void psci_quiesce_apq(void)
+{
+    u8 f = qs_apq_ok ? 1 : 0;
+    if (qs_apq_ok) {
+        qs_apq_saved[0] = read32(QS_APQ_8014);
+        qs_apq_saved[1] = read32(QS_APQ_82BC);
+        write32(QS_APQ_8014, 1);
+        write32(QS_APQ_82BC, 1);
+        write32(QS_APQ_82BC, 2);
+        write32(QS_APQ_82BC, 4);
+        sysop("dsb sy");
+        qs_apq_done = true;
+        dc_civac_range((void *)qs_apq_saved, sizeof(qs_apq_saved));
+        dc_civac_range((void *)&qs_apq_done, sizeof(qs_apq_done));
+        f |= 2;
+        u8 b = (qs_apq_saved[0] & 0xf) | (qs_apq_saved[1] & 0xf) << 4;
+        qs_crumb_write(0x6026, &b, 1);
+    }
+    qs_crumb_write(0x6025, &f, 1);
+}
+
+static void qs_apq_restore(void)
+{
+    if (!qs_apq_done)
+        return;
+    u8 b = (read32(QS_APQ_8014) & 0xf) | (read32(QS_APQ_82BC) & 0xf) << 4, f = 7;
+    qs_crumb_write(0x6027, &b, 1);
+    write32(QS_APQ_82BC, qs_apq_saved[1]);
+    write32(QS_APQ_8014, qs_apq_saved[0]);
+    sysop("dsb sy");
+    qs_crumb_write(0x6025, &f, 1);
+    qs_apq_done = false;
+    dc_civac_range((void *)&qs_apq_done, sizeof(qs_apq_done));
+}
+
+/*
+ * image 102 (psci_ctl[5] bit 7): lower-only PMGR PS helper. Never turns any domain ON; clears target
+ * and AUTO_ENABLE (QS_PS_CLEAR) for macOS-OFF entries (val & 0xf == 0) in two reverse passes so
+ * children precede parents and ANE/GFX (with AUTO_ENABLE=1) actually gate.
+ */
+static void psci_force_ps_lower(void)
+{
+    qs_lower_save.n = 0;
+    for (int pass = 0; pass < 2; pass++) {
+        for (int i = (int)(sizeof(qs_macos_ps) / sizeof(qs_macos_ps[0])) - 1; i >= 15; i--) {
+            u64 a = qs_macos_ps[i].addr;
+            if (a == 0x29e280000ULL || (qs_macos_ps[i].val & 0xf) != 0)
+                continue;
+            u32 v = read32(a);
+            if ((v & 0xff) == 0)
+                continue;
+            if (pass == 0 && qs_lower_save.n < 128) {
+                u32 k = qs_lower_save.n++;
+                qs_lower_save.ent[k].addr = a;
+                qs_lower_save.ent[k].val = v;
+            }
+            write32(a, v & ~QS_PS_CLEAR);
+            u64 t0 = qs_now();
+            while ((read32(a) & 0xf0) && qs_now() - t0 < 48000)
+                ;
+        }
+    }
+    sysop("dsb sy");
+    dc_civac_range((void *)&qs_lower_save, sizeof(qs_lower_save));
+}
+
+static u8 qs_zero_ps_still_on(u8 *key_mask)
+{
+    static const u64 key_addrs[8] = {
+        0x28e080260ULL, /* ANE_SYS */
+        0x28e0802e0ULL, /* ANE_CPU */
+        0x2902801c8ULL, /* ISP_SYS */
+        0x404e80108ULL, /* GFX */
+        0x29e2800e0ULL, /* ATC3_USB */
+        0x290280420ULL, /* APCIE_GE_SYS */
+        0x290280408ULL, /* APCIE_ST_SYS */
+        0x2902801a8ULL, /* ANS2 */
+    };
+    u32 n = 0;
+    u8 km = 0;
+
+    for (u32 i = 15; i < sizeof(qs_macos_ps) / sizeof(qs_macos_ps[0]); i++) {
+        u64 a = qs_macos_ps[i].addr;
+        if (a == 0x29e280000ULL || (qs_macos_ps[i].val & 0xf) != 0)
+            continue;
+        if (read32(a) & 0xf0)
+            n++;
+    }
+    for (u32 k = 0; k < 8; k++)
+        if (read32(key_addrs[k]) & 0xf0)
+            km |= BIT(k);
+    *key_mask = km;
+    return n > 255 ? 255 : (u8)n;
+}
+
+/*
+ * image 102 (psci_ctl[5] bit 7): filtered qs_macos_mem[] replay keeping MCC/SLC/DCS drain, PMP DVFS
+ * idle, AOP GPIO IRQ clear, error-handler and event-log zeros while skipping poison power-ons
+ * (APCIE_GE_SYS, SIO_CPU), PMP/PMS_SRAM toggle, early-done PCIe RC teardown, and soc-clusters.
+ */
+static void psci_replay_mem_clean(void)
+{
+    for (u32 i = 0; i < sizeof(qs_macos_mem) / sizeof(qs_macos_mem[0]); i++) {
+        u64 a = qs_macos_mem[i].addr;
+        if (a == 0x28e0802c8ULL || a == 0x28e0802d0ULL ||
+            a == 0x290280420ULL || a == 0x2902801e0ULL ||
+            a == 0x59e008000ULL || a == 0x59e008004ULL || a == 0x59c000400ULL ||
+            (a >= 0x28e088000ULL && a <= 0x28e088018ULL))
+            continue;
+        if (qs_macos_mem[i].size == 8)
+            write64(a, qs_macos_mem[i].val);
+        else
+            write32(a, (u32)qs_macos_mem[i].val);
+    }
+    sysop("dsb sy");
+    psci_mem_done = 1;
+}
+
+/*
+ * image 93 (psci_ctl[4] bit 61): the observer compares the 374 PMGR power words, as they stand right before the commit (after
+ * every Aura quiesce step), with macOS's at its own S2R timer write (qs_macos_ps.h, from the hypervisor run). bits 0-9 only.
+ * psci_ctl[4] bits 0-15 = first mismatch index to list. Scratch: 0x6005 number of mismatches (255 max), then the list as
+ * index - start (one byte each, ff = none) at 0x6006..0x600b and 0x6011..0x6016.
+ */
+static void psci_s2r_pscmp(void)
+{
+    u8 e[18], r[1];
+    u32 n = 0, k = 0, start = psci_ctl[4] & 0xffff;
+
+    for (int i = 0; i < 18; i++)
+        e[i] = 0xff;
+    qs_crumb(0xa1);
+    for (u32 i = 0; i < sizeof(qs_macos_ps) / sizeof(qs_macos_ps[0]); i++) {
+        u32 v = read32(qs_macos_ps[i].addr) & 0xff;
+        if (v == (qs_macos_ps[i].val & 0xff))
+            continue;
+        n++;
+        if (i >= start && k < 18) {
+            u32 d = i - start;
+            e[k++] = d > 254 ? 254 : d;
+        }
+    }
+    qs_crumb_write(0x6006, e, 4);
+    qs_crumb_write(0x600a, e + 4, 3);
+    qs_crumb_write(0x6011, e + 7, 4);
+    qs_crumb_write(0x6015, e + 11, 2);
+    qs_crumb_write(0x601b, e + 13, 4);
+    qs_crumb_write(0x601f, e + 17, 1);
+    r[0] = n > 255 ? 255 : n;
+    qs_crumb_write(0x6005, r, 1);
+    qs_crumb(0xa4);
+    psci_s2r_snapdone = 1;
+    dc_civac_range((void *)&psci_s2r_snapdone, sizeof(psci_s2r_snapdone));
+}
+
+/*
+ * image 90 (psci_ctl[4] bit 62): which AP wake sources stand at the commit. The five-wake-status words of Naeem Malik's T8103
+ * entry latch at the first S2R-timer write; the T6020 block is the PMGR's "AOP global" one (0x404ea8000: mask words +0x0c,
+ * status words +0x30, nine each, as AppleT6020PMGR::setAPWakeupSources/getAPWakeupSources). Read 3 s after the commit.
+ * Scratch: 0x6005 count of set status bits (255 max), 0x6006..0x600b the first three as word, bit; 0x6011/0x6012 the fourth;
+ * 0x601b count of set bits whose mask bit is 0 (enabled); 0x601c status word 0 low byte; 0x601d..0x601f words 1..3 low bytes.
+ */
+#define QS_WAKE_BASE 0x404ea8000ULL
+static void psci_s2r_wakestat(void)
+{
+    u8 r[4] = {0xff, 0xff, 0xff, 0xff};
+    u32 n = 0, ne = 0, st[9], mk[9];
+
+    psci_s2r_snapdone = 1;
+    dc_civac_range((void *)&psci_s2r_snapdone, sizeof(psci_s2r_snapdone));
+    qs_crumb(0xa1);
+    u64 t0 = qs_now();
+    while (*(volatile u64 *)&psci_s2r_committed != 1)
+        if (qs_now() - t0 > 5 * 24000000ULL) {
+            qs_crumb(0xae);
+            return;
+        }
+    t0 = qs_now();
+    while (qs_now() - t0 < 3 * 24000000ULL)
+        ;
+    qs_crumb(0xa2);
+    for (int w = 0; w < 9; w++) {
+        st[w] = read32(QS_WAKE_BASE + 0x30 + 4 * w);
+        mk[w] = read32(QS_WAKE_BASE + 0x0c + 4 * w);
+    }
+    qs_crumb_write(0x6006, r, 4);
+    qs_crumb_write(0x600a, r, 2);
+    qs_crumb_write(0x6011, r, 2);
+    u8 src[8] = {0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff};
+    for (int w = 0; w < 9; w++)
+        for (int b = 0; b < 32; b++)
+            if (st[w] & BIT(b)) {
+                if (n < 4) {
+                    src[2 * n] = w;
+                    src[2 * n + 1] = b;
+                }
+                n++;
+                if (!(mk[w] & BIT(b)))
+                    ne++;
+            }
+    qs_crumb_write(0x6006, src, 4);
+    qs_crumb_write(0x600a, src + 4, 2);
+    qs_crumb_write(0x6011, src + 6, 2);
+    r[0] = n > 255 ? 255 : n;
+    qs_crumb_write(0x6005, r, 1);
+    r[0] = ne > 255 ? 255 : ne;
+    r[1] = st[0];
+    r[2] = st[1];
+    r[3] = st[2];
+    qs_crumb_write(0x601b, r, 4);
+    r[0] = st[3];
+    qs_crumb_write(0x601f, r, 1);
+    qs_crumb(0xa4);
+}
+
+/*
+ * image 88 (psci_ctl[4] bit 63): trace the five MPMGR_AON words the commit changes (R35B/D/E) from the commit until
+ * the reset. Each change is an event of 3 bytes: id << 5 | new value & 0x1f, then the time since the commit in 4 ms
+ * units (16 bits, little endian). ids: 0 +0x14 byte 0, 1 +0x100 byte 0, 2 +0x4000 byte 0, 3 +0x4008 byte 0,
+ * 4 +0x4008 byte 1, 5 +0x400c byte 0, 6 another byte of one of the five (value = word number 0-4).
+ * Slots: 0x6005, 0x6008, 0x6011, 0x6014, 0x601b (first five events); 0x600b = events seen (ff = 255 or more);
+ * 0x600c = +0x100 byte 0 now; 0x601e = +0x14 byte 0 now; 0x601f = bit 0..2: +0x4000/+0x4008/+0x400c byte 0 != 0.
+ */
+static const u32 qs_tr_off[5] = {0x14, 0x100, 0x4000, 0x4008, 0x400c};
+static void psci_s2r_trace(void)
+{
+    static const u16 slot[5] = {0x6005, 0x6008, 0x6011, 0x6014, 0x601b};
+    u32 v[5], n = 0;
+    u8 r[4];
+
+    for (int k = 0; k < 5; k++)
+        v[k] = read32(QS_AON_BASE + qs_tr_off[k]);
+    qs_crumb(0xa1);
+    psci_s2r_snapdone = 1;
+    dc_civac_range((void *)&psci_s2r_snapdone, sizeof(psci_s2r_snapdone));
+    u64 t0 = qs_now();
+    while (*(volatile u64 *)&psci_s2r_committed != 1)
+        if (qs_now() - t0 > 5 * 24000000ULL) {
+            qs_crumb(0xae);
+            return;
+        }
+    t0 = qs_now();
+    /* after the commit: the boot core's own snapshot (before it) uses the same slots */
+    r[0] = r[1] = r[2] = r[3] = 0xff;
+    for (int k = 0; k < 5; k++)
+        qs_crumb_write(slot[k], r, 3);
+    r[0] = 0;
+    qs_crumb_write(0x600b, r, 1);
+    r[0] = v[1];
+    qs_crumb_write(0x600c, r, 1);
+    r[0] = v[0];
+    r[1] = (!!(v[2] & 0xff)) | (!!(v[3] & 0xff)) << 1 | (!!(v[4] & 0xff)) << 2;
+    qs_crumb_write(0x601e, r, 2);
+    qs_crumb(0xa2);
+    while (qs_now() - t0 < 120 * 24000000ULL) {
+        for (int k = 0; k < 5; k++) {
+            u32 w = read32(QS_AON_BASE + qs_tr_off[k]), x = w ^ v[k];
+            if (!x)
+                continue;
+            u32 t = (qs_now() - t0) / 96000; /* 4 ms */
+            for (int b = 0; b < 4 && x; b++) {
+                if (!((x >> (8 * b)) & 0xff))
+                    continue;
+                x &= ~(0xffU << (8 * b));
+                u8 id, val = (w >> (8 * b)) & 0x1f;
+                if (b == 0)
+                    id = k == 0 ? 0 : k == 1 ? 1 : k == 2 ? 2 : k == 3 ? 3 : 5;
+                else if (b == 1 && k == 3)
+                    id = 4;
+                else {
+                    id = 6;
+                    val = k;
+                }
+                if (n < 5) {
+                    r[0] = (id << 5) | val;
+                    r[1] = t > 0xffff ? 0xff : t;
+                    r[2] = t > 0xffff ? 0xff : t >> 8;
+                    qs_crumb_write(slot[n], r, 3);
+                }
+                n++;
+                r[0] = n > 255 ? 255 : n;
+                qs_crumb_write(0x600b, r, 1);
+            }
+            v[k] = w;
+            r[0] = v[1];
+            qs_crumb_write(0x600c, r, 1);
+            r[0] = v[0];
+            r[1] = (!!(v[2] & 0xff)) | (!!(v[3] & 0xff)) << 1 | (!!(v[4] & 0xff)) << 2;
+            qs_crumb_write(0x601e, r, 2);
+        }
+    }
+    qs_crumb(0xa4);
+}
+
+void psci_s2r_observe(void)
+{
+    u8 r[5] = {0, 0, 0, 0, 0};
+    u64 t0 = qs_now();
+    u32 nvol = 0;
+
+    while (!*(volatile u64 *)&psci_s2r_committed)
+        if (qs_now() - t0 > 5 * 24000000ULL) {
+            qs_crumb(0xaf); /* the boot core never got to the commit */
+            return;
+        }
+    u64 obs = psci_ctl[4];
+    if (obs & BIT(63)) {
+        psci_s2r_trace();
+        return;
+    }
+    if (obs & BIT(61)) {
+        psci_s2r_pscmp();
+        return;
+    }
+    if (obs & BIT(62)) {
+        psci_s2r_wakestat();
+        return;
+    }
+    u32 pages = (obs >> 16) & 0xfffff, noprobe = (obs >> 36) & 0xfffff;
+    if (!pages) {
+        pages = 0xff; /* R35A: the observer stopped in page 8 */
+        noprobe |= BIT(8);
+    }
+    for (u32 i = 0; i < QS_AON_WORDS; i++) {
+        if (!(pages & BIT(i >> 10)))
+            continue;
+        if (!(i & 0x3ff)) {
+            r[0] = 0x80 | (i >> 10);
+            qs_crumb_write(0x600c, r, 1);
+        }
+        qs_aon_snap[i] = read32(QS_AON_BASE + 4 * i);
+    }
+    for (u32 i = 0; i < sizeof(qs_aon_vol); i++)
+        qs_aon_vol[i] = 0;
+    t0 = qs_now();
+    while (qs_now() - t0 < 1200000)
+        ;
+    for (u32 i = 0; i < QS_AON_WORDS; i++) {
+        if (!(pages & BIT(i >> 10)))
+            continue;
+        u32 v = read32(QS_AON_BASE + 4 * i);
+        if (v != qs_aon_snap[i]) {
+            qs_aon_vol[i >> 3] |= BIT(i & 7);
+            nvol++;
+        }
+        qs_aon_snap[i] = v;
+    }
+    r[0] = 0xc0 | (nvol > 63 ? 63 : nvol); /* c0 | volatile words: the "before" snapshot is done */
+    qs_crumb_write(0x600c, r, 1);
+    u32 c0[14];
+    for (int i = 0; i < 14; i++)
+        c0[i] = read32(QS_STATE_CNT + 16 * (42 + i) + 8);
+    qs_crumb(0xa1);
+    psci_s2r_snapdone = 1;
+    dc_civac_range((void *)&psci_s2r_snapdone, sizeof(psci_s2r_snapdone));
+    t0 = qs_now();
+    while (*(volatile u64 *)&psci_s2r_committed != 1)
+        if (qs_now() - t0 > 5 * 24000000ULL) {
+            qs_crumb(0xae); /* the boot core never committed after the snapshot */
+            return;
+        }
+    t0 = qs_now();
+    while (qs_now() - t0 < 3 * 24000000ULL)
+        ;
+    qs_crumb(0xa2);
+    u8 m0 = 0x80;
+    for (int i = 0; i < 14; i += 2)
+        if (read32(QS_STATE_CNT + 16 * (42 + i) + 8) != c0[i])
+            m0 |= BIT(i >> 1);
+    static const u16 slot[] = {0x6007, 0x6012, 0x601b}; /* image 86: three entries; 0x600d/e do not survive a reset */
+    u32 nd = 0, last = 0xffff, from = obs & 0xffff;
+    /* image 87: the three slots are filled with ff first, so what the boot core left there cannot pass for an entry */
+    r[0] = r[1] = r[2] = r[3] = r[4] = 0xff;
+    for (int k = 0; k < 3; k++) {
+        qs_crumb_write(slot[k], r, 4);
+        qs_crumb_write(slot[k] + 4, r, 1);
+    }
+    for (u32 i = 0; i < QS_AON_WORDS; i++) {
+        if (!(pages & BIT(i >> 10)))
+            continue;
+        if (!(i & 0x3ff)) {
+            r[0] = 0x40 | (i >> 10);
+            qs_crumb_write(0x600c, r, 1);
+        }
+        u32 v = read32(QS_AON_BASE + 4 * i), x = v ^ qs_aon_snap[i];
+        if (!x || (qs_aon_vol[i >> 3] & BIT(i & 7)))
+            continue;
+        if (i >= from && nd < 3) {
+            u32 fb = 0, nb = 0;
+            for (int k = 3; k >= 0; k--)
+                if ((x >> (8 * k)) & 0xff) {
+                    fb = k;
+                    nb++;
+                }
+            r[0] = i & 0xff;
+            r[1] = i >> 8;
+            r[2] = fb | (nb << 4);
+            r[3] = qs_aon_snap[i] >> (8 * fb);
+            r[4] = v >> (8 * fb);
+            qs_crumb_write(slot[nd], r, 4);
+            qs_crumb_write(slot[nd] + 4, &r[4], 1);
+        }
+        if (i >= from)
+            nd++;
+        last = i;
+    }
+    r[0] = m0;
+    r[1] = nd > 255 ? 255 : nd;
+    qs_crumb_write(0x6005, r, 2);
+    (void)last;
+    r[0] = 0xff;
+    qs_crumb_write(0x600c, r, 1);
+    qs_crumb(0xa4);
+    /* image 85: after the report, read the pages not diffed, one by one: 0x600d = 0x80 | page before it, ff = all read */
+    for (u32 pg = 0; pg < QS_AON_WORDS >> 10; pg++) {
+        if ((pages | noprobe) & BIT(pg))
+            continue;
+        r[0] = 0x20 | pg; /* image 86: in 0x600c, which survives the reset (2x/3x = probing, ee = all read) */
+        qs_crumb_write(0x600c, r, 1);
+        for (u32 i = pg << 10; i < (pg + 1) << 10; i++)
+            read32(QS_AON_BASE + 4 * i);
+    }
+    r[0] = 0xee;
+    qs_crumb_write(0x600c, r, 1);
+}
+static void qs_crumb_snapshot(void)
+{
+    u8 a[4], c[4], w[4];
+    u64 t0, t;
+    u32 zero = 0, again = 0, maxl = 0;
+
+    if (!qs_crumbs.on)
+        return;
+    /* image 60d: wait up to 500 ms for both P complexes to read off; 0x6014 = the wait in 2 ms units, 0xff = timeout */
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(t0));
+    do {
+        asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(t));
+        /* image 60e: only the actual-state nibble (bits 4-7); R12 timed out on bit 8 (was-power-gated) with PCPM0 off */
+        if (!(read32(QS_CPM_PS + 8) & 0xf0) && !(read32(QS_CPM_PS + 0x10) & 0xf0))
+            break;
+    } while (t - t0 < 12000000);
+    a[0] = read32(QS_PMP_REQ) >> 8;
+    a[1] = read32(QS_PMP_REQ + 0x80) >> 8;
+    a[2] = read32(QS_CPM_PS) >> 4;
+    a[3] = read32(QS_CPM_PS + 8) >> 4;
+    c[0] = read32(QS_CPM_PS + 0x10) >> 4;
+    c[1] = read32(QS_CLUSTER);
+    c[2] = read32(QS_CLUSTER + 4);
+    c[3] = read32(QS_CLUSTER + 8);
+    /* image 60d: each secondary's cpu_sleep count (by Aura's CPU index; 0 = never got there, >1 = woke again) */
+    for (int i = 1; i < 16 && i < MAX_CPUS; i++) {
+        u32 n = smp_psci_s2r_loops(i);
+        if (!n)
+            zero |= BIT(i);
+        if (n > 1)
+            again |= BIT(i);
+        if (n > maxl)
+            maxl = n;
+    }
+    w[0] = (t - t0 >= 12000000) ? 0xff : (u8)((t - t0) / 48000);
+    w[1] = zero & 0xff;
+    w[2] = zero >> 8;
+    w[3] = maxl > 255 ? 255 : maxl;
+    qs_crumb_write(0x6010, a, 4);
+    qs_crumb_write(0x601b, c, 4);
+    qs_crumb_write(0x6014, w, 3);
+    w[0] = again & 0xff;
+    w[1] = again >> 8;
+    w[2] = w[3];
+    qs_crumb_write(0x600c, w, 3);
+    /*
+     * image 60e: 0x6005/0x6006 = the cores Aura held as CPU_OFF at the release (bit = index); 0x6007 = the lowest
+     * valid secondary that never slept (bits 4-7) and its PSCI state (bits 0-3: 0 parked, 1 on, 2 off), ff if none
+     */
+    u32 offm = smp_psci_off_mask(), first = 0xff;
+    int fi = -1;
+    for (int i = 1; i < 16 && i < MAX_CPUS; i++)
+        if ((zero & BIT(i)) && smp_psci_cpu_valid(i)) {
+            first = (i << 4) | (smp_psci_cpu_state(i) & 0xf);
+            fi = i;
+            break;
+        }
+    w[0] = offm & 0xff;
+    w[1] = (offm >> 8) & 0xff;
+    w[2] = first;
+    qs_crumb_write(0x6005, w, 3);
+    /*
+     * image 60f, for that core (R13: cpu3, CPU_OFF and sent the IPI, never slept): 0x6010/0x6011 the spin-table
+     * MPIDR the release IPI used (bits 0-15); 0x600c its park entries since boot, 0x600d its park-loop WFI returns
+     * since the clear (both capped at 255), 0x600e its S2R sleep count 2 ms after a second IPI built from the reset
+     * table's MPIDR. All ff if every core slept. R13's PMP request/ack were 0, as in R11 and R12.
+     */
+    u8 m[2] = {0xff, 0xff}, q[3] = {0xff, 0xff, 0xff};
+    /* image 62: with no never-slept core, 0x600d = qs_fabric_state() at the snapshot (only when bit 18 ran) */
+    if (fi <= 0 && (qs_save.saved & 256))
+        q[1] = qs_fabric_state();
+    /* image 63: likewise 0x600e = qs_atc_state() (only when bit 19 ran) */
+    if (fi <= 0 && (qs_save.saved & 512))
+        q[2] = qs_atc_state();
+    /* image 64: 0x600c = qs_pcie_aon_state() (only when bit 20 or 21 ran), bit 7 = some ATC word still on:
+     * 0x600d and 0x600e read 0 after every reset, 0x600c survives */
+    if (fi <= 0 && (qs_save.saved & (1024 | 2048)))
+        q[0] = qs_pcie_aon_state() | (((qs_save.saved & 512) && qs_atc_state()) ? 0x80 : 0);
+    /* image 65: 0x6011 = qs_pmp_state() (only when bit 22 ran; ff otherwise) */
+    if (fi <= 0 && (qs_save.saved & 4096))
+        m[1] = qs_pmp_state() | qs_sep_res; /* image 67: bits 2-4 = the SEP step (0x10 ran, 4 outbox on, 8 word) */
+    if (fi > 0) {
+        u64 mp = smp_psci_ipi_mpidr(fi);
+        u32 pe = smp_psci_s2r_word(fi, 1), wr = smp_psci_s2r_word(fi, 2);
+        m[0] = mp & 0xff;
+        m[1] = (mp >> 8) & 0xff;
+        q[0] = pe > 255 ? 255 : pe;
+        q[1] = wr > 255 ? 255 : wr;
+        smp_psci_reipi(fi);
+        udelay(2000);
+        u32 n = smp_psci_s2r_loops(fi);
+        q[2] = n > 255 ? 255 : n;
+    }
+    qs_crumb_write(0x6010, m, 2);
+    qs_crumb_write(0x600c, q, 3);
+}
+
+static void __attribute__((noreturn)) psci_resume_kernel(int line, int via_rvbar)
+{
+    u64 now;
+
+    for (unsigned i = 0; i < 2; i++)
+        write32(aic->base + aic->regs.mask_set + 4 * (wake_irq[i] >> 5), BIT(wake_irq[i] & 31));
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(now));
+    if (!via_rvbar)
+        wdt_psci_disarm();
+    psci_resume.magic = 0;
+    smp_psci_s2r_clear();
+    psci_quiesce_undo();
+    if (via_rvbar) {
+        qs_crumb(0x26);
+        smp_psci_s2r_prep_secondaries();
+        qs_crumb(0x27);
+        wdt_psci_arm(RESUME_WDT_S); /* stage 2: reset unless the kernel's resume takes over its watchdog */
+    }
+    psci_dbg[3] = 1;
+    psci_dbg[4] = line;
+    psci_dbg[5] = now - psci_resume.start;
+    /* 2: the core lost its state and came back through RVBAR; 3: the same with no wake line (S2R) */
+    psci_dbg[13] = via_rvbar ? (line < 0 ? 3 : 2) : 1;
+    psci_dbg[15] = mrs(SYS_IMP_APL_CYC_OVRD);
+    psci_dbg[0] = 0xA0AA0001;
+    dc_civac_range((void *)&psci_resume, sizeof(psci_resume));
+    dc_civac_range((void *)psci_dbg, sizeof(psci_dbg));
+    qs_crumb(via_rvbar ? 0x22 : 0x1e);
+    psci_enter(psci_resume.entry, psci_resume.context);
+}
+
+bool psci_runtime_quiet(void)
+{
+    dc_ivac_range((void *)&psci_runtime, sizeof(psci_runtime));
+    return psci_runtime;
+}
+
+bool psci_suspend_resuming(void)
+{
+    dc_ivac_range((void *)&psci_resume, sizeof(psci_resume));
+    return psci_resume.magic == RESUME_MAGIC;
+}
+
+/* image 103: RVBAR wake telemetry (T6020 real AP wake status at 0x29e004030, PMGR state counters, WD2) */
+#define QS_AP_WAKE_STAT 0x29e004030ULL
+
+static u8 qs_cnt_sec(u32 idx)
+{
+    u64 a = QS_STATE_CNT + 16ULL * idx;
+    u32 hi1, lo, hi2;
+
+    do {
+        hi1 = read32(a + 12);
+        lo = read32(a + 8);
+        hi2 = read32(a + 12);
+    } while (hi1 != hi2);
+    u64 ticks = ((u64)hi1 << 32) | lo;
+    if (!ticks)
+        return 0;
+    if (ticks < 24000000ULL)
+        return 0xfe;
+    u64 secs = ticks / 24000000ULL;
+    return secs > 253 ? 253 : (u8)secs;
+}
+
+static void qs_rvbar_telemetry(int line, u8 spmi_wk)
+{
+    if (!qs_crumbs.on)
+        return;
+
+    /* Stage 0x23: elapsed cntpct_el0 seconds (u16 LE at 0x6005..0x6006), zero MMIO reads */
+    u64 now = qs_now();
+    u16 el_s;
+    if (!psci_resume.frq)
+        el_s = 0xffff;
+    else if (now < psci_resume.start)
+        el_s = 0xfffe;
+    else {
+        u64 s = (now - psci_resume.start) / psci_resume.frq;
+        el_s = s > 0xfffd ? 0xfffd : (u16)s;
+    }
+    u8 el[2] = {el_s & 0xff, el_s >> 8};
+    qs_crumb_write(0x6005, el, 2);
+    qs_crumb(0x23);
+
+    /* Stage 0x24: 7 PMGR AON state counters (0x6007..0x600b and 0x6012..0x6013) */
+    u8 sc[4] = {qs_cnt_sec(46), qs_cnt_sec(42), qs_cnt_sec(48), qs_cnt_sec(52)};
+    u8 sc5 = qs_cnt_sec(54);
+    u8 aw[2] = {qs_cnt_sec(44), qs_cnt_sec(50)};
+    qs_crumb_write(0x6007, sc, 4);
+    qs_crumb_write(0x600b, &sc5, 1);
+    qs_crumb_write(0x6012, aw, 2);
+    qs_crumb(0x24);
+
+    /* Stage 0x25: AP wake status (0x6015..0x6016) + WD2 / RVBAR count / pre-crumb SPMI0 or AIC line (0x601b..0x601e) */
+    u8 wk[2] = {0xff, 0};
+    for (u32 w = 0; w < 9; w++) {
+        u32 v = read32(QS_AP_WAKE_STAT + 4ULL * w);
+        for (u32 b = 0; b < 32; b++) {
+            if (v & BIT(b)) {
+                if (wk[0] == 0xff) {
+                    u32 bit = w * 32 + b;
+                    wk[0] = bit > 254 ? 254 : (u8)bit;
+                }
+                if (wk[1] < 255)
+                    wk[1]++;
+            }
+        }
+    }
+    qs_crumb_write(0x6015, wk, 2);
+
+    u8 tail[4];
+    u64 wdt = wdt_psci_base();
+    if (wdt) {
+        u32 ws = read32(wdt + 0x20) / 24000000U;
+        tail[0] = ws > 255 ? 255 : (u8)ws;
+        tail[1] = read32(wdt + 0x2c) & 0xff;
+    } else {
+        tail[0] = 0xff;
+        tail[1] = 0xff;
+    }
+    tail[2] = psci_dbg[12] > 255 ? 255 : (u8)psci_dbg[12];
+    tail[3] = line < 0 ? spmi_wk : (line == 724 ? 1 : (line == 865 ? 2 : 0xfe));
+    qs_crumb_write(0x601b, tail, 4);
+    qs_crumb(0x25);
+}
+
+/*
+ * image 120: the AP GPIO block (pinctrl@39b028000, ADT /arm-io/gpio0, 255 pins) is reset by the real cut, every pin back
+ * at its reset value; among them the Wi-Fi's PERST# (pin 4), so its PCIe link cannot train. Snapshot the pins and the
+ * block's word at +0xc48 at SYSTEM_SUSPEND; at the wake write +0xc48 first, then each changed pin in macOS's order
+ * (config with the input enable as it was, then the input enable, the lock last), skipping locked pins and the ADT's
+ * no-restore-gpio-pins. Found by nekolyanich (t6020), Diljit Singh (T8140, aurora-silicon/linux bc9540d8) and
+ * Frantisek Balazsy (T6040, bdcec850, 6708d139, a9b887ff), whose write order this follows.
+ */
+#define QS_GPIO_BASE 0x39b028000ULL
+#define QS_GPIO_N    255
+static u32 qs_gpio_save[QS_GPIO_N] __attribute__((aligned(64)));
+static u32 qs_gpio_global, qs_gpio_saved;
+static u8 qs_gpio_skip[(QS_GPIO_N + 7) / 8];
+
+static void qs_gpio_init(void)
+{
+    int node = adt_path_offset(adt, "/arm-io/gpio0");
+    u32 len = 0;
+    const u32 *np = node >= 0 ? adt_getprop(adt, node, "no-restore-gpio-pins", &len) : NULL;
+    if (np && len >= 4) {
+        for (u32 i = 0; i < len / 4; i++)
+            if (np[i] < QS_GPIO_N)
+                qs_gpio_skip[np[i] / 8] |= BIT(np[i] % 8);
+    } else {
+        static const u8 def[3] = {130, 131, 135}; /* j416s (nekolyanich) */
+        for (int i = 0; i < 3; i++)
+            qs_gpio_skip[def[i] / 8] |= BIT(def[i] % 8);
+    }
+    dc_civac_range((void *)qs_gpio_skip, sizeof(qs_gpio_skip));
+}
+
+static void qs_gpio_snapshot(void)
+{
+    for (int i = 0; i < QS_GPIO_N; i++)
+        qs_gpio_save[i] = read32(QS_GPIO_BASE + 4 * i);
+    qs_gpio_global = read32(QS_GPIO_BASE + 0xc48);
+    qs_gpio_saved = 1;
+    dc_civac_range((void *)qs_gpio_save, sizeof(qs_gpio_save));
+    dc_civac_range((void *)&qs_gpio_global, sizeof(qs_gpio_global));
+    dc_civac_range((void *)&qs_gpio_saved, sizeof(qs_gpio_saved));
+}
+
+static int qs_gpio_restore(void)
+{
+    const u32 LOCK = BIT(21), IE = BIT(9);
+    int n = 0;
+
+    if (!qs_gpio_saved)
+        return -1;
+    write32(QS_GPIO_BASE + 0xc48, qs_gpio_global);
+    for (int i = 0; i < QS_GPIO_N; i++) {
+        u32 old = read32(QS_GPIO_BASE + 4 * i), cfg = qs_gpio_save[i];
+        if (old == cfg || (qs_gpio_skip[i / 8] & BIT(i % 8)) || (old & LOCK))
+            continue;
+        u32 val = cfg & ~(LOCK | IE);
+        u64 r = QS_GPIO_BASE + 4 * i;
+        if (!(cfg & IE)) {
+            write32(r, old & ~(LOCK | IE));
+            write32(r, val);
+        } else {
+            write32(r, (old & IE) | val);
+            if (!(old & IE))
+                write32(r, cfg & ~LOCK);
+        }
+        if (cfg & LOCK)
+            write32(r, cfg);
+        n++;
+    }
+    return n;
+}
+
+/*
+ * image 119: the internal PCIe ports' per-port setup that Linux's probe writes (apple_pcie_setup_port) and the power
+ * cut loses: INTMSK, MSICFG, MSIADDR(_HI), RID2SID[16], MSIMAP[32] (nekolyanich: "redo probe's whole per-port setup").
+ * Ports 0 (Wi-Fi) and 1 (SD) on T6020. Saved at SYSTEM_SUSPEND, written back after the apcie re-init at the wake.
+ */
+static const u64 qs_pport[2] = {0x594008000ULL, 0x595008000ULL};
+static u32 qs_pport_save[2][4 + 16 + 32] __attribute__((aligned(64)));
+static u32 qs_pport_saved;
+
+static void qs_pport_do(int restore)
+{
+    for (int p = 0; p < 2; p++) {
+        u64 b = qs_pport[p];
+        u32 *v = qs_pport_save[p];
+        if (!restore) {
+            v[0] = read32(b + 0x104);
+            v[1] = read32(b + 0x124);
+            v[2] = read32(b + 0x16c);
+            v[3] = read32(b + 0x170);
+            for (int i = 0; i < 16; i++)
+                v[4 + i] = read32(b + 0x3000 + 4 * i);
+            for (int i = 0; i < 32; i++)
+                v[20 + i] = read32(b + 0x3800 + 4 * i);
+        } else {
+            write32(b + 0x16c, v[2]);
+            write32(b + 0x170, v[3]);
+            for (int i = 0; i < 32; i++)
+                write32(b + 0x3800 + 4 * i, v[20 + i]);
+            for (int i = 0; i < 16; i++)
+                write32(b + 0x3000 + 4 * i, v[4 + i]);
+            write32(b + 0x124, v[1]);
+            write32(b + 0x104, v[0]);
+        }
+    }
+}
+
+static u32 psci_ps_sep_saved; /* image 118: ps_sep at SYSTEM_SUSPEND, cleaned to the PoC */
+
+/* RVBAR re-entry of the boot CPU from psci_system_suspend(), after init_cpu() and exception_initialize() */
+
+/*
+ * image 123: the power cut resets every PMGR power state, but Linux's genpd still has the domains it left on
+ * (and their parents) as on. Snapshot all of them at SYSTEM_SUSPEND entry and, at the RVBAR wake, before
+ * anything touches a block, put back target ACTIVE on each that was fully on, in passes so that children
+ * follow their parents (Andreas Fernandez's t6000 S2R driver does the same from Linux). 0x6008 = domains
+ * re-powered, 0x600a = still not on after the last pass (both capped at 254).
+ */
+#define QS_PS_MAX 512
+static u32 qs_ps_saved[QS_PS_MAX] __attribute__((aligned(64)));
+static u32 qs_ps_saved_n;
+
+static void qs_ps_snapshot(void)
+{
+    u32 n = pmgr_ps_tab_count(), key;
+
+    if (n > QS_PS_MAX)
+        n = QS_PS_MAX;
+    for (u32 i = 0; i < n; i++)
+        qs_ps_saved[i] = read32(pmgr_ps_tab_addr(i, &key));
+    qs_ps_saved_n = n;
+    dc_civac_range(qs_ps_saved, sizeof(qs_ps_saved));
+    dc_civac_range(&qs_ps_saved_n, sizeof(qs_ps_saved_n));
+}
+
+static void qs_ps_restore(void)
+{
+    u32 key, redone = 0, left = 0;
+    u8 b;
+
+    dc_ivac_range(qs_ps_saved, sizeof(qs_ps_saved));
+    dc_ivac_range(&qs_ps_saved_n, sizeof(qs_ps_saved_n));
+    for (int pass = 0; pass < 6; pass++) {
+        u32 touched = 0;
+        left = 0;
+        for (u32 i = 0; i < qs_ps_saved_n; i++) {
+            u32 sv = qs_ps_saved[i];
+            if ((sv & 0xf) != 0xf || ((sv >> 4) & 0xf) != 0xf)
+                continue;
+            u64 a = pmgr_ps_tab_addr(i, &key);
+            u32 cur = read32(a);
+            if (((cur >> 4) & 0xf) == 0xf)
+                continue;
+            if ((cur & 0xf) != 0xf) {
+                write32(a, (cur & ~0xfU) | 0xf);
+                touched++;
+                if (!pass)
+                    redone++;
+            }
+            for (int t = 0; t < 200 && ((read32(a) >> 4) & 0xf) != 0xf; t++)
+                udelay(5);
+            if (((read32(a) >> 4) & 0xf) != 0xf)
+                left++;
+        }
+        if (!left || !touched)
+            break;
+    }
+    b = redone > 254 ? 254 : redone;
+    qs_crumb_write(0x6008, &b, 1);
+    b = left > 254 ? 254 : left;
+    qs_crumb_write(0x600a, &b, 1);
+}
+
+void __attribute__((noreturn)) psci_suspend_rvbar(void)
+{
+    int line;
+
+    asm volatile("msr daifset, #0xf\n isb" ::: "memory");
+    /*
+     * stage 1: reset 10 s from here. The time to the reset tells how far the RVBAR path got: 10 s and 150 s
+     * (stage 2) are unlike every other dog (120 s) and the SMC's own reset, so a reset time names its stage.
+     */
+    wdt_psci_arm(RVBAR_WDT_S);
+    /* Sample nub-spmi0 active IRQs before qs_crumb(0x21) triggers SPMI_IRQ_NOTIFY */
+    u32 spmi_p0 = read32(0x29e114060ULL) & read32(0x29e114020ULL);
+    u32 spmi_c0 = read32(0x29e114080ULL) & read32(0x29e114040ULL);
+    u8 spmi_wk = 0x80 | ((spmi_c0 & 1U) ? 1 : 0) | ((spmi_c0 & ~1U) ? 2 : 0) |
+                 ((spmi_p0 & BIT(2)) ? 4 : 0) | ((spmi_p0 & ~BIT(2)) ? 8 : 0);
+    qs_crumb(0x21);
+    dc_ivac_range((void *)psci_dbg, sizeof(psci_dbg));
+    psci_dbg[12]++;
+    /*
+     * A boot CPU back through RVBAR with the resume magic set had its power cut: by the SoC's S2R (the
+     * reconfig engine restarts it on a wake source) or a core power-down. After S2R the AIC has lost its
+     * state, so no wake line shows; resume the kernel anyway (line -1, psci_dbg[13] 3) and let its AIC
+     * restore and drivers take over. Stage 2 (RESUME_WDT_S) resets the Mac if the kernel's resume hangs.
+     */
+    line = psci_wake_line();
+    qs_rvbar_telemetry(line, spmi_wk);
+    qs_ps_restore(); /* image 123: before any block is touched */
+    /* image 120: the AP GPIO block back before the PCIe re-init (Wi-Fi PERST#); pins put back -> 0x601e (ff = no snapshot) */
+    {
+        int g = qs_gpio_restore();
+        u8 gb = g < 0 ? 0xff : (g > 254 ? 254 : (u8)g);
+        qs_crumb_write(0x601e, &gb, 1);
+    }
+    qs_apq_restore(); /* image 125: before the apcie re-init */
+    /* image 116: rerun the apcie bring-up (see pcie_reinit_apcie); 0x6023: a1 started, a0 done, af error */
+    {
+        u8 c = 0xa1;
+        iodev_console_muted = true;
+        qs_crumb_write(0x6023, &c, 1);
+        c = pcie_reinit_apcie() == 0 ? 0xa0 : 0xaf;
+        if (c == 0xa0 && qs_pport_saved) { /* image 119 */
+            qs_pport_do(1);
+            c |= 0x04;
+        }
+        qs_crumb_write(0x6023, &c, 1);
+    }
+    /*
+     * image 118: R57AK: ps_sep did not come on with a target write (actual 0 after 100 ms). In normal running it sits
+     * at 0x1000030f (AUTO_ENABLE, target f, actual 0, power-gated) and wakes on access; the cut likely resets that.
+     * Write back the value saved at SYSTEM_SUSPEND (RESET cleared, target f). Raw value found at the wake: 0x601d
+     * bits 7:0, 0x601e bits 15:8, 0x600f bits 31:24; 0x6023 |= 2 if the actual state reaches f.
+     */
+    {
+        u64 ps = 0x290280c00ULL;
+        u32 v = read32(ps);
+        u8 r0 = v & 0xff, r3 = v >> 24;
+        qs_crumb_write(0x601d, &r0, 1);
+        qs_crumb_write(0x600f, &r3, 1);
+        u32 w = (psci_ps_sep_saved ? psci_ps_sep_saved : v) & ~(BIT(31) | 0xfU);
+        write32(ps, w | 0xf);
+        u8 ok = 0;
+        for (int i = 0; i < 10000; i++) {
+            if (((read32(ps) >> 4) & 0xf) == 0xf) {
+                ok = 1;
+                break;
+            }
+            udelay(10);
+        }
+        if (ok) {
+            u8 c = 0xa2 | (qs_pport_saved ? 0x04 : 0);
+            qs_crumb_write(0x6023, &c, 1);
+        }
+    }
+    psci_resume_kernel(line, 1);
+}
+
+static unsigned long psci_system_suspend(unsigned long entry, unsigned long context)
+{
+    u64 now, hcr, daif;
+    int line;
+
+    wdt_psci_arm(SUSPEND_WDT_S);
+    /* image 122: entry crumbs before anything that touches other blocks (0x31 entry, 0x32 GPIO done, 0x33 ports done) */
+    qs_crumbs.on = 1;
+    dc_civac_range((void *)&qs_crumbs, sizeof(qs_crumbs));
+    qs_crumb(0x31);
+    qs_ps_snapshot(); /* image 123 */
+    psci_ps_sep_saved = read32(0x290280c00ULL); /* image 118 */
+    if (chip_id == T6020) /* image 120 */
+        qs_gpio_snapshot();
+    qs_crumb(0x32);
+    if (chip_id == T6020) { /* image 119 */
+        qs_pport_do(0);
+        qs_crumb(0x33);
+        qs_pport_saved = 1;
+        dc_civac_range((void *)qs_pport_save, sizeof(qs_pport_save));
+        dc_civac_range((void *)&qs_pport_saved, sizeof(qs_pport_saved));
+    }
+    dc_civac_range((void *)&psci_ps_sep_saved, sizeof(psci_ps_sep_saved));
+    asm volatile("mrs %0, hcr_el2" : "=r"(hcr));
+    asm volatile("mrs %0, daif" : "=r"(daif));
+    for (unsigned i = 0; i < 24; i++)
+        psci_dbg[i] = 0;
+    psci_dbg[1] = hcr;
+    psci_dbg[2] = daif;
+    psci_dbg[14] = mrs(SYS_IMP_APL_CYC_OVRD);
+    dc_ivac_range((void *)psci_ctl, sizeof(psci_ctl));
+    u64 steps = psci_ctl[1] & (PSCI_S2R_TIMER | PSCI_S2R_CORESOFF | PSCI_S2R_DOMAINS | PSCI_S2R_CLOCKS | PSCI_S2R_CLUSTERS | PSCI_S2R_STOPREQ | PSCI_S2R_HELD | PSCI_S2R_REC | PSCI_S2R_AMCC | PSCI_S2R_STOPWD2 | PSCI_S2R_AICMASK | PSCI_S2R_WD1OFF | PSCI_S2R_RESUMENOW | PSCI_S2R_CRUMB | PSCI_S2R_QUIET | PSCI_S2R_EACC | PSCI_S2R_DVFS | PSCI_S2R_FABRIC | PSCI_S2R_ATC | PSCI_S2R_PCIE | PSCI_S2R_AON | PSCI_S2R_PMP | PSCI_S2R_SPMINOTIFY | PSCI_S2R_SEP | PSCI_S2R_DVFSLATE | PSCI_S2R_EDPRCR | PSCI_S2R_OBSERVE | PSCI_S2R_OBSERVE_P0 | PSCI_S2R_NOCOMMIT | PSCI_S2R_LATEREL | PSCI_S2R_TWOWR);
+    for (unsigned i = 0; i < 48; i++)
+        psci_dbg2[i] = 0;
+    psci_dbg2[1] = steps | ((u64)qs_amcc_n << 32) | ((u64)qs_amcc_planes << 40);
+    if (steps & PSCI_S2R_REC) {
+        qs_rec_wdt(2);
+        qs_rec_amcc(26);
+        for (int i = 0; i < qs_amcc_n && i < 4; i++)
+            psci_dbg2[34 + i] = ((u64)read32(AMCC_EN(qs_amcc_base[i], 0, 1)) << 32) | read32(AMCC_EN(qs_amcc_base[i], 0, 0));
+    }
+    qs_crumbs.on = !!(steps & PSCI_S2R_CRUMB);
+    dc_civac_range((void *)&qs_crumbs, sizeof(qs_crumbs));
+    psci_s2r_committed = 0;
+    dc_civac_range((void *)&psci_s2r_committed, sizeof(psci_s2r_committed));
+    qs_crumb(0x11);
+    qs_held_mask = (psci_ctl[2] & 0xfff) ? (psci_ctl[2] & 0xfff) : 0xfff;
+    psci_dbg[17] = 0x5300000000ULL | (psci_ctl[1] & 0xffffffff); /* the control word this suspend read */
+
+    if (!aic || aic->version != 2) {
+        psci_dbg[3] = 2;
+        wdt_psci_disarm();
+        psci_dbg[0] = 0xA0AA0001;
+        dc_civac_range((void *)psci_dbg, sizeof(psci_dbg));
+        psci_enter(entry, context);
+    }
+
+    psci_resume.entry = entry;
+    psci_resume.context = context;
+    asm volatile("mrs %0, cntfrq_el0" : "=r"(psci_resume.frq));
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(psci_resume.start));
+    /* Ignore wake sources for the first SUSPEND_MIN_MS (Linux is still finishing its own suspend work) */
+    do {
+        asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(now));
+    } while (now - psci_resume.start < psci_resume.frq / 1000 * SUSPEND_MIN_MS);
+
+    for (unsigned i = 0; i < 2; i++)
+        psci_resume.basew[i] = read32(wake_hw_word(i)) & BIT(wake_irq[i] & 31);
+    psci_dbg[11] = 0x100000000UL | psci_resume.basew[0] | ((u64)psci_resume.basew[1] << 16);
+    psci_resume.magic = RESUME_MAGIC;
+
+    /*
+     * All of DAIF masked (WFI still wakes on a pending interrupt, and Linux's vectors never run); the wake lines
+     * unmasked at the AIC for the wait and masked again afterwards as Linux's syscore suspend left them. A line
+     * already asserted would end every WFI at once, so it stays masked.
+     */
+    asm volatile("msr daifset, #0xf\n isb" ::: "memory");
+    for (unsigned i = 0; i < 2; i++)
+        if (!psci_resume.basew[i])
+            write32(aic->base + aic->regs.mask_clr + 4 * (wake_irq[i] >> 5), BIT(wake_irq[i] & 31));
+    /*
+     * The RVBAR path runs with the MMU and caches off and so reads DRAM directly: every global it touches
+     * (boot_cpu_mpidr for is_boot_cpu(), the watchdog and AIC bases, cpu_features, the reset stacks, this
+     * state) must be in memory, and nothing of the image may stay cached to shadow what it writes there.
+     * Clean and invalidate the whole resident image, code to end of BSS.
+     */
+    /* image 39: the whole-image clean (images 35 to 38) is left out: 37 and 38 hung with it, 31 passed without */
+    dc_civac_range((void *)&psci_resume, sizeof(psci_resume));
+
+    /* the S2R steps, in macOS's order: quiesceHW's domains and clocks, its S2R timer last, then every core */
+    /* image 68: the SEP step first. Image 67 had it after the PMGR quiesce and hung at it (run R18I: last crumb
+     * 0x17, WD1's reset): by then the mailbox's own domain or clock is off. Crumbs 0x18 before, 0x19 after */
+    bool quiet = (steps & PSCI_S2R_QUIET) && (steps & PSCI_S2R_TIMER) && (steps & PSCI_S2R_CORESOFF);
+    bool edge_hold = quiet && (psci_ctl[5] & 64);
+    bool clean_mode = quiet && (psci_ctl[5] & 128);
+    u32 edge_awake = 0;
+    if (edge_hold)
+        edge_awake = smp_psci_hold_parked();
+    qs_sep_res = 0;
+    if (steps & PSCI_S2R_SEP) {
+        qs_crumb(0x18);
+        psci_quiesce_sep();
+        qs_crumb(0x19);
+    }
+    if (clean_mode && (psci_ctl[5] & 1))
+        psci_quiesce_asc();
+    if (steps & PSCI_S2R_HELD)
+        psci_quiesce_held();
+    if (steps & PSCI_S2R_DOMAINS)
+        psci_quiesce_domains();
+    if (steps & PSCI_S2R_ATC)
+        psci_quiesce_atc();
+    if (clean_mode)
+        psci_quiesce_pcie_rc();
+    if (psci_ctl[5] & 256)
+        psci_quiesce_apq(); /* image 125 */
+    if (steps & PSCI_S2R_PCIE)
+        psci_quiesce_pcie();
+    if (steps & PSCI_S2R_AON)
+        psci_quiesce_aon();
+    if (steps & PSCI_S2R_PMP)
+        psci_quiesce_pmp();
+    if (clean_mode)
+        psci_force_ps_lower();
+    if (steps & PSCI_S2R_FABRIC)
+        psci_quiesce_fabric();
+    if (steps & PSCI_S2R_CLUSTERS)
+        psci_quiesce_clusters();
+    if (steps & PSCI_S2R_EACC)
+        psci_quiesce_eacc();
+    if (steps & PSCI_S2R_CLOCKS)
+        psci_quiesce_clocks();
+    if (steps & PSCI_S2R_AMCC)
+        psci_quiesce_amcc();
+    if (steps & PSCI_S2R_DVFS)
+        psci_quiesce_dvfs(7);
+    if (steps & PSCI_S2R_REC) {
+        qs_rec_wdt(8);
+        qs_rec_amcc(30);
+    }
+    /*
+     * Image 59: macOS enters with every AON watchdog's ctl at 0 (t8103 and T8140 traces; 13.5's AppleARMWatchdogTimer
+     * sleep action leaves WD1 alone and clears WD0 and reg 3's low byte, both already 0 here). Aura's WD1 has been armed
+     * (120 s) through every entry so far. The timer's own reset stays as the safety net.
+     */
+    if (!clean_mode && (psci_ctl[5] & 1))
+        psci_quiesce_asc();
+    if (clean_mode)
+        psci_replay_mem_clean();
+    else if (psci_ctl[5] & 4)
+        psci_replay_mem();
+    if (!clean_mode && (psci_ctl[5] & 2))
+        psci_force_ps();
+    /* image 99 (psci_ctl[5] bit 4): deep sleep timers off (+ IRQ/FIQ_MODE 2 on secondaries; image 102 keeps 0 on CPU0) */
+    cpu_sleep_deep_extra = !!(psci_ctl[5] & 16);
+    cpu_sleep_boot_irq_route = clean_mode;
+    dc_civac_range((void *)&cpu_sleep_deep_extra, sizeof(cpu_sleep_deep_extra));
+    dc_civac_range((void *)&cpu_sleep_boot_irq_route, sizeof(cpu_sleep_boot_irq_route));
+    sysop("dsb sy");
+    qs_crumb(0x12);
+    if (quiet) {
+        /* image 60g: everything that touches hardware happens before the commit */
+        if ((steps & PSCI_S2R_AICMASK) && !(psci_ctl[5] & 32)) /* image 100 (bit 5): the mask-all goes between the two commits */
+            psci_quiesce_aic();
+        qs_crumb(0x17);
+        if (edge_hold) {
+            if (steps & PSCI_S2R_STOPREQ) {
+                smp_psci_stop_parked();
+                udelay(2000);
+            }
+            u32 edge_alive = smp_psci_ping_held();
+            if (qs_crumbs.on) {
+                u8 cnt = 0;
+                for (int i = 0; i < 16; i++)
+                    if (edge_awake & BIT(i))
+                        cnt++;
+                u8 aw[3] = {edge_awake & 0xff, edge_awake >> 8, cnt};
+                u8 al[2] = {edge_alive & 0xff, edge_alive >> 8};
+                u8 cp[2] = {read32(QS_CPM_PS) >> 4, read32(QS_CPM_PS + 8) >> 4};
+                u8 cl[4] = {read32(QS_CPM_PS + 0x10) >> 4, read32(QS_CLUSTER), read32(QS_CLUSTER + 4), read32(QS_CLUSTER + 8)};
+                qs_crumb_write(0x6005, aw, 3);
+                qs_crumb_write(0x6015, al, 2);
+                qs_crumb_write(0x6012, cp, 2);
+                qs_crumb_write(0x601b, cl, 4);
+                if (qs_save.saved & 4096) {
+                    u8 pm = qs_pmp_state() | qs_sep_res;
+                    qs_crumb_write(0x6011, &pm, 1);
+                }
+                if (qs_save.saved & (1024 | 2048)) {
+                    u8 pa = qs_pcie_aon_state() | (((qs_save.saved & 512) && qs_atc_state()) ? 0x80 : 0);
+                    qs_crumb_write(0x600c, &pa, 1);
+                }
+                if (clean_mode) {
+                    u8 key_on = 0;
+                    u8 rem_on = qs_zero_ps_still_on(&key_on);
+                    qs_crumb_write(0x6014, &rem_on, 1);
+                    qs_crumb_write(0x601f, &key_on, 1);
+                }
+            }
+        } else {
+            if (!(steps & PSCI_S2R_LATEREL)) {
+                smp_psci_release_parked(steps & PSCI_S2R_STOPREQ, steps & PSCI_S2R_EDPRCR,
+                                        (steps & PSCI_S2R_OBSERVE) ? ((steps & PSCI_S2R_OBSERVE_P0) ? 2 : 1) : 0);
+                udelay(2000);
+            }
+            if ((steps & PSCI_S2R_LATEREL) && (steps & PSCI_S2R_STOPREQ)) {
+                smp_psci_stop_parked(); /* image 91: the stop requests while every core is still awake, as macOS */
+                udelay(40000);
+            }
+            qs_crumb_snapshot();
+        }
+        if (steps & PSCI_S2R_EDPRCR) {
+            /* image 72: the boot core's own EDPRCR := 0, and what every core had there, kept in 0x601f */
+            u32 b = smp_psci_ed_release(), o = 0;
+            for (int i = 1; i < 16 && i < MAX_CPUS; i++)
+                if (smp_psci_cpu_valid(i))
+                    o |= smp_psci_s2r_word(i, 4);
+            u8 e = 0x80 | (b & 3) | ((b >> 1) & 4) | ((b & 0xff00) ? 8 : 0) | ((o & 3) << 4) | ((o & 8) << 3);
+            qs_crumb_write(0x601f, &e, 1);
+        }
+        if (steps & PSCI_S2R_DVFSLATE) {
+            /*
+             * image 70: macOS turns APSC off once its secondaries are down; image 61 did it before the release.
+             * image 71: R20b stopped inside the step (crumb 0x17 left, both P complexes read off in the snapshot), so
+             * only the clusters whose complex still reads on are touched (the boot core's E cluster), crumb 0x1c first.
+             */
+            unsigned m = 1;
+            if (read32(QS_CPM_PS + 8) & 0xf0)
+                m |= 2;
+            if (read32(QS_CPM_PS + 0x10) & 0xf0)
+                m |= 4;
+            qs_crumb(0x1c);
+            psci_quiesce_dvfs(m);
+            qs_crumb(0x1b); /* the last access before the commit, the late APSC step done */
+        } else {
+            qs_crumb(0x16); /* the last access before the commit */
+        }
+    }
+    if (quiet && (steps & PSCI_S2R_SPMINOTIFY)) {
+        /* image 104: W1C-ack pending controller IRQs on nub-spmi0/1 (incl. SPMI_IRQ_NOTIFY from qs_crumb) before and after NOTIFY_EN */
+        write32(QS_SPMI0_NOTIFY_ACK, 0xffffffffU);
+        (void)read32(QS_SPMI0_NOTIFY_ACK);
+        write32(QS_SPMI1_NOTIFY_ACK, 0xffffffffU);
+        (void)read32(QS_SPMI1_NOTIFY_ACK);
+        write32(QS_SPMI0_NOTIFY_EN, QS_SPMI_NOTIFY_SLEEP);
+        write32(QS_SPMI1_NOTIFY_EN, QS_SPMI_NOTIFY_SLEEP);
+        write32(QS_SPMI0_NOTIFY_ACK, 0xffffffffU);
+        (void)read32(QS_SPMI0_NOTIFY_ACK);
+        write32(QS_SPMI1_NOTIFY_ACK, 0xffffffffU);
+        (void)read32(QS_SPMI1_NOTIFY_ACK);
+        sysop("dsb sy");
+        psci_dbg2[46] = ((u64)read32(QS_SPMI1_NOTIFY_EN) << 32) | read32(QS_SPMI0_NOTIFY_EN);
+    }
+    if ((steps & PSCI_S2R_WD1OFF) && (steps & PSCI_S2R_TIMER)) {
+        wdt_psci_disarm();
+        psci_dbg2[45] = 0x5100000000ULL | 1;
+    }
+    if (quiet) {
+        if (steps & PSCI_S2R_OBSERVE) { /* image 84: the observer's "before" snapshot, up to 2 s */
+            u64 ts = qs_now();
+            psci_s2r_snapdone = 0;
+            dc_civac_range((void *)&psci_s2r_snapdone, sizeof(psci_s2r_snapdone));
+            psci_s2r_committed = 2;
+            dc_civac_range((void *)&psci_s2r_committed, sizeof(psci_s2r_committed));
+            while (!*(volatile u64 *)&psci_s2r_snapdone && qs_now() - ts < 2 * 24000000ULL)
+                ;
+        }
+        if (!(steps & PSCI_S2R_NOCOMMIT)) {
+            write32(MPMGR_AON_S2R_TIMER, 1);
+            sysop("dsb sy");
+            if (psci_ctl[5] & 32) {
+                /*
+                 * image 100 (psci_ctl[5] bit 5), nekolyanich's t6020 order (GH-5 #5, 2026-11-18): commit 1, AIC mask-all,
+                 * commit 2 about 0.52 ms later. Only two writes in total, so bit 3 is implied.
+                 */
+                if (steps & PSCI_S2R_AICMASK)
+                    psci_quiesce_aic();
+                udelay(520);
+                write32(MPMGR_AON_S2R_TIMER, 1);
+                sysop("dsb sy");
+            } else
+            /* image 99 (psci_ctl[5] bit 3): one timer write, as Andreas Fernandez's t6000 driver */
+            if (!(psci_ctl[5] & 8)) {
+                write32(MPMGR_AON_S2R_TIMER, 1);
+                sysop("dsb sy");
+            }
+            if (!(steps & PSCI_S2R_TWOWR) && !(psci_ctl[5] & (8 | 32))) {
+                write32(MPMGR_AON_S2R_TIMER, 1);
+                sysop("dsb sy");
+            }
+        }
+        psci_dbg[18] = 3;
+        psci_dbg[0] = 0xA0AA0003;
+        psci_s2r_committed = 1; /* image 73: the observer core starts its 3 s here */
+        dc_civac_range((void *)&psci_s2r_committed, sizeof(psci_s2r_committed));
+        sysop("dsb sy");
+        if (edge_hold)
+            smp_psci_edge_release_and_sleep();
+        if (steps & PSCI_S2R_LATEREL) /* image 89: only now do the secondaries arm their deep sleep, with the boot core */
+            smp_psci_release_parked(steps & PSCI_S2R_STOPREQ, false, 0);
+        dcsw_op_all(DCSW_OP_DCCISW);
+        sysop("dsb sy");
+        cpu_sleep_counted(true, smp_psci_s2r_ptr(boot_cpu_idx)); /* back only through RVBAR: psci_suspend_rvbar() */
+    }
+    if (!quiet && (steps & PSCI_S2R_TIMER)) {
+        write32(MPMGR_AON_S2R_TIMER, 1);
+        sysop("dsb sy");
+        psci_dbg[18] = 1;
+        qs_crumb(0x13);
+        if (steps & PSCI_S2R_REC)
+            qs_rec_wdt(14);
+        if (steps & PSCI_S2R_REC || steps & PSCI_S2R_STOPWD2) {
+            udelay(100000);
+            qs_rec_wdt(20);
+        }
+        if (steps & PSCI_S2R_STOPWD2) {
+            u64 wdt = wdt_psci_base();
+            if (wdt) {
+                write32(wdt + 0x2c, 0);
+                sysop("dsb sy");
+                psci_dbg2[44] = 0x5700000000ULL | read32(wdt + 0x2c);
+            }
+        }
+        qs_crumb(0x14);
+        if ((steps & PSCI_S2R_AICMASK) && (steps & PSCI_S2R_CORESOFF))
+            psci_quiesce_aic();
+        qs_crumb(0x15);
+    }
+    psci_dbg2[0] = 0xA0AA0002;
+    dc_civac_range((void *)psci_dbg2, sizeof(psci_dbg2));
+    /* image 59: straight back to the kernel after the timer (no cores off): Linux logs the watchdogs until the reset */
+    if ((steps & PSCI_S2R_RESUMENOW) && (steps & PSCI_S2R_TIMER) && !(steps & PSCI_S2R_CORESOFF)) {
+        asm volatile("msr daifset, #0xf\n isb" ::: "memory");
+        psci_resume_kernel(-1, 0);
+    }
+    if (!quiet && (steps & PSCI_S2R_CORESOFF)) {
+        psci_dbg[0] = 0xA0AA0001;
+        dc_civac_range((void *)psci_dbg, sizeof(psci_dbg));
+        qs_crumb(0x17);
+        smp_psci_release_parked(steps & PSCI_S2R_STOPREQ, false, false); /* the secondaries go first, as macOS's stall release */
+        udelay(2000);
+        qs_crumb_snapshot();
+        qs_crumb(0x18);
+        dcsw_op_all(DCSW_OP_DCCISW);
+        sysop("dsb sy");
+        qs_crumb(0x19);
+        cpu_sleep(true); /* back only through RVBAR: psci_suspend_rvbar() */
+    }
+
+    u64 hb_ctl = mrs(SYS_CNTHP_CTL_EL2), hb_cval = mrs(SYS_CNTHP_CVAL_EL2), hb_next;
+    asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(now));
+    hb_next = now + psci_resume.frq * SUSPEND_HB_S;
+    msr(SYS_CNTHP_CVAL_EL2, hb_next);
+    msr(SYS_CNTHP_CTL_EL2, CNTx_CTL_ENABLE);
+    sysop("isb");
+    qs_crumb(0x1a);
+    u64 hb_max = psci_ctl[3] & 0xffff, hb_n = 0;
+    if (!hb_max)
+        hb_max = SUSPEND_HB_MAX;
+    for (;;) {
+        psci_sleep_core();
+        psci_dbg[12]++;
+        if ((line = psci_wake_line()) >= 0)
+            break;
+        asm volatile("isb\n mrs %0, cntpct_el0" : "=r"(now));
+        if (now >= hb_next) {
+            if (hb_max != 0xffff && ++hb_n >= hb_max)
+                break; /* the cap: resume with line -1 */
+            wdt_psci_arm(SUSPEND_WDT_S);
+            psci_dbg[16]++;
+            hb_next = now + psci_resume.frq * SUSPEND_HB_S;
+            msr(SYS_CNTHP_CVAL_EL2, hb_next);
+            sysop("isb");
+        }
+    }
+    msr(SYS_CNTHP_CTL_EL2, hb_ctl);
+    msr(SYS_CNTHP_CVAL_EL2, hb_cval);
+    sysop("isb");
+    psci_resume_kernel(line, 0);
+}
+
+/*
+ * Image 106: the kernel's SYSTEM_RESET after an RVBAR wake. R57W showed the woken kernel panics within about a
+ * second (reset stamp = alarm + kernel.panic), and DRAM does not survive the reset. The restart runs this handler on
+ * the panicking CPU's kernel stack with the kernel's TTBR1 live, so walk its frame records (FRAME_POINTER=y, no
+ * KASLR) and leave the return addresses in PMU scratch, which survives: 0x6040 'P', frames, MPIDR aff0|aff1<<4,
+ * RVBAR entries; 0x6044.. low 32 bits of each kernel return address (PAC bits stripped), 31 max (to 0x60bf).
+ * Only after an RVBAR wake in this suspend (psci_dbg[12]); returns NOT_SUPPORTED so the kernel's next restart
+ * handler (the watchdog) still resets. Frames that are not kernel addresses (Aura's own) are skipped.
+ */
+/*
+ * image 121: a reset with no RVBAR wake in this boot (a test boot that fails before or without a sleep: the kernel's
+ * panic, or a deliberate reboot from the initramfs or userspace). 0x6004 = 0x51, 0x6005 = frames, slot 9 = ESR
+ * (EC 0x15 = a reboot syscall); skip the 4 restart frames (EFI wrapper, virt_efi_reset_system, machine_restart,
+ * emergency_restart or kernel_restart), keep 8; a pt_regs record (frame_record_meta type 2 at pt_regs + 296) is
+ * crossed and its pc taken as the next frame.
+ */
+static void qs_reset_trace_boot(const u16 *slot)
+{
+    u8 m = 0x51, n = 0;
+    int skip = 4;
+
+    qs_crumbs.on = 1;
+    qs_crumb_write(0x6005, &n, 1);
+    qs_crumb_write(0x6004, &m, 1);
+    u32 esr = (u32)mrs(ESR_EL1);
+    u8 e[3] = {esr & 0xff, (esr >> 8) & 0xff, ((esr >> 16) & 0x3) | (((esr >> 26) & 0x3f) << 2)};
+    qs_crumb_write(slot[8], e, 3);
+    u64 fp = (u64)__builtin_frame_address(0);
+    for (int i = 0; i < 64 && n < 8; i++) {
+        if (!fp || (fp & 7) || (fp >> 48) != 0xffff)
+            break;
+        u64 next = ((volatile u64 *)fp)[0];
+        u64 lr = ((volatile u64 *)fp)[1];
+        if (next == 0 && lr == 0 && ((volatile u64 *)(fp - 296))[312 / 8] == 2) {
+            u64 regs = fp - 296;
+            lr = ((volatile u64 *)regs)[256 / 8] | BIT(55);
+            next = ((volatile u64 *)regs)[232 / 8];
+            skip = 0;
+        }
+        if (lr & BIT(55)) {
+            if (skip > 0) {
+                skip--;
+            } else {
+                u64 x = (lr | 0xffff000000000000ULL) - 0xffff800080000000ULL;
+                u32 v = x >= (1ULL << 26) ? 0xffffff : (u32)(x >> 2);
+                u8 w[3] = {v & 0xff, (v >> 8) & 0xff, (v >> 16) & 0xff};
+                qs_crumb_write(slot[n], w, 3);
+                n++;
+                qs_crumb_write(0x6005, &n, 1);
+            }
+        }
+        if (!next || next == fp)
+            break;
+        fp = next;
+    }
+}
+
+static void __attribute__((noinline)) psci_reset_trace(void)
+{
+    /*
+     * Image 112: R57AE showed the PMU answers writes at 0x6040, but the PMU's scratch only holds 0x6000..0x6027
+     * (writes above read back 0 even from main). So the record overwrites the wake telemetry: 0x6004 = 0x50 (marker,
+     * replaces 0x22), 0x6005 = frames, then up to 9 kernel return addresses as ((lr - _text) >> 2), 3 bytes LE each,
+     * at the slots below. 0x600f/0x6010 (0x6010 = bootbin's test-boot flag), 0x601d..0x601f and 0x6024 are left alone.
+     */
+    static const u16 slot[9] = {0x6006, 0x6009, 0x600c, 0x6011, 0x6014, 0x6017, 0x601a, 0x6020, 0x6025};
+    u64 rv = psci_dbg[12];
+
+    if (!qs_crumbs.base)
+        return;
+    if (!rv) {
+        qs_reset_trace_boot(slot);
+        return;
+    }
+    qs_crumbs.on = 1;
+    u8 m = 0x50, n = 0;
+    qs_crumb_write(0x6005, &n, 1);
+    qs_crumb_write(0x6004, &m, 1);
+    /* image 113: R57AF named arm64_serror_panic as frame 8; skip the 8 known restart frames, keep 8, ESR in slot 9 */
+    u32 esr = (u32)mrs(ESR_EL1);
+    u8 e[3] = {esr & 0xff, (esr >> 8) & 0xff, ((esr >> 16) & 0x3) | (((esr >> 26) & 0x3f) << 2)};
+    qs_crumb_write(slot[8], e, 3);
+    /*
+     * image 115: R57AH showed the SError interrupted el1_abort (from el1h_64_sync): the kernel was already handling a
+     * synchronous abort. Cross TWO pt_regs (frame_record_meta, type 2, at pt_regs + 296); at the second, record the
+     * faulting pc (+256) and its lr (+240), then 4 frames from its x29 (+232). Slots 6/7: FAR as a physical address
+     * (AT S1E1R, PAR_EL1), 48 bits LE; bit 47 set = the translation failed and it is FAR's VA. Slot 8: ESR.
+     */
+    {
+        u64 far = mrs(FAR_EL1), par, pa;
+        asm volatile("at s1e1r, %0\n isb" ::"r"(far));
+        par = mrs(PAR_EL1);
+        if (par & 1)
+            pa = far & 0xffffffffffffULL;
+        else
+            pa = (par & 0xfffffffff000ULL) | (far & 0xfff);
+        u8 p0[3] = {pa & 0xff, (pa >> 8) & 0xff, (pa >> 16) & 0xff};
+        u8 p1[3] = {(pa >> 24) & 0xff, (pa >> 32) & 0xff, (pa >> 40) & 0xff};
+        qs_crumb_write(slot[6], p0, 3);
+        qs_crumb_write(slot[7], p1, 3);
+    }
+    u64 fp = (u64)__builtin_frame_address(0);
+    int crossed = 0;
+    for (int i = 0; i < 80 && n < 6; i++) {
+        if (!fp || (fp & 7) || (fp >> 48) != 0xffff)
+            break;
+        u64 next = ((volatile u64 *)fp)[0];
+        u64 lr = ((volatile u64 *)fp)[1];
+        if (next == 0 && lr == 0 && ((volatile u64 *)(fp - 296))[312 / 8] == 2) { /* FRAME_META_TYPE_PT_REGS */
+            u64 regs = fp - 296;
+            crossed++;
+            if (crossed == 2) {
+                u64 rec[2] = {((volatile u64 *)regs)[256 / 8], ((volatile u64 *)regs)[240 / 8]};
+                for (int k = 0; k < 2; k++) {
+                    u64 x = (rec[k] | 0xffff000000000000ULL) - 0xffff800080000000ULL;
+                    u32 v = x >= (1ULL << 26) ? 0xffffff : (u32)(x >> 2);
+                    u8 w[3] = {v & 0xff, (v >> 8) & 0xff, (v >> 16) & 0xff};
+                    qs_crumb_write(slot[n], w, 3);
+                    n++;
+                    qs_crumb_write(0x6005, &n, 1);
+                }
+            }
+            fp = ((volatile u64 *)regs)[232 / 8];
+            continue;
+        }
+        if (crossed >= 2 && (lr & BIT(55))) {
+            u64 x = (lr | 0xffff000000000000ULL) - 0xffff800080000000ULL;
+            u32 v = x >= (1ULL << 26) ? 0xffffff : (u32)(x >> 2);
+            u8 w[3] = {v & 0xff, (v >> 8) & 0xff, (v >> 16) & 0xff};
+            qs_crumb_write(slot[n], w, 3);
+            n++;
+            qs_crumb_write(0x6005, &n, 1);
+        }
+        if (!next || next == fp)
+            break;
+        fp = next;
+    }
+}
+
+unsigned long psci_efi_handler(unsigned long fid, unsigned long arg0, unsigned long arg1,
+                               unsigned long arg2)
+{
+    if (!psci_runtime) {
+        psci_runtime = true;
+        dc_civac_range((void *)&psci_runtime, sizeof(psci_runtime));
+    }
+    switch (fid) {
+        case PSCI_0_2_FN_PSCI_VERSION:
+            return PSCI_VERSION_1_0;
+        case PSCI_1_0_FN_PSCI_FEATURES:
+            if (PSCI_FN(arg0) >= PSCI_MAX_FN)
+                return PSCI_RET_NOT_SUPPORTED;
+            return psci_efi_table.features[PSCI_FN(arg0)];
+        case PSCI_0_2_FN_CPU_OFF:
+            return smp_psci_cpu_off();
+        case PSCI_0_2_FN64_CPU_ON:
+            return smp_psci_cpu_on(arg0, arg1, arg2);
+        case PSCI_1_0_FN64_SYSTEM_SUSPEND:
+            return psci_system_suspend(arg0, arg1);
+        case PSCI_0_2_FN64_AFFINITY_INFO:
+            return psci_affinity_info(arg0, arg1);
+        case PSCI_0_2_FN_SYSTEM_RESET:
+            /* image 110/112: WD1 at 5 s while the record is written, then 2 s and no return */
+            wdt_psci_arm(5);
+            psci_reset_trace();
+            wdt_psci_arm(2);
+            for (;;)
+                asm volatile("wfe");
+            return PSCI_RET_NOT_SUPPORTED;
+        default:
+            return PSCI_RET_NOT_SUPPORTED;
+    }
+}
+
+const struct psci_efi_table psci_efi_table = {
+    .version = PSCI_VERSION_1_0,
+    .num_features = PSCI_MAX_FN,
+    .handler = psci_efi_handler,
+    .features =
+        {
+            [0 ... PSCI_MAX_FN - 1] = PSCI_RET_NOT_SUPPORTED,
+            [PSCI_FN(PSCI_0_2_FN_PSCI_VERSION)] = PSCI_RET_SUCCESS,
+            [PSCI_FN(PSCI_1_0_FN_PSCI_FEATURES)] = PSCI_RET_SUCCESS,
+            [PSCI_FN(PSCI_0_2_FN_CPU_OFF)] = PSCI_RET_SUCCESS,
+            [PSCI_FN(PSCI_0_2_FN64_CPU_ON)] = PSCI_RET_SUCCESS,
+            [PSCI_FN(PSCI_0_2_FN64_AFFINITY_INFO)] = PSCI_RET_SUCCESS,
+            [PSCI_FN(PSCI_1_0_FN64_SYSTEM_SUSPEND)] = PSCI_RET_SUCCESS,
+        },
+};
