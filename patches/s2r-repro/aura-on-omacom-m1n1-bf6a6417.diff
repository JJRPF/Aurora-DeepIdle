-void cpu_sleep(bool deep)
+volatile bool cpu_sleep_deep_extra;
+volatile bool cpu_sleep_boot_irq_route;
+
+/* image 99: what Andreas Fernandez's apple_s2r_cpu_sleep does before the final WFI (his s2r-sleep.S): a pending timer,
+ * even a masked one, aborts the power down; image 102 keeps IRQ/FIQ_MODE=0 on CPU0 (as Ante042 and macOS) so wake sources stay routed */
+static void cpu_sleep_deep_extra_setup(bool keep_irq_route)
 {
+    msr(CNTP_CTL_EL0, 0L);
+    msr(CNTV_CTL_EL0, 0L);
+    if (in_el2()) {
+        msr(CNTP_CTL_EL02, 0L);
+        msr(CNTV_CTL_EL02, 0L);
+    }
+    if (cpu_features->apple_sysregs_unlocked) {
+        u64 mode = keep_irq_route ? 0 : (CYC_OVRD_FIQ_MODE(2) | CYC_OVRD_IRQ_MODE(2));
+        reg_mask(SYS_IMP_APL_CYC_OVRD, CYC_OVRD_FIQ_MODE_MASK | CYC_OVRD_IRQ_MODE_MASK, mode);
+    }
+}
+
+static void cpu_sleep_setup(bool deep, bool keep_irq_route)
+{
+    if (deep && cpu_sleep_deep_extra)
+        cpu_sleep_deep_extra_setup(keep_irq_route);
     if (deep) {
         switch (cpu_features->sleep_mode) {
             case SLEEP_GLOBAL:
@@ -277,9 +299,49 @@ void cpu_sleep(bool deep)
                  CYC_OVRD_WFI_MODE(3) | CYC_OVRD_DISABLE_WFI_RET);
     }
 
+}
+
+void cpu_sleep(bool deep)
+{
+    cpu_sleep_setup(deep, false);
     // enter deep sleep
     while (1) {
         sysop("isb");
         sysop("wfi");
     }
 }
+
+/*
+ * image 75: as cpu_sleep(), but a WFI that returns is counted in w[5] and ISR_EL1 kept in w[6] (bit 8 = valid), flushed
+ * so another core can read it. A core that really powers down never gets here.
+ */
+void cpu_sleep_counted(bool deep, volatile u32 *w)
+{
+    cpu_sleep_setup(deep, cpu_sleep_boot_irq_route);
+    while (1) {
+        sysop("isb");
+        sysop("wfi");
+        w[5]++;
+        w[6] |= 0x100 | (mrs(ISR_EL1) & 0xff);
+        dc_civac_range((void *)w, 64);
+        sysop("dsb sy");
+    }
+}
+
+/*
+ * image 101: non-last core in a cluster enters deep WFI (WFI_MODE 3 + DISABLE_WFI_RET) without writing
+ * cluster-wide ACC_OVRD_DEEP_SLEEP, which xnu cpu.c / nekolyanich warn only the last core in the cluster should write.
+ */
+void cpu_sleep_no_acc(void)
+{
+    if (cpu_sleep_deep_extra)
+        cpu_sleep_deep_extra_setup(false);
+    if (cpu_features->apple_sysregs_unlocked) {
+        reg_mask(SYS_IMP_APL_CYC_OVRD, CYC_OVRD_WFI_MODE_MASK,
+                 CYC_OVRD_WFI_MODE(3) | CYC_OVRD_DISABLE_WFI_RET);
+    }
+    while (1) {
+        sysop("isb");
+        sysop("wfi");
+    }
+}
