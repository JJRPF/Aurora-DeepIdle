+/*
+ * PSCI CPU_ON / CPU_OFF / AFFINITY_INFO (psci.c), called by the kernel through the
+ * PSCI-via-EFI conduit: in the kernel's context, under its 1:1 EFI runtime map, so
+ * no printf here, and the spin table is shared with CPUs that run with the MMU
+ * off, so every write to it is cleaned to the point of coherency and every read
+ * of what those CPUs write is invalidated first.
+ *
+ * A secondary is parked in smp_secondary_entry() from boot until the kernel's
+ * first CPU_ON (PSCI OFF). CPU_OFF powers it down the way smp_stop_cpu() does
+ * (PMGR stop request, cpu_sleep(true)); CPU_ON then restarts it through the PMGR
+ * start registers, it re-enters through RVBAR (_cpu_reset_c) into the park loop,
+ * and is dispatched to the kernel's entry point from there.
+ *
+ * Known gap: a CPU_ON within the few instructions between the dying CPU's OFF
+ * and its power-down would find the core still up; the restart then does
+ * nothing and CPU_ON fails with INTERNAL_FAILURE (the kernel reports the CPU as
+ * failing to come online, nothing worse). The 1 ms wait makes that unlikely.
+ */
+enum psci_cpu_state {
+    PSCI_CPU_PARKED = 0, /* in the park loop, not yet given to the kernel */
+    PSCI_CPU_ON,
+    PSCI_CPU_OFF, /* done with memory and going down (set by the CPU itself) */
+};
+
+static u8 psci_cpu_state[MAX_CPUS] SMP_SHARED;
+static u8 psci_cpu_cold[MAX_CPUS] SMP_SHARED;
+
+static int smp_psci_index(u64 mpidr)
+{
+    mpidr &= 0xffffff;
+    for (int i = 0; i < MAX_CPUS; i++) {
+        dc_civac_range(&smp_reset_stacks[i], sizeof(smp_reset_stacks[i]));
+        if (cpu_info[i].valid && smp_reset_stacks[i].mpidr == mpidr)
+            return i;
+    }
+    if (boot_cpu_idx >= 0 && mpidr == (boot_cpu_mpidr & 0xffffff))
+        return boot_cpu_idx;
+    return -1;
+}
+
+int smp_psci_affinity_info(u64 mpidr)
+{
+    int index = smp_psci_index(mpidr);
+
+    if (index < 0)
+        return PSCI_RET_INVALID_PARAMS;
+    if (index == boot_cpu_idx)
+        return PSCI_AFFINITY_INFO_ON;
+
+    /*
+     * No power status read here: smp_stop_cpu() notes that register access dies
+     * with the last core of a cluster, so OFF is the CPU's own word, written
+     * after its last memory access, just before the power-down.
+     */
+    dc_civac_range(&psci_cpu_state[index], 1);
+    return psci_cpu_state[index] == PSCI_CPU_ON ? PSCI_AFFINITY_INFO_ON : PSCI_AFFINITY_INFO_OFF;
+}
+
+/* Hand a parked CPU its entry point, as smp_call4() does, without waiting. */
+static int smp_psci_dispatch(int index, u64 entry, u64 context)
+{
+    struct spin_table *t = &spin_table[index];
+
+    dc_civac_range(t, sizeof(*t));
+    if (!t->flag || t->target)
+        return PSCI_RET_INTERNAL_FAILURE;
+
+    t->args[0] = context;
+    t->args[1] = 0;
+    t->args[2] = 0;
+    t->args[3] = 0;
+    sysop("dmb sy");
+    t->target = entry;
+    dc_civac_range(t, sizeof(*t));
+    psci_cpu_state[index] = PSCI_CPU_ON;
+    dc_civac_range(&psci_cpu_state[index], 1);
+    sysop("dsb sy");
+
+    if (wfe_mode)
+        sysop("sev");
+    else
+        smp_send_ipi(index);
+    return PSCI_RET_SUCCESS;
+}
+
+int smp_psci_cpu_on(u64 mpidr, u64 entry, u64 context)
+{
+    int index = smp_psci_index(mpidr);
+
+    if (index < 0)
+        return PSCI_RET_INVALID_PARAMS;
+    if (!entry)
+        return PSCI_RET_INVALID_ADDRESS;
+    if (index == boot_cpu_idx)
+        return PSCI_RET_ALREADY_ON;
+
+    dc_civac_range(&psci_cpu_state[index], 1);
+    switch (psci_cpu_state[index]) {
+        case PSCI_CPU_ON:
+            return PSCI_RET_ALREADY_ON;
+        case PSCI_CPU_PARKED:
+        case PSCI_CPU_OFF:
+        default:
+            dc_civac_range(&psci_cpu_cold[index], 1);
+            if (psci_cpu_cold[index]) {
+                struct spin_table *t = &spin_table[index];
+                psci_cpu_cold[index] = 0;
+                dc_civac_range(&psci_cpu_cold[index], 1);
+                t->flag = 0;
+                t->args[0] = context;
+                t->args[1] = 0;
+                t->args[2] = 0;
+                t->args[3] = 0;
+                sysop("dmb sy");
+                t->target = entry;
+                dc_civac_range(t, sizeof(*t));
+                psci_cpu_state[index] = PSCI_CPU_ON;
+                dc_civac_range(&psci_cpu_state[index], 1);
+                sysop("dsb sy");
+                u64 start_base = cpu_start_base + cpu_info[index].die * PMGR_DIE_OFFSET;
+                write32(start_base + 0x4, cpu_start_bit(index, &cpu_info[index]));
+                write32(start_base + 0x8 + 4 * cpu_info[index].cluster, 1 << cpu_info[index].core);
+                sysop("dsb sy");
+                return PSCI_RET_SUCCESS;
+            }
+            /* An OFF core is parked in psci_park_c(), which takes the entry like the boot-time park loop. */
+            return smp_psci_dispatch(index, entry, context);
+    }
+}
+
+/*
+ * Leave Aura for a kernel entry point (secondary_entry, cpu_resume) as PSCI firmware would: MMU and
+ * caches off at EL2 (the caller runs under a 1:1 map, so the code under
+ * us stays reachable), HCR_EL2 back to its reset value (the kernel ran as a VHE host), then
+ * x0 = context, branch to the entry.
+ */
+
+asm(".text\n.globl psci_enter\npsci_enter:\n"
+    "mrs x2, sctlr_el2\n"
+    "bic x2, x2, #(1 << 0)\n"
+    "bic x2, x2, #(1 << 2)\n"
+    "bic x2, x2, #(1 << 12)\n"
+    "msr sctlr_el2, x2\n"
+    "isb\n"
+    "mov x2, #(1 << 31)\n"
+    "orr x2, x2, #(1 << 34)\n"
+    "msr hcr_el2, x2\n"
+    "isb\n"
+    "mov x3, x0\n"
+    "mov x0, x1\n"
+    "br x3\n");
+
+/*
+ * Set by the boot CPU's SYSTEM_SUSPEND with PSCI_S2R_CORESOFF: the parked cores leave the retention WFI for the
+ * global deep sleep, as macOS's secondaries do when CPU0 clears arm64_stall_sleep. Their ACC_OVRD deep sleep bit
+ * hangs any core of the cluster that later idles in a plain WFI (xnu cpu.c), so this happens only once every
+ * core is parked and the boot core is about to sleep the same way.
+ */
+static volatile u64 psci_s2r_go __attribute__((aligned(64)));
+/* image 60d: how often each released secondary went into cpu_sleep(true); one cache line each */
+static volatile u32 psci_s2r_loops[MAX_CPUS][16] __attribute__((aligned(64)));
+
+/*
+ * image 101 (psci_ctl[5] bit 6): hold all CPU_OFF secondaries awake in a WFE loop (WFI_MODE=0)
+ * from before CPUSTART+0 and the S2R commit until cpu0's edge (SEV), then only the last core of
+ * each cluster writes ACC_OVRD after its siblings reach WFI.
+ * psci_s2r_edge: 0 = inactive, 1 = wake into WFE hold, 2 = post-STOPREQ liveness ping, 3 = edge release.
+ * psci_s2r_edge_state[i]: [0] = awake in WFE, [1] = post-STOPREQ ping ack, [2] = released & entering WFI.
+ */
+static volatile u64 psci_s2r_edge __attribute__((aligned(64)));
+static volatile u32 psci_s2r_edge_state[MAX_CPUS][16] __attribute__((aligned(64)));
+static volatile u8 psci_s2r_cluster_last[MAX_CPUS] __attribute__((aligned(64)));
+static volatile u32 psci_s2r_expected_mask __attribute__((aligned(64)));
+
+volatile u32 *smp_psci_s2r_ptr(int i)
+{
+    return psci_s2r_loops[i];
+}
+
+u32 smp_psci_s2r_loops(int i)
+{
+    dc_ivac_range((void *)psci_s2r_loops[i], 64);
+    return psci_s2r_loops[i][0];
+}
+
+
+static u32 psci_s2r_offmask;
+
+u32 smp_psci_off_mask(void)
+{
+    return psci_s2r_offmask;
+}
+
+int smp_psci_cpu_valid(int i)
+{
+    return i >= 0 && i < MAX_CPUS && cpu_info[i].valid;
+}
+
+/* image 60f: [i][1] park entries since boot (not cleared), [i][2] WFI returns in the park loop since the S2R clear */
+u32 smp_psci_s2r_word(int i, int w)
+{
+    dc_ivac_range((void *)psci_s2r_loops[i], 64);
+    return psci_s2r_loops[i][w];
+}
+
+u64 smp_psci_ipi_mpidr(int i)
+{
+    dc_civac_range(&spin_table[i], sizeof(spin_table[i]));
+    return spin_table[i].mpidr;
+}
+
+/* image 60f: the release IPI again, built from the reset table's MPIDR (cluster bit 16) instead of the spin table's */
+void smp_psci_reipi(int i)
+{
+    dc_civac_range(&smp_reset_stacks[i], sizeof(smp_reset_stacks[i]));
+    u64 mpidr = smp_reset_stacks[i].mpidr;
+    if (cpu_features->fast_ipi)
+        msr(SYS_IMP_APL_IPI_RR_GLOBAL_EL1, (mpidr & 0xff) | ((mpidr & 0xff00) << 8));
+    else
+        smp_send_ipi(i);
+    sysop("isb");
+    sysop("sev");
+}
+
+int smp_psci_cpu_state(int i)
+{
+    dc_civac_range(&psci_cpu_state[i], 1);
+    return psci_cpu_state[i];
+}
+
+/*
+ * image 72 (PSCI_S2R_EDPRCR): the calling core's external debug block (J414s ADT cpuN coresight-reg: 0x210010000 +
+ * cluster * 0x1000000 + core * 0x100000), EDLAR unlocked and EDPRCR := 0 as xnu's ml_arm_sleep. Returns bit 31 set,
+ * EDPRCR before in bits 0-7, its read-back after in bits 8-15. Only a core's own block: it is powered while it runs.
+ */
+u32 smp_psci_ed_release(void)
+{
+    u64 mpidr = mrs(MPIDR_EL1);
+    u64 cl = (mpidr >> 8) & 0xff, co = mpidr & 0xff;
+
+    if (chip_id != T6020 || cl > 2 || co > 3)
+        return 0;
+    u64 ed = 0x210010000ULL + cl * 0x1000000ULL + co * 0x100000ULL;
+    write32(ed + 0xfb0, 0xc5acce55);
+    u32 pre = read32(ed + 0x310);
+    write32(ed + 0x310, 0);
+    sysop("dsb sy");
+    return BIT(31) | (pre & 0xff) | ((read32(ed + 0x310) & 0xff) << 8);
+}
+
+static volatile u64 psci_s2r_observer __attribute__((aligned(64)));
+
+void smp_psci_release_parked(bool stopreq, bool ed, int observe)
+{
+    psci_s2r_offmask = 0;
+    /* image 73: the observer is the highest CPU_OFF core (a P core of the second P complex on T6020) */
+    u64 obs = 0;
+    /* observe: 1 = the highest CPU_OFF core, 2 = the lowest one with index >= 4 (image 74) */
+    for (int k = 0; observe && k < MAX_CPUS; k++) {
+        int i = observe == 2 ? k : MAX_CPUS - 1 - k;
+        if (i == boot_cpu_idx || i < (observe == 2 ? 4 : 1) || !cpu_info[i].valid)
+            continue;
+        dc_civac_range(&psci_cpu_state[i], 1);
+        if (psci_cpu_state[i] == PSCI_CPU_OFF) {
+            obs = i;
+            break;
+        }
+    }
+    psci_s2r_observer = obs;
+    dc_civac_range((void *)&psci_s2r_observer, sizeof(psci_s2r_observer));
+    psci_s2r_go = (ed ? 3 : 1) | (obs ? 4 : 0);
+    dc_civac_range((void *)&psci_s2r_go, sizeof(psci_s2r_go));
+    sysop("dsb sy");
+    for (int i = 0; i < MAX_CPUS; i++) {
+        if (i == boot_cpu_idx || !cpu_info[i].valid)
+            continue;
+        dc_civac_range(&psci_cpu_state[i], 1);
+        if (psci_cpu_state[i] != PSCI_CPU_OFF)
+            continue;
+        psci_s2r_offmask |= BIT(i);
+        /* macOS's trace: CPUSTART + 0 written for each secondary (1-6, 8-10) before the cores sleep */
+        if (stopreq)
+            write32(cpu_start_base + cpu_info[i].die * PMGR_DIE_OFFSET + 0x0, cpu_start_bit(i, &cpu_info[i]));
+        smp_send_ipi(i);
+    }
+    sysop("sev");
+}
+
+/* image 91: macOS's step 6 (HV run 2026-11-12): each secondary's PMGR stop request (CPUSTART + 0, its own bit, one write per core)
+ * BEFORE the commit while the cores are still awake; used with PSCI_S2R_LATEREL, which releases them into deep sleep after it. */
+void smp_psci_stop_parked(void)
+{
+    for (int i = 0; i < MAX_CPUS; i++) {
+        if (i == boot_cpu_idx || !cpu_info[i].valid)
+            continue;
+        dc_civac_range(&psci_cpu_state[i], 1);
+        if (psci_cpu_state[i] != PSCI_CPU_OFF)
+            continue;
+        write32(cpu_start_base + cpu_info[i].die * PMGR_DIE_OFFSET + 0x0, cpu_start_bit(i, &cpu_info[i]));
+    }
+    sysop("dsb sy");
+}
+
+u32 smp_psci_hold_parked(void)
+{
+    u32 expected = 0;
+
+    for (int i = 0; i < MAX_CPUS; i++) {
+        psci_s2r_cluster_last[i] = 0;
+        for (int k = 0; k < 4; k++)
+            psci_s2r_edge_state[i][k] = 0;
+        dc_civac_range((void *)psci_s2r_edge_state[i], 64);
+        if (i == boot_cpu_idx || !cpu_info[i].valid)
+            continue;
+        dc_civac_range(&psci_cpu_state[i], 1);
+        if (psci_cpu_state[i] == PSCI_CPU_OFF)
+            expected |= BIT(i);
+    }
+    /* Boot core is last in its own cluster; highest valid CPU_OFF core is last in each other cluster */
+    psci_s2r_cluster_last[boot_cpu_idx] = 1;
+    u8 boot_cl = cpu_info[boot_cpu_idx].cluster;
+    for (int c = 0; c < 8; c++) {
+        if (c == boot_cl)
+            continue;
+        int last = -1;
+        for (int i = 0; i < MAX_CPUS; i++)
+            if ((expected & BIT(i)) && cpu_info[i].cluster == c)
+                last = i;
+        if (last >= 0)
+            psci_s2r_cluster_last[last] = 1;
+    }
+    dc_civac_range((void *)psci_s2r_cluster_last, sizeof(psci_s2r_cluster_last));
+    psci_s2r_expected_mask = expected;
+    psci_s2r_offmask = expected;
+    dc_civac_range((void *)&psci_s2r_expected_mask, 64);
+    psci_s2r_edge = 1;
+    dc_civac_range((void *)&psci_s2r_edge, 64);
+    sysop("dsb sy");
+
+    for (int i = 0; i < MAX_CPUS; i++)
+        if (expected & BIT(i))
+            smp_send_ipi(i);
+    sysop("sev");
+
+    u32 awake = 0;
+    for (int t = 0; t < 500; t++) {
+        awake = 0;
+        for (int i = 0; i < MAX_CPUS; i++) {
+            if (!(expected & BIT(i)))
+                continue;
+            dc_ivac_range((void *)psci_s2r_edge_state[i], 64);
+            if (psci_s2r_edge_state[i][0])
+                awake |= BIT(i);
+        }
+        if (awake == expected)
+            break;
+        udelay(100);
+    }
+    return awake;
+}
+
+u32 smp_psci_ping_held(void)
+{
+    u32 expected = psci_s2r_expected_mask;
+
+    psci_s2r_edge = 2;
+    dc_civac_range((void *)&psci_s2r_edge, 64);
+    sysop("dsb sy");
+    sysop("sev");
+
+    u32 alive = 0;
+    for (int t = 0; t < 200; t++) {
+        alive = 0;
+        for (int i = 0; i < MAX_CPUS; i++) {
+            if (!(expected & BIT(i)))
+                continue;
+            dc_ivac_range((void *)psci_s2r_edge_state[i], 64);
+            if (psci_s2r_edge_state[i][1])
+                alive |= BIT(i);
+        }
+        if (alive == expected)
+            break;
+        sysop("sev");
+        udelay(100);
+    }
+    return alive;
+}
+
+void smp_psci_edge_release_and_sleep(void)
+{
+    u32 expected = psci_s2r_expected_mask;
+
+    psci_s2r_edge = 3;
+    dc_civac_range((void *)&psci_s2r_edge, 64);
+    sysop("dsb sy");
+    sysop("sev");
+
+    u64 t0 = mrs(CNTPCT_EL0), lim = 20 * (mrs(CNTFRQ_EL0) / 1000);
+    while (mrs(CNTPCT_EL0) - t0 < lim) {
+        bool all = true;
+        for (int j = 0; j < MAX_CPUS; j++) {
+            if (!(expected & BIT(j)))
+                continue;
+            dc_ivac_range((void *)psci_s2r_edge_state[j], 64);
+            if (!psci_s2r_edge_state[j][2]) {
+                all = false;
+                break;
+            }
+        }
+        if (all)
+            break;
+        sysop("sev");
+    }
+    udelay(3000);
+    dcsw_op_all(DCSW_OP_DCCISW);
+    sysop("dsb sy");
+    cpu_sleep(true);
+}
+
+void smp_psci_s2r_clear(void)
+{
+    for (int i = 0; i < MAX_CPUS; i++) {
+        psci_s2r_loops[i][0] = 0;
+        psci_s2r_loops[i][2] = 0;
+        psci_s2r_loops[i][5] = 0;
+        psci_s2r_loops[i][6] = 0;
+        dc_civac_range((void *)psci_s2r_loops[i], 64);
+        psci_s2r_cluster_last[i] = 0;
+        for (int k = 0; k < 4; k++)
+            psci_s2r_edge_state[i][k] = 0;
+        dc_civac_range((void *)psci_s2r_edge_state[i], 64);
+    }
+    dc_civac_range((void *)psci_s2r_cluster_last, sizeof(psci_s2r_cluster_last));
+    psci_s2r_expected_mask = 0;
+    dc_civac_range((void *)&psci_s2r_expected_mask, 64);
+    psci_s2r_edge = 0;
+    dc_civac_range((void *)&psci_s2r_edge, 64);
+    psci_s2r_go = 0;
+    dc_civac_range((void *)&psci_s2r_go, sizeof(psci_s2r_go));
+}
+
+/* image 105: after a real RVBAR wake (SLP_S2R), secondary CPUs lost power; rewrite unlocked RVBAR and mark cold */
+void smp_psci_s2r_prep_secondaries(void)
+{
+    for (int i = 0; i < MAX_CPUS; i++) {
+        if (i == boot_cpu_idx || !cpu_info[i].valid)
+            continue;
+        dc_ivac_range(&psci_cpu_state[i], 1);
+        if (psci_cpu_state[i] != PSCI_CPU_OFF)
+            continue;
+        if (cpu_features->apple_sysregs_unlocked) {
+            u64 rvbar = read64(cpu_info[i].impl_reg);
+            if (!(rvbar & RVBAR_LOCK))
+                write64(cpu_info[i].impl_reg, (u64)_vectors_start);
+        }
+        spin_table[i].flag = 0;
+        spin_table[i].target = 0;
+        dc_civac_range(&spin_table[i], sizeof(spin_table[i]));
+        psci_cpu_cold[i] = 1;
+        dc_civac_range(&psci_cpu_cold[i], 1);
+    }
+    sysop("dsb sy");
+}
+
+/* The parked state of a CPU_OFF'd core: deep WFI on the Aura stack until it is handed an entry. */
+void psci_park_c(u64 index) __attribute__((noreturn, used));
+void psci_park_c(u64 index)
+{
+    struct spin_table *me = &spin_table[index];
+    u64 target;
+
+    psci_s2r_loops[index][1]++;
+    dc_civac_range((void *)psci_s2r_loops[index], 64);
+
+    /*
+     * Deep WFI with state retention, as the boot CPU's SYSTEM_SUSPEND wait (2026-11-04 images 41/42). This set
+     * DISABLE_WFI_RET before: a core powered down without retention is not woken back into this loop (images
+     * 32 to 36), and on 2026-10-25 one such core restarted through RVBAR into the kernel by itself.
+     */
+    extern void _deep_wfi_helper(void);
+    u64 cyc_ovrd = cpu_features->apple_sysregs_unlocked ? mrs(SYS_IMP_APL_CYC_OVRD) : 0;
+    if (cpu_features->apple_sysregs_unlocked) {
+        reg_mask(SYS_IMP_APL_CYC_OVRD, CYC_OVRD_WFI_MODE_MASK | CYC_OVRD_DISABLE_WFI_RET, CYC_OVRD_WFI_MODE(3));
+        sysop("isb");
+    }
+    while (1) {
+        /* Plain load: the mapping is inner-shareable write-back, the other CPU's civac-ed store is visible. */
+        if ((target = *(volatile u64 *)&me->target))
+            break;
+        if (*(volatile u64 *)&psci_s2r_edge >= 1) {
+            if (cpu_features->fast_ipi) {
+                msr(SYS_IMP_APL_IPI_SR_EL1, IPI_SR_PENDING);
+                sysop("isb");
+            }
+            asm volatile("msr daifset, #0xf\n isb" ::: "memory");
+            if (cpu_features->apple_sysregs_unlocked) {
+                reg_mask(SYS_IMP_APL_CYC_OVRD,
+                         CYC_OVRD_WFI_MODE_MASK | CYC_OVRD_DISABLE_WFI_RET |
+                         CYC_OVRD_FIQ_MODE_MASK | CYC_OVRD_IRQ_MODE_MASK,
+                         CYC_OVRD_FIQ_MODE(2) | CYC_OVRD_IRQ_MODE(2));
+                sysop("isb");
+            }
+            msr(CNTP_CTL_EL0, 0L);
+            msr(CNTV_CTL_EL0, 0L);
+            if (in_el2()) {
+                msr(CNTP_CTL_EL02, 0L);
+                msr(CNTV_CTL_EL02, 0L);
+            }
+            psci_s2r_edge_state[index][0] = 1;
+            dc_civac_range((void *)psci_s2r_edge_state[index], 64);
+            sysop("dsb sy");
+            sysop("sev");
+            while (*(volatile u64 *)&psci_s2r_edge < 2) {
+                sysop("wfe");
+                sysop("dsb sy");
+            }
+            psci_s2r_edge_state[index][1] = 1;
+            dc_civac_range((void *)psci_s2r_edge_state[index], 64);
+            sysop("dsb sy");
+            sysop("sev");
+            while (*(volatile u64 *)&psci_s2r_edge < 3) {
+                sysop("wfe");
+                sysop("dsb sy");
+            }
+            dc_ivac_range((void *)psci_s2r_cluster_last, sizeof(psci_s2r_cluster_last));
+            dc_ivac_range((void *)&psci_s2r_expected_mask, 64);
+            if (!psci_s2r_cluster_last[index]) {
+                psci_s2r_edge_state[index][2] = 1;
+                dc_civac_range((void *)psci_s2r_edge_state[index], 64);
+                sysop("dsb sy");
+                sysop("sev");
+                dcsw_op_level1(DCSW_OP_DCCISW);
+                sysop("dsb sy");
+                cpu_sleep_no_acc();
+            } else {
+                u8 my_cl = cpu_info[index].cluster;
+                u32 exp = psci_s2r_expected_mask;
+                u64 t0 = mrs(CNTPCT_EL0), lim = 10 * (mrs(CNTFRQ_EL0) / 1000);
+                while (mrs(CNTPCT_EL0) - t0 < lim) {
+                    bool all = true;
+                    for (int j = 0; j < MAX_CPUS; j++) {
+                        if (j == (int)index || j == boot_cpu_idx || !cpu_info[j].valid ||
+                            cpu_info[j].cluster != my_cl || !(exp & BIT(j)))
+                            continue;
+                        dc_ivac_range((void *)psci_s2r_edge_state[j], 64);
+                        if (!psci_s2r_edge_state[j][2]) {
+                            all = false;
+                            break;
+                        }
+                    }
+                    if (all)
+                        break;
+                }
+                udelay(3000);
+                psci_s2r_edge_state[index][2] = 1;
+                dc_civac_range((void *)psci_s2r_edge_state[index], 64);
+                sysop("dsb sy");
+                sysop("sev");
+                dcsw_op_all(DCSW_OP_DCCISW);
+                sysop("dsb sy");
+                cpu_sleep(true);
+            }
+        }
+        if (*(volatile u64 *)&psci_s2r_go) {
+            /*
+             * image 60d: the release IPI stays pending in IPI_SR (nothing here acked it, unlike the boot-time
+             * secondary loop), and a pending fast IPI ends each WFI at once, so the core spun instead of powering
+             * down (run R11: PCPM0 still on 2 ms after the release)
+             */
+            if (cpu_features->fast_ipi) {
+                msr(SYS_IMP_APL_IPI_SR_EL1, IPI_SR_PENDING);
+                sysop("isb");
+            }
+            if ((*(volatile u64 *)&psci_s2r_go & 4) && *(volatile u64 *)&psci_s2r_observer == index) {
+                extern void psci_s2r_observe(void);
+                psci_s2r_observe(); /* image 73 */
+            }
+            psci_s2r_loops[index][0]++;
+            if (*(volatile u64 *)&psci_s2r_go & 2)
+                psci_s2r_loops[index][4] = smp_psci_ed_release(); /* image 72 */
+            dc_civac_range((void *)psci_s2r_loops[index], 64);
+            dcsw_op_all(DCSW_OP_DCCISW);
+            sysop("dsb sy");
+            cpu_sleep_counted(true, psci_s2r_loops[index]); /* image 75 */
+        }
+        _deep_wfi_helper();
+        psci_s2r_loops[index][2]++;
+        dc_civac_range((void *)psci_s2r_loops[index], 64);
+    }
+    /* the kernel must not inherit WFI_MODE 3: give the core back the CYC_OVRD it had when it called CPU_OFF */
+    if (cpu_features->apple_sysregs_unlocked) {
+        msr(SYS_IMP_APL_CYC_OVRD, cyc_ovrd);
+        sysop("isb");
+    }
+    sysop("dmb sy");
+    me->flag++;
+    sysop("dmb sy");
+    psci_enter(target, me->args[0]);
+}
+
+int smp_psci_cpu_off(void)
+{
+    int index = smp_psci_index(mrs(MPIDR_EL1));
+
+    if (index < 0 || index == boot_cpu_idx)
+        return PSCI_RET_DENIED;
+
+    /*
+     * Not the PMGR stop request: a core stopped that way did not come back from any start
+     * strobe, IPI or timer (images 5 to 10, 2026-10-25), and a deep-WFI core resumes after the
+     * WFI instead of restarting at RVBAR. So the core parks in Aura: clean its L1, move to its
+     * Aura stack, and wait in psci_park_c() for the next CPU_ON.
+     */
+    /* The entry this core was started with is still in the table (the kernel never returns). */
+    spin_table[index].target = 0;
+    dc_civac_range(&spin_table[index], sizeof(struct spin_table));
+    psci_cpu_state[index] = PSCI_CPU_OFF;
+    dc_civac_range(&psci_cpu_state[index], 1);
+    dcsw_op_level1(DCSW_OP_DCCISW);
+    sysop("dsb sy");
+    u64 sp = (u64)secondary_stacks[index] + SECONDARY_STACK_SIZE;
+    asm volatile("mov sp, %0\n mov x0, %1\n b psci_park_c" ::"r"(sp), "r"((u64)index) : "x0");
+    __builtin_unreachable();
+}
+
+/*
+ * The MMIO the PSCI handler touches, as page-aligned <base, size> pairs, for the
+ * EFI runtime memory map: the PMGR CPU start/stop block of each die and, without
+ * fast IPIs, the AIC. Returns the number of pairs written.
+ */
+static void smp_psci_add_range(u64 *ranges, int max, int *n, u64 base, u64 size)
+{
+    u64 start = ALIGN_DOWN(base, SZ_16K);
+    u64 end = ALIGN_UP(base + size, SZ_16K);
+
+    for (int i = 0; i < *n; i++)
+        if (ranges[2 * i] == start && ranges[2 * i + 1] == end - start)
+            return;
+    if (*n < max) {
+        ranges[2 * *n] = start;
+        ranges[2 * *n + 1] = end - start;
+        (*n)++;
+    }
+}
+
+int smp_psci_mmio_ranges(u64 *ranges, int max)
+{
+    int n = 0;
+
+    for (int i = 0; i < MAX_CPUS; i++) {
+        if (!cpu_info[i].valid)
+            continue;
+        smp_psci_add_range(ranges, max, &n, cpu_start_base + cpu_info[i].die * PMGR_DIE_OFFSET,
+                           0x100);
+    }
+    u64 wdt = wdt_psci_base();
+    if (wdt)
+        smp_psci_add_range(ranges, max, &n, wdt, 0x30); /* image 58: WD2 (+0x20..0x2c) too */
+    /* MPMGR_AON's S2R timer (PSCI_S2R_TIMER, psci.c) */
+    if (chip_id == T6020)
+        smp_psci_add_range(ranges, max, &n, 0x29e5c0000, 0x14000); /* image 84: the whole MPMGR_AON block */
+        smp_psci_add_range(ranges, max, &n, 0x347400000, 0x10000); /* image 92: ANS, SIO, GFX and PMP coprocessor wrappers (CPU_CONTROL +0x44, mailbox +0x8114) */
+        smp_psci_add_range(ranges, max, &n, 0x39bc00000, 0x10000);
+        smp_psci_add_range(ranges, max, &n, 0x406400000, 0x10000);
+        smp_psci_add_range(ranges, max, &n, 0x28ec00000, 0x10000);
+        smp_psci_add_range(ranges, max, &n, 0x404ea8000, 0x100);   /* image 90: the AP wake-source mask (+0x0c) and status (+0x30) words */
+    /* image 53's quiesceHW steps (psci.c): MINI 0x4d010, ps_afr, ps_sio(_cpu), ClkGen-SOC, PLL-off */
+    if (chip_id == T6020) {
+        smp_psci_add_range(ranges, max, &n, 0x29e2cd010, 4);
+        smp_psci_add_range(ranges, max, &n, 0x29e2c83a0, 0xe0); /* image 83: the state counters */
+        smp_psci_add_range(ranges, max, &n, 0x404e80100, 4);
+        smp_psci_add_range(ranges, max, &n, 0x2902801c0, 0x24);
+        smp_psci_add_range(ranges, max, &n, 0x28e038158, 0x18);
+        smp_psci_add_range(ranges, max, &n, 0x28e224000, 4);
+        smp_psci_add_range(ranges, max, &n, 0x28e088000, 0x1c); /* image 54: the soc-cluster words */
+        /* image 61: each CPU cluster's CLUSTER_PSTATE (PSCI_S2R_DVFS) */
+        smp_psci_add_range(ranges, max, &n, 0x210e20020, 8);
+        smp_psci_add_range(ranges, max, &n, 0x211e20020, 8);
+        smp_psci_add_range(ranges, max, &n, 0x212e20020, 8);
+        /* image 62: the fabric PS words (PSCI_S2R_FABRIC) */
+        smp_psci_add_range(ranges, max, &n, 0x28e080210, 4);
+        smp_psci_add_range(ranges, max, &n, 0x290280178, 4);
+        smp_psci_add_range(ranges, max, &n, 0x290280418, 4);
+        /*
+         * image 58: image 56's held domains on the two pages that were never mapped (dispext0/1 at 0x28e080248..2d8,
+         * atc0/1/2_usb at 0x29e2800c8..d8; disp0 shares ps_sio's page), so runs Y1, Y1T, Y2T faulted there
+         */
+        smp_psci_add_range(ranges, max, &n, 0x28e080248, 0x94);
+        smp_psci_add_range(ranges, max, &n, 0x29e2800c8, 0x14);
+        /* image 58: each AMCC plane's error enable/status words (plane + 0x21000..0x2100f) */
+        u64 mcc[8], stride;
+        int planes, nm = mcc_plane_bases(mcc, 8, &stride, &planes);
+        for (int i = 0; i < nm; i++)
+            for (int p = 0; p < planes; p++)
+                smp_psci_add_range(ranges, max, &n, mcc[i] + p * stride + 0x21000, 0x10);
+    }
+    /* image 97: the memory-controller pages macOS writes during its sleep entry (psci_replay_mem) */
+    if (chip_id == T6020) {
