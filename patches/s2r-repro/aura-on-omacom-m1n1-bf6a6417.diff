--- /dev/null
+++ b/src/zz_local_popcount.c
@@ -0,0 +1,11 @@
+/* local build aid only, not committed: the host's clang has no compiler-rt for __builtin_popcountll */
+int __popcountdi2(long long a)
+{
+    unsigned long long x = a;
+    int n = 0;
+    while (x) {
+        x &= x - 1;
+        n++;
+    }
+    return n;
+}
