diff --git a/src/wdt.c b/src/wdt.c
index a509a577..12d79499 100644
--- a/src/wdt.c
+++ b/src/wdt.c
@@ -27,6 +27,17 @@ void wdt_disable(void)
     }
 
     printf("Primary WDT register @ 0x%lx\n", wdt_base);
+    if (read32(wdt_base + WDT_CTL) & 4) {
+        /*
+         * Armed by the one-shot loader that chainloaded this test image (Aurora-DeepIdle GH-5): leave it
+         * running, with a fresh 120 s, so a hang here, in U-Boot or in the boot loader ends in a reset.
+         * The kernel's watchdog driver takes a running watchdog over.
+         */
+        write32(wdt_base + WDT_COUNT, 0);
+        write32(wdt_base + WDT_ALARM, 120 * 24000000u);
+        printf("Primary WDT was armed: kept, 120 s\n");
+        return;
+    }
     write32(wdt_base + WDT_CTL, 0);
     printf("Primary WDT disabled\n");
 
@@ -82,3 +93,43 @@ int wdt_arm_seconds(unsigned seconds)
     wdt_base = primary;
     return 0;
 }
+
+/*
+ * Safety net for firmware calls that may never return (PSCI SYSTEM_SUSPEND experiments): the reset watchdog
+ * (WD1, as in wdt_reboot) armed for a number of seconds, and disarmed again on the way back. The base is looked
+ * up once at init so the handler need not touch the ADT later.
+ */
+static u64 wdt_psci;
+
+u64 wdt_psci_base(void)
+{
+    int path[8];
+    u64 base, size;
+
+    if (wdt_psci)
+        return wdt_psci;
+    int node = adt_path_offset_trace(adt, "/arm-io/wdt", path);
+    if (node < 0 || adt_get_reg(adt, path, "reg", 0, &base, &size) || (base & 3) || size < 0x20)
+        return 0;
+    wdt_psci = base;
+    return base;
+}
+
+void wdt_psci_arm(unsigned seconds)
+{
+    if (!wdt_psci)
+        return;
+    write32(wdt_psci + WDT_CTL, 0);
+    write32(wdt_psci + WDT_COUNT, 0);
+    write32(wdt_psci + WDT_ALARM, seconds * 24000000u);
+    write32(wdt_psci + WDT_CTL, 4);
+    sysop("dsb sy");
+}
+
+void wdt_psci_disarm(void)
+{
+    if (!wdt_psci)
+        return;
+    write32(wdt_psci + WDT_CTL, 0);
+    sysop("dsb sy");
+}
