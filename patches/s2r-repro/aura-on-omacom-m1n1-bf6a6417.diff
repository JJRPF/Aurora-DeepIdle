+    /* image 60b: the PMU's SPMI controller for PSCI_S2R_CRUMB (image 60 faulted on its first read: run R10) */
+    if (psci_crumb_base())
+        smp_psci_add_range(ranges, max, &n, psci_crumb_base(), 0x10);
+    /* image 120: the AP GPIO block, snapshotted at SYSTEM_SUSPEND */
+    if (chip_id == T6020)
+        smp_psci_add_range(ranges, max, &n, 0x39b028000ULL, 0x4000);
+    /* image 119: internal PCIe ports 0/1 (Wi-Fi, SD): Linux's per-port MSI/RID2SID setup is saved at SYSTEM_SUSPEND */
+    if (chip_id == T6020) {
+        smp_psci_add_range(ranges, max, &n, 0x594008000ULL, 0x4000);
+        smp_psci_add_range(ranges, max, &n, 0x595008000ULL, 0x4000);
