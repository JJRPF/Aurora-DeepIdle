+            const u8 *v = prop->value;
+            for (u32 off = 0; off + 24 <= prop->size && n < 64; off += 24) {
+                u32 o = *(const u32 *)(v + off), sz = *(const u32 *)(v + off + 4);
+                u64 m = *(const u64 *)(v + off + 8), val = *(const u64 *)(v + off + 16);
+                for (u32 w = 0; w < (sz == 8 ? 2u : 1u) && n < 64; w++) {
+                    u64 a = base + o + 4 * w;
+                    if (sz != 4 && sz != 8)
