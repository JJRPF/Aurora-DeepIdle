--- /dev/null
+++ b/src/psci.h
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: MIT */
+
+#ifndef PSCI_H
+#define PSCI_H
+
+#include "types.h"
+
+/*
+ * PSCI through the PSCI-via-EFI conduit (Sven Peter's RFC, July 2026): there is
+ * no EL3 on Apple silicon and the kernel shares EL2 with us, so the kernel calls
+ * psci_efi_handler() directly, as a plain function under its EFI runtime mapping,
+ * found through the LINUX_EFI_ARM_PSCI_HANDLER_TABLE configuration table.
+ *
+ * The handler runs in the kernel's context: its stack, its page tables (the EFI
+ * runtime map, which must be 1:1: the arm64 stub's default with 48-bit VAs),
+ * interrupts masked. So it must not use FP/SIMD (we build with
+ * -mgeneral-regs-only), must not printf (the UART is not mapped there) and may
+ * touch only our image and the MMIO ranges exported with the table.
+ */
+
+#define PSCI_VERSION_1_0 0x00010000
+
+/* Function numbers are the low byte of a function ID, the same for SMC32/SMC64. */
+#define PSCI_MAX_FN  0x20
+#define PSCI_FN(fid) ((fid) & 0xff)
+
+enum psci_fn_id {
+    PSCI_0_2_FN_PSCI_VERSION = 0x84000000,
+    PSCI_0_2_FN64_CPU_SUSPEND = 0xc4000001,
+    PSCI_0_2_FN_CPU_OFF = 0x84000002,
+    PSCI_0_2_FN64_CPU_ON = 0xc4000003,
+    PSCI_0_2_FN64_AFFINITY_INFO = 0xc4000004,
+    PSCI_0_2_FN_SYSTEM_RESET = 0x84000009,
+    PSCI_1_0_FN_PSCI_FEATURES = 0x8400000a,
+    PSCI_1_0_FN64_SYSTEM_SUSPEND = 0xc400000e,
+};
+
+enum psci_ret {
+    PSCI_RET_SUCCESS = 0,
+    PSCI_RET_NOT_SUPPORTED = -1,
+    PSCI_RET_INVALID_PARAMS = -2,
+    PSCI_RET_DENIED = -3,
+    PSCI_RET_ALREADY_ON = -4,
+    PSCI_RET_ON_PENDING = -5,
+    PSCI_RET_INTERNAL_FAILURE = -6,
+    PSCI_RET_NOT_PRESENT = -7,
+    PSCI_RET_DISABLED = -8,
+    PSCI_RET_INVALID_ADDRESS = -9,
+};
+
+enum psci_affinity_info {
+    PSCI_AFFINITY_INFO_ON = 0,
+    PSCI_AFFINITY_INFO_OFF = 1,
+    PSCI_AFFINITY_INFO_ON_PENDING = 2,
+};
+
+/* Must match the kernel's struct efi_psci_table (arch/arm64/include/asm/efi.h). */
+struct psci_efi_table {
+    u32 version;
+    u32 num_features;
+    unsigned long (*handler)(unsigned long fid, unsigned long arg0, unsigned long arg1,
+                             unsigned long arg2);
+    s32 features[PSCI_MAX_FN];
+};
+
+extern const struct psci_efi_table psci_efi_table;
+
+#define PSCI_S2R_TIMER    BIT(0)
+#define PSCI_S2R_CORESOFF BIT(1)
+#define PSCI_S2R_DOMAINS  BIT(2)
+#define PSCI_S2R_CLOCKS   BIT(3)
+#define PSCI_S2R_CLUSTERS BIT(4)
+/* image 55: each secondary's PMGR stop request (CPUSTART + 0, as smp_stop_cpu() and macOS) before it sleeps */
+#define PSCI_S2R_STOPREQ  BIT(5)
+#define PSCI_S2R_HELD     BIT(6) /* image 56: the PMGR domains Linux keeps on at sleep, off before quiesceHW */
+/* image 58: leads from DJ's T8140 and Naeem Malik's t8103 S2R under a hypervisor (psci.c) */
+#define PSCI_S2R_REC      BIT(8)  /* record the AON watchdogs, the timer word and the AMCC errors in psci_dbg2 */
+#define PSCI_S2R_AMCC     BIT(9)  /* clear the AMCC DSID_AGE_OUT and UNEXP_RT_HIT_DIR error enables before the timer */
+#define PSCI_S2R_STOPWD2  BIT(10) /* stop WD2 100 ms after the timer: is the reset 60 s after it WD2? */
+#define PSCI_S2R_AICMASK  BIT(11) /* mask every AIC line after the timer (only with PSCI_S2R_CORESOFF) */
+/* image 59 */
+#define PSCI_S2R_WD1OFF   BIT(12) /* WD1 (Aura's suspend dog) disarmed just before the timer, as macOS has every AON dog off */
+#define PSCI_S2R_RESUMENOW BIT(13) /* resume the kernel right after the timer (no wait, no cores off): Linux logs the dogs */
+u64 psci_crumb_base(void);
+#define PSCI_S2R_CRUMB    BIT(14) /* image 60: stage codes in the PMU's legacy scratch key 4 (0x6004), which survives a SoC reset */
+/* image 60g: Naeem's M1 order: AIC mask, secondaries released and snapshot before the commit; the commit written three
+ * times (macOS); after it no MMIO or SPMI access at all, only the boot core's flush and deep WFI (needs TIMER and CORESOFF) */
+#define PSCI_S2R_QUIET    BIT(15)
+/* image 60h: AppleT6020PMGR::quiesceHW's enableCluster(c, false, c > 3) starts at logical cluster 1, which is EACC (the ADT
+ * soc-clusters entry's byte 3 is the logical number: EACC 1, PACC0 2, PACC1 3, ANE0 6, DISPLAY 8, AVEMSR 9; byte 0 is the
+ * word's index). Image 54 read byte 0 and left EACC, the boot cluster, out. With this bit EACC's target goes to 0 too, with
+ * no poll (as macOS: c = 1 is not waited on), after the other clusters; the M1 entry also writes both CPU complexes to 0 */
+#define PSCI_S2R_EACC     BIT(16)
+/* image 61: macOS's cluster DVFS teardown (maralcbr's T6000 sleep trace, GH-8 issue #9: CLUSTER_PSTATE = 0x40000500101, i.e.
+ * M1_APSC_DIS): before the timer, set M2_APSC_DIS (bit 23) in each CPU cluster's CLUSTER_PSTATE (base + 0x20020) and wait
+ * for APSC_BUSY (bit 7) to clear. The J414s ADT has cpu-apsc = 1 (Aura enables APSC at boot) and no ppt/llc/amx-thrtl or
+ * fixed-freq-pll-relock, so the trace's other cluster writes (bit 63 clear) are already the boot state */
+#define PSCI_S2R_DVFS     BIT(17)
+/* image 62: macOS's fabric auto-PM floor (maralcbr's 15.6.1 hv dump, lab_ps_off: AFNC1_LW2, AFNC2_LW1, APCIE_GP_SYS =
+ * 0x1000030f at sleep entry). J414s leaves them at 0x1f0000ff: AUTO_ENABLE with PS_AUTO f, so the PMGR never gates them
+ * (Linux's pmgr-pwrstate never writes PS_AUTO). After the domains step, write macOS's 0x1000030f (AUTO_ENABLE, PS_AUTO 0,
+ * target f): the PMGR may gate each lane while it is idle and wakes it on access. Restored on any resume */
+#define PSCI_S2R_FABRIC   BIT(18)
+/* image 63: the USB-C complexes macOS has off at sleep entry and the DT keeps always-on: atcN_pcie, atcN_common */
+#define PSCI_S2R_ATC      BIT(19)
+/* image 64: the PCIe chain macOS has off or gated at sleep entry: apcie_gp_sys (always-on in the DT), then its
+ * parents apcie_gpshr_sys and apcie_gp (aurora-silicon t6040_sleep_lower_apcie_gp). Commit runs only: nothing
+ * retrains the links, so Wi-Fi and Bluetooth are gone after a resume that follows this step */
+#define PSCI_S2R_PCIE     BIT(20)
+/* image 64: the AON-side words macOS has at target 0 at sleep entry and the DT keeps always-on: atc1..3_usb_aon, msg
+ * (data/psmap.txt). Commit runs only */
+#define PSCI_S2R_AON      BIT(21)
+/* image 65: the PMP's own power words, which macOS has off at sleep entry (PMP 0x0f0f0300, PMS_SRAM 0x0f000300,
+ * data/psmap.txt); Linux only sends the PMP its RTKit sleep. Commit runs only: nothing boots the PMP again */
+#define PSCI_S2R_PMP      BIT(22)
+/* image 66: NOTIFY_ENABLE (+0x40) := 0x2000001 on both PMU SPMI controllers (nub-spmi0, nub-spmi1) right before the
+ * timer, after the last crumb, as aurora-silicon's T6040 entry (t6040-sleep.c, "HW") and macOS's per-SoC SPMI config
+ * value on T6020 (15.7.1 AppleSPMI). J414s has 0 there while Linux runs. Commit runs only: Linux's SPMI driver does
+ * not expect it */
+#define PSCI_S2R_SPMINOTIFY BIT(23)
+/* image 67: the SEP's last two host steps of macOS's sleep entry, after Linux's SLEEP message: the mailbox's
+ * OUTBOX_CTRL enable off, then ps_sep := 0x1000030f. First step of the quiesce (image 68; crumb 0x6011
+ * bits 2-4, with bit 22). Commit runs only: nothing enables the outbox again */
+#define PSCI_S2R_SEP      BIT(24)
+#define PSCI_S2R_DVFSLATE BIT(25) /* image 70: cluster APSC off after the secondaries have slept (run R20b) */
+/* image 72: xnu's ml_arm_sleep on every core right before its deep WFI (15.7.1 kernel, both the secondary and the
+ * boot path): unlock the core's external debug block (EDLAR, +0xfb0 := 0xc5acce55) and write EDPRCR (+0x310) := 0,
+ * "tell debugger to not prevent power gating". With CORENPDRQ set a core only emulates its power-down. Crumb 0x601f:
+ * bit 7 ran, bits 0-2 the boot core's EDPRCR before (bits 0, 1, 3), bit 3 its read-back not 0, bits 4-6 the same
+ * three bits ORed over the secondaries */
+#define PSCI_S2R_EDPRCR   BIT(26)
+/*
+ * image 73 (run R23): one P core (the highest CPU_OFF one) does not sleep with the others. It waits for the boot core's
+ * commit, then samples the boot (E) complex's power word for 3 s and reads the boot core's EDPRSR, and leaves the
+ * result in the PMU scratch (0x6004 a1/a2/a3, 0x6008-0x600b, copies in 0x6012/0x6013/0x601f). Then it sleeps too.
+ */
+#define PSCI_S2R_OBSERVE  BIT(27)
+/* image 74: the observer is the lowest CPU_OFF P core (index >= 4, the first P complex) instead of the highest */
+#define PSCI_S2R_OBSERVE_P0 BIT(28)
+/* image 77, the control for the wake probe: everything as a commit run, but the three S2R timer writes are skipped */
+#define PSCI_S2R_NOCOMMIT BIT(29)
+/*
+ * image 89 (Naeem Malik's global-sleep order, from XNU's arm64_stall_sleep and his macOS traces on t8103): the parked
+ * secondaries stay in their retention WFI until AFTER the commit; only then are they released, and every core (the boot
+ * core right after) arms its deep sleep together. Quiet path only; without it the secondaries sleep deep before the commit.
+ */
+#define PSCI_S2R_LATEREL BIT(30)
+/* image 91: the S2R timer written twice, as macOS does on T6020 (HV run 2026-11-12: two writes of 1 by CPU 0, none other in MPMGR_AON) */
+#define PSCI_S2R_TWOWR BIT(31)
+void smp_psci_stop_parked(void);
+void psci_s2r_observe(void);
+void psci_ctl_init(void);
+
+bool psci_suspend_resuming(void);
+bool psci_runtime_quiet(void);
+void psci_suspend_rvbar(void) __attribute__((noreturn));
+
+unsigned long psci_efi_handler(unsigned long fid, unsigned long arg0, unsigned long arg1,
+                               unsigned long arg2);
+
+#endif
