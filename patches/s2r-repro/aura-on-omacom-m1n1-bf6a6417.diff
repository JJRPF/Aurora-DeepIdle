+ * *tunables* property of the ADT ans node, for the record.
+ */
+static int dt_set_ans_tunables(void)
+{
+    static const struct {
+        const char *name;
+        int reg;
+    } known[] = {
+        {"afc-aiu-ans-dual-tunables", 4},
+        {"storage-lane-common-tunables", 5},
+    };
+    int path[8];
+    int anode = adt_path_offset_trace(adt, "/arm-io/ans", path);
+    int node = fdt_path_offset(dt, "/chosen");
+    u32 out[4 * 64];
+    int n = 0;
+    char names[256];
+    int nl = 0;
+
+    if (anode < 0 || node < 0)
+        return 0;
+    ADT_FOREACH_PROPERTY(adt, anode, prop)
+    {
+        if (!strstr(prop->name, "tunable"))
+            continue;
+        int len = strlen(prop->name);
+        if (nl + len + 1 < (int)sizeof(names)) {
+            memcpy(names + nl, prop->name, len + 1);
+            nl += len + 1;
+        }
+        for (size_t k = 0; k < ARRAY_SIZE(known); k++) {
+            u64 base;
+            if (strcmp(prop->name, known[k].name) ||
