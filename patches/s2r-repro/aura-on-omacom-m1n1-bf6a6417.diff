+                    out[4 * n] = cpu_to_fdt32(a >> 32);
+                    out[4 * n + 1] = cpu_to_fdt32((u32)a);
+                    out[4 * n + 2] = cpu_to_fdt32((u32)(m >> (32 * w)));
+                    out[4 * n + 3] = cpu_to_fdt32((u32)(val >> (32 * w)));
+                    n++;
+                }
+            }
+        }
+    }
+    if (nl)
+        fdt_setprop(dt, node, "aurora,ans-tunable-props", names, nl);
+    if (n)
+        fdt_setprop(dt, node, "aurora,ans-tunables", out, n * 16);
+    printf("FDT: %d ANS tunable writes published\n", n);
+    return 0;
+}
