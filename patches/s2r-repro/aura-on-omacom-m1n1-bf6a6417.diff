+/* image 105: save domains lowered by psci_force_ps_lower() so psci_quiesce_undo() restores them parents-first */
+static volatile struct {
+    u32 n;
+    u32 pad;
+    struct {
+        u64 addr;
+        u32 val;
+        u32 pad;
+    } ent[128];
+} qs_lower_save __attribute__((aligned(64)));
