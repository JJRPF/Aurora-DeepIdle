index 000000000000..78644081e636
--- /dev/null
+++ w/tools/aurora-sep/tests/test_t6020_cpu_em.py
@@ -0,0 +1,75 @@
+"""t6020-cpu-em.py and the T602x CPU energy model (opp-microwatt) it derives."""
+
+from pathlib import Path
+import importlib.util
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("cpu_em", ROOT / "t6020-cpu-em.py")
+cpu_em = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(cpu_em)
+
+# capacity-dmips-mhz of the two core types in t602x-common.dtsi.
+CAPACITY = {"blizzard_opp": 756, "avalanche_opp": 1024}
+
+
+@unittest.skipUnless(cpu_em.T8112.exists(), "needs a kernel tree (AURORA_TREE)")
+class T6020CpuEmTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.t8112 = cpu_em.T8112.read_text()
+        cls.t602x = cpu_em.T602X.read_text()
+        cls.derived = cpu_em.derive(cls.t8112)
+
+    def test_the_tree_carries_the_derived_values(self):
+        self.assertEqual(cpu_em.apply(self.t602x, self.derived), self.t602x)
+
+    def test_every_cpu_opp_has_a_power_that_rises_with_frequency(self):
+        for label, volts in (("blizzard_opp", cpu_em.T6020_E), ("avalanche_opp", cpu_em.T6020_P)):
+            with self.subTest(label=label):
+                table = cpu_em.opp_table(self.t602x, label)
+                self.assertEqual([mhz for mhz, _ in table], [mhz for mhz, _ in volts])
+                powers = [uw for _, uw in table]
+                self.assertNotIn(None, powers)
+                self.assertEqual(powers, sorted(set(powers)))
+
+    def test_no_opp_is_inefficient(self):
+        # An inefficient OPP is skipped by cpufreq: the model must not change
+        # which frequencies schedutil can pick.
+        # cpu_capacity reads 561 for the E cores and 1024 for the P cores on a J414s.
+        for label, capacity in (("blizzard_opp", 561), ("avalanche_opp", 1024)):
+            with self.subTest(label=label):
+                table = cpu_em.opp_table(self.t602x, label)
+                self.assertEqual(cpu_em.inefficient(table, capacity), [])
+        self.assertEqual(cpu_em.inefficient([(100, 10000), (200, 15000), (300, 40000)]), [100])
+        # Equal cost per cycle at two OPPs: the slower one is inefficient.
+        self.assertEqual(cpu_em.inefficient([(512, 1000), (1024, 2000)]), [512])
+
+    def test_the_fit_follows_the_t8112_measurements(self):
+        for label, (coef, rms, _) in self.derived.items():
+            with self.subTest(label=label):
+                self.assertLess(rms, 0.07)
+                self.assertGreater(coef[0], 0)
+
+    def test_e_cores_are_cheaper_per_unit_of_capacity_at_the_bottom(self):
+        cost = {}
+        for label, scale in CAPACITY.items():
+            table = cpu_em.opp_table(self.t602x, label)
+            mhz, uw = table[0]
+            cost[label] = uw / (scale * mhz)
+        self.assertLess(cost["blizzard_opp"] * 2, cost["avalanche_opp"])
+
+    def test_points_use_the_next_t6020_voltage_and_stay_in_range(self):
+        volts = [(700, 600), (900, 650), (1000, 700)]
+        measured = [(600, 1), (700, 2), (800, 3), (1000, 4), (1100, 5)]
+        self.assertEqual(cpu_em.points(measured, volts), [(700, 600, 2), (800, 650, 3), (1000, 700, 4)])
+
+    def test_apply_refuses_a_table_that_does_not_match(self):
+        broken = self.t602x.replace("<912000000>", "<600000000>", 1)
+        with self.assertRaisesRegex(ValueError, "blizzard_opp"):
+            cpu_em.apply(broken, self.derived)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git c/tools/aurora-sep/tests/test_t6020_nodcpext.py w/tools/aurora-sep/tests/test_t6020_nodcpext.py
new file mode 100644
index 000000000000..7711d98016d5
--- /dev/null
+++ w/tools/aurora-sep/tests/test_t6020_nodcpext.py
@@ -0,0 +1,151 @@
+"""J414s (MacBook Pro 14" M2 Pro) test tree without the external DCPs (t6020-j414s-nodcpext.dts).
+
+Set DTC to this kernel's built scripts/dtc/dtc for Apple floating-point cells.
+"""
+
+from pathlib import Path
+import importlib.util
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+
+HERE = Path(__file__).resolve().parent
+SPEC = importlib.util.spec_from_file_location("pmp_test", HERE / "test_t6020_pmp.py")
+pmp_test = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(pmp_test)
+
+DTS, DTC = pmp_test.DTS, pmp_test.DTC
+parse, phandles = pmp_test.parse, pmp_test.phandles
+
+# The external DCPs and everything only they use.
+DISABLED = (
+    "/soc/dcp@289c00000",      # dcpext0
+    "/soc/iommu@28930c000",    # dcpext0_dart
+    "/soc/mbox@289c08000",     # dcpext0_mbox
+    "/soc/iommu@289304000",    # dispext0_dart
+    "/soc/dcp@315c00000",      # dcpext1
+    "/soc/iommu@31530c000",    # dcpext1_dart
+    "/soc/mbox@315c08000",     # dcpext1_mbox
+    "/soc/iommu@315304000",    # dispext1_dart
+)
+# The Type-C routes inside them: the USB-C controllers' mode-switch providers.
+ROUTES = tuple(f"{dcp}/typec-routes/route@{n}" for dcp in DISABLED[0::4] for n in range(3))
+DISPLAY = "/soc/display-subsystem"
+
+
+def merged(board):
+    """The board's tree after dtc merges its overrides, references kept as &label."""
+    dump = subprocess.run([DTC, "-q", "-I", "dts", "-O", "dts"], input=pmp_test.preprocess(board),
+                          check=True, capture_output=True, text=True)
+    return parse(dump.stdout)
+DISP0_DART = "/soc/iommu@389304000"
+
+
+@unittest.skipUnless(shutil.which("cpp") and shutil.which(DTC) and DTS.is_dir(),
+                     "requires cpp, dtc and a kernel tree (AURORA_TREE)")
+class J414sNoDcpextTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.temp = tempfile.TemporaryDirectory(prefix="aurora-t6020-nodcpext-")
+        cls.addClassCleanup(cls.temp.cleanup)
+        compile_board = pmp_test.J414sPmpTest.compile_board.__func__
+        cls.stock = compile_board(cls, "t6020-j414s")
+        cls.variant = compile_board(cls, "t6020-j414s-nodcpext")
+
+    def test_m1n1_finds_no_external_dcp(self):
+        # m1n1 enables and carves out memory for the DCPs named by an alias.
+        self.assertIn("dcpext0", self.stock["/aliases"])
+        self.assertIn("dcpext1", self.stock["/aliases"])
+        self.assertNotIn("dcpext0", self.variant["/aliases"])
+        self.assertNotIn("dcpext1", self.variant["/aliases"])
+        for alias in ("dcp", "disp0", "disp0_piodma"):
+            self.assertEqual(self.variant["/aliases"][alias], self.stock["/aliases"][alias])
+
+    def test_external_dcps_and_their_darts_and_mailboxes_are_off(self):
+        for path in DISABLED:
+            with self.subTest(path=path):
+                self.assertEqual(self.stock[path].get("status"), '"okay"')
+                self.assertEqual(self.variant[path]["status"], '"disabled"')
+
+    def test_no_mode_switch_is_left_enabled_under_a_disabled_node(self):
+        # fwnode_typec_mux_get() follows the connector's graph and checks only
+        # the remote node's own status: an enabled mode-switch with no driver
+        # behind it defers the USB-C controller's probe for ever.
+        self.assertEqual(len(ROUTES), 6)
+        for path, props in self.variant.items():
+            if "mode-switch" not in props or props.get("status") == '"disabled"':
+                continue
+            parts = path.split("/")
+            ancestors = ["/".join(parts[:i]) for i in range(2, len(parts))]
+            with self.subTest(path=path):
+                for ancestor in ancestors:
+                    self.assertNotEqual(self.variant[ancestor].get("status"), '"disabled"')
+        for path in ROUTES:
+            with self.subTest(path=path):
+                self.assertIn("mode-switch", self.variant[path])
+                self.assertEqual(self.variant[path]["status"], '"disabled"')
+
+    def test_no_graph_link_leads_into_a_disabled_node(self):
+        # The same holds for any graph link: the far side's port parent must
+        # be disabled itself, not only through an ancestor.
+        nodes, handles = self.variant, phandles(self.variant)
+
+        def off(path):
+            parts = path.split("/")
+            return any(nodes.get("/".join(parts[:i]) or "/", {}).get("status") == '"disabled"'
+                       for i in range(2, len(parts) + 1))
+
+        for path, props in nodes.items():
+            if "remote-endpoint" not in props or off(path):
+                continue
+            remote = handles[int(props["remote-endpoint"].strip("<>"), 16)]
+            parent = remote.split("/")[:-2]
+            if parent[-1] == "ports":
+                parent = parent[:-1]
+            parent = "/".join(parent)
+            with self.subTest(path=path, remote=parent):
+                self.assertFalse(off(remote) and nodes[parent].get("status") != '"disabled"')
+
+    def test_display_keeps_only_the_internal_dart(self):
+        cells = self.variant[DISPLAY]["iommus"].strip("<>").split()
+        self.assertEqual(len(cells), 2)
+        self.assertEqual(phandles(self.variant)[int(cells[0], 16)], DISP0_DART)
+        self.assertEqual(len(self.stock[DISPLAY]["iommus"].strip("<>").split()), 6)
+
+    def test_no_enabled_device_uses_a_dispext_domain(self):
+        handles = phandles(self.variant)
+        dispext = {handle for handle, path in handles.items()
+                   if "power-controller" in path and
+                   self.variant[path].get("label", "").startswith('"dispext')}
+        self.assertEqual(len(dispext), 6)
+        for path, props in self.variant.items():
+            if "power-controller" in path or "pmp_report" in path:
+                continue
+            if props.get("status", '"okay"') != '"okay"' or "power-domains" not in props:
+                continue
+            cells = {int(cell, 16) for cell in props["power-domains"].strip("<>").split()}
+            with self.subTest(path=path):
+                self.assertFalse(cells & dispext)
+
+    def test_only_those_properties_differ(self):
+        # dtc numbers phandles in a different order for each tree; compare the
+        # merged sources instead, which keep references as &label.
+        stock, variant = (merged(board) for board in ("t6020-j414s", "t6020-j414s-nodcpext"))
+        self.assertEqual(set(stock), set(variant))
+        changed = {(path, name) for path in stock
+                   for name in (set(stock[path]) | set(variant[path])) - {"phandle"}
+                   if stock[path].get(name) != variant[path].get(name)}
+        expected = {(path, "status") for path in DISABLED + ROUTES}
+        expected |= {("/aliases", "dcpext0"), ("/aliases", "dcpext1"), (DISPLAY, "iommus")}
+        self.assertEqual(changed, expected)
+
+    def test_variant_is_not_built_by_default(self):
+        makefile = (DTS / "Makefile").read_text()
+        self.assertIn("t6020-j414s.dtb", makefile)
+        self.assertNotIn("t6020-j414s-nodcpext", makefile)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git c/tools/aurora-sep/tests/test_t6020_pmp.py w/tools/aurora-sep/tests/test_t6020_pmp.py
new file mode 100644
index 000000000000..d2e047ba7583
--- /dev/null
+++ w/tools/aurora-sep/tests/test_t6020_pmp.py
@@ -0,0 +1,142 @@
+"""J414s (MacBook Pro 14" M2 Pro) opt-in PMP device tree (t6020-j414s-pmp.dts).
+
+Set DTC to this kernel's built scripts/dtc/dtc for Apple floating-point cells.
+"""
+
+from pathlib import Path
+import difflib
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+
+# The kernel tree: this test's own, or AURORA_TREE when run from a copy outside it.
+ROOT = Path(os.environ.get("AURORA_TREE") or Path(__file__).resolve().parents[3])
+DTS = ROOT / "arch/arm64/boot/dts/apple"
+DTC = os.environ.get("DTC", "dtc")
+
+PMP = "/soc/pmp@28e700000"
+REPORT = "/soc/pmp_report@28e3c0000"
+# Consumers that APPLE_USE_PMP moves from a PMGR domain to a PMP report entry.
+CONSUMERS = {
+    "/soc/dcp@389c00000": REPORT + "/report@d",
+    "/soc/dcp@289c00000": REPORT + "/report@e",
+    "/soc/dcp@315c00000": REPORT + "/report@f",
+    "/soc/avd@286000000": REPORT + "/report@11",
+    "/soc/iommu@3860e8000": REPORT + "/report@c",
+}
+
+
+def parse(text):
+    """Map each node path of a dtc -O dts dump to its {property: raw value}."""
+    nodes, stack = {}, []
+    for line in text.splitlines():
+        line = line.strip()
+        if line.endswith("{"):
+            name = line[:-1].strip().split(":")[-1].strip()
+            stack.append(name)
+            path = "/" + "/".join(stack[1:]) if len(stack) > 1 else "/"
+            nodes[path] = {}
+        elif line == "};":
+            stack.pop()
+        elif stack and line.endswith(";"):
+            path = "/" + "/".join(stack[1:]) if len(stack) > 1 else "/"
+            name, _, value = line[:-1].partition(" = ")
+            nodes[path][name] = value
+    return nodes
+
+
+def preprocess(board):
+    """The board's source after cpp, one statement per line, indentation dropped."""
+    pp = subprocess.run(["cpp", "-P", "-nostdinc", "-undef", "-D__DTS__", "-x",
+                         "assembler-with-cpp", "-I", str(ROOT / "include"),
+                         "-I", str(DTS), str(DTS / f"{board}.dts")],
+                        check=True, capture_output=True, text=True)
+    return "\n".join(line.strip() for line in pp.stdout.splitlines() if line.strip())
+
+
+def phandles(nodes):
+    return {int(props["phandle"].strip("<>"), 16): path
+            for path, props in nodes.items() if "phandle" in props}
+
+
+@unittest.skipUnless(shutil.which("cpp") and shutil.which(DTC) and DTS.is_dir(),
+                     "requires cpp, dtc and a kernel tree (AURORA_TREE)")
+class J414sPmpTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.temp = tempfile.TemporaryDirectory(prefix="aurora-t6020-pmp-")
+        cls.addClassCleanup(cls.temp.cleanup)
+        cls.stock = cls.compile_board("t6020-j414s")
+        cls.pmp = cls.compile_board("t6020-j414s-pmp")
+
+    @classmethod
+    def compile_board(cls, board):
+        dtb = Path(cls.temp.name) / f"{board}.dtb"
+        subprocess.run([DTC, "-q", "-I", "dts", "-O", "dtb", "-o", str(dtb)],
+                       input=preprocess(board), check=True, capture_output=True, text=True)
+        dump = subprocess.run([DTC, "-q", "-I", "dtb", "-O", "dts", str(dtb)],
+                              check=True, capture_output=True, text=True)
+        return parse(dump.stdout)
+
+    def domain(self, nodes, path):
+        cells = nodes[path]["power-domains"].strip("<>").split()
+        return phandles(nodes)[int(cells[0], 16)]
+
+    def test_stock_board_keeps_the_pmp_off(self):
+        self.assertNotIn("pmp", self.stock["/aliases"])
+        for consumer in CONSUMERS:
+            with self.subTest(consumer=consumer):
+                self.assertNotIn("pmp_report", self.domain(self.stock, consumer))
+
+    def test_pmp_board_names_the_pmp_for_m1n1(self):
+        # m1n1 (kboot dt_set_pmp) finds the node through this alias, copies
+        # the ADT values onto it and only then sets it okay.
+        self.assertEqual(self.pmp["/aliases"]["pmp"], f'"{PMP}"')
+        self.assertEqual(self.pmp[PMP]["status"], '"disabled"')
+        self.assertEqual(self.pmp[PMP]["compatible"],
+                         '"apple,t6020-pmp-v2", "apple,t6000-pmp-v2"')
+
+    def test_pmp_board_reports_consumer_power_to_the_pmp(self):
+        for consumer, entry in CONSUMERS.items():
+            with self.subTest(consumer=consumer):
+                self.assertEqual(self.domain(self.pmp, consumer), entry)
+                self.assertNotEqual(self.pmp[entry].get("status"), '"disabled"')
+                # The entry still powers the consumer's own PMGR domain.
+                self.assertIn("power-controller", self.domain(self.pmp, entry))
+
+    def test_only_the_pmp_wiring_differs(self):
+        self.assertEqual(set(self.stock), set(self.pmp))
+        for prop in ("compatible", "model"):
+            self.assertEqual(self.stock["/"][prop], self.pmp["/"][prop])
+        # Compare the sources by label, before dtc numbers the phandles.
+        stock = preprocess("t6020-j414s").splitlines()
+        pmp = preprocess("t6020-j414s-pmp").splitlines()
+        diff = [line for line in difflib.unified_diff(stock, pmp, lineterm="", n=0)
+                if line[:1] in "+-" and line[:3] not in ("+++", "---")]
+        self.assertEqual(sorted(diff), sorted([
+            "+pmp = &pmp;",
+            "-power-domains = <&ps_disp0_cpu0>;",
+            "+power-domains = <&pmp_report_disp0>;",
+            "-power-domains = <&ps_dispext0_cpu0>;",
+            "+power-domains = <&pmp_report_dispext0>;",
+            "-power-domains = <&ps_dispext1_cpu0>;",
+            "+power-domains = <&pmp_report_dispext1>;",
+            "-power-domains = <&ps_avd_sys>;",
+            "+power-domains = <&pmp_report_avd_sys>;",
+            "-power-domains = <&ps_isp_sys>;",
+            "+power-domains = <&pmp_report_isp_sys>;",
+        ]))
+
+    def test_variant_is_not_built_by_default(self):
+        # Same compatible as t6020-j414s.dtb: m1n1 boots the last match, so a
+        # packaged copy would turn the PMP on for every J414s.
+        makefile = (DTS / "Makefile").read_text()
+        self.assertIn("t6020-j414s.dtb", makefile)
+        self.assertNotIn("t6020-j414s-pmp", makefile)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git c/tools/aurora-sep/wakelat.c w/tools/aurora-sep/wakelat.c
new file mode 100644
index 000000000000..1f11859d9877
--- /dev/null
+++ w/tools/aurora-sep/wakelat.c
@@ -0,0 +1,116 @@
+// Wake-up latency probe: timer overshoot on one CPU, or futex wake across two CPUs.
+// usage: wakelat timer CPU SAMPLES PERIOD_US
+//        wakelat ipi CPU_WAKER CPU_SLEEPER SAMPLES PERIOD_US
+// Prints p50 p90 p99 max in microseconds. Runs SCHED_FIFO 50 when allowed.
+#define _GNU_SOURCE
+#include <linux/futex.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+
+static int64_t now_ns(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec;
+}
+
+static void pin(int cpu)
+{
+	cpu_set_t set;
+	struct sched_param sp = { .sched_priority = 50 };
+
+	CPU_ZERO(&set);
+	CPU_SET(cpu, &set);
+	if (sched_setaffinity(0, sizeof(set), &set)) {
+		perror("sched_setaffinity");
+		exit(1);
+	}
+	sched_setscheduler(0, SCHED_FIFO, &sp);
+}
+
+static int cmp(const void *a, const void *b)
+{
+	int64_t x = *(const int64_t *)a, y = *(const int64_t *)b;
+	return (x > y) - (x < y);
+}
+
+static void report(int64_t *lat, int n)
+{
+	qsort(lat, n, sizeof(*lat), cmp);
+	printf("p50 %.1f p90 %.1f p99 %.1f max %.1f\n", lat[n / 2] / 1e3, lat[n * 9 / 10] / 1e3,
+	       lat[n * 99 / 100] / 1e3, lat[n - 1] / 1e3);
+}
+
+static atomic_int word;
+static _Atomic int64_t stamp;
+static int sleeper_cpu, samples;
+static int64_t *lat;
+
+static void *sleeper(void *arg)
+{
+	(void)arg;
+	pin(sleeper_cpu);
+	for (int i = 0; i < samples; i++) {
+		while (atomic_load(&word) == 0)
+			syscall(SYS_futex, &word, FUTEX_WAIT_PRIVATE, 0, NULL, NULL, 0);
+		lat[i] = now_ns() - atomic_load(&stamp);
+		atomic_store(&word, 0);
+	}
+	return NULL;
+}
+
+int main(int argc, char **argv)
+{
+	if (argc == 5 && !strcmp(argv[1], "timer")) {
+		int cpu = atoi(argv[2]), n = atoi(argv[3]);
+		int64_t period = atoll(argv[4]) * 1000, *l = calloc(n, sizeof(*l));
+		struct timespec ts;
+
+		pin(cpu);
+		clock_gettime(CLOCK_MONOTONIC, &ts);
+		for (int i = 0; i < n; i++) {
+			int64_t target = (int64_t)ts.tv_sec * 1000000000 + ts.tv_nsec + period;
+
+			ts.tv_sec = target / 1000000000;
+			ts.tv_nsec = target % 1000000000;
+			clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &ts, NULL);
+			l[i] = now_ns() - target;
+		}
+		report(l, n);
+		return 0;
+	}
+	if (argc == 6 && !strcmp(argv[1], "ipi")) {
+		int waker = atoi(argv[2]);
+		int64_t period = atoll(argv[5]) * 1000;
+		pthread_t t;
+
+		sleeper_cpu = atoi(argv[3]);
+		samples = atoi(argv[4]);
+		lat = calloc(samples, sizeof(*lat));
+		pthread_create(&t, NULL, sleeper, NULL);
+		pin(waker);
+		for (int i = 0; i < samples; i++) {
+			struct timespec ts = { 0, period };
+
+			nanosleep(&ts, NULL);
+			while (atomic_load(&word) != 0)
+				sched_yield();
+			atomic_store(&stamp, now_ns());
+			atomic_store(&word, 1);
+			syscall(SYS_futex, &word, FUTEX_WAKE_PRIVATE, 1, NULL, NULL, 0);
+		}
+		pthread_join(t, NULL);
+		report(lat, samples);
+		return 0;
+	}
+	fprintf(stderr, "usage: wakelat timer CPU N PERIOD_US | ipi WAKER SLEEPER N PERIOD_US\n");
+	return 2;
+}
