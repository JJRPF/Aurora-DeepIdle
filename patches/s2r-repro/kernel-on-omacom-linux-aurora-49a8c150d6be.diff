+/* Only T6000 has the power cycle; elsewhere stop returns -EOPNOTSUPP */
+static int pmp_pc_init(struct device *dev)
+{
+	struct platform_device *pdev = to_platform_device(dev);
+	struct device_node *ps_np, *parent, *child;
+	struct resource *res;
+	int ret = -ENODEV;
+
+	/* GH-5: t6000 and t6020 share the PMP layout (IORVBAR 0x28e850000, DAPF 0x28e304000, checked on J414s) */
+	if (!of_device_is_compatible(dev->of_node, "apple,t6000-pmp-v2") ||
+	    !(of_machine_is_compatible("apple,t6000") || of_machine_is_compatible("apple,t6020")))
+		return 0;
