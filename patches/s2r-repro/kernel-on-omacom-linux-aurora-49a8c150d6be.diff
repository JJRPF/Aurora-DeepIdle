+/*
+ * As late as a device callback with the SMC mailbox interrupt still on: macOS sends slpa from
+ * a platform sleep action, after every driver. The atomic SMC write cannot be used in noirq:
+ * its mode is one way, for power off.
+ */
+static int macsmc_reboot_pm_suspend_late(struct device *dev)
+{
+	struct macsmc_reboot *reboot = dev_get_drvdata(dev);
+	int ret;
+
+	if ((reboot->sleep_steps & MACSMC_SLEEP_STAGE) && pm_suspend_target_state == PM_SUSPEND_MEM &&
+	    reboot->nvm.boot_stage) {
+		reboot->saved_stage = nvmem_cell_get_u8(reboot->nvm.boot_stage);
+		ret = reboot->saved_stage < 0 ? reboot->saved_stage :
+		      nvmem_cell_set_u8(reboot->nvm.boot_stage, BOOT_STAGE_SLEEP);
+		reboot->stage_set = ret >= 0;
+		dev_info(dev, "sleep: boot_stage %#x -> %#x (%d)\n", reboot->saved_stage, BOOT_STAGE_SLEEP, ret);
+	}
+	if ((reboot->sleep_steps & MACSMC_SLEEP_PSDUMP) && pm_suspend_target_state == PM_SUSPEND_MEM)
+		macsmc_reboot_ps_dump(dev, "suspend_late");
+	if ((reboot->sleep_steps & MACSMC_SLEEP_PMPREL) && pm_suspend_target_state == PM_SUSPEND_MEM) {
+		ret = apple_pmp_report_sleep_release(true);
+		reboot->pmp_released = true;
+		dev_info(dev, "sleep: PMP requests released before slpa (%d)\n", ret);
+	}
+	if (reboot->sleep_steps & MACSMC_SLEEP_SLPA) {
+		int reg_on_before = macsmc_reboot_wlan_reg_on(reboot);
+		unsigned int pmvc = READ_ONCE(s2r_pmvc);
+
+		if (pmvc) {
+			macsmc_reboot_log_pmvc(dev, reboot, "before pmVC");
+			ret = apple_smc_write_u32(reboot->smc, SMC_KEY(pmVC), pmvc);
+			dev_info(dev, "TEST s2r: pmVC = %#x before slpa (%d)\n", pmvc, ret);
+			msleep(35);
+			macsmc_reboot_log_pmvc(dev, reboot, "35 ms after pmVC");
+		}
+		macsmc_reboot_s2r_gpio(dev, reboot, true);
+		ret = apple_smc_write_u32(reboot->smc, SMC_KEY(MBSE), SMC_KEY(slpa));
+		reboot->slpa_sent = ret >= 0;
+		dev_info(dev, "sleep: MBSE = slpa (%d)\n", ret);
+		dev_info(dev, "TEST s2r: gP0d before %d, after slpa %d\n", reg_on_before, macsmc_reboot_wlan_reg_on(reboot));
+		msleep(100);
+		dev_info(dev, "TEST s2r: gP0d 100ms after slpa %d\n", macsmc_reboot_wlan_reg_on(reboot));
+	}
+	return 0;
+}
