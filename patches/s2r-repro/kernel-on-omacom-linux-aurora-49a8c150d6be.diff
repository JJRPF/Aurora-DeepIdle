+		ret = nvmem_cell_set_u8(reboot->nvm.boot_stage, reboot->saved_stage);
+		dev_info(dev, "sleep: boot_stage back to %#x (%d)\n", reboot->saved_stage, ret);
+	}
+	if (!reboot->slpa_sent)
+		return 0;
+	reboot->slpa_sent = false;
+	macsmc_reboot_s2r_gpio(dev, reboot, false);
+	dev_info(dev, "TEST s2r: gP0d at the wake before waka %d\n", macsmc_reboot_wlan_reg_on(reboot));
