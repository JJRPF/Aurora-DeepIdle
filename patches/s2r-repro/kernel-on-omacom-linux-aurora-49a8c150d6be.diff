+static int apple_smc_suspend_late(struct device *dev)
+{
+	struct apple_smc *smc = dev_get_drvdata(dev);
+	int ret;
+
+	if (!ap_idle_in_suspend || !smc)
+		return 0;
+	ret = apple_rtkit_set_ap_power(smc->rtk, 0x201);
+	dev_info(dev, "SetAPPower IDLE: %d\n", ret);
+	if (pmp_sleep && pm_suspend_target_state == PM_SUSPEND_MEM) {
+		ret = pmp_cycle ? apple_pmp_power_cycle(true) : apple_pmp_sleep(true);
+		pmp_slept = !ret;
+		dev_info(dev, "sleep: PMP %s: %d\n", pmp_cycle ? "stopped, SRAM saved" : "SetAPPower/SetIOPPower IDLE", ret);
+		/* TEST: macOS's trace step 6, the CPU complexes' requests withdrawn last */
+		ret = apple_pmp_report_test_pcpm_release();
+		if (ret)
+			dev_info(dev, "sleep: TEST pcpm release: %d\n", ret);
+	}
+	return 0;
+}
+
+static int apple_smc_resume_early(struct device *dev)
+{
+	struct apple_smc *smc = dev_get_drvdata(dev);
+	int ret;
+
+	if (!ap_idle_in_suspend || !smc)
+		return 0;
+	ret = apple_rtkit_set_ap_power(smc->rtk, 0x20);
+	dev_info(dev, "SetAPPower ON: %d\n", ret);
+	if (pmp_slept) {
+		pmp_slept = false;
+		ret = pmp_cycle ? apple_pmp_power_cycle(false) : apple_pmp_sleep(false);
+		dev_info(dev, "sleep: PMP %s: %d\n", pmp_cycle ? "restarted" : "wake", ret);
+	}
+	return 0;
+}
+
+static const struct dev_pm_ops apple_smc_pm_ops = {
+	LATE_SYSTEM_SLEEP_PM_OPS(apple_smc_suspend_late, apple_smc_resume_early)
+};
