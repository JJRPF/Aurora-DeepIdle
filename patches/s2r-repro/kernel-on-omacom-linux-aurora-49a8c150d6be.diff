index 000000000000..4747e22f604e
--- /dev/null
+++ w/tools/aurora-sep/idle-ab.py
@@ -0,0 +1,273 @@
+#!/usr/bin/env python3
+"""Compare CPU idle settings by system power, on a running machine.
+
+  idle-ab.py [--rounds N] [--window S] [--settle S] SETTING...
+
+Each SETTING is one of
+  default      both states enabled, the residency as found
+  wfi-only     CPU PD disabled
+  pd-always    WFI disabled, so every idle entry is CPU PD
+  res=US       both states enabled, CPU PD target residency US microseconds
+               (needs cpuidle_apple.pd_residency_us)
+  no-eas       both states enabled, energy-aware scheduling off
+               (kernel.sched_energy_aware=0; needs a CPU energy model,
+               so compare it with default to see what EAS saves)
+
+wfi-only and pd-always take a CPU list, as in pd-always@4-9 or
+wfi-only@0,2: the listed CPUs get the setting and the others both states,
+to tell the E cores' share from the P cores' or one cluster's.
+
+Every round runs each setting for --window seconds, after --settle seconds,
+alternating the order from round to round, and samples every SMC power
+sensor once a second (Total System Power, and Heatpipe Power, the SoC
+package, which leaves out the display and the rest of the board). The report
+gives each setting's mean per sensor, its CPU PD and WFI residency, and its
+difference from the first setting, paired by round: a busy machine's load
+drifts by watts, and pairing cancels most of it. More rounds narrow the
+spread (the standard error is printed). It also gives each setting's busy
+time (all CPUs, from /proc/stat) and each cpufreq policy's mean frequency,
+to show whether a setting changed the work done or the clocks rather than
+only the idle power.
+
+It writes only the cpuidle 'disable' files, pd_residency_us and
+sched_energy_aware, as root, and puts every one back as it found it on
+exit, also on an error or Ctrl-C.
+"""
+import argparse
+import json
+from pathlib import Path
+import statistics
+import sys
+import time
+
+CPUS = 'sys/devices/system/cpu'
+HWMON = 'sys/class/hwmon'
+RESIDENCY = 'sys/module/cpuidle_apple/parameters/pd_residency_us'
+EAS = 'proc/sys/kernel/sched_energy_aware'
+POWER_LABEL = 'Total System Power'
+POLICIES = 'sys/devices/system/cpu/cpufreq'
+STAT = 'proc/stat'
+HWMON_NAME = 'macsmc_hwmon'
+
+
+def parse_cpus(text):
+    """The set of CPU numbers in a list such as 0-3,7."""
+    cpus = set()
+    for part in text.split(','):
+        first, _, last = part.partition('-')
+        if not first.isdigit() or not (last or first).isdigit() or int(first) > int(last or first):
+            raise ValueError(f'bad CPU list {text!r}')
+        cpus.update(range(int(first), int(last or first) + 1))
+    return frozenset(cpus)
+
+
+def parse_setting(text):
+    """(state0 disable, state1 disable, residency or None, CPUs or None, EAS or None)
+    for a SETTING."""
+    fixed = {'default': (0, 0), 'wfi-only': (0, 1), 'pd-always': (1, 0)}
+    name, at, cpus = text.partition('@')
+    if name in fixed and not (at and name == 'default'):
+        return (*fixed[name], None, parse_cpus(cpus) if at else None, None)
+    if text.startswith('res=') and text[4:].isdigit() and int(text[4:]) > 0:
+        return 0, 0, int(text[4:]), None, None
+    if text == 'no-eas':
+        return 0, 0, None, None, 0
+    raise ValueError(f'unknown setting {text!r}')
+
+
+def power_sensors(root):
+    """{label: input path} of the SMC's power sensors, Total System Power first."""
+    sensors = {}
+    for label in sorted((root / HWMON).glob('hwmon*/power*_label')):
+        name = (label.parent / 'name').read_text().strip() if (label.parent / 'name').exists() else ''
+        if name == HWMON_NAME or label.read_text().strip() == POWER_LABEL:
+            sensors[label.read_text().strip()] = label.with_name(
+                label.name.replace('_label', '_input'))
+    if POWER_LABEL not in sensors:
+        raise FileNotFoundError(f'no hwmon sensor labelled {POWER_LABEL!r}')
+    return dict(sorted(sensors.items(), key=lambda item: item[0] != POWER_LABEL))
+
+
+class Machine:
+    def __init__(self, root=Path('/')):
+        self.root = root
+        self.cpus = sorted((root / CPUS).glob('cpu[0-9]*/cpuidle'),
+                           key=lambda path: int(path.parent.name[3:]))
+        if not self.cpus:
+            raise FileNotFoundError('no cpuidle states')
+        self.sensors = power_sensors(root)
+        self.residency = root / RESIDENCY
+        self.eas = root / EAS
+        self.policies = sorted((root / POLICIES).glob('policy[0-9]*'),
+                               key=lambda path: int(path.name[6:]))
+        self.saved = {path: path.read_text() for path in self.knobs()}
+        self.written = set()
+
+    def knobs(self):
+        paths = [cpu / f'state{i}/disable' for cpu in self.cpus for i in (0, 1)]
+        return paths + [path for path in (self.residency, self.eas) if path.exists()]
+
+    def apply(self, setting):
+        d0, d1, residency, only, eas = setting
+        if eas is not None:
+            if not self.eas.exists():
+                raise FileNotFoundError(f'{EAS} is missing')
+            self.write(self.eas, f'{eas}\n')
+        elif self.eas in self.written:
+            # Each write rebuilds the scheduler domains; leave it alone until used.
+            self.write(self.eas, self.saved[self.eas])
+        if residency is not None:
+            if not self.residency.exists():
+                raise FileNotFoundError(f'{RESIDENCY} is missing: this kernel has no '
+                                        'pd_residency_us')
+            self.write(self.residency, f'{residency}\n')
+        elif self.residency in self.saved:
+            self.write(self.residency, self.saved[self.residency])
+        for number, cpu in zip(self.numbers(), self.cpus):
+            mine = only is None or number in only
+            self.write(cpu / 'state0/disable', f'{d0 if mine else 0}\n')
+            self.write(cpu / 'state1/disable', f'{d1 if mine else 0}\n')
+
+    def write(self, path, value):
+        self.written.add(path)
+        path.write_text(value)
+
+    def numbers(self):
+        return [int(cpu.parent.name[3:]) for cpu in self.cpus]
+
+    def restore(self):
+        """Put back every knob this run wrote."""
+        for path, value in self.saved.items():
+            if path in self.written:
+                path.write_text(value)
+
+    def residency_us(self):
+        """Time in WFI and in CPU PD of each CPU, in microseconds."""
+        return [[int((cpu / f'state{i}/time').read_text()) for i in (0, 1)] for cpu in self.cpus]
+
+    def busy(self):
+        """{CPU number: (busy, total)} jiffies, busy being all but idle and iowait."""
+        out = {}
+        for line in (self.root / STAT).read_text().splitlines():
+            fields = line.split()
+            if fields and fields[0].startswith('cpu') and fields[0][3:].isdigit():
+                ticks = [int(x) for x in fields[1:]]
+                out[int(fields[0][3:])] = (sum(ticks) - ticks[3] - ticks[4], sum(ticks))
+        return out
+
+    def mhz(self):
+        """{policy name: current MHz}."""
+        return {policy.name: int((policy / 'scaling_cur_freq').read_text()) // 1000
+                for policy in self.policies}
+
+    def watts(self):
+        """{label: watts} for every sensor."""
+        return {label: int(path.read_text()) / 1e6 for label, path in self.sensors.items()}
+
+
+def run(machine, names, rounds, window, settle, log=None):
+    for name in names:
+        only = parse_setting(name)[3]
+        if only is not None and not only <= set(machine.numbers()):
+            raise ValueError(f'{name}: no CPU {min(only - set(machine.numbers()))}')
+    rows = []
+    try:
+        for n in range(rounds):
+            for name in (names if n % 2 == 0 else names[::-1]):
+                machine.apply(parse_setting(name))
+                time.sleep(settle)
+                before, start, samples = machine.residency_us(), time.monotonic(), []
+                ticks, clocks = machine.busy(), []
+                while time.monotonic() - start < window:
+                    samples.append(machine.watts())
+                    clocks.append(machine.mhz())
+                    time.sleep(1)
+                after, elapsed = machine.residency_us(), time.monotonic() - start
+                ticks = {cpu: [b - a for a, b in zip(ticks[cpu], now)]
+                         for cpu, now in machine.busy().items() if cpu in ticks}
+                busy, jiffies = (sum(t[i] for t in ticks.values()) for i in (0, 1))
+                spent = [[a - b for a, b in zip(*pair)] for pair in zip(after, before)]
+                total = elapsed * 1e6 * len(machine.cpus)
+                row = {'round': n, 'setting': name,
+                       'watts': statistics.mean(sample[POWER_LABEL] for sample in samples),
+                       'sensors': {label: statistics.mean(sample[label] for sample in samples)
+                                   for label in samples[0]},
+                       'wfi_pct': 100 * sum(cpu[0] for cpu in spent) / total,
+                       'pd_pct': 100 * sum(cpu[1] for cpu in spent) / total,
+                       'pd_pct_by_cpu': {number: round(100 * cpu[1] / (elapsed * 1e6), 1)
+                                         for number, cpu in zip(machine.numbers(), spent)},
+                       'busy_pct': 100 * busy / jiffies if jiffies else 0.0,
+                       'busy_pct_by_cpu': {cpu: round(100 * b / t, 1) if t else 0.0
+                                           for cpu, (b, t) in ticks.items()},
+                       'mhz': {name: statistics.mean(clock[name] for clock in clocks)
+                               for name in clocks[0]}}
+                rows.append(row)
+                if log:
+                    print(json.dumps(row), file=log, flush=True)
+    finally:
+        machine.restore()
+    return rows
+
+
+def report(rows, names):
+    out = []
+    labels = list(rows[0].get('sensors') or {POWER_LABEL: None}) if rows else []
+    for label in labels:
+        def watts(row):
+            return row['sensors'][label] if 'sensors' in row else row['watts']
+        out.append(f'{label}:')
+        out.append(f'  {"setting":12} {"mean W":>8} {"PD %":>6} {"WFI %":>6}   '
+                   f'paired difference from {names[0]}')
+        base = {row['round']: watts(row) for row in rows if row['setting'] == names[0]}
+        for name in names:
+            mine = [row for row in rows if row['setting'] == name]
+            if not mine:
+                continue
+            line = (f'  {name:12} {statistics.mean(watts(r) for r in mine):8.2f} '
+                    f'{statistics.mean(r["pd_pct"] for r in mine):6.1f} '
+                    f'{statistics.mean(r["wfi_pct"] for r in mine):6.1f}')
+            diffs = [watts(r) - base[r['round']] for r in mine if r['round'] in base]
+            if name != names[0] and len(diffs) > 1:
+                mean, sd = statistics.mean(diffs), statistics.stdev(diffs)
+                lower = sum(d < 0 for d in diffs)
+                line += (f'   {mean:+.3f} W (sd {sd:.2f}, se {sd / len(diffs) ** 0.5:.3f}, '
+                         f'lower in {lower} of {len(diffs)})')
+            out.append(line)
+    if rows and 'busy_pct' in rows[0]:
+        out.append('Busy time and clocks:')
+        policies = list(rows[0]['mhz'])
+        out.append(f'  {"setting":12} {"busy %":>6} ' + ' '.join(f'{name:>9}' for name in policies))
+        for name in names:
+            mine = [row for row in rows if row['setting'] == name]
+            if mine:
+                out.append(f'  {name:12} {statistics.mean(r["busy_pct"] for r in mine):6.1f} ' +
+                           ' '.join(f'{statistics.mean(r["mhz"][p] for r in mine):9.0f}'
+                                    for p in policies))
+    return out
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('--rounds', type=int, default=10)
+    parser.add_argument('--window', type=int, default=20, help='seconds per setting')
+    parser.add_argument('--settle', type=int, default=3, help='seconds before sampling')
+    parser.add_argument('--log', type=Path, help='also write each window as JSON lines')
+    parser.add_argument('settings', nargs='+')
+    args = parser.parse_args()
+    for name in args.settings:
+        try:
+            parse_setting(name)
+        except ValueError as error:
+            parser.error(str(error))
+    if len(set(args.settings)) != len(args.settings):
+        parser.error('each setting once')
+    machine = Machine()
+    log = args.log.open('w') if args.log else None
+    rows = run(machine, args.settings, args.rounds, args.window, args.settle, log)
+    print('\n'.join(report(rows, args.settings)))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git c/tools/aurora-sep/sleep-drain-probe.py w/tools/aurora-sep/sleep-drain-probe.py
new file mode 100755
index 000000000000..812b0f94b234
--- /dev/null
+++ w/tools/aurora-sep/sleep-drain-probe.py
@@ -0,0 +1,441 @@
+#!/usr/bin/env python3
+"""Measure s2idle battery drain and what wakes the SoC while it sleeps.
+
+  snapshot FILE   record the counters below in FILE (JSON)
+  compare A B     report drain and wake activity between two snapshots
+  around [FILE]   snapshot, suspend through systemd, snapshot after resume,
+                  compare (and keep both snapshots in FILE if given)
+  arm             snapshot into STATE and start the s2idle trace; then suspend
+                  any way you like (lid, menu, systemctl)
+  report          after resume: snapshot, compare with STATE, print the trace
+                  analysis and stop the trace (--keep leaves it running)
+  disarm          stop and remove the s2idle trace
+
+Counters: the battery's energy (macsmc), the time spent suspended
+(CLOCK_BOOTTIME - CLOCK_MONOTONIC), each CPU's s2idle entries per cpuidle
+state, /proc/interrupts and, as root, the wakeup sources in debugfs. In
+s2idle each CPU re-enters its idle state once per interrupt it takes, so
+entries per suspended second measure how often the SoC woke.
+
+As root it also records each power domain's power-off count (debugfs
+pm_genpd), so the report lists the domains the kernel may power off (not
+apple,always-on in the device tree) that stayed on through a suspend.
+
+The s2idle trace is a tracefs instance of its own (INSTANCE). Triggers turn
+it on when the machine enters suspend-to-idle and off at the first device
+resume callback, so it holds only what happened while suspended: the
+timekeeping freezes (each one a wake of the whole SoC), the interrupt that
+woke the first CPU each time, and the interrupts, IPIs, timers and work that
+ran. The trace clock stops while every CPU sleeps, so it orders events but
+does not time the gaps between wakes.
+
+It only reads, except that 'around' asks systemd to suspend and 'arm',
+'report' and 'disarm' create, configure and remove the tracefs instance. Run
+on battery: on AC the battery does not discharge and the drain is
+meaningless.
+"""
+import argparse
+from collections import Counter
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import time
+
+BATTERY = 'sys/class/power_supply/macsmc-battery'
+CPUS = 'sys/devices/system/cpu'
+WAKEUP_SOURCES = 'sys/kernel/debug/wakeup_sources'
+GENPD = 'sys/kernel/debug/pm_genpd'
+PMGR = 'sys/firmware/devicetree/base/soc'
+TRACING = 'sys/kernel/tracing'
+INSTANCE = 'sleep-drain-probe'
+STATE = Path('/var/tmp/sleep-drain-probe.json')
+
+TRACE_EVENTS = (
+    'power/suspend_resume',
+    'power/wakeup_source_activate',
+    'irq/irq_handler_entry',
+    'irq/softirq_entry',
+    'ipi/ipi_entry',
+    'timer/hrtimer_expire_entry',
+    'timer/timer_expire_entry',
+    'workqueue/workqueue_execute_start',
+)
+# An event takes one traceon/traceoff trigger, so the trace stops at the
+# first device callback after suspend-to-idle (system sleep callbacks are
+# the only ones this event traces; the ones before it find the trace off).
+TRACE_TRIGGERS = (
+    ('power/suspend_resume', 'traceon if action == "machine_suspend" && start == 1'),
+    ('power/device_pm_callback_start', 'traceoff'),
+)
+
+
+def read(path, default=None):
+    try:
+        return path.read_text().strip()
+    except OSError:
+        return default
+
+
+def read_int(path):
+    value = read(path)
+    return int(value) if value is not None and value.lstrip('-').isdigit() else None
+
+
+def interrupts(text):
+    """Total count per interrupt line of /proc/interrupts, keyed 'irq name'."""
+    lines = text.splitlines()
+    if not lines:
+        return {}
+    ncpus = len(lines[0].split())
+    counts = {}
+    for line in lines[1:]:
+        irq, _, rest = line.partition(':')
+        fields = rest.split()
+        cells = [int(f) for f in fields[:ncpus] if f.isdigit()]
+        if not cells:
+            continue
+        name = ' '.join(fields[len(cells):])
+        counts[f'{irq.strip()} {name}'.strip()] = sum(cells)
+    return counts
+
+
+def wakeup_sources(text):
+    rows = text.splitlines()
+    sources = {}
+    for row in rows[1:]:
+        fields = row.split()
+        if len(fields) >= 4 and fields[2].isdigit() and fields[3].isdigit():
+            sources[fields[0]] = {'events': int(fields[2]), 'wakeups': int(fields[3])}
+    return sources
+
+
+def genpd(root):
+    """Power-off count (all idle states' usage) and state of each domain."""
+    base = root / GENPD
+    try:
+        names = sorted(path.name for path in base.iterdir())
+    except OSError:
+        return None
+    domains = {}
+    for name in names:
+        rows = (read(base / name / 'idle_states') or '').splitlines()[1:]
+        usage = [row.split() for row in rows]
+        domains[name] = {
+            'off': sum(int(f[2]) for f in usage if len(f) > 2 and f[2].isdigit()),
+            'state': (read(base / name / 'current_state') or '?').split('-')[0],
+        }
+    return domains
+
+
+def always_on(root):
+    """Labels of the PMGR power states the device tree keeps always on."""
+    return sorted(read(node / 'label', '').rstrip('\0')
+                  for node in (root / PMGR).glob('power-management@*/power-controller@*')
+                  if (node / 'apple,always-on').exists())
+
+
+def snapshot(root=Path('/')):
+    cpus = {}
+    for cpu in sorted((root / CPUS).glob('cpu[0-9]*')):
+        states = {}
+        for state in sorted((cpu / 'cpuidle').glob('state[0-9]*')):
+            states[read(state / 'name', state.name)] = read_int(state / 's2idle' / 'usage')
+        cpus[cpu.name] = states
+    battery = root / BATTERY
+    sources = read(root / WAKEUP_SOURCES)
+    return {
+        'wall': time.time(),
+        'monotonic': time.clock_gettime(time.CLOCK_MONOTONIC),
+        'boottime': time.clock_gettime(time.CLOCK_BOOTTIME),
+        'battery': {
+            'status': read(battery / 'status'),
+            'energy_uwh': read_int(battery / 'energy_now'),
+            'capacity': read_int(battery / 'capacity'),
+        },
+        'cpus': cpus,
+        'interrupts': interrupts(read(root / 'proc/interrupts', '')),
+        'wakeup_sources': wakeup_sources(sources) if sources else None,
+        'suspend_success': read_int(root / 'sys/power/suspend_stats/success'),
+        'mem_sleep': read(root / 'sys/power/mem_sleep'),
+        'genpd': genpd(root),
+        'always_on': always_on(root),
+    }
+
+
+def compare(a, b, top=12):
+    """The report between snapshots a and b, as lines of text."""
+    suspended = max(0.0, (b['boottime'] - b['monotonic']) - (a['boottime'] - a['monotonic']))
+    awake = b['monotonic'] - a['monotonic']
+    total = b['boottime'] - a['boottime']
+    out = [f'window {total / 3600:.2f} h: suspended {suspended / 3600:.2f} h, '
+           f'awake {awake / 60:.1f} min; suspends '
+           f'{(b["suspend_success"] or 0) - (a["suspend_success"] or 0)}; '
+           f'mem_sleep {b["mem_sleep"]}']
+
+    ea, eb = a['battery']['energy_uwh'], b['battery']['energy_uwh']
+    if ea is None or eb is None:
+        out.append('battery: no energy reading')
+    else:
+        used = (ea - eb) / 1e6
+        out.append(f'battery: {ea / 1e6:.2f} -> {eb / 1e6:.2f} Wh ({used:.3f} Wh used), '
+                   f'status {a["battery"]["status"]} -> {b["battery"]["status"]}')
+        if total > 0:
+            out.append(f'average drain over the window: {used / (total / 3600):.3f} W')
+        if 'Discharging' not in (a['battery']['status'], b['battery']['status']):
+            out.append('warning: the battery was not discharging; this drain is not the '
+                       'sleep drain (run on battery)')
+        if suspended > 0 and awake > 0.05 * total:
+            out.append('note: the awake time is more than 5% of the window, so the '
+                       'average overstates the sleep drain')
+
+    if suspended > 1:
+        out.append('s2idle entries per suspended second (each is one wake of that CPU):')
+        for cpu, states in b['cpus'].items():
+            before = a['cpus'].get(cpu, {})
+            deltas = {name: (count or 0) - (before.get(name) or 0)
+                      for name, count in states.items()}
+            entries = sum(deltas.values())
+            detail = ', '.join(f'{name} {count}' for name, count in deltas.items() if count)
+            out.append(f'  {cpu}: {entries / suspended:8.2f}/s  ({detail or "none"})')
+
+    deltas = sorted(((b['interrupts'][irq] - a['interrupts'].get(irq, 0), irq)
+                     for irq in b['interrupts']), reverse=True)
+    out.append(f'interrupts over the window (top {top}; includes the awake time):')
+    for count, irq in deltas[:top]:
+        if count <= 0:
+            break
+        rate = f' ({count / suspended:.2f} per suspended s)' if suspended > 1 else ''
+        out.append(f'  {count:10d} {irq}{rate}')
+
+    if a['wakeup_sources'] is not None and b['wakeup_sources'] is not None:
+        changed = []
+        for name, now in b['wakeup_sources'].items():
+            then = a['wakeup_sources'].get(name, {'events': 0, 'wakeups': 0})
+            events = now['events'] - then['events']
+            wakeups = now['wakeups'] - then['wakeups']
+            if events or wakeups:
+                changed.append((events, wakeups, name))
+        out.append('wakeup sources (events, wakeups):')
+        out.extend(f'  {events:6d} {wakeups:6d} {name}'
+                   for events, wakeups, name in sorted(changed, reverse=True)[:top])
+        if not changed:
+            out.append('  none')
+    else:
+        out.append('wakeup sources: not read (run as root)')
+
+    suspends = (b['suspend_success'] or 0) - (a['suspend_success'] or 0)
+    if a.get('genpd') and b.get('genpd') and suspends > 0:
+        fixed = set(b.get('always_on') or ())
+        stayed = sorted(name for name, now in b['genpd'].items()
+                        if name in a['genpd'] and name not in fixed
+                        and 'on' in (a['genpd'][name]['state'], now['state'])
+                        and now['off'] - a['genpd'][name]['off'] < suspends)
+        out.append(f'power domains not always-on that stayed on through a suspend '
+                   f'({len(stayed)}; {len(fixed)} always-on domains not listed):')
+        out.append('  ' + (' '.join(stayed) or 'none'))
+    elif suspends > 0:
+        out.append('power domains: not read (run as root)')
+    return out
+
+
+TRACE_LINE = re.compile(r'^\s*.+?-\d+\s+\[(?P<cpu>\d+)\]\s+(?:\S+\s+)?[\d.]+:\s+'
+                        r'(?P<event>\w+):\s+(?P<body>.*)$')
+TRACE_KEYS = {
+    'irq_handler_entry': re.compile(r'name=(\S+)'),
+    'ipi_entry': re.compile(r'\((.*)\)'),
+    'softirq_entry': re.compile(r'action=(\w+)'),
+    'hrtimer_expire_entry': re.compile(r'function=(\S+)'),
+    'timer_expire_entry': re.compile(r'function=(\S+)'),
+    'workqueue_execute_start': re.compile(r'function (\S+)'),
+    'wakeup_source_activate': re.compile(r'^(\S+)'),
+}
+TRACE_NAMES = {
+    'irq_handler_entry': 'interrupts',
+    'ipi_entry': 'IPIs',
+    'softirq_entry': 'softirqs',
+    'hrtimer_expire_entry': 'hrtimers',
+    'timer_expire_entry': 'timers',
+    'workqueue_execute_start': 'work items',
+    'wakeup_source_activate': 'wakeup sources activated',
+}
+
+
+def analyse_trace(text, top=10):
+    """Report on an s2idle trace, as lines of text.
+
+    Each 'timekeeping_freeze[N] end' marks CPU N leaving a state in which
+    every CPU slept; the next interrupt or IPI that CPU takes is what woke
+    the SoC.
+    """
+    freezes, woken, counts = 0, Counter(), {event: Counter() for event in TRACE_KEYS}
+    waiting = set()
+    written = None
+    for line in text.splitlines():
+        if line.startswith('#'):
+            match = re.search(r'entries-in-buffer/entries-written: (\d+)/(\d+)', line)
+            if match:
+                written = tuple(int(n) for n in match.groups())
+            continue
+        match = TRACE_LINE.match(line)
+        if not match:
+            continue
+        cpu, event, body = int(match['cpu']), match['event'], match['body']
+        if event == 'suspend_resume':
+            if body.startswith('timekeeping_freeze[') and body.endswith(' end'):
+                freezes += 1
+                waiting.add(cpu)
+            continue
+        key = TRACE_KEYS.get(event)
+        if not key:
+            continue
+        found = key.search(body)
+        name = found.group(1) if found else body
+        counts[event][name] += 1
+        # An IPI also enters as an interrupt named IPI; its ipi_entry names it.
+        if cpu in waiting and (event == 'ipi_entry' or
+                               event == 'irq_handler_entry' and name != 'IPI'):
+            waiting.discard(cpu)
+            woken[f'{"IPI " if event == "ipi_entry" else ""}{name}'] += 1
+
+    out = [f's2idle trace: {freezes} whole-SoC wakes']
+    if written and written[1] > written[0]:
+        out.append(f'warning: the trace buffer filled: kept the first {written[0]} of '
+                   f'{written[1]} events (arm with a larger --buffer-kb)')
+    if freezes:
+        out.append('what woke the SoC (first interrupt on the waking CPU):')
+        out.extend(f'  {count:8d} {100 * count / freezes:5.1f}%  {name}'
+                   for name, count in woken.most_common(top))
+        unknown = freezes - sum(woken.values())
+        if unknown:
+            out.append(f'  {unknown:8d} {100 * unknown / freezes:5.1f}%  (no interrupt traced)')
+    for event, title in TRACE_NAMES.items():
+        if counts[event]:
+            per = ', per wake' if freezes else ''
+            out.append(f'{title} while suspended (count{per}):')
+            out.extend(f'  {count:8d}' + (f' {count / freezes:7.2f}' if freezes else '')
+                       + f'  {name}' for name, count in counts[event].most_common(top))
+    return out
+
+
+def write(path, value):
+    path.write_text(value + '\n')
+
+
+def arm_trace(root=Path('/'), buffer_kb=8192):
+    instance = root / TRACING / 'instances' / INSTANCE
+    instance.mkdir()
+    try:
+        write(instance / 'tracing_on', '0')
+        write(instance / 'buffer_size_kb', str(buffer_kb))
+        # Keep the first events of a long sleep rather than the last.
+        write(instance / 'options/overwrite', '0')
+        for event in TRACE_EVENTS:
+            write(instance / 'events' / event / 'enable', '1')
+        for event, trigger in TRACE_TRIGGERS:
+            write(instance / 'events' / event / 'trigger', trigger)
+    except OSError:
+        disarm_trace(root)
+        raise
+
+
+def disarm_trace(root=Path('/')):
+    instance = root / TRACING / 'instances' / INSTANCE
+    if not instance.exists():
+        return False
+    write(instance / 'tracing_on', '0')
+    for event, trigger in TRACE_TRIGGERS:
+        try:
+            write(instance / 'events' / event / 'trigger', '!' + trigger)
+        except OSError:
+            pass
+    for event in TRACE_EVENTS:
+        try:
+            write(instance / 'events' / event / 'enable', '0')
+        except OSError:
+            pass
+    instance.rmdir()
+    return True
+
+
+def around(wait_for_suspend=120, settle=5):
+    before = snapshot()
+    subprocess.run(['systemctl', 'suspend'], check=True)
+    offset = before['boottime'] - before['monotonic']
+    deadline = time.monotonic() + wait_for_suspend
+    while time.monotonic() < deadline:
+        time.sleep(1)
+        if time.clock_gettime(time.CLOCK_BOOTTIME) - \
+                time.clock_gettime(time.CLOCK_MONOTONIC) - offset > 2:
+            break
+    else:
+        print(f'warning: no suspend seen within {wait_for_suspend} s', file=sys.stderr)
+    # The SMC updates the battery reading a few seconds after resume.
+    time.sleep(settle)
+    return before, snapshot()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = parser.add_subparsers(dest='command', required=True)
+    take = sub.add_parser('snapshot')
+    take.add_argument('file', type=Path)
+    diff = sub.add_parser('compare')
+    diff.add_argument('before', type=Path)
+    diff.add_argument('after', type=Path)
+    wrap = sub.add_parser('around')
+    wrap.add_argument('file', type=Path, nargs='?')
+    arm = sub.add_parser('arm')
+    arm.add_argument('--buffer-kb', type=int, default=8192,
+                     help='trace buffer per CPU (default 8192)')
+    report = sub.add_parser('report')
+    report.add_argument('--keep', action='store_true',
+                        help='leave the trace running for another suspend')
+    sub.add_parser('disarm')
+    args = parser.parse_args()
+
+    if args.command in ('arm', 'report', 'disarm') and os.geteuid() != 0:
+        parser.error(f'{args.command} needs root (tracefs and debugfs)')
+    if args.command == 'arm':
+        if (Path('/') / TRACING / 'instances' / INSTANCE).exists():
+            parser.error('already armed: run report or disarm first')
+        STATE.write_text(json.dumps({'before': snapshot()}))
+        arm_trace(buffer_kb=args.buffer_kb)
+        print(f'armed: counters in {STATE}, trace in {TRACING}/instances/{INSTANCE}.\n'
+              'Suspend as usual, on battery; after resume run: report')
+        return 0
+    if args.command == 'disarm':
+        print('disarmed' if disarm_trace() else 'not armed')
+        return 0
+    if args.command == 'report':
+        a = json.loads(STATE.read_text())['before']
+        b = snapshot()
+        STATE.write_text(json.dumps({'before': a, 'after': b}))
+        print('\n'.join(compare(a, b)))
+        trace = read(Path('/') / TRACING / 'instances' / INSTANCE / 'trace')
+        if trace is None:
+            print('s2idle trace: not armed')
+        else:
+            print('\n'.join(analyse_trace(trace)))
+            if not args.keep:
+                disarm_trace()
+        return 0
+
+    if args.command == 'snapshot':
+        args.file.write_text(json.dumps(snapshot()))
+        return 0
+    if args.command == 'compare':
+        a, b = (json.loads(path.read_text()) for path in (args.before, args.after))
+    else:
+        a, b = around()
+        if args.file:
+            args.file.write_text(json.dumps({'before': a, 'after': b}))
+    print('\n'.join(compare(a, b)))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git c/tools/aurora-sep/t6020-cpu-em.py w/tools/aurora-sep/t6020-cpu-em.py
new file mode 100755
index 000000000000..027f325d205e
--- /dev/null
+++ w/tools/aurora-sep/t6020-cpu-em.py
@@ -0,0 +1,167 @@
+#!/usr/bin/env python3
+"""Derive opp-microwatt for the T602x (M2 Pro/Max) CPU OPP tables.
+
+  t6020-cpu-em.py [--write]
+
+Without an energy model the scheduler's energy-aware placement (EAS) is
+off: on T602x the CPU OPP tables have no opp-microwatt, while T8103, T600x,
+T8112 and T8140 have measured ones. T8112 (M2) has the same cores as T602x,
+Blizzard and Avalanche, on the same process, so its measurements carry over
+once the voltage of each OPP is taken into account.
+
+T8112's per-OPP power (its opp-microwatt, measured with the SMC's cluster
+power meter) is fitted to P = (a + b f) V^2 f per core type, where V is
+T6020's voltage for that frequency: a switching capacitance that grows
+slowly with frequency, which absorbs leakage and temperature at the top.
+A T8112 point gets the voltage of the lowest T6020 OPP at or above its
+frequency (an upper bound when the two tables differ); points outside
+T6020's range are left out, since their voltage is unknown. The fitted
+model then gives T6020's OPPs: within 6% rms of T8112's measurements for
+both core types.
+
+Its energy per cycle, (a + b f) V^2, rises from each OPP to the next, so
+the energy model marks no OPP inefficient and cpufreq keeps choosing among
+all of them as it does today; only the scheduler's placement changes.
+
+The voltages are those of a J414s (M2 Pro, 10 cores), from the ADT's
+/arm-io/pmgr voltage-states1 (E cluster) and voltage-states5 (P cluster 0;
+cluster 1's voltage-states13 is within 6 mV), whose cells are pairs of
+(65536000 / MHz, mV). Prints the fit and each table's values; --write
+puts them into t602x-common.dtsi as each OPP's opp-microwatt. It reads
+the kernel tree it sits in, or the one AURORA_TREE names.
+"""
+import argparse
+import os
+from pathlib import Path
+import re
+import sys
+
+# The kernel tree: this script's own, or AURORA_TREE when run from a copy outside it.
+ROOT = Path(os.environ.get('AURORA_TREE') or Path(__file__).resolve().parents[2])
+T8112 = ROOT / 'arch/arm64/boot/dts/apple/t8112.dtsi'
+T602X = ROOT / 'arch/arm64/boot/dts/apple/t602x-common.dtsi'
+
+# (MHz, mV) for each T6020 OPP, in the order of t602x-common.dtsi.
+T6020_E = [(912, 612), (1284, 681), (1752, 775), (2004, 834), (2256, 887), (2424, 946)]
+T6020_P = [(702, 600), (948, 625), (1188, 646), (1452, 687), (1704, 718), (1968, 759),
+           (2208, 793), (2400, 825), (2568, 856), (2724, 896), (2868, 931), (3000, 975),
+           (3132, 1012), (3264, 1056), (3360, 1056), (3408, 1056), (3504, 1056)]
+TABLES = {'blizzard_opp': ('ecluster_opp', T6020_E), 'avalanche_opp': ('pcluster_opp', T6020_P)}
+
+
+def opp_table(source, label):
+    """[(MHz, opp-microwatt or None)] of the OPP table with that label."""
+    start = source.index(f'{label}: ')
+    body = source[start:source.index('\n\t};', start)]
+    rows = []
+    for node in re.findall(r'opp\d+ \{(.*?)\}', body, re.S):
+        hz = re.search(r'opp-hz = /bits/ 64 <(\d+)>', node)
+        uw = re.search(r'opp-microwatt = <(\d+)>', node)
+        rows.append((int(hz.group(1)) // 1000000, int(uw.group(1)) if uw else None))
+    return rows
+
+
+def points(measured, volts):
+    """(MHz, mV, uW) for each measured OPP in T6020's range, at the voltage of the next
+    T6020 OPP up."""
+    out = []
+    for mhz, uw in measured:
+        above = [mv for f, mv in volts if f >= mhz]
+        if above and mhz >= volts[0][0]:
+            out.append((mhz, above[0], uw))
+    return out
+
+
+def fit(data):
+    """(a, b) of P = (a + b f) V^2 f, least squares on the relative error."""
+    rows = [(v * v * f / p, v * v * f * f / p) for f, v, p in ((f, v / 1000, p) for f, v, p in data)]
+    s11 = sum(x * x for x, _ in rows)
+    s12 = sum(x * y for x, y in rows)
+    s22 = sum(y * y for _, y in rows)
+    t1 = sum(x for x, _ in rows)
+    t2 = sum(y for _, y in rows)
+    det = s11 * s22 - s12 * s12
+    return (t1 * s22 - t2 * s12) / det, (s11 * t2 - s12 * t1) / det
+
+
+def model(coef, mhz, mv):
+    a, b = coef
+    v = mv / 1000
+    return (a + b * mhz) * v * v * mhz
+
+
+def microwatts(coef, volts):
+    """opp-microwatt for each OPP, rounded to the milliwatt."""
+    return [(mhz, round(model(coef, mhz, mv) / 1000) * 1000) for mhz, mv in volts]
+
+
+def inefficient(table, capacity=1024):
+    """The OPPs the energy model would mark inefficient, in em_compute_costs()'s integer
+    arithmetic: cost = power * 10 / performance, performance = capacity * f / fmax, an OPP
+    being inefficient when its cost is not below that of every faster one."""
+    fmax = table[-1][0]
+    out, prev = [], None
+    for mhz, uw in reversed(table):
+        cost = uw * 10 // (capacity * mhz // fmax)
+        if prev is not None and cost >= prev:
+            out.append(mhz)
+        else:
+            prev = cost
+    return sorted(out)
+
+
+def derive(source):
+    """{T6020 label: (coef, rms relative error, [(MHz, uW)])}."""
+    out = {}
+    for label, (t8112_label, volts) in TABLES.items():
+        data = points(opp_table(source, t8112_label), volts)
+        coef = fit(data)
+        rms = (sum(((model(coef, f, v) - p) / p) ** 2 for f, v, p in data) / len(data)) ** 0.5
+        out[label] = coef, rms, microwatts(coef, volts)
+    return out
+
+
+def apply(source, derived):
+    """The T602x source with each CPU OPP's opp-microwatt set to the derived value."""
+    for label, (_, _, table) in derived.items():
+        start = source.index(f'{label}: ')
+        end = source.index('\n\t};', start)
+        body = source[start:end]
+        values = iter(table)
+
+        def node(match):
+            text = re.sub(r'\n\t\t\topp-microwatt = <\d+>;', '', match.group(0))
+            mhz, uw = next(values)
+            hz = int(re.search(r'opp-hz = /bits/ 64 <(\d+)>', text).group(1))
+            if hz != mhz * 1000000:
+                raise ValueError(f'{label}: OPP {hz} Hz, expected {mhz} MHz')
+            return re.sub(r'(\n\t\t\tclock-latency-ns = <\d+>;)',
+                          rf'\1\n\t\t\topp-microwatt = <{uw}>;', text, count=1)
+
+        body = re.sub(r'\t\topp\d+ \{.*?\n\t\t\};', node, body, flags=re.S)
+        if next(values, None) is not None:
+            raise ValueError(f'{label}: fewer OPPs than derived')
+        source = source[:start] + body + source[end:]
+    return source
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('--write', action='store_true', help=f'update {T602X.name}')
+    args = parser.parse_args()
+    if not T8112.exists():
+        parser.error(f'{T8112} not found: set AURORA_TREE to a linux-aurora tree')
+    derived = derive(T8112.read_text())
+    for label, (coef, rms, table) in derived.items():
+        print(f'{label}: a={coef[0]:.1f} b={coef[1]:.5f} rms {rms * 100:.1f}% '
+              f'inefficient {inefficient(table) or "none"}')
+        for mhz, uw in table:
+            print(f'  {mhz} MHz: {uw} uW')
+    if args.write:
+        T602X.write_text(apply(T602X.read_text(), derived))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git c/tools/aurora-sep/tests/test_deep_idle_check.py w/tools/aurora-sep/tests/test_deep_idle_check.py
new file mode 100644
index 000000000000..a9d308032e39
--- /dev/null
+++ w/tools/aurora-sep/tests/test_deep_idle_check.py
@@ -0,0 +1,144 @@
+"""deep-idle-check.py: image names, device tree, energy model, PMP, cpuidle and domains."""
+
+from pathlib import Path
+import hashlib
+import importlib.util
+import os
+import tempfile
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("deep_idle_check", ROOT / "deep-idle-check.py")
+check = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(check)
+
+GENPD = """domain                          status          children        performance
+    /device                         runtime status                  managed by
+------------------------------------------------------------------------------
+dispext0_sys                    on                              0
+    289c00000.dcp                   unsupported                 0           SW
+ane_cpu                         off-0                           0
+atc0_usb                        on                              0
+pmp                             on                              0
+gfx                             on                              0
+"""
+
+
+def machine(root, *, image=b"m1n1", em=False, pmp=False, residency=None):
+    def write(path, text):
+        path = root / path
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text)
+    (root / check.BOOT_BIN).parent.mkdir(parents=True)
+    (root / check.BOOT_BIN).write_bytes(image)
+    write("proc/sys/kernel/osrelease", "7.1.12-test\n")
+    write(check.EAS, "1\n")
+    write(check.CMDLINE, "root=x quiet" + (f" cpuidle_apple.pd_residency_us={residency}" if residency else "") + "\n")
+    for n in range(2):
+        for i, name in enumerate(("WFI", "CPU PD")):
+            state = f"{check.CPUS}/cpu{n}/cpuidle/state{i}"
+            write(f"{state}/name", name + "\n")
+            write(f"{state}/disable", "1\n" if (i == 0 and n == 0) else "0\n")
+            write(f"{state}/time", "0\n")
+    write(f"{check.DT}/aliases/dcpext0", "/soc/dcp")
+    if em:
+        for opp in ("opp02", "opp03"):
+            write(f"{check.DT}/opp-table-0/{opp}/opp-microwatt", "x")
+        write(f"{check.DT}/opp-table-gpu/opp00/opp-microwatt", "x")
+        for cpu in ("cpu0", "cpu4"):
+            (root / check.ENERGY_MODEL / cpu).mkdir(parents=True)
+    else:
+        (root / check.ENERGY_MODEL).mkdir(parents=True)
+    if pmp:
+        write(f"{check.DT}/aliases/pmp", "/soc/pmp")
+    driver = root / check.PMP_DRIVER
+    driver.mkdir(parents=True)
+    (driver / "bind").write_text("")
+    if pmp:
+        os.symlink(root, driver / "28e700000.pmp")
+    if residency:
+        write(check.RESIDENCY, f"{residency}\n")
+    write(check.GENPD_SUMMARY, GENPD)
+
+
+class DeepIdleCheckTest(unittest.TestCase):
+    def test_names_a_staged_image_by_its_hash(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            machine(root, image=b"staged")
+            digest = hashlib.sha256(b"staged").hexdigest()[:16]
+            self.assertIn("not a staged image", check.image(root))
+            check.IMAGES[digest] = "E6 test"
+            try:
+                self.assertEqual(check.image(root), f"{digest} E6 test")
+            finally:
+                del check.IMAGES[digest]
+        self.assertEqual(len(set(check.IMAGES.values())), len(check.IMAGES))
+
+    def test_stock_machine(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            machine(root)
+            text = "\n".join(check.report(root, 2, sleep=lambda s: None, clock=iter([0, 2]).__next__))
+            self.assertIn("CPU opp-microwatt entries: 0", text)
+            self.assertIn("pmp alias: no", text)
+            self.assertIn("dcpext aliases: dcpext0", text)
+            self.assertIn("energy model domains: none", text)
+            self.assertIn("apple_pmp bound: nothing", text)
+            self.assertIn("WFI: disable 0/1 on 2 CPUs", text)
+            self.assertIn("pd_residency_us: not in this kernel", text)
+            self.assertIn("power domains: dispext0_sys=on ane_cpu=off-0 atc0_usb=on pmp=on", text)
+            self.assertNotIn("gfx", text)
+
+    def test_energy_model_pmp_and_residency(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            machine(root, em=True, pmp=True, residency=500)
+            text = "\n".join(check.report(root, 2, sleep=lambda s: None, clock=iter([0, 2]).__next__))
+            self.assertIn("CPU opp-microwatt entries: 2", text)
+            self.assertIn("pmp alias: yes", text)
+            self.assertIn("energy model domains: cpu0 cpu4", text)
+            self.assertIn("apple_pmp bound: 28e700000.pmp", text)
+            self.assertIn("pd_residency_us: 500 (command line 500)", text)
+
+    def test_residency_share_over_the_window(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            machine(root)
+            states = root / check.CPUS
+            for n in range(2):
+                (states / f"cpu{n}/cpuidle/state1/time").write_text("1000000\n")
+            (states / "cpu1/cpuidle/state0/time").write_text("200000\n")
+
+            def sleep(seconds):
+                for n in range(2):
+                    (states / f"cpu{n}/cpuidle/state1/time").write_text("2500000\n")
+                (states / "cpu1/cpuidle/state0/time").write_text("700000\n")
+            lines = check.cpuidle(root, 2, sleep=sleep, clock=iter([10, 12]).__next__)
+            self.assertIn("time over 2s: WFI 12.5%, CPU PD 75.0%", lines)
+
+    def test_empty_eas_read_means_eas_impossible(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            machine(root)
+            (root / check.EAS).write_text("")
+            self.assertIn("sched_energy_aware: empty (EAS not possible)", check.energy_model(root))
+
+    def test_debugfs_without_root(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            machine(root)
+            (root / check.GENPD_SUMMARY).chmod(0)
+            (root / check.ENERGY_MODEL).chmod(0)
+            try:
+                if os.geteuid() == 0:
+                    self.skipTest("root reads anything")
+                self.assertEqual(check.domains(root), ["power domains: needs root"])
+                self.assertIn("energy model: needs root", check.energy_model(root))
+            finally:
+                (root / check.ENERGY_MODEL).chmod(0o755)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git c/tools/aurora-sep/tests/test_idle_ab.py w/tools/aurora-sep/tests/test_idle_ab.py
new file mode 100644
index 000000000000..ba9f34dab090
--- /dev/null
+++ w/tools/aurora-sep/tests/test_idle_ab.py
@@ -0,0 +1,221 @@
+"""idle-ab.py: settings, a fake sysfs run that restores every knob, the paired report."""
+
+from pathlib import Path
+import importlib.util
+import tempfile
+import unittest
+from unittest import mock
+
+
+ROOT = Path(__file__).resolve().parents[1]
+SPEC = importlib.util.spec_from_file_location("idle_ab", ROOT / "idle-ab.py")
+idle_ab = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(idle_ab)
+
+
+def fake_machine(root, residency=True, cpus=2):
+    for n in range(cpus):
+        for i in range(2):
+            state = root / idle_ab.CPUS / f"cpu{n}/cpuidle/state{i}"
+            state.mkdir(parents=True)
+            (state / "disable").write_text("0\n")
+            (state / "time").write_text("0\n")
+    hwmon = root / idle_ab.HWMON / "hwmon1"
+    hwmon.mkdir(parents=True)
+    (hwmon / "name").write_text("macsmc_hwmon\n")
+    (hwmon / "power1_label").write_text("Heatpipe Power\n")
+    (hwmon / "power1_input").write_text("1250000\n")
+    (hwmon / "power2_label").write_text("Total System Power\n")
+    (hwmon / "power2_input").write_text("6550000\n")
+    other = root / idle_ab.HWMON / "hwmon4"
+    other.mkdir(parents=True)
+    (other / "name").write_text("tas2764\n")
+    (other / "power1_label").write_text("Speaker\n")
+    for policy, mhz in (("policy0", 912000), ("policy4", 3264000)):
+        (root / idle_ab.POLICIES / policy).mkdir(parents=True)
+        (root / idle_ab.POLICIES / policy / "scaling_cur_freq").write_text(f"{mhz}\n")
+    (root / "proc/sys/kernel").mkdir(parents=True)
+    (root / idle_ab.EAS).write_text("1\n")
+    (root / idle_ab.STAT).write_text("cpu  9 0 0 9 0 0 0 0 0 0\n"
+                                     "cpu0 3 0 1 4 2 0 0 0 0 0\ncpu1 1 0 0 9 0 0 0 0 0 0\nintr 5\n")
+    if residency:
+        param = root / idle_ab.RESIDENCY
+        param.parent.mkdir(parents=True)
+        param.write_text("10000\n")
+
+
+class IdleAbTest(unittest.TestCase):
+    def test_settings(self):
+        self.assertEqual(idle_ab.parse_setting("default"), (0, 0, None, None, None))
+        self.assertEqual(idle_ab.parse_setting("wfi-only"), (0, 1, None, None, None))
+        self.assertEqual(idle_ab.parse_setting("pd-always"), (1, 0, None, None, None))
+        self.assertEqual(idle_ab.parse_setting("res=500"), (0, 0, 500, None, None))
+        self.assertEqual(idle_ab.parse_setting("pd-always@4-6,9"), (1, 0, None, {4, 5, 6, 9}, None))
+        self.assertEqual(idle_ab.parse_setting("wfi-only@1"), (0, 1, None, {1}, None))
+        self.assertEqual(idle_ab.parse_setting("no-eas"), (0, 0, None, None, 0))
+        for bad in ("res=0", "res=", "res=x", "fast", "default@1", "pd-always@", "pd-always@3-1",
+                    "pd-always@a", "pd-always@1,", "res=5@1", "no-eas@1", "eas"):
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                idle_ab.parse_setting(bad)
+
+    def test_run_applies_each_setting_and_restores_everything(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            fake_machine(root)
+            machine = idle_ab.Machine(root)
+            self.assertEqual(list(machine.sensors), ["Total System Power", "Heatpipe Power"])
+            seen = []
+            real_apply = machine.apply
+
+            def apply(setting):
+                real_apply(setting)
+                seen.append(((root / idle_ab.CPUS / "cpu1/cpuidle/state0/disable").read_text(),
+                             (root / idle_ab.CPUS / "cpu1/cpuidle/state1/disable").read_text(),
+                             (root / idle_ab.RESIDENCY).read_text()))
+            machine.apply = apply
+            with mock.patch.object(idle_ab.time, "sleep"), \
+                    mock.patch.object(idle_ab.time, "monotonic", side_effect=range(1000)):
+                rows = idle_ab.run(machine, ["default", "pd-always", "res=500"], 2, 2, 0)
+            self.assertEqual([r["setting"] for r in rows],
+                             ["default", "pd-always", "res=500", "res=500", "pd-always", "default"])
+            self.assertEqual(seen[1], ("1\n", "0\n", "10000\n"))
+            self.assertEqual(seen[2], ("0\n", "0\n", "500\n"))
+            # A setting without a residency runs with the one found, also after res=.
+            self.assertEqual(seen[4], ("1\n", "0\n", "10000\n"))
+            self.assertEqual(rows[0]["watts"], 6.55)
+            self.assertEqual(rows[0]["mhz"], {"policy0": 912, "policy4": 3264})
+            self.assertEqual(machine.busy(), {0: (4, 10), 1: (1, 10)})
+            self.assertEqual(rows[0]["busy_pct"], 0.0)
+            self.assertEqual(rows[0]["busy_pct_by_cpu"], {0: 0.0, 1: 0.0})
+
+    def test_busy_time_is_the_difference_over_the_window(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            fake_machine(root)
+            machine = idle_ab.Machine(root)
+            stat = root / idle_ab.STAT
+
+            def sleep(seconds):
+                if seconds == 1:  # a sampling sleep, after the window's first snapshot
+                        stat.write_text("cpu0 9 0 1 4 2 0 0 0 0 0\ncpu1 1 0 0 19 0 0 0 0 0 0\n")
+            with mock.patch.object(idle_ab.time, "sleep", side_effect=sleep), \
+                    mock.patch.object(idle_ab.time, "monotonic", side_effect=range(1000)):
+                rows = idle_ab.run(machine, ["default"], 1, 2, 0)
+            # cpu0: 6 more busy jiffies of 6; cpu1: none of 10.
+            self.assertEqual(rows[0]["busy_pct_by_cpu"], {0: 100.0, 1: 0.0})
+            self.assertEqual(rows[0]["busy_pct"], 37.5)
+            self.assertEqual(rows[0]["sensors"], {"Total System Power": 6.55,
+                                                  "Heatpipe Power": 1.25})
+            self.assertEqual(sorted({p.read_text() for p in machine.saved}), ["0\n", "1\n", "10000\n"])
+            for path, value in machine.saved.items():
+                self.assertEqual(path.read_text(), value)
+            self.assertEqual((root / idle_ab.RESIDENCY).read_text(), "10000\n")
+
+    def test_a_cpu_list_sets_only_those_cpus(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            fake_machine(root, cpus=11)
+            machine = idle_ab.Machine(root)
+            self.assertEqual(machine.numbers(), list(range(11)))
+            states = []
+            real_apply = machine.apply
+
+            def apply(setting):
+                real_apply(setting)
+                states.append([(root / idle_ab.CPUS / f"cpu{n}/cpuidle/state{i}/disable")
+                               .read_text().strip() for n in range(11) for i in (0, 1)])
+            machine.apply = apply
+            with mock.patch.object(idle_ab.time, "sleep"), \
+                    mock.patch.object(idle_ab.time, "monotonic", side_effect=range(1000)):
+                rows = idle_ab.run(machine, ["pd-always@1,10", "wfi-only@0-1"], 1, 2, 0)
+            pd = ["0"] * 22
+            pd[2] = pd[20] = "1"
+            self.assertEqual(states[0], pd)
+            self.assertEqual(states[1], ["0", "1", "0", "1"] + ["0"] * 18)
+            self.assertEqual(sorted(rows[0]["pd_pct_by_cpu"]), list(range(11)))
+            for path in machine.saved:
+                expected = "0\n" if "disable" in str(path) else "1\n" if path == root / idle_ab.EAS \
+                    else "10000\n"
+                self.assertEqual(path.read_text(), expected)
+
+    def test_a_missing_cpu_is_refused_before_anything_is_written(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            fake_machine(root)
+            machine = idle_ab.Machine(root)
+            machine.apply = mock.Mock()
+            with self.assertRaisesRegex(ValueError, "no CPU 2"):
+                idle_ab.run(machine, ["default", "pd-always@1-2"], 1, 1, 0)
+            machine.apply.assert_not_called()
+
+    def test_no_eas_turns_eas_off_only_for_its_window(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            fake_machine(root)
+            machine = idle_ab.Machine(root)
+            seen = []
+            real_apply = machine.apply
+
+            def apply(setting):
+                real_apply(setting)
+                seen.append((root / idle_ab.EAS).read_text())
+            machine.apply = apply
+            with mock.patch.object(idle_ab.time, "sleep"), \
+                    mock.patch.object(idle_ab.time, "monotonic", side_effect=range(1000)):
+                idle_ab.run(machine, ["default", "no-eas", "pd-always"], 1, 2, 0)
+            self.assertEqual(seen, ["1\n", "0\n", "1\n"])
+            self.assertEqual((root / idle_ab.EAS).read_text(), "1\n")
+
+    def test_eas_is_not_written_unless_a_setting_uses_it(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            fake_machine(root)
+            (root / idle_ab.EAS).chmod(0o444)
+            machine = idle_ab.Machine(root)
+            with mock.patch.object(idle_ab.time, "sleep"), \
+                    mock.patch.object(idle_ab.time, "monotonic", side_effect=range(1000)):
+                idle_ab.run(machine, ["default", "pd-always"], 2, 2, 0)
+            self.assertNotIn(root / idle_ab.EAS, machine.written)
+
+    def test_restores_after_an_error(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            fake_machine(root)
+            machine = idle_ab.Machine(root)
+            with mock.patch.object(idle_ab.time, "sleep", side_effect=KeyboardInterrupt), \
+                    self.assertRaises(KeyboardInterrupt):
+                idle_ab.run(machine, ["pd-always", "res=200"], 1, 5, 1)
+            self.assertEqual((root / idle_ab.CPUS / "cpu0/cpuidle/state0/disable").read_text(),
+                             "0\n")
+            self.assertEqual((root / idle_ab.RESIDENCY).read_text(), "10000\n")
+
+    def test_residency_setting_needs_the_parameter(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            fake_machine(root, residency=False)
+            machine = idle_ab.Machine(root)
+            with mock.patch.object(idle_ab.time, "sleep"), \
+                    self.assertRaises(FileNotFoundError):
+                idle_ab.run(machine, ["res=500"], 1, 1, 0)
+
+    def test_report_pairs_by_round(self):
+        rows = [{"round": n, "setting": s, "watts": w, "pd_pct": 1.0, "wfi_pct": 2.0,
+                 "sensors": {"Total System Power": w, "Heatpipe Power": w / 4},
+                 "busy_pct": 40.0 if s == "default" else 30.0,
+                 "mhz": {"policy0": 912, "policy4": 1000 + n}}
+                for n, base in enumerate((12.0, 8.0, 10.0))
+                for s, w in (("default", base), ("pd-always", base - 0.5))]
+        report = "\n".join(idle_ab.report(rows, ["default", "pd-always"]))
+        total, heatpipe = report.split("Heatpipe Power:")
+        self.assertIn("default         10.00", total)
+        self.assertIn("pd-always        9.50", total)
+        self.assertIn("-0.500 W (sd 0.00, se 0.000, lower in 3 of 3)", total)
+        self.assertIn("pd-always        2.38", heatpipe)
+        self.assertIn("-0.125 W", heatpipe)
+        clocks = report.split("Busy time and clocks:")[1]
+        self.assertIn("default        40.0       912      1001", clocks)
+        self.assertIn("pd-always      30.0       912      1001", clocks)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git c/tools/aurora-sep/tests/test_sleep_drain_probe.py w/tools/aurora-sep/tests/test_sleep_drain_probe.py
new file mode 100644
index 000000000000..8b7fd4864a72
--- /dev/null
