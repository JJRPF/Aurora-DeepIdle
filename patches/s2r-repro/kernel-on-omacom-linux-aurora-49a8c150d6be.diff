+/*
+ * GH-5 R60L TEST: write a u32 SMC key from userspace, e.g. "pmVC=0x1ff", logs the value before, the write's
+ * return and the value after (with MEPS). For trying pmVC masks after the wake without a new kernel.
+ */
+static int smc_write_set(const char *val, const struct kernel_param *kp)
+{
+	struct macsmc_reboot *reboot = READ_ONCE(macsmc_reboot_inst);
+	char k[5] = {};
+	u32 v, before = 0, after = 0;
+	u8 meps[6] = {};
+	int ret, r0, r1;
+
+	if (!reboot)
+		return -ENODEV;
+	if (strlen(val) < 6 || val[4] != '=')
+		return -EINVAL;
+	memcpy(k, val, 4);
+	ret = kstrtou32(val + 5, 0, &v);
+	if (ret)
+		return ret;
+	smc_key key = __SMC_KEY(k[0], k[1], k[2], k[3]);
+	r0 = apple_smc_read_u32(reboot->smc, key, &before);
+	ret = apple_smc_write_u32(reboot->smc, key, v);
+	msleep(50);
+	r1 = apple_smc_read_u32(reboot->smc, key, &after);
+	apple_smc_read(reboot->smc, SMC_KEY(MEPS), meps, sizeof(meps));
+	dev_info(reboot->dev, "TEST smc_write: %s = %#x (%d): before %#x (%d), after %#x (%d), MEPS %6phN\n",
+		 k, v, ret, before, r0, after, r1, meps);
+	return ret < 0 ? ret : 0;
+}
