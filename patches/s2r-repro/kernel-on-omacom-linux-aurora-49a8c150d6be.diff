+static void macsmc_reboot_s2r_gpio(struct device *dev, struct macsmc_reboot *reboot, bool off)
+{
+	unsigned long pins = off ? READ_ONCE(s2r_gpio_off) : s2r_gpio_lowered;
+	unsigned int i;
+
+	for_each_set_bit(i, &pins, 32) {
+		smc_key key = __SMC_KEY('g', 'P', hex_asc_hi(i), hex_asc_lo(i));
+		u32 before = 0, after = 0;
+		int r0 = apple_smc_rw_u32(reboot->smc, key, 1 << 24, &before);
+		int ret = apple_smc_write_u32(reboot->smc, key, off ? 0 : (1 << 24) | 1);
+		int r1 = apple_smc_rw_u32(reboot->smc, key, 1 << 24, &after);
+
+		if (off && ret >= 0)
+			__set_bit(i, &s2r_gpio_lowered);
+		dev_info(dev, "TEST s2r: SMC gP%02x %s (%d): read %#x (%d) -> %#x (%d)\n", i, off ? "= 0 before slpa" :
+			 "on again at the wake", ret, before, r0, after, r1);
+	}
+	if (!off)
+		s2r_gpio_lowered = 0;
